#!/usr/bin/env python3
"""Empty every stored enable secret that is only a copy of its login password.

Register B14, NSOT_PLAN P.3 step 11. Every device stored its login password
twice: as `password`, and again as `secret`. No device here has an enable
secret, and Netmiko sends `secret` only in answer to an enable prompt, so the
copy did nothing, and it is what made the terminal's unconditional send of it
look harmless (B13). A credential stored twice is a credential that leaks
twice.

    python3 scripts/nmas-credential-dedupe            # dry run: what would change
    python3 scripts/nmas-credential-dedupe --apply    # write it

What it touches:
  * every list's devices.csv (NetBox-sourced lists have none, and are named);
  * data/credential_profiles.json: device overrides and profiles.

What it does NOT touch:
  * a secret that DIFFERS from its password: that is a real enable secret, and
    it is kept and counted;
  * anything it cannot decrypt: left alone and named;
  * the credential store at all, if the file does not parse. The store's own
    loader turns an unreadable file into an empty one, and saving that would
    erase every credential: the settings-file erasure, one store over.

It prints names and counts only, never a value. The connection falls back to
the login password for an empty secret (`connection.connection_params`), so a
device that never asked for an enable secret behaves exactly as before.

Exit 0 on success (dry run or applied), 1 if anything was refused, 2 if it
could not run.
"""

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)


def _csv_lists():
    from modules.config import LISTS_DIR
    from modules.device import get_device_lists
    for entry in get_device_lists():
        yield entry["name"], os.path.join(LISTS_DIR, entry["filename"], "devices.csv")


def _scan_csv(path: str) -> dict:
    from modules.device import decrypt_field, fernet, load_saved_devices
    rows = load_saved_devices(path)
    out = {"rows": rows, "dupes": [], "kept": [], "empty": [], "unreadable": []}
    for row in rows:
        name = row.get("hostname") or row.get("ip", "?")
        try:
            password = decrypt_field(row.get("password", ""))
            secret = decrypt_field(row["secret"]) if row.get("secret") else ""
        except Exception:                                   # noqa: BLE001
            out["unreadable"].append(name)
            continue
        if not secret:
            out["empty"].append(name)
        elif secret == password:
            out["dupes"].append(name)
            row["secret"] = fernet.encrypt(b"").decode()
        else:
            out["kept"].append(name)
    return out


def _scan_store(path: str) -> dict:
    """Read the store ITSELF, and refuse on a parse failure."""
    from modules.secrets_store import decrypt_value
    if not os.path.exists(path):
        return {"missing": True}
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        return {"unparseable": f"{type(exc).__name__}"}
    out = {"data": data, "dupes": [], "kept": [], "unreadable": []}
    for section in ("device_overrides", "profiles"):
        for key, entry in (data.get(section) or {}).items():
            label = f"{section}:{key}"
            if not entry.get("secret"):
                continue
            try:
                password = decrypt_value(entry.get("password", ""))
                secret = decrypt_value(entry["secret"])
            except Exception:                               # noqa: BLE001
                out["unreadable"].append(label)
                continue
            if secret and secret == password:
                out["dupes"].append(label)
                entry["secret"] = ""
            elif secret:
                out["kept"].append(label)
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true", help="write the changes")
    args = ap.parse_args()

    from modules import credentials
    from modules.device import write_devices_csv

    refused = 0
    total_dupes = 0
    print("DRY RUN" if not args.apply else "APPLYING")
    for name, path in _csv_lists():
        if not os.path.exists(path):
            print(f"  list {name!r}: no devices.csv (NetBox-sourced or empty); nothing to do")
            continue
        got = _scan_csv(path)
        total_dupes += len(got["dupes"])
        print(f"  list {name!r}: {len(got['dupes'])} copy/copies of the password to empty"
              f" {got['dupes']}; {len(got['kept'])} distinct enable secret(s) kept"
              f" {got['kept']}; {len(got['empty'])} already empty")
        if got["unreadable"]:
            refused += 1
            print(f"    left alone, could not decrypt: {got['unreadable']}")
        if args.apply and got["dupes"]:
            write_devices_csv(got["rows"], path)
            print("    written")

    store_path = credentials._FILE
    got = _scan_store(store_path)
    if got.get("missing"):
        print("  credential store: none; nothing to do")
    elif got.get("unparseable"):
        refused += 1
        print(f"  credential store: REFUSED, the file does not parse ({got['unparseable']}). "
              "It is not written: the store's loader would read it as empty, and "
              "saving that erases every credential.")
    else:
        total_dupes += len(got["dupes"])
        print(f"  credential store: {len(got['dupes'])} copy/copies to empty {got['dupes']};"
              f" {len(got['kept'])} distinct enable secret(s) kept {got['kept']}")
        if got["unreadable"]:
            refused += 1
            print(f"    left alone, could not decrypt: {got['unreadable']}")
        if args.apply and got["dupes"]:
            with credentials._lock:
                credentials._save(got["data"])
            print("    written")

    print(f"{total_dupes} stored copy/copies of a login password "
          + ("emptied." if args.apply else "would be emptied. Re-run with --apply."))
    return 1 if refused else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:                                  # noqa: BLE001
        print(f"UNPROVEN: could not run: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(2)
