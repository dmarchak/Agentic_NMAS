# TEMPLATE (2026-09-29): the repository is public, so the host's user and paths
# are placeholders. Render it, never copy it:
# P.6 D2/D5/D6: serves a pending ZTP device its bootstrap config, read
# requests only, on the socket nmas-ztp-responder.socket binds. Started by
# that socket; never enabled on its own.
[Unit]
Description=NMAS: ZTP config responder (read-only TFTP)
Requires=nmas-ztp-responder.socket
After=nmas-ztp-responder.socket

[Service]
User=@NMAS_USER@
Group=@NMAS_USER@
WorkingDirectory=@NMAS_CHECKOUT@
ExecStart=@NMAS_CHECKOUT@/scripts/nmas-ztp-responder
# Nothing gains a capability: systemd holds the port.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
# The audit row is the only thing it writes.
ReadWritePaths=@NMAS_CHECKOUT@/data
RestrictAddressFamilies=AF_INET AF_UNIX
