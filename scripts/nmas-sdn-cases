#!/usr/bin/env python3
"""Record classify_threat's cases live (PHASE8_PLAN 17.1 S7; modules/sdn/closed_loop.py;
tests/fixtures/ai_cases/sdn_classify/).

    # on the host, the deployed copy run as a file (it adopts the app's interpreter): each
    # case classified through the real path, recorded as an evaluation, ten runs
    nmas-host nmas -- <checkout>/scripts/nmas-sdn-cases --list <network> --runs 10 \\
        --out /tmp/sdn-cases.json
    nmas-host nmas -- <checkout>/scripts/nmas-sdn-cases --list <network> \\
        --cases tests/fixtures/ai_cases/sdn_classify/held_out.json --runs 10 \\
        --out /tmp/sdn-held-out.json

Each run asks every case through `closed_loop.classify_pack`, the screen's and the loop's own
path (the classification marking, the topology class and the response limits of *--list*,
the gateway's allowance, caps, mask and record, the code's check of the answer), with the case's
detection and the evidence pack's sdn section as Mercury kept them. **Nothing is sent to a
switch**: a classification only proposes.

**Recorded as an evaluation, never a person** (C1784, C1846; PHASE8_PLAN 18.3 rule 9): the
actor is ``evaluation:<run>`` (none given is ``evaluation:sdn-cases-<UTC time>``; an address or
anything else is refused before anything is asked), the trigger the evaluation's, so its spend
counts against the caps under its run.

Per case and run it keeps the outcome, the action and the source or flow it acts on, the
judge's misses (`cases.sdn_classify_misses`), the compared fields (`cases.sdn_compared`), the
cost and the latency, and reports per case the passes, whether every run passed (**reliable**:
TESTING.md, "Reliability decides, not consistency"), whether every run's compared fields agree
(consistency, reported, deciding nothing), the cost and the latency; then the reliability (the
share of cases reliable), with its cases and runs beside it, and the cost per call and per
successful answer. A refusal that is Mercury's or the provider's (hosted AI off, a cap) stops
the run with nothing more spent (3). A call that stops at max_tokens voids the run (4, C1756's
rule). `--out` may not be inside the checkout (2).

**Check** (`--check`, and first thing in every recording): each case's expectations against its
own evidence, with no call: an expected source the evidence does not hold, a cited id it did not
send, or a flow that is not the detection's own stops the recording before anything is asked or
spent (5), never scored as the model's miss.
"""
import argparse
import json
import os
import statistics
import sys
import time

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

CASES = os.path.join("tests", "fixtures", "ai_cases", "sdn_classify", "recorded.json")
STOPS = ("ai_off", "no_key", "over_cap", "unknown_task", "unknown_model", "provider_error",
         "rate_limited", "overloaded", "key_refused", "bad_request", "provider_down",
         "trigger", "withheld", "classified", "limits")


def pack_of(case: dict, network: str) -> dict:
    """A case's evidence as the pack Mercury keeps it: its sdn section, never hashed (the
    case's own file is what is versioned)."""
    from modules import evidence_pack as EP

    return {"id": f"case-{case['n']}", "network": network, "store": "sdn",
            "sections": [dict(case["section"], name=EP.SDN_SECTION)]}


def check(checkout: str, case_file: str = CASES) -> list:
    """The expectations each case's own evidence does not bear out, in words, with no call."""
    import ipaddress

    from modules.ai import cases
    from modules.sdn import closed_loop

    out = []
    data = cases.load(os.path.join(checkout, case_file))
    for c in data["cases"]:
        e, sent = c["expect"], closed_loop.sent_evidence(c["section"])
        if not sent["detection"]:
            out.append(f"case {c['n']}: its section holds no detection")
            continue
        if e.get("source"):
            want = ipaddress.ip_address(e["source"]).compressed
            if want not in sent["names"] or want != closed_loop._canon(c["detection"].get("source")):
                out.append(f"case {c['n']}: the expected source {want} is not the detection's "
                           f"({c['detection'].get('source')})")
        stray = [r for r in e.get("cites_any") or [] if r not in sent["ids"]]
        if stray or not e.get("cites_any"):
            out.append(f"case {c['n']}: cites_any holds {stray[:2] or 'nothing'}, not ids the "
                       "evidence sends")
        if e.get("flow") and e["flow"] != (c["detection"].get("subject") or {}).get("value"):
            out.append(f"case {c['n']}: the expected flow is not the one the detection names")
        bad = [a for a in e["action_id"] if a != closed_loop.NO_ACTION and c["detection"]["rule"]
               not in closed_loop.CATALOGUE.get(a, {}).get("rules", ())]
        if bad:
            out.append(f"case {c['n']}: {bad} cannot answer the rule {c['detection']['rule']}")
    return out


def summary(case: dict, runs: list) -> dict:
    """One case's runs, reported: passes, reliable (every run passed), consistent (every run's
    compared fields the same), cost and latency."""
    lat = [r["latency_s"] for r in runs]
    passed = sum(not r["misses"] for r in runs)
    return {"n": case["n"], "key": case["key"], "passed": passed, "runs": len(runs),
            "reliable": bool(runs) and passed == len(runs),
            "consistent": len({r["compared"] for r in runs}) == 1,
            "cost_usd": round(sum(r["cost_usd"] for r in runs), 6),
            "latency_p50_s": round(statistics.median(lat), 2) if lat else None,
            "outcomes": [r["outcome"] for r in runs],
            "first_miss": next((r["misses"][0] for r in runs if r["misses"]), "")}


def record(checkout: str, list_name: str, actor: str, out: str, case_file: str,
           runs: int, model: str = "", prompt: tuple = None) -> int:
    from modules.ai import cases, profiles, triggers
    from modules.sdn import closed_loop

    prompt = tuple(prompt or closed_loop.CLASSIFY_PROMPT)

    if os.path.realpath(out).startswith(os.path.realpath(checkout) + os.sep):
        print(f"nmas-sdn-cases: --out {out} is inside the checkout; write it elsewhere",
              file=sys.stderr)
        return 2
    actor, refusal = cases.evaluation_actor(actor, "sdn-cases")
    refusal = refusal or cases.measure_on(closed_loop.CLASSIFY_FEATURE, model)
    if refusal:
        print(f"nmas-sdn-cases: {refusal}", file=sys.stderr)
        return 2
    print(f"nmas-sdn-cases: recorded as {actor}"
          + (f", on {model} (the pin file unchanged)" if model else "")
          + f", prompt {prompt[0]}.v{prompt[1]}")
    problems = check(checkout, case_file)
    if problems:
        for p in problems:
            print(f"nmas-sdn-cases: stale expectation: {p}", file=sys.stderr)
        print(f"nmas-sdn-cases: {len(problems)} stale expectation(s); nothing asked, nothing "
              "spent", file=sys.stderr)
        return 5
    data = cases.load(os.path.join(checkout, case_file))
    pin = profiles.TASKS[closed_loop.CLASSIFY_FEATURE]["model"]
    if model:
        data = dict(data, model=model)
    if data["model"] != pin:
        print(f"nmas-sdn-cases: the case file is for {data['model']}, the task is pinned to "
              f"{pin}", file=sys.stderr)
        return 2
    by_case, spent, status = {c["n"]: [] for c in data["cases"]}, 0.0, 0
    for run in range(1, runs + 1):
        for case in data["cases"]:
            t0 = time.monotonic()
            got = closed_loop.classify_pack(list_name, case["detection"],
                                            pack_of(case, list_name), actor=actor,
                                            trigger=triggers.evaluation(actor), intact=False,
                                            prompt=prompt)
            took = time.monotonic() - t0
            spent += float(got.get("cost_usd") or 0)
            if got.get("error") in STOPS:
                print(f"nmas-sdn-cases: run {run} case {case['n']} refused by Mercury "
                      f"({got['error']}: {got.get('detail', '')}); stopped, ${spent:.4f} spent",
                      file=sys.stderr)
                status = 3
                break
            if got.get("error") == "max_tokens":
                print(f"nmas-sdn-cases: run {run} case {case['n']} stopped at max_tokens: the "
                      "run is void (C1756)", file=sys.stderr)
                status = 4
                break
            c = got.get("classification") or {}
            rec = {"run": run, "outcome": cases.sdn_outcome(got), "action": got.get("action"),
                   "params": got.get("params") or {}, "answer": c,
                   "misses": cases.sdn_classify_misses(case["expect"], got),
                   "compared": cases.sdn_compared(got),
                   "cost_usd": float(got.get("cost_usd") or 0), "latency_s": round(took, 2),
                   "call_id": got.get("call_id", ""), "error": got.get("error", ""),
                   "detail": (got.get("detail") or "")[:240]}
            by_case[case["n"]].append(rec)
            verdict = "pass" if not rec["misses"] else "MISS: " + "; ".join(rec["misses"])
            print(f"run {run} case {case['n']:2d} ({rec['outcome']}, {rec['action']}, "
                  f"{took:.1f} s): {verdict}", flush=True)
        if status:
            break
    report = [summary(c, by_case[c["n"]]) for c in data["cases"] if by_case[c["n"]]]
    total = sum(s["runs"] for s in report)
    passed = sum(s["passed"] for s in report)
    reliable = sum(s["reliable"] for s in report)
    consistent = sum(s["consistent"] for s in report)
    answered = sum(1 for rs in by_case.values() for r in rs if not r["misses"])
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"model": data["model"], "prompt": "{}.v{}".format(*prompt),
                   "case_file": case_file, "actor": actor, "runs": runs,
                   "spent_usd": round(spent, 6),
                   "reliability": {"reliable": reliable, "cases": len(report), "runs": total},
                   "consistency": {"consistent": consistent, "cases": len(report)},
                   "usd_per_call": round(spent / total, 6) if total else None,
                   "usd_per_success": round(spent / answered, 6) if answered else None,
                   "report": report, "recordings": by_case}, fh, indent=2)
    lat = [r["latency_s"] for rs in by_case.values() for r in rs]
    print(f"{reliable} of {len(report)} cases reliable ({total} runs); {passed} of {total} runs "
          f"pass; {consistent} of {len(report)} consistent (reported, deciding nothing); "
          f"latency p50 {statistics.median(lat) if lat else 0:.1f} s; ${spent:.4f} spent"
          + (f", ${spent / answered:.6f} a successful answer" if answered else "")
          + f"; written {out}")
    return status


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    ap.add_argument("--checkout", default="")
    ap.add_argument("--list", default="")
    ap.add_argument("--actor", default="")
    ap.add_argument("--out", default="")
    ap.add_argument("--cases", default=CASES)
    ap.add_argument("--runs", type=int, default=1)
    ap.add_argument("--model", default="",
                    help="ask on this model in place of the task's pin, in this process alone "
                         "(a comparison: Sonnet as the ceiling)")
    ap.add_argument("--check", action="store_true",
                    help="only check the expectations against each case's evidence; no call")
    ap.add_argument("--prompt", type=int, default=0,
                    help="ask with this version of the classifier's prompt in place of the "
                         "adopted one (a comparison before adoption, C1988)")
    args = ap.parse_args(argv)
    checkout = os.path.abspath(os.path.expanduser(args.checkout)) if args.checkout else ROOT
    sys.path.insert(0, checkout)
    os.chdir(checkout)
    if args.check:
        problems = check(checkout, args.cases)
        for p in problems:
            print(f"stale expectation: {p}")
        print(f"{len(problems)} stale expectation(s) in {args.cases}")
        return 5 if problems else 0
    if not args.out or not args.list:
        ap.error("a recording needs --list and --out (--actor defaults to evaluation:<run>)")
    # The network through the one resolver (C1903): either spelling, the case file's own
    # network (its canonical id) the same one, else refused before anything is asked.
    from modules.ai import cases
    declared = cases.load(os.path.join(checkout, args.cases)).get("network") or ""
    args.list, refusal = cases.run_network(args.list, declared)
    if refusal:
        print(f"nmas-sdn-cases: {refusal}", file=sys.stderr)
        return 2
    from modules.sdn import closed_loop
    prompt = (closed_loop.CLASSIFY_PROMPT[0], args.prompt) if args.prompt else None
    return record(checkout, args.list, args.actor, args.out, args.cases, args.runs, args.model,
                  prompt)


if __name__ == "__main__":
    sys.exit(main())
