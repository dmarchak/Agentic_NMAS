#!/usr/bin/env python3
"""Refuse a staged set that would publish a secret or a stray (2026-09-29).

    git add -A && scripts/nmas-stage-guard [--allow PATH ...] && <suite> && git commit

The repository is PUBLIC, and the commit gate stages with `git add -A`: every
untracked file that is not ignored goes in. That is the unscoped add that once
committed clab-r6's CA private key into r6's lab repository, fixed there by an
allowlist. Printing the status protects nothing unless something reads it and
can refuse, so this reads the INDEX and refuses:

- a NEW file whose name has a secret's shape: a private key or certificate
  store (*.key, *.pem, *.p12, *.pfx, *.jks, id_rsa and its kin), an env file
  (.env, .env.*), a break-glass record (*.bg), an encrypted backup (*.gpg),
  a password vault (*.kdbx), anything under data/, or a credential store by
  name (key.key, credential_profiles.json, devices.csv, user_settings.json);
- a NEW or MODIFIED file whose staged content holds a private-key block
  (BEGIN ... PRIVATE KEY) or a GitHub token (ghp_ and kin, github_pat_): a
  key pasted into an existing file is the same leak; and a NEW *.token file;
- a NEW file outside the top-level entries HEAD already has, unless it is named
  with --allow (or NMAS_STAGE_ALLOW, space-separated): a stray is refused
  until someone says it belongs.

It prints every NEW file, refused or not, so an unexpected addition is seen.
The publication check (tests/test_nothing_personal_is_published.py) catches
personal details; this catches secrets and strays, the worse things to publish.
Exit 0 passes; 1 refuses, naming each file and why; 2 means it could not read
the index, which is never a pass.
"""

import argparse
import fnmatch
import os
import re
import subprocess
import sys

SECRET_NAMES = ("*.key", "*.pem", "*.p12", "*.pfx", "*.jks", "*.kdbx", "*.bg", "*.gpg",
                "id_rsa", "id_rsa.*", "id_dsa", "id_dsa.*", "id_ecdsa", "id_ecdsa.*",
                "id_ed25519", "id_ed25519.*", ".env", ".env.*",
                "key.key", "credential_profiles.json", "devices.csv", "user_settings.json",
                "*.token")
SECRET_DIRS = ("data/",)
PRIVATE_KEY = re.compile(r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----")
#: A GitHub token, by GitHub's published prefixes: a classic or app token
#: (ghp_, gho_, ghu_, ghs_, ghr_, 36 characters after) and a fine-grained one
#: (github_pat_). Added before the operator's Actions-read token existed (the
#: operator, 2026-10-01: "confirm the guards would refuse it"; they did not).
GITHUB_TOKEN = re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})\b")
EXIT_REFUSED, EXIT_UNREADABLE = 1, 2


def _git(repo, *args, binary=False):
    proc = subprocess.run(["git", "-C", repo, *args], capture_output=True, timeout=60)
    if proc.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {proc.stderr.decode(errors='replace')[:300]}")
    return proc.stdout if binary else proc.stdout.decode("utf-8", "replace")


def staged(repo: str) -> dict:
    """{path: status} for staged additions, copies, renames and modifications."""
    out = {}
    parts = _git(repo, "diff", "--cached", "--name-status", "-z",
                 "--diff-filter=ACMR").split("\0")
    i = 0
    while i < len(parts) and parts[i]:
        status = parts[i]
        if status[0] in "RC":                # old path, then new path
            out[parts[i + 2]] = "A"
            i += 3
        else:
            out[parts[i + 1]] = "A" if status[0] == "A" else "M"
            i += 2
    return out


def known_tops(repo: str) -> set:
    try:
        return set(_git(repo, "ls-tree", "--name-only", "HEAD").split())
    except RuntimeError:
        return set()                          # no commit yet: nothing is a stray


def secret_name(path: str) -> str:
    base = os.path.basename(path)
    for d in SECRET_DIRS:
        if path.startswith(d):
            return f"it is under {d}, the live store"
    for pat in SECRET_NAMES:
        if fnmatch.fnmatch(base, pat):
            return f"its name has a secret's shape ({pat})"
    return ""


def judge(repo: str, allow=()) -> dict:
    files = staged(repo)
    tops = known_tops(repo)
    new = sorted(p for p, s in files.items() if s == "A")
    refused = []
    for path in sorted(files):
        if files[path] == "A":
            why = secret_name(path)
            if why:
                refused.append((path, why))
                continue
            top = path.split("/", 1)[0]
            if tops and top not in tops and path not in allow:
                refused.append((path, f"it is outside the repository's known top-level entries "
                                      f"('{top}' is new); name it with --allow if it belongs"))
                continue
        blob = _git(repo, "show", f":{path}", binary=True)
        text = blob.decode("latin-1")
        if PRIVATE_KEY.search(text):
            refused.append((path, "its staged content holds a private-key block"))
        if GITHUB_TOKEN.search(text):
            refused.append((path, "its staged content holds a GitHub token"))
    return {"new": new, "refused": refused, "staged": len(files)}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="nmas-stage-guard", description=__doc__.split("\n")[0])
    ap.add_argument("--repo", default=os.getcwd())
    ap.add_argument("--allow", action="append", default=[],
                    help="a NEW path outside the known top-level entries that belongs")
    args = ap.parse_args(argv)
    allow = set(args.allow) | set((os.environ.get("NMAS_STAGE_ALLOW") or "").split())
    try:
        out = judge(args.repo, allow)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
        print(f"nmas-stage-guard: could not read the index ({exc}); nothing is passed",
              file=sys.stderr)
        return EXIT_UNREADABLE
    print(f"nmas-stage-guard: {out['staged']} staged file(s), {len(out['new'])} new:")
    for path in out["new"]:
        print(f"  new  {path}")
    if out["refused"]:
        print("REFUSED - this staged set would publish something it must not:", file=sys.stderr)
        for path, why in out["refused"]:
            print(f"  {path}: {why}", file=sys.stderr)
        print("Unstage it (git restore --staged <path>) or gitignore it; nothing was committed.",
              file=sys.stderr)
        return EXIT_REFUSED
    return 0


if __name__ == "__main__":
    sys.exit(main())
