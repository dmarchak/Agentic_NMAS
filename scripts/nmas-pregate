#: The trace marker: every line `sh -x` prints for the hook starts with it.
PS4 = "+nmas-pregate-trace+ "

TEMPLATE_REF = re.compile(r"""\{%-?\s*(?:include|extends|import|from)\s+["']([^"']+)["']""")
URL_ATTR = re.compile(r"""\b(?:hx-get|hx-post|hx-put|hx-delete|hx-patch|src|href|action)\s*=\s*"""
                      r"""["'](/[^"'{}\s]*)""")
ROUTE_METHODS = {"route", "get", "post", "put", "delete", "patch"}
#: The str methods whose argument is a text searched for, never a request.
TEXT_PROBES = {"startswith", "endswith", "find", "rfind", "index", "rindex", "count", "split",
               "rsplit", "partition", "rpartition", "replace", "removeprefix", "removesuffix"}
HOLE = "\x00"


def _load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


# --- the change -------------------------------------------------------------------------------

class Change:
    """What a change touches: its paths, each side's changed line spans, and each side's text."""

    def __init__(self, repo, files, new_spans, old_spans, new_rev, old_rev):
        self.repo, self.files = repo, files
        self.new_spans, self.old_spans = new_spans, old_spans
        self._revs = {"new": new_rev, "old": old_rev}

    def text(self, path, side="new"):
        r = git(self.repo, "show", f"{self._revs[side]}:{path}")
        return r.stdout if r.returncode == 0 else None


def change(repo, rng=None):
    """The Change of the index against HEAD, or of the range ``A..B``; None when git cannot
    say."""
    if rng:
        if ".." not in rng:
            return None
        a, b = rng.split("..", 1)
        base = ["diff", "--no-renames", a, b or "HEAD"]
        new_rev, old_rev = b or "HEAD", a
    else:
        base = ["diff", "--cached", "--no-renames"]
        new_rev, old_rev = "", "HEAD"           # ":<path>" is the index's copy
    names = git(repo, *base, "--name-only", "-z")
    patch = git(repo, *base, "-U0")
    if names.returncode or patch.returncode:
        return None
    files = sorted(p for p in names.stdout.split("\0") if p)
    new, old, cur_new, cur_old = {}, {}, None, None
    for line in patch.stdout.splitlines():
        if line.startswith("--- "):
            cur_old = line[6:] if line.startswith("--- a/") else None
        elif line.startswith("+++ "):
            cur_new = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", line)
            if not m:
                continue
            a0, an, b0, bn = (int(m.group(1)), int(m.group(2) or 1), int(m.group(3)),
                              int(m.group(4) or 1))
            if cur_new:
                new.setdefault(cur_new, []).append((b0, b0 + max(bn, 1) - 1))
            if cur_old and an:
                old.setdefault(cur_old, []).append((a0, a0 + an - 1))
    return Change(repo, files, new, old, new_rev, old_rev)


def _top_level(tree):
    """``[(first, last, names or None, refs)]`` for each top-level statement: a def, class or
    assignment names what it binds; any other statement (an import, an `if`) is None, the whole
    module; *refs* are the global names it reads."""
    out = []
    for i, n in enumerate(tree.body):
        first = min([n.lineno] + [d.lineno for d in getattr(n, "decorator_list", [])])
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            names = {n.name}
        elif isinstance(n, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
            targets = n.targets if isinstance(n, ast.Assign) else [n.target]
            names = {x.id for t in targets for x in ast.walk(t) if isinstance(x, ast.Name)}
        elif i == 0 and isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant) \
                and isinstance(n.value.value, str):
            names = set()                       # the module's docstring changes nothing run
        else:
            names = None
        refs = {x.id for x in ast.walk(n) if isinstance(x, ast.Name)}
        out.append((first, n.end_lineno, names, refs))
    return out


def touched_names(text, spans):
    """The top-level names a change to *text* at *spans* touches, or None when it touches a
    statement that binds no name (the whole module counts). Lines outside every statement
    (comments, blank lines) touch nothing."""
    if text is None:
        return set()
    try:
        tops = _top_level(ast.parse(text))
    except (SyntaxError, ValueError):
        return None
    out = set()
    for a, b in spans:
        for first, last, names, _r in tops:
            if a <= last and b >= first:
                if names is None:
                    return None
                out |= names
    return out


def affected_names(change_, path):
    """The names of *path*'s module a test may meet changed: those the change touches on either
    side, closed over the module's own references (a def reading an affected name is affected);
    None for the whole module."""
    new_text, old_text = change_.text(path, "new"), change_.text(path, "old")
    if path not in change_.new_spans and path not in change_.old_spans:
        return None
    a = touched_names(new_text, change_.new_spans.get(path, []))
    b = touched_names(old_text, change_.old_spans.get(path, []))
    if a is None or b is None:
        return None
    affected = a | b
    try:
        tops = _top_level(ast.parse(new_text)) if new_text is not None else []
    except (SyntaxError, ValueError):
        return None
    grew = True
    while grew:
        grew = False
        for _f, _l, names, refs in tops:
            if names and not names <= affected and refs & affected:
                affected |= names
                grew = True
    return affected


def unstaged(repo):
    """Tracked files whose working-tree text differs from the index."""
    r = git(repo, "diff", "--name-only", "-z")
    return sorted(p for p in r.stdout.split("\0") if p)


# --- reading the tests -----------------------------------------------------------------------

def module_of(path):
    """The dotted module a Python file is, or None (``modules/nsot/__init__.py`` -> modules.nsot)."""
    if not path.endswith(".py"):
        return None
    parts = path[:-3].split("/")
    if parts[-1] == "__init__":
        parts = parts[:-1]
    if not parts or not all(p.isidentifier() for p in parts):
        return None
    return ".".join(parts)


def _pattern(node):
    """A string expression's text, each interpolated piece a HOLE: a constant, an f-string, or
    a `+` of them; None for anything else."""
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.JoinedStr):
        return "".join(v.value if isinstance(v, ast.Constant) else HOLE for v in node.values)
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        left, right = _pattern(node.left), _pattern(node.right)
        if left is None and right is None:
            return None
        return (left if left is not None else HOLE) + (right if right is not None else HOLE)
    return None


def _dotted(node):
    """``a.b.c`` for a chain of names, else ""."""
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        base = _dotted(node.value)
        return f"{base}.{node.attr}" if base else ""
    return ""


class TestFile:
    """One test file, parsed: what it imports, its string literals, whether it drives a browser."""

    def __init__(self, path, text):
        self.path = path
        self.imports = set()
        self.strings = set()
        self.browser = False
        self.parsed = True
        #: ``{module: {name}}`` of `from module import name`; ``{bound name: module}`` of each
        #: import binding a module (a `from P import X` binds P.X when that is a module).
        self.from_names, self.aliases = {}, {}
        #: ``{(dotted base, attribute)}`` read, and the names read bare (not as an attribute's
        #: base).
        self.attrs, self.bare = set(), set()
        #: The literals that may name a request: every string literal but those a text is
        #: searched for.
        self.requests = set()
        try:
            tree = ast.parse(text)
        except (SyntaxError, ValueError):
            self.parsed = False
            return
        browser_module_names = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                for a in node.names:
                    self.imports.add(a.name)
                    self.aliases[a.asname or a.name] = a.name
                    if a.name == "tests.browser":
                        browser_module_names.add(a.asname or "tests.browser")
            elif isinstance(node, ast.ImportFrom) and node.module and not node.level:
                self.imports.add(node.module)
                for a in node.names:
                    self.imports.add(f"{node.module}.{a.name}")
                    self.from_names.setdefault(node.module, set()).add(a.name)
                    self.aliases[a.asname or a.name] = f"{node.module}.{a.name}"
                    if node.module == "tests.browser" and a.name == "Browser":
                        self.browser = True
                    if node.module == "tests" and a.name == "browser":
                        browser_module_names.add(a.asname or "browser")
            elif isinstance(node, ast.Attribute):
                base = _dotted(node.value)
                if base:
                    self.attrs.add((base, node.attr))
                for child in ast.iter_child_nodes(node):
                    child._pregate_base = True
            elif isinstance(node, ast.Name) and not getattr(node, "_pregate_base", False):
                self.bare.add(node.id)
            if isinstance(node, ast.Call) and node.args and isinstance(node.args[0], ast.Name) \
                    and (getattr(node.func, "attr", None) or getattr(node.func, "id", None)) \
                    in ("setattr", "delattr"):
                # monkeypatch.setattr(module, "name", ...) reads only the name it names.
                node.args[0]._pregate_base = True
            # A literal a text is searched for (`"/v2/" in html`, `href.startswith("/v2/")`)
            # names no request: it counts for a file's name, never for a route.
            if isinstance(node, ast.Compare) and any(isinstance(o, (ast.In, ast.NotIn))
                                                     for o in node.ops):
                node.left._pregate_probe = True
            if isinstance(node, ast.Call) and getattr(node.func, "attr", None) in TEXT_PROBES:
                for arg in node.args:
                    arg._pregate_probe = True
            if isinstance(node, (ast.Tuple, ast.List)) and getattr(node, "_pregate_probe", False):
                for e in node.elts:
                    e._pregate_probe = True
            p = _pattern(node) if isinstance(node, (ast.Constant, ast.JoinedStr, ast.BinOp)) else None
            if p:
                self.strings.add(p)
                if not getattr(node, "_pregate_probe", False):
                    self.requests.add(p)
        for node in ast.walk(tree):
            if isinstance(node, ast.Attribute) and node.attr == "Browser":
                base = node.value
                dotted = (base.id if isinstance(base, ast.Name) else
                          f"{base.value.id}.{base.attr}" if isinstance(base, ast.Attribute)
                          and isinstance(base.value, ast.Name) else "")
                if dotted in browser_module_names:
                    self.browser = True

    def imports_module(self, mod):
        return any(i == mod or i.startswith(mod + ".") for i in self.imports)

    def meets(self, mod, affected):
        """Why this file meets *mod*'s *affected* names, or None. With *affected* None (the
        whole module), importing it is enough. Otherwise: a `from mod import` of an affected
        name (or `*`); an attribute read of one on a name bound to the module; an affected name
        as a whole literal beside such an import (`monkeypatch.setattr(m, "name", ...)`); and,
        erring toward running, a submodule imported, or the bound name used bare (passed on,
        so any attribute may be read)."""
        if not self.imports_module(mod):
            return None
        if affected is None:
            return f"imports {mod}"
        if any(i.startswith(mod + ".") and i not in {f"{mod}.{n}" for n in
                                                       self.from_names.get(mod, ())}
               for i in self.imports):
            return f"imports a submodule of {mod}"
        names = self.from_names.get(mod, set())
        hit = sorted(names & affected)
        if hit or "*" in names:
            return f"imports {', '.join(hit) or '*'} from {mod}, changed"
        bound = [b for b, m in self.aliases.items() if m == mod]
        for b in bound:
            used = {attr for base, attr in self.attrs if base == b}
            hit = sorted(used & affected)
            if hit:
                return f"reads {b}.{hit[0]} of {mod}, changed"
            named = sorted(self.strings & affected)
            if named:
                return f"names {named[0]!r} beside its import of {mod}, changed"
            if "." not in b and b in self.bare:
                return f"uses {b} ({mod}) other than by attribute, so any of it"
            if "." in b and not used:
                return f"imports {mod} and reads none of it by attribute, so any of it"
        return None

    def names_file(self, path):
        """The literal naming *path*, or None."""
        keys = {path}
        if path.startswith("templates/"):
            keys.add(path[len("templates/"):])
        base = os.path.basename(path)
        by_name = path.startswith(("templates/", "scripts/", "static/"))
        mod = module_of(path)
        tails = tuple("/" + k for k in keys)
        for s in self.strings:
            if HOLE in s:
                continue
            if s in keys or s.endswith(tails) or (by_name and s == base):
                return s
            if mod and s == mod:
                return s
        return None

    def names_route(self, route):
        """The literal anchored to the whole of *route* (a Route), or None."""
        for s in sorted(self.requests):
            if route.matches(s):
                return s.replace(HOLE, "{}")
        return None


def data_folders(repo):
    """tests/data_folders.py's DATA_FOLDERS, parsed (scripts/nmas-fast-checks reads it so)."""
    try:
        with open(os.path.join(repo, "tests", "data_folders.py"), encoding="utf-8") as fh:
            tree = ast.parse(fh.read())
    except (OSError, SyntaxError, ValueError):
        return ()
    for n in tree.body:
        if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "DATA_FOLDERS"
                                             for t in n.targets) \
                and isinstance(n.value, (ast.Tuple, ast.List)):
            return tuple(e.value for e in n.value.elts if isinstance(e, ast.Constant)
                         and isinstance(e.value, str) and e.value.startswith("tests/fixtures/"))
    return ()


def test_files(repo):
    """Every tests/**/test_*.py on disk outside the data folders, parsed, each one's `browser`
    set by `browser_modules` (a real browser started by any path the suite uses)."""
    out, skip = {}, data_folders(repo)
    for root, dirs, files in os.walk(os.path.join(repo, "tests")):
        dirs[:] = sorted(d for d in dirs if d != "__pycache__")
        for f in sorted(files):
            if f.startswith("test_") and f.endswith(".py"):
                rel = os.path.relpath(os.path.join(root, f), repo).replace(os.sep, "/")
                if rel.startswith(skip):
                    continue
                with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                    out[rel] = TestFile(rel, fh.read())
    starting = browser_modules(repo)
    for rel, tf in out.items():
        tf.browser = tf.browser or rel in starting
    return out


#: The names of tests/browser.py that start a real browser: `Browser`, and `available`, whose
#: call is CI's own marker of a file that starts one (`= browser.available()`,
#: scripts/nmas-shards' `uses_a_browser`).
BROWSER_MODULE = "tests.browser"
BROWSER_ROOTS = frozenset({"Browser", "available"})


def _bindings(tree, known):
    """``(names, modules)`` of a module's imports: ``{bound: (module, attr)}`` for each
    `from M import attr` of a name, ``{bound: module}`` for each import binding a module of
    *known* (`import tests.x as y`, `from tests import x`)."""
    names, modules = {}, {}
    for n in ast.walk(tree):
        if isinstance(n, ast.Import):
            for a in n.names:
                if a.asname:
                    modules[a.asname] = a.name
                else:
                    modules[a.name.split(".")[0]] = a.name.split(".")[0]
                    modules[a.name] = a.name
        elif isinstance(n, ast.ImportFrom) and n.module and not n.level:
            for a in n.names:
                if f"{n.module}.{a.name}" in known:
                    modules[a.asname or a.name] = f"{n.module}.{a.name}"
                else:
                    names[a.asname or a.name] = (n.module, a.name)
    return names, modules


def browser_modules(repo):
    """The test files (paths) that start a real browser by any path the suite uses (C3421: the
    coordinator, 2026-11-13: tests/test_v2_links_stay_on_v2.py starts one through the `served`
    fixture it imports from another test module, and ran confined, where Firefox cannot start).

    One rule, closed over every module under tests/: a top-level def or class of a module
    STARTS one when its body reads, as a name, an attribute of a bound module, or an
    argument (a fixture asked for by name), a name that starts one: tests/browser.py's
    BROWSER_ROOTS, or such a def of its own module or of the module it imports it from. A file
    starts one when anything in it does, an import of such a name by name included (a fixture
    is used as an argument). `from tests.browser import free_port` starts none."""
    paths, skip = {}, data_folders(repo)
    for root, dirs, files in os.walk(os.path.join(repo, "tests")):
        dirs[:] = sorted(d for d in dirs if d != "__pycache__")
        for f in sorted(files):
            rel = os.path.relpath(os.path.join(root, f), repo).replace(os.sep, "/")
            mod = module_of(rel)
            if mod and not rel.startswith(skip):
                paths[mod] = rel
    trees = {}
    for mod, rel in paths.items():
        try:
            with open(os.path.join(repo, rel), encoding="utf-8", errors="replace") as fh:
                trees[mod] = ast.parse(fh.read())
        except (OSError, SyntaxError, ValueError):
            continue
    known = set(trees) | {BROWSER_MODULE}
    binds = {m: _bindings(t, known) for m, t in trees.items()}
    starts = {m: set() for m in trees}
    starts[BROWSER_MODULE] = set(BROWSER_ROOTS)

    def reads(node):
        """``(names, attrs, imported)`` *node* reads: names and arguments, ``(base, attr)``
        pairs, and ``(module, name)`` imported by name."""
        names, attrs, imported = set(), set(), set()
        for x in ast.walk(node):
            if isinstance(x, ast.Name):
                names.add(x.id)
            elif isinstance(x, ast.arg):
                names.add(x.arg)
            elif isinstance(x, ast.Attribute):
                base = _dotted(x.value)
                if base:
                    attrs.add((base, x.attr))
            elif isinstance(x, ast.ImportFrom) and x.module and not x.level:
                imported |= {(x.module, a.name) for a in x.names}
        return names, attrs, imported

    def starter(mod, read):
        names, attrs, imported = read
        bound, modules = binds[mod]
        if names & starts[mod]:
            return True
        for n in names:
            src = bound.get(n)
            if src and src[1] in starts.get(src[0], ()):
                return True
        if any(a in starts.get(modules.get(b, ""), ()) for b, a in attrs):
            return True
        return any(a in starts.get(m, ()) for m, a in imported)

    tops, whole = {}, {}
    for m, t in trees.items():
        if m == BROWSER_MODULE:
            continue
        tops[m], names, attrs, imported = [], set(), set(), set()
        for top in t.body:
            read = reads(top)
            if isinstance(top, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                tops[m].append((top.name, read))
            names |= read[0]
            attrs |= read[1]
            imported |= read[2]
        whole[m] = (names, attrs, imported)
    grew = True
    while grew:
        grew = False
        for mod, defs in tops.items():
            for name, read in defs:
                if name not in starts[mod] and starter(mod, read):
                    starts[mod].add(name)
                    grew = True
    return {paths[m] for m, tree in trees.items() if m != BROWSER_MODULE
            and os.path.basename(paths[m]).startswith("test_")
            and starter(m, whole[m])}


# --- routes and templates --------------------------------------------------------------------

class Route:
    """A route's rule and the templates its function renders."""

    def __init__(self, rule, module, first, last, templates):
        self.rule, self.module, self.first, self.last = rule, module, first, last
        self.templates = set(templates)
        parts = re.split(r"(<[^>]+>)", rule)
        rx = []
        for p in parts:
            if p.startswith("<") and p.endswith(">"):
                rx.append(f"(?:[^/{HOLE}]+|{HOLE})" if not p.startswith("<path:")
                          else f"(?:.+|{HOLE})")
            else:
                rx.append(re.escape(p))
        self.regex = re.compile("".join(rx) + rf"/?(?:[?#].*|{HOLE}.*)?", re.S)

    def matches(self, s):
        # "/" and the bare prefix of a parameterised rule name everything: never matched alone.
        if not s.startswith("/") or len(self.rule.strip("/")) == 0:
            return False
        return bool(self.regex.fullmatch(s))


def _templates_in(node):
    return {n.value for n in ast.walk(node)
            if isinstance(n, ast.Constant) and isinstance(n.value, str)
            and n.value.endswith(".html") and "/" in n.value}


def routes_of(path, text):
    """[Route] declared in a routes module: its blueprints' url_prefix parsed with each
    decorated function's rule, line span and templates (its own, and those of the module's
    functions it calls by name)."""
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return []
    prefixes, funcs = {}, {}
    for n in tree.body:
        if isinstance(n, ast.Assign) and isinstance(n.value, ast.Call) \
                and getattr(n.value.func, "id", getattr(n.value.func, "attr", "")) == "Blueprint":
            pre = next((k.value.value for k in n.value.keywords if k.arg == "url_prefix"
                        and isinstance(k.value, ast.Constant)), "")
            for t in n.targets:
                if isinstance(t, ast.Name):
                    prefixes[t.id] = (pre, n.lineno)
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            funcs[n.name] = n
    out = []
    for name, fn in funcs.items():
        for d in fn.decorator_list:
            if not (isinstance(d, ast.Call) and isinstance(d.func, ast.Attribute)
                    and d.func.attr in ROUTE_METHODS and isinstance(d.func.value, ast.Name)
                    and d.func.value.id in prefixes and d.args
                    and isinstance(d.args[0], ast.Constant) and isinstance(d.args[0].value, str)):
                continue
            pre = prefixes[d.func.value.id][0].rstrip("/")
            rule = pre + d.args[0].value if d.args[0].value != "/" or not pre else pre
            temps = _templates_in(fn)
            for c in ast.walk(fn):
                if isinstance(c, ast.Call) and isinstance(c.func, ast.Name) and c.func.id in funcs:
                    temps |= _templates_in(funcs[c.func.id])
            first = min([fn.lineno] + [x.lineno for x in fn.decorator_list])
            out.append(Route(rule or "/", path, first, fn.end_lineno, temps))
    return out


def blueprint_lines(text):
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return set()
    return {n.lineno for n in tree.body if isinstance(n, ast.Assign) and isinstance(n.value, ast.Call)
            and getattr(n.value.func, "id", getattr(n.value.func, "attr", "")) == "Blueprint"}


def all_routes(repo):
    out = []
    folder = os.path.join(repo, "routes")
    for f in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
        if f.endswith(".py"):
            with open(os.path.join(folder, f), encoding="utf-8", errors="replace") as fh:
                out += routes_of(f"routes/{f}", fh.read())
    return out


def template_graph(repo):
    """``(refs, urls)``: each template's name under templates/ to the templates it includes,
    extends or imports, and to the URL paths its attributes load."""
    refs, urls = {}, {}
    top = os.path.join(repo, "templates")
    for root, _d, files in os.walk(top):
        for f in files:
            if f.endswith(".html"):
                rel = os.path.relpath(os.path.join(root, f), top).replace(os.sep, "/")
                with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                    text = fh.read()
                refs[rel] = set(TEMPLATE_REF.findall(text))
                urls[rel] = set(URL_ATTR.findall(text))
    return refs, urls


def users_of(name, refs, parents=None):
    """*name* and every template that includes, extends or imports it, transitively.
    *parents* (``{template: {its users}}``, the reverse of *refs*) saves building it again."""
    if parents is None:
        parents = {}
        for parent, children in refs.items():
            for c in children:
                parents.setdefault(c, set()).add(parent)
    seen, todo = {name}, [name]
    while todo:
        for parent in parents.get(todo.pop(), ()):
            if parent not in seen:
                seen.add(parent)
                todo.append(parent)
    return seen


# --- shared filters, globals and imports (C3421) ---------------------------------------------

#: A decorator registering the function under it with Jinja, and what it registers.
JINJA_DECORATORS = {"app_template_filter": "filter", "template_filter": "filter",
                    "app_template_global": "global", "template_global": "global",
                    "app_template_test": "test", "template_test": "test",
                    "app_context_processor": "context", "context_processor": "context"}
#: A call registering its first argument, and what it registers.
JINJA_CALLS = {"add_template_filter": "filter", "add_app_template_filter": "filter",
               "add_template_global": "global", "add_app_template_global": "global",
               "add_template_test": "test", "add_app_template_test": "test"}
#: `<env>.<table>[name] = value`: the Jinja environment's tables.
JINJA_TABLES = {"filters": "filter", "globals": "global", "tests": "test"}
#: A template's code: what its `{{ }}` and `{% %}` hold.
JINJA_CODE = re.compile(r"\{\{(.*?)\}\}|\{%(.*?)%\}", re.S)
#: The lock's test, chosen when an import outside the product changes.
LOCK_TEST = "tests/test_requirements_lock.py"


def _spans_meet(spans, first, last):
    return any(a <= last and b >= first for a, b in spans)


def _context_keys(fn):
    """The names a context processor returns: each returned dict literal's constant keys and
    each `dict(name=...)`'s; None when a return is anything else (its names cannot be read)."""
    keys = set()
    for n in ast.walk(fn):
        if not isinstance(n, ast.Return) or n.value is None:
            continue
        v = n.value
        if isinstance(v, ast.Dict) and all(isinstance(k, ast.Constant) and isinstance(k.value, str)
                                           for k in v.keys):
            keys |= {k.value for k in v.keys}
        elif isinstance(v, ast.Call) and getattr(v.func, "id", "") == "dict" and not v.args \
                and all(k.arg for k in v.keywords):
            keys |= {k.arg for k in v.keywords}
        else:
            return None
    return keys


def jinja_registrations(text):
    """``[{kind, names, func, target, span}]``: each Jinja registration in a module's *text*.
    *names* is the set registered (None: a context processor whose names cannot be read);
    *func* the registered function's name in this module, *target* ``(dotted base,
    attribute)`` when it is an attribute of another (`preview_confirm.control_gate`), *span*
    the registering statement's lines (a decorated def's whole span)."""
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return []
    out = []
    for n in ast.walk(tree):
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            first = min([n.lineno] + [d.lineno for d in n.decorator_list])
            for d in n.decorator_list:
                f = d.func if isinstance(d, ast.Call) else d
                kind = JINJA_DECORATORS.get(getattr(f, "attr", getattr(f, "id", "")))
                if not kind:
                    continue
                if kind == "context":
                    names = _context_keys(n)
                else:
                    arg = d.args[0] if isinstance(d, ast.Call) and d.args else next(
                        (k.value for k in getattr(d, "keywords", []) if k.arg == "name"), None)
                    names = {arg.value if isinstance(arg, ast.Constant)
                             and isinstance(arg.value, str) else n.name}
                out.append({"kind": kind, "names": names, "func": n.name, "target": None,
                            "span": (first, n.end_lineno)})
        elif isinstance(n, ast.Call) and getattr(n.func, "attr", "") in JINJA_CALLS and n.args:
            kind, v = JINJA_CALLS[n.func.attr], n.args[0]
            name = n.args[1] if len(n.args) > 1 else next(
                (k.value for k in n.keywords if k.arg == "name"), None)
            fname = v.id if isinstance(v, ast.Name) else getattr(v, "attr", "")
            names = {name.value if isinstance(name, ast.Constant) else fname}
            out.append({"kind": kind, "names": names,
                        "func": v.id if isinstance(v, ast.Name) else None,
                        "target": (_dotted(v.value), v.attr) if isinstance(v, ast.Attribute)
                        else None, "span": (n.lineno, n.end_lineno)})
        elif isinstance(n, ast.Assign):
            for t in n.targets:
                if isinstance(t, ast.Subscript) and isinstance(t.value, ast.Attribute) \
                        and t.value.attr in JINJA_TABLES and isinstance(t.slice, ast.Constant) \
                        and isinstance(t.slice.value, str):
                    v = n.value
                    out.append({"kind": JINJA_TABLES[t.value.attr], "names": {t.slice.value},
                                "func": v.id if isinstance(v, ast.Name) else None,
                                "target": (_dotted(v.value), v.attr)
                                if isinstance(v, ast.Attribute) else None,
                                "span": (n.lineno, n.end_lineno)})
    return out


def _def_spans(text):
    """``{name: [(first, last)]}`` of every def at any depth (a nested one registered by
    name)."""
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return {}
    out = {}
    for n in ast.walk(tree):
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            first = min([n.lineno] + [d.lineno for d in n.decorator_list])
            out.setdefault(n.name, []).append((first, n.end_lineno))
    return out


def changed_jinja(repo, change_, affected):
    """``[(kind, names, why)]``: the Jinja registrations the change touches, on either side:
    the registering statement, the registered function (its top-level name among the module's
    *affected* names, or a nested def's lines), or the attribute of a changed module it
    registers. *affected* is ``{path: affected names or None}`` of the changed Python files.
    Scanned: routes/*.py, app.py and every changed Python file."""
    paths = {f for f in change_.files if f.endswith(".py")}
    folder = os.path.join(repo, "routes")
    paths |= {f"routes/{f}" for f in (os.listdir(folder) if os.path.isdir(folder) else ())
              if f.endswith(".py")}
    paths.add("app.py")
    by_module = {module_of(f): f for f in change_.files if module_of(f)}
    out = []
    for path in sorted(paths):
        sides = [("new", change_.new_spans.get(path, []))]
        if path in change_.files:
            sides.append(("old", change_.old_spans.get(path, [])))
        for side, spans in sides:
            text = change_.text(path, side)
            if text is None and side == "new" and path not in change_.files:
                try:
                    with open(os.path.join(repo, path), encoding="utf-8") as fh:
                        text = fh.read()
                except OSError:
                    text = None
            if not text:
                continue
            defs = None
            for reg in jinja_registrations(text):
                why = None
                if _spans_meet(spans, *reg["span"]):
                    why = f"its registration in {path} changed"
                elif reg["func"] and path in affected and (
                        affected[path] is None or reg["func"] in affected[path]):
                    why = f"{reg['func']} in {path} changed"
                elif reg["func"] and spans:
                    defs = _def_spans(text) if defs is None else defs
                    if any(_spans_meet(spans, a, b) for a, b in defs.get(reg["func"], ())):
                        why = f"{reg['func']} in {path} changed"
                if why is None and reg["target"]:
                    base, attr = reg["target"]
                    names, modules = _bindings(ast.parse(text), set(by_module))
                    mod = modules.get(base) or (names.get(base) and ".".join(names[base]))
                    f = by_module.get(mod)
                    if f and (affected.get(f) is None or attr in affected[f]):
                        why = f"{mod}.{attr} ({f}) changed"
                if why:
                    out.append((reg["kind"], reg["names"], why))
    return out


def template_code(repo):
    """``{template name: (filters, names, tests)}`` read from each template's Jinja code: the
    filters it applies (`| name`, `{% filter name %}`), every identifier it reads, and the
    tests it asks (`is name`)."""
    out = {}
    top = os.path.join(repo, "templates")
    for root, _d, files in os.walk(top):
        for f in files:
            if f.endswith(".html"):
                rel = os.path.relpath(os.path.join(root, f), top).replace(os.sep, "/")
                with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                    text = fh.read()
                parts = [m.group(1) if m.group(1) is not None else m.group(2)
                         for m in JINJA_CODE.finditer(text)]
                code = "\n".join(parts)
                filters = set(re.findall(r"\|\s*([A-Za-z_]\w*)", code))
                filters |= {m.group(1) for p in parts
                            for m in [re.match(r"-?\s*filter\s+([A-Za-z_]\w*)", p)] if m}
                names = set(re.findall(r"(?<![\w.])([A-Za-z_]\w*)", code))
                tests = set(re.findall(r"\bis\s+(?:not\s+)?([A-Za-z_]\w*)", code))
                out[rel] = (filters, names, tests)
    return out


def templates_using(registrations, code):
    """``{template name: why}``: each template using a changed registration."""
    out = {}
    for kind, names, why in registrations:
        for t, (filters, idents, tests) in sorted(code.items()):
            if names is None:
                hit = "a context processor whose names cannot be read"
            else:
                pool = {"filter": filters, "test": tests}.get(kind, idents)
                found = sorted(names & pool)
                hit = f"the {kind} {found[0]}" if found else None
            if hit:
                out.setdefault(t, f"{t}, which uses {hit} ({why})")
    return out


def _is_python(path):
    return path.endswith(".py") or (path.startswith("scripts/")
                                    and "." not in os.path.basename(path))


def outside_imports(text, local):
    """The top-level names *text* imports (anywhere in it) that are neither the standard
    library nor *local*; None when it is not Python."""
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return None
    found = set()
    for n in ast.walk(tree):
        if isinstance(n, ast.Import):
            found |= {a.name.split(".")[0] for a in n.names}
        elif isinstance(n, ast.ImportFrom) and n.module and not n.level:
            found.add(n.module.split(".")[0])
    return {n for n in found if n not in sys.stdlib_module_names and n not in local}


def local_names(repo, path):
    """The names an import of *path*'s may take from the tree: the tree's top-level folders
    and modules, and those beside *path* (a script's helper on its own folder's path)."""
    out = set()
    for folder in {repo, os.path.join(repo, os.path.dirname(path))}:
        try:
            entries = os.listdir(folder)
        except OSError:
            continue
        for e in entries:
            if os.path.isdir(os.path.join(folder, e)):
                out.add(e)
            elif e.endswith(".py"):
                out.add(e[:-3])
    return out


def import_changes(repo, change_):
    """``[(path, gained, lost)]``: each changed Python file whose imports outside the product
    gained or lost a name, either side read from git."""
    out = []
    for f in change_.files:
        if not _is_python(f):
            continue
        local = local_names(repo, f)
        new_t, old_t = change_.text(f, "new"), change_.text(f, "old")
        new = outside_imports(new_t, local) if new_t is not None else set()
        old = outside_imports(old_t, local) if old_t is not None else set()
        if new is None or old is None:
            continue
        if new != old:
            out.append((f, sorted(new - old), sorted(old - new)))
    return out


# --- the selection ---------------------------------------------------------------------------

def select(repo, change_, tests=None, routes=None, graph=None):
    """``{test path: [why, ...]}`` in a stable order: the change's own tests, the parsed
    reasons, then the fixed sets."""
    files, hunks, show = change_.files, change_.new_spans, change_.text
    tests = test_files(repo) if tests is None else tests
    chosen = {}

    def add(t, why):
        # A fixed set's file is chosen whether or not it exists: an absent one is said as not
        # run, never dropped without a word.
        chosen.setdefault(t, [])
        if why not in chosen[t]:
            chosen[t].append(why)

    skip = data_folders(repo)
    for f in files:
        if f in tests or (f.startswith("tests/") and os.path.basename(f).startswith("test_")
                          and f.endswith(".py") and not f.startswith(skip)
                          and os.path.exists(os.path.join(repo, f))):
            add(f, "a changed test file")
    affected_of = {}
    for f in files:
        mod = module_of(f)
        affected = affected_names(change_, f) if mod else None
        if mod:
            affected_of[f] = affected
        for t, tf in tests.items():
            if t == f:
                continue
            met = tf.meets(mod, affected) if mod else None
            if met:
                add(t, f"{met} ({f}" + (")" if affected is None else
                                        f": {len(affected)} name(s) affected)"))
                continue
            lit = tf.names_file(f)
            if lit:
                add(t, f"names {f} (the literal {lit!r})")
    # An import outside the product gained or lost: the lock's test (C3421).
    for f, gained, lost in import_changes(repo, change_):
        words = ", ".join([f"+{n}" for n in gained] + [f"-{n}" for n in lost])
        add(LOCK_TEST, f"{f} changes its imports outside the product ({words})")
    # Templates and routes. A template using a changed filter, global, test or context name
    # counts as changed (C3421).
    templates = [f[len("templates/"):] for f in files
                 if f.startswith("templates/") and f.endswith(".html")]
    route_files = [f for f in files if f.startswith("routes/") and f.endswith(".py")]
    uses = {name: name for name in templates}       # {template: how it counts as changed}
    jinja = changed_jinja(repo, change_, affected_of)
    if jinja:
        for t, how in templates_using(jinja, template_code(repo)).items():
            uses.setdefault(t, how)
    if uses or route_files:
        routes = all_routes(repo) if routes is None else routes
        refs, urls = template_graph(repo) if graph is None else graph
        hit = []                                    # [(Route, why)]
        parents = {}
        for parent, children in refs.items():
            for c in children:
                parents.setdefault(c, set()).add(parent)
        rendered = {}                               # {template: how}, the first reason kept
        for name, how0 in uses.items():
            used = users_of(name, refs, parents)
            for r in routes:
                via = sorted(r.templates & used)
                if via:
                    how = how0 if via == [name] else f"{via[0]}, which uses {how0}"
                    hit.append((r, f"renders {how}"))
            for user in sorted(used):
                if not (user == name and name in templates):    # a changed file: named above
                    rendered.setdefault(user, how0 if user == name
                                        else f"{user}, which uses {how0}")
        # A test naming a template that uses it renders it (a macro file's or a partial's
        # users, transitively, and every user of a changed filter). Each literal is indexed by
        # its last part: `names_file` matches a whole path, its tail, or a template's name.
        by_base = {}
        for t, tf in tests.items():
            for s in tf.strings:
                if HOLE not in s:
                    by_base.setdefault(os.path.basename(s), set()).add(t)
        for user, via in sorted(rendered.items()):
            for t in sorted(by_base.get(os.path.basename(user), ())):
                lit = tests[t].names_file(f"templates/{user}")
                if lit:
                    add(t, f"names a template that renders it: {via} (the literal {lit!r})")
        for f in route_files:
            text = show(f) or ""
            spans = hunks.get(f, [])
            bp = blueprint_lines(text)
            whole = any(a <= ln <= b for ln in bp for a, b in spans)
            for r in routes_of(f, text):
                if whole or any(a <= r.last and b >= r.first for a, b in spans):
                    hit.append((r, f"its function in {f} changed"))
        for r, why in hit:
            for t, tf in tests.items():
                lit = tf.names_route(r)
                if lit:
                    add(t, f"names the route {r.rule} ({why}; the literal {lit!r})")
        # One htmx hop, for the browser files: a page whose template loads a hit route.
        loaders = set()
        for tname, paths in urls.items():
            if any(r.matches(u) for r, _w in hit for u in paths):
                loaders |= users_of(tname, refs)
        if loaders:
            for r in routes:
                if r.templates & loaders:
                    for t, tf in tests.items():
                        if tf.browser:
                            lit = tf.names_route(r)
                            if lit:
                                add(t, f"a browser file naming {r.rule}, whose page loads a "
                                       f"changed route (the literal {lit!r})")
    for t in CONVENTIONS:
        add(t, "the convention set")
    if any(f.startswith("docs/manual/") for f in files) or templates:
        why = "docs/manual/ changed" if any(f.startswith("docs/manual/") for f in files) \
            else "a template changed"
        for t in MANUAL:
            add(t, f"the manual and fidelity tests ({why})")
    if route_files:
        for t in ROUTES:
            add(t, "the route tests (routes/ changed)")
    return chosen


# --- the gate ---------------------------------------------------------------------------------

def _workers():
    return _load("nmas_workers_for_pregate", os.path.join(REPO, "scripts", "nmas-workers"))


def gate_holder(lock):
    """``(pid, text)`` when the full-suite lock names a live process, else None: the build
    briefs' check (its first number, `kill -0`)."""
    try:
        with open(lock, encoding="utf-8", errors="replace") as fh:
            text = fh.read().strip()
    except OSError:
        return None
    m = re.search(r"\d+", text)
    if not m:
        return None
    pid = int(m.group())
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return None
    except PermissionError:
        pass
    except OverflowError:
        return None
    return pid, text.splitlines()[0] if text else ""


def wait_for_no_gate(lock, bound_s, every_s, no_wait, say, sleep=time.sleep):
    """None when no gate runs (now, or within *bound_s*), else why the runs did not start."""
    waited = 0
    while True:
        held = gate_holder(lock)
        if not held:
            return None
        pid, text = held
        if no_wait:
            return f"a gate is running: {lock} names live process {pid} ({text}); --no-wait"
        if waited >= bound_s:
            return (f"a gate still running after {waited} s (the bound, {bound_s} s): {lock} "
                    f"names live process {pid} ({text})")
        say(f"nmas-pregate: waits: {lock} names live process {pid} ({text}), a gate "
            f"running; the tests start only when none is (asking again in {every_s} s)")
        sleep(every_s)
        waited += every_s


# --- the runs ---------------------------------------------------------------------------------

def _bounded(cmd, cwd, env, bound_s):
    """``(rc, fired)``: *cmd* in its own session, ended by TERM then KILL past *bound_s*."""
    p = subprocess.Popen(cmd, cwd=cwd, env=env, start_new_session=True)
    try:
        return p.wait(timeout=bound_s), False
    except subprocess.TimeoutExpired:
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(p.pid, sig)
            except ProcessLookupError:
                break
            try:
                p.wait(timeout=15)
                break
            except subprocess.TimeoutExpired:
                continue
        return p.wait(), True


def _env(extra=None):
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", NMAS_REQUIRE_PG="1")
    # Whether a browser must start is this tool's to say, per run (the browser run sets it):
    # a caller's own (a gate's browser shard running this tool's tests) never leaks into a
    # confined run.
    env.pop("NMAS_REQUIRE_BROWSER", None)
    if os.path.isdir(PG_LIB):
        env["LD_LIBRARY_PATH"] = os.pathsep.join(
            p for p in (PG_LIB, os.environ.get("LD_LIBRARY_PATH", "")) if p)
    env.update(extra or {})
    return env


def run_confined(repo, files, scratch, bound_s, label="confined", deselect=()):
    """The confined run of *files* (paths or node ids) in *repo* (the snapshot, or the checkout
    for CHECKOUT_ONLY), each of *deselect* deselected."""
    junit = os.path.join(scratch, f"{label}.xml")
    cmd = [os.path.join(repo, "scripts", "nmas-test"), "-q", "-p", "no:cacheprovider", "-n", "2",
           "-rEfs", f"--junitxml={junit}", "--basetemp", os.path.join(scratch, f"{label}-t"),
           *[x for d in deselect for x in ("--deselect", d)], *files]
    rc, fired = _bounded(cmd, repo, _env({"NMAS_TEST_TIMEOUT": str(bound_s)}), bound_s + 30)
    return rc, fired, junit


def run_browser(repo, files, scratch, bound_s, python=None):
    python = python or CI_PYTHON
    junit = os.path.join(scratch, "browser.xml")
    if not os.access(python, os.X_OK):
        return None, False, junit, f"no interpreter at {python} (scripts/nmas-ci-env builds it)"
    path = os.pathsep.join([BROWSER_DIR, os.path.join(BROWSER_DIR, "firefox"),
                            os.environ.get("PATH", "")])
    cmd = [python, "-m", "pytest", "-q", "-p", "no:cacheprovider", "-rEfs",
           f"--junitxml={junit}", "--basetemp", os.path.join(scratch, "browser-t"), *files]
    rc, fired = _bounded(cmd, repo, _env({"PATH": path, "NMAS_REQUIRE_BROWSER": "1"}), bound_s)
    return rc, fired, junit, ""


def outcomes(junit, files):
    """``{file: {"passed": n, "failed": n, "skipped": n}}`` from a JUnit file (each case placed
    in the chosen file its dotted classname, or a collection error's name, begins with); None
    when the file is absent or unreadable."""
    try:
        tree = ET.parse(junit)
    except (OSError, ET.ParseError):
        return None
    dotted = sorted(((f[:-3].replace("/", "."), f) for f in files), key=lambda x: -len(x[0]))
    out = {f: {"passed": 0, "failed": 0, "skipped": 0} for f in files}
    for case in tree.iter("testcase"):
        where = case.get("classname") or case.get("name") or ""
        where = where.replace("/", ".")
        if where.endswith(".py"):
            where = where[:-3]
        f = next((f for d, f in dotted if where == d or where.startswith(d + ".")), None)
        if f is None:
            continue
        tags = {c.tag for c in case}
        if tags & {"failure", "error"}:
            out[f]["failed"] += 1
        elif "skipped" in tags:
            out[f]["skipped"] += 1
        else:
            out[f]["passed"] += 1
    return out


def skip_check(repo, junits):
    """``(rc, words)``: scripts/nmas-skip-check --where gate over the run's JUnit files."""
    check = os.path.join(repo, "scripts", "nmas-skip-check")
    if not os.path.exists(check):
        return 4, f"not run: no {check}"
    r = subprocess.run([sys.executable, check, "--where", "gate", *junits], cwd=repo,
                       capture_output=True, text=True, env=_env())
    return r.returncode, (r.stdout + r.stderr).strip()


def refused_skips(words, files):
    """The chosen files whose skips the skip check refused: each `REFUSED: <dotted test id>:`
    line, placed in the file its id begins with."""
    dotted = sorted(((f[:-3].replace("/", "."), f) for f in files), key=lambda x: -len(x[0]))
    out = []
    for m in re.finditer(r"REFUSED: ([\w.]+)(?:::|:)", words):
        f = next((f for d, f in dotted if m.group(1) == d or m.group(1).startswith(d + ".")),
                 None)
        if f and f not in out:
            out.append(f)
    return out


def run_hook(repo, message, scratch, bound_s):
    """``(rc, refused, fired)``: the commit-msg hook traced; *refused* names each check whose
    command was followed by the hook's `status=1`."""
    hook = os.path.join(repo, "scripts", "hooks", "commit-msg")
    copy = os.path.join(scratch, "message")
    shutil.copyfile(message, copy)
    trace = os.path.join(scratch, "hook.trace")
    path = os.pathsep.join([BROWSER_DIR, os.path.join(BROWSER_DIR, "firefox"),
                            os.environ.get("PATH", "")])
    env = _env({"PS4": PS4, "PATH": path})
    with open(trace, "w", encoding="utf-8") as out:
        p = subprocess.Popen(["sh", "-x", hook, copy], cwd=repo, env=env, stdout=out,
                             stderr=subprocess.STDOUT, start_new_session=True)
        try:
            rc, fired = p.wait(timeout=bound_s), False
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)
            rc, fired = p.wait(), True
    refused, last = [], None
    with open(trace, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if line.startswith(PS4):
                cmd = line[len(PS4):].strip()
                if cmd.startswith("status=1") and last:
                    refused.append(last)
                m = re.search(r"scripts/([\w.-]+)", cmd)
                if m and not cmd.startswith(("status=", "ROOT=", "CHECKS=", "exit")):
                    last = m.group(1)
            else:
                sys.stdout.write(line)
    return rc, refused, fired


# --- the snapshot (C3421) --------------------------------------------------------------------

#: Every snapshot's folder begins so (in the temporary directory, owner-only by `mkdtemp`);
#: never scripts/nmas-gate's prefix, so neither sweeps the other's.
SNAPSHOT_PREFIX = "nmas-pregate-snapshot-"
#: The file in a snapshot's folder naming the run that owns it.
SNAPSHOT_OWNER = "owner.pid"
#: The local-only folder never copied into a snapshot (the operator's files: the publication
#: denylist, the lab hosts).
NOT_COPIED = "data/"
#: The tests that read the checkout's local-only files under NOT_COPIED (C3421): deselected in
#: the snapshot, run in the checkout, where those files are, and said so: they read the
#: working tree's files, not the tested tree's (tests/test_nothing_personal_is_published.py's
#: `published_files`). Their skip, where the files are absent, is declared for CI alone
#: (tests/skip_reasons.py), so the gate's skip check refuses it here as the gate does.
CHECKOUT_ONLY = {
    "tests/test_nothing_personal_is_published.py": (
        "TestThePublishedFiles::test_no_term_on_the_local_denylist",
        "TestThePublishedFiles::test_no_real_host_address_is_exempted",
    ),
}


def snapshot_local():
    """scripts/nmas-gate's SNAPSHOT_LOCAL, parsed from it (one list of the files outside git
    the tests read), less every file under NOT_COPIED."""
    try:
        with open(os.path.join(REPO, "scripts", "nmas-gate"), encoding="utf-8") as fh:
            tree = ast.parse(fh.read())
    except (OSError, SyntaxError, ValueError):
        return ()
    for n in tree.body:
        if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "SNAPSHOT_LOCAL"
                                             for t in n.targets) \
                and isinstance(n.value, (ast.Tuple, ast.List)):
            return tuple(e.value for e in n.value.elts if isinstance(e, ast.Constant)
                         and isinstance(e.value, str) and not e.value.startswith(NOT_COPIED))
    return ()


def _owner_alive(parent):
    try:
        with open(os.path.join(parent, SNAPSHOT_OWNER), encoding="utf-8") as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OverflowError):
        return True
    return True


def remove_stale(repo):
    """Remove each of *repo*'s snapshot worktrees whose run is gone (killed, its `finally`
    never ran); ``[folders removed]``. One whose run still lives is never touched."""
    gone = []
    r = git(repo, "worktree", "list", "--porcelain")
    for line in r.stdout.splitlines():
        path = line[len("worktree "):] if line.startswith("worktree ") else ""
        parent = os.path.dirname(path)
        if os.path.basename(parent).startswith(SNAPSHOT_PREFIX) and not _owner_alive(parent):
            git(repo, "worktree", "remove", "--force", path)
            shutil.rmtree(parent, ignore_errors=True)
            gone.append(parent)
    if gone:
        git(repo, "worktree", "prune")
    return gone


def make_snapshot(repo, tree, base):
    """``(path, remove, why)``: a worktree of *base* (its HEAD), set to exactly *tree*, index
    and files, as scripts/nmas-gate's step 2b makes one, with `snapshot_local()` copied in;
    ``(None, None, why)`` when git cannot. Its folder is owner-only (`mkdtemp`'s 0700), outside
    the checkout; nothing in *repo*'s working tree or index changes."""
    parent = tempfile.mkdtemp(prefix=SNAPSHOT_PREFIX)
    with open(os.path.join(parent, SNAPSHOT_OWNER), "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    snap = os.path.join(parent, "tree")
    r = git(repo, "worktree", "add", "-q", "--no-checkout", "--detach", snap, base)
    if r.returncode:
        shutil.rmtree(parent, ignore_errors=True)
        return None, None, (r.stderr or r.stdout).strip()[:400]

    def remove():
        git(repo, "worktree", "remove", "--force", snap)
        shutil.rmtree(parent, ignore_errors=True)
        git(repo, "worktree", "prune")
    r = git(snap, "read-tree", "-u", "--reset", tree)
    if r.returncode:
        remove()
        return None, None, (r.stderr or r.stdout).strip()[:400]
    for rel in snapshot_local():
        src = os.path.join(repo, rel)
        if os.path.isfile(src):
            os.makedirs(os.path.dirname(os.path.join(snap, rel)) or snap, exist_ok=True)
            shutil.copy2(src, os.path.join(snap, rel))
    return snap, remove, ""


def _exit_on_signal(signum, _frame):
    """SIGTERM and SIGHUP end the run as an exit does, so its `finally` removes the snapshot."""
    raise SystemExit(128 + signum)


# --- the verdict (C3421) ---------------------------------------------------------------------

def verdict_dir(repo):
    """``<git common dir>/nmas-pregate/verdicts``: shared by every worktree of *repo*."""
    common = git(repo, "rev-parse", "--git-common-dir").stdout.strip()
    if common and not os.path.isabs(common):
        common = os.path.join(repo, common)
    return os.path.join(common, "nmas-pregate", "verdicts")


def record_verdict(repo, record):
    """Write *record* as ``<tree>.json`` atomically (a temporary file in the same folder,
    flushed and synced, then `os.replace`); returns its path."""
    folder = verdict_dir(repo)
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, f"{record['tree']}.json")
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".writing-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, indent=1, sort_keys=True)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return path


def read_verdict(repo, tree):
    """The record of *tree*, or None (none written, or unreadable: never a pass)."""
    try:
        with open(os.path.join(verdict_dir(repo), f"{tree}.json"), encoding="utf-8") as fh:
            rec = json.load(fh)
    except (OSError, ValueError):
        return None
    return rec if isinstance(rec, dict) and rec.get("tree") == tree else None


def show_verdict(repo, what, say):
    """`--verdict`: 0 only for a recorded pass of *what*'s tree; 1 none or not a pass; 2 no
    such tree."""
    r = git(repo, "rev-parse", "--verify", "-q", f"{what}^{{tree}}")
    tree = r.stdout.strip()
    if r.returncode or not tree:
        say(f"nmas-pregate: no tree or commit {what!r} in {repo}")
        return 2
    rec = read_verdict(repo, tree)
    if rec is None:
        say(f"nmas-pregate: tree {tree}: NO VERDICT recorded (run scripts/nmas-pregate on it: "
            "staged, or --range <base>..<commit>)")
        return 1
    files = rec.get("files", {})
    say(f"nmas-pregate: tree {tree}: {rec.get('verdict')} ({rec.get('change')}, base "
        f"{rec.get('base', '')[:10]}, at {rec.get('at')}; {len(files)} file(s); the message: "
        f"{rec.get('message')})")
    for t, f in sorted(files.items()):
        if not str(f.get("state", "")).startswith("passed"):
            say(f"  {f.get('state')}: {t}")
    return 0 if rec.get("verdict") == "pass" else 1


# --- the whole -------------------------------------------------------------------------------

def fingerprint(repo):
    return _load("nmas_control_for_pregate", os.path.join(REPO, "scripts", "nmas-control")
                 ).fingerprint(repo)


def summary(chosen, states):
    """The lines: each file, its state, and why it was chosen."""
    lines = []
    for t, whys in chosen.items():
        state = states.get(t, "NOT RUN: no run reached it")
        more = f" (+{len(whys) - 1} more)" if len(whys) > 1 else ""
        lines.append(f"  {state:<34} {t}: {whys[0]}{more}")
    return lines


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--range", help="A..B: the commits after A up to B, in place of the index")
    ap.add_argument("--message", help="a commit message file for scripts/hooks/commit-msg")
    ap.add_argument("--list", action="store_true", help="list the tests and why; run nothing")
    ap.add_argument("--no-wait", action="store_true", help="refuse at once while a gate runs")
    ap.add_argument("--verdict", metavar="TREE-OR-COMMIT",
                    help="print the verdict recorded for that tree; exit 0 only for a pass")
    ap.add_argument("--repo", default=None, help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    def say(words):
        print(words, flush=True)

    top = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel")
    repo = top.stdout.strip()
    if top.returncode or not repo:
        say(f"nmas-pregate: not a git checkout: {a.repo or os.getcwd()}")
        return 2
    if a.verdict:
        return show_verdict(repo, a.verdict, say)
    if a.message and not os.path.isfile(a.message):
        say(f"nmas-pregate: no message file at {a.message}")
        return 2
    what = f"the range {a.range}" if a.range else "staged"
    if a.range:
        lo, sep, hi = a.range.partition("..")
        base_r = git(repo, "rev-parse", "--verify", "-q", f"{lo}^{{commit}}")
        tree_r = git(repo, "rev-parse", "--verify", "-q", f"{hi or 'HEAD'}^{{tree}}")
    else:
        sep = ".."
        base_r = git(repo, "rev-parse", "--verify", "-q", "HEAD^{commit}")
        tree_r = git(repo, "write-tree")
    base, tree = base_r.stdout.strip(), tree_r.stdout.strip()
    if not sep or base_r.returncode or tree_r.returncode or not base or not tree:
        say(f"nmas-pregate: git cannot say what {'the range ' + a.range if a.range else 'is staged'}"
            " changes")
        return 2
    if git(repo, "diff-tree", "--quiet", base, tree).returncode == 0:
        say(f"nmas-pregate: {'the range ' + a.range if a.range else 'the index'} changes nothing")
        return 2
    for stale in remove_stale(repo):
        say(f"nmas-pregate: removed a snapshot a run that is gone left behind: {stale}")
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _exit_on_signal)
    snap, remove, why = make_snapshot(repo, tree, base)
    if snap is None:
        say(f"nmas-pregate: the snapshot of tree {tree} could not be made: {why}")
        return 2
    try:
        return _tested(a, repo, snap, tree, base, what, say)
    finally:
        remove()


def _tested(a, repo, snap, tree, base, what, say):
    """The selection, the runs and the verdict, all in the snapshot *snap* of *tree* (its HEAD
    *base*), the CHECKOUT_ONLY tests in *repo*."""
    got = change(snap)
    if got is None or not got.files:
        say(f"nmas-pregate: git cannot say what tree {tree} changes on {base}")
        return 2
    files = got.files
    say(f"nmas-pregate: {len(files)} changed file(s) ({what}); tested: tree {tree[:12]} on "
        f"{base[:12]}, in the snapshot {snap}; the working tree is free to edit")
    if not a.range:
        loose = unstaged(repo)
        if loose:
            say(f"nmas-pregate: note: {len(loose)} file(s) differ between the index and the "
                f"working tree, and are not in the tested tree: {', '.join(loose[:8])}"
                f"{' ...' if len(loose) > 8 else ''}")
    tests = test_files(snap)
    chosen = select(snap, got, tests=tests)
    absent = [t for t in chosen if not os.path.isfile(os.path.join(snap, t))]
    browser = [t for t in chosen if t in tests and tests[t].browser]
    confined = [t for t in chosen if t not in browser and t not in absent]
    in_checkout = {t: ids for t, ids in CHECKOUT_ONLY.items() if t in confined}
    say(f"nmas-pregate: {len(chosen)} test file(s): {len(confined)} confined, "
        f"{len(browser)} browser")
    checkout_words = [
        f"not run in the snapshot: {t}::{i}: it reads the checkout's local-only files under "
        f"{NOT_COPIED}, never copied into the snapshot, so it runs in the checkout, reading the "
        f"working tree's files, not tree {tree[:12]}'s" for t, ids in in_checkout.items()
        for i in ids]
    if a.list:
        for line in summary(chosen, {t: "listed (--list: not run)" for t in chosen}):
            say(line)
        for line in checkout_words:
            say(f"  {line}")
        say("nmas-pregate: listed only; nothing was run, and no verdict recorded")
        return 0

    w = _workers()
    lock = os.environ.get("NMAS_FULL_LOCK", w.FULL_LOCK)
    bound_wait = int(os.environ.get("NMAS_PREGATE_WAIT_S", w.WAIT_BOUND_S))
    every = int(os.environ.get("NMAS_PREGATE_POLL_S", w.WAIT_EVERY_S))
    before = fingerprint(repo)
    states, failed, not_run, extra = {}, False, bool(absent), []
    counts, missing = {}, {}            # summed over the runs; why a file's run did not happen
    for t in absent:
        missing[t] = "absent from the tested tree"
    extra += checkout_words
    scratch = tempfile.mkdtemp(prefix="nmas-pregate-")
    try:
        junits = []
        runs = (("confined", confined, snap,
                 [f"{t}::{i}" for t, ids in in_checkout.items() for i in ids]),
                ("browser", browser, snap, ()),
                ("checkout", [f"{t}::{i}" for t, ids in in_checkout.items() for i in ids],
                 repo, ()))
        for label, group, where, desel in runs:
            if not group:
                continue
            owners = list(in_checkout) if label == "checkout" else group
            why = wait_for_no_gate(lock, bound_wait, every, a.no_wait, say)
            if why:
                for t in owners:
                    missing.setdefault(t, "a gate was running")
                extra.append(f"the {label} run did not start: {why}")
                not_run = True
                continue
            if label in ("confined", "checkout"):
                b = confined_bound(len(owners))
                say(f"nmas-pregate: the {label} run, in "
                    f"{'the checkout' if label == 'checkout' else 'the snapshot'}, "
                    f"{len(group)} {'test(s)' if label == 'checkout' else 'file(s)'}, bound "
                    f"{b} s (about 2.5x the measured {MEASURED_CONVENTIONS_S} s for the "
                    f"convention set and {MEASURED_PER_FILE_S} s a further file)")
                rc, fired, junit = run_confined(where, group, scratch, b, label=label,
                                                deselect=desel)
                note = ""
            else:
                b = browser_bound(len(group))
                say(f"nmas-pregate: the browser run, unconfined, in the snapshot, {len(group)} "
                    f"file(s), bound {b} s (about 2.5x the measured {MEASURED_BROWSER_FILE_S} s "
                    f"a file, never under 2.5x the slowest file's {MEASURED_BROWSER_SLOWEST_S} s)")
                rc, fired, junit, note = run_browser(where, group, scratch, b)
            if note or rc is None:
                for t in owners:
                    missing.setdefault(t, "no browser interpreter")
                extra.append(f"the {label} run did not start: {note}")
                not_run = True
                continue
            if fired:
                extra.append(f"the {label} run's bound fired ({b} s); its files are not run")
            got = None if fired else outcomes(junit, owners)
            if got is None:
                for t in owners:
                    missing.setdefault(t, "the bound fired" if fired else
                                       f"no JUnit result from the {label} run (exit {rc})")
                not_run = True
                continue
            junits.append(junit)
            for t in owners:
                c = counts.setdefault(t, {"passed": 0, "failed": 0, "skipped": 0})
                for k in c:
                    c[k] += got[t][k]
                if label == "checkout" and not got[t]["passed"] + got[t]["failed"]:
                    missing.setdefault(t, "its checkout-only tests did not run")
            if rc and not any(got[t]["failed"] for t in owners):
                extra.append(f"the {label} run exited {rc} with no test failed in its JUnit "
                             "file (a collection or session error: read its output above)")
                failed = True
        all_skipped, skips_declared = [], False
        for t in chosen:
            o = counts.get(t)
            if o and o["failed"]:
                states[t] = f"FAILED ({o['failed']} failed, {o['passed']} passed)"
                failed = True
            elif t in missing:
                states[t] = f"NOT RUN: {missing[t]}"
                not_run = True
            elif o is None:
                states[t] = "NOT RUN: no run reached it"
                not_run = True
            elif not o["passed"] and not o["skipped"]:
                states[t] = "NOT RUN: no test collected"
                not_run = True
            elif not o["passed"]:
                # Judged after the skip check, below: every skip declared for the gate is the
                # file's declared state there (C3448), anything else is not run.
                states[t] = "NOT RUN: every test skipped"
                all_skipped.append(t)
            else:
                states[t] = f"passed ({o['passed']}" + (
                    f", {o['skipped']} skipped)" if o["skipped"] else ")")
        if junits:
            rc, words = skip_check(snap, junits)
            skips_declared = rc == 0
            if rc:
                extra.append(f"the skip check (scripts/nmas-skip-check --where gate) refused: "
                             f"{words}")
                failed = failed or rc == 1
                not_run = not_run or rc != 1
                # Each file a refused skip belongs to says so, never "passed".
                for t in refused_skips(words, list(states)):
                    states[t] = "FAILED: a skip the gate refuses"
        # A file whose every test skipped is "skipped as declared" only when the skip check,
        # over this run's JUnit files, accepted every skip as declared for the gate: that is
        # the state the gate itself holds it in (tests/test_board_shots.py, run only when
        # asked). A skip check that refused or could not run leaves it not run (C3448).
        for t in all_skipped:
            if states[t].startswith("FAILED"):
                continue
            if skips_declared:
                states[t] = f"skipped as declared ({counts[t]['skipped']})"
            else:
                not_run = True
        hook_line = None
        if a.message:
            why = wait_for_no_gate(lock, bound_wait, every, a.no_wait, say)
            if why:
                hook_line = f"NOT RUN: the commit-msg hook ({why})"
                not_run = True
            else:
                say(f"nmas-pregate: scripts/hooks/commit-msg on a copy of {a.message}, bound "
                    f"{HOOK_BOUND} s")
                rc, refused, fired = run_hook(snap, a.message, scratch, HOOK_BOUND)
                if fired:
                    hook_line = f"NOT RUN: the commit-msg hook's bound fired ({HOOK_BOUND} s)"
                    not_run = True
                elif rc == 0:
                    hook_line = "passed: the commit-msg hook"
                else:
                    hook_line = ("REFUSED: the commit-msg hook, by " + (", ".join(refused) or
                                 f"no check named in its trace (exit {rc})"))
                    failed = True
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    after = fingerprint(repo)
    moved = sorted(k for k in set(before) | set(after) if before.get(k) != after.get(k))
    say("nmas-pregate: the summary")
    for line in summary(chosen, states):
        say(line)
    if hook_line:
        say(f"  {hook_line}")
    for e in extra:
        say(f"  {e}")
    # The working tree decides nothing: the tree tested is the snapshot's (C3421).
    say(f"nmas-pregate: the working tree changed during the run (not part of the verdict, which "
        f"is tree {tree[:12]}'s): {moved}" if moved else
        "nmas-pregate: the working tree did not change during the run")
    rc = 1 if failed else 4 if not_run else 0
    record = {
        "tree": tree, "verdict": {0: "pass", 1: "failed"}.get(rc, "not run"), "exit": rc,
        "change": what, "base": base,
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "message": hook_line or ("not given" if not a.message else "not run"),
        "files": {t: {"why": whys, "state": states.get(t, "NOT RUN: no run reached it")}
                  for t, whys in chosen.items()},
        "notes": extra, "working_tree_changed": moved,
    }
    path = record_verdict(repo, record)
    say(f"nmas-pregate: the verdict for tree {tree}: {record['verdict']}, recorded in {path}")
    if failed:
        say("nmas-pregate: FAILED")
    elif not_run:
        say("nmas-pregate: NOT EVERYTHING RAN: no pass")
    else:
        held = sorted(t for t, s in states.items() if s.startswith("skipped as declared"))
        say("nmas-pregate: every chosen file ran and passed" + (
            f", but {len(held)} skipped as declared for the gate: {', '.join(held)}"
            if held else ""))
    return rc


if __name__ == "__main__":
    sys.exit(main())
