+for n in "${DEVICES[@]}"; do
+  d="$(ssh "$CLAB" "diff -u '${CFGDIR[$n]}/${n}.cfg' '$STAGE/${n}.cfg' 2>&1" || true)"
   if [ -z "$d" ]; then
-    printf '  %-4s unchanged\n' "$n"
+    printf '  %-4s %-16s unchanged\n' "$n" "${LAB[$n]}"
   elif grep -q 'No such file' <<<"$d"; then
-    printf '  %-4s NEW - no current file on the clab VM\n' "$n"
+    printf '  %-4s %-16s NEW - no current file on the clab VM\n' "$n" "${LAB[$n]}"
     newfiles=$((newfiles+1))
   else
     add=$(grep -c '^+[^+]' <<<"$d")
     del=$(grep -c '^-[^-]' <<<"$d")
-    printf '  %-4s CHANGED  +%s / -%s lines\n' "$n" "$add" "$del"
+    printf '  %-4s %-16s CHANGED  +%s / -%s lines\n' "$n" "${LAB[$n]}" "$add" "$del"
     changed=$((changed+1))
   fi
 done
