            "^ip ospf (authentication|authentication-key|message-digest-key)\\b",
            "^ipv6 ospf (authentication|encryption)\\b",
            "^ospfv3 (\\d+ )?(authentication|encryption)\\b",
            "^area \\S+ (authentication\\b|virtual-link \\S+ .*(authentication|message-digest-key)\\b)",
            "^neighbor \\S+ (password|ao)\\b",
            "^isis authentication\\b",
            "^authentication (mode|key-chain|send-only)\\b",
            "^ip rip authentication\\b",
            "^ipv6 rip \\S+ authentication\\b",
            "^ip authentication (mode|key-chain) eigrp\\b",
            "^standby (\\d+ )?authentication\\b",
            "^vrrp \\d+ authentication\\b",
            "^key chain \\S+"
          ],
          "sections": ["^key chain \\S+"]
        },
        "acl": {
          "words": "an ACL, its entries or its application",
          "lines": [
