#!/usr/bin/env python3
"""Which account does each stored integration token act as, and what may it do?

    nmas-integration-accounts            # both
    nmas-integration-accounts --json     # the same, as JSON

Read-only: GETs through the app's own NetBox and Grafana clients, never a
write, and never a token, value or credential printed.

- **NetBox:** the version (`api/status/`) and the account the stored token
  belongs to (`api/authentication-check/`, NetBox 4.x). C100: until the
  switch-over this is the operator's own account, so NetBox's change log
  cannot tell the NMAS's writes from a person's. After it, it must name the
  NMAS's own account, and the drift reader asks the same endpoint for the
  name it treats as "the NMAS" (never a setting that could go stale).
- **Grafana:** the version (`api/health`) and every permission the stored
  token holds (`api/access-control/user/permissions`). C230: the token held
  an Editor's permissions (silence, write and delete rules and dashboards)
  while the reader only reads. With a Viewer token, the list printed IS the
  Viewer role on the installed version, and every create, write or delete
  in it is named, expected none.

Exit 0 when both answered and the Grafana token holds no write; 1 when the
Grafana token holds a write (named); 2 when something could not be asked
(named). "Could not ask" is never read as "holds nothing".
"""

import sys

ROOT = __import__("os").path.dirname(__import__("os").path.dirname(
    __import__("os").path.abspath(__file__)))
sys.path.insert(0, ROOT)

import argparse  # noqa: E402
import json  # noqa: E402

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

#: A permission is a write when its action ends in one of these verbs.
#: Grafana names actions `<resource>:<verb>`; the reads are read, list,
#: query and explore.
WRITE_VERBS = ("create", "write", "delete", "update", "push", "test")


def writes(permissions: dict) -> list:
    """Every permission whose verb changes something, sorted."""
    return sorted(a for a in permissions if a.rsplit(":", 1)[-1] in WRITE_VERBS)


def netbox_account(session=None, base=None) -> dict:
    """The NetBox version and the account the stored token belongs to."""
    from modules import netbox_client as N
    if session is None:
        cfg = N.get_netbox_config()
        if not cfg.get("url") or not cfg.get("token"):
            return {"asked": False, "why": "NetBox is not configured (Settings > Integrations)"}
        session, base = N._session_from_config(cfg), cfg["url"].rstrip("/")
    out = {"asked": True}
    for key, path in (("status", "api/status/"), ("account", "api/authentication-check/")):
        try:
            r = session.get(f"{base}/{path}", timeout=15)
        except Exception as exc:              # noqa: BLE001
            return {"asked": False, "why": f"{path}: {type(exc).__name__}"}
        if r.status_code != 200:
            # C468: NetBox's own reason (an expired token, a source address it does not allow),
            # never the status alone.
            said = N.refusal_reason(r)
            return {"asked": False, "why": f"{path}: HTTP {r.status_code}"
                                           + (f": {said}" if said else "")}
        out[key] = r.json()
    return {"asked": True, "version": out["status"].get("netbox-version"),
            "username": out["account"].get("username"), "id": out["account"].get("id")}


def grafana_account(client=None) -> dict:
    """The Grafana version and every permission the stored token holds."""
    if client is None:
        from modules.integrations.grafana import GrafanaIntegration
        client = GrafanaIntegration()
    got = {}
    for key, path in (("health", "api/health"),
                      ("permissions", "api/access-control/user/permissions")):
        r = client._get(path)
        if not r.get("ok"):
            return {"asked": False, "why": f"{path}: {r.get('error') or 'no answer'}"}
        got[key] = r["response"].json()
    perms = got["permissions"] or {}
    return {"asked": True, "version": got["health"].get("version"),
            "permissions": sorted(perms), "writes": writes(perms)}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--json", action="store_true", help="print the result as JSON")
    args = ap.parse_args(argv)

    nb, gf = netbox_account(), grafana_account()
    if args.json:
        print(json.dumps({"netbox": nb, "grafana": gf}, indent=1, sort_keys=True))
    else:
        if nb["asked"]:
            print(f"NetBox {nb['version']}: the stored token acts as '{nb['username']}' "
                  f"(user id {nb['id']})")
        else:
            print(f"NetBox: COULD NOT ASK ({nb['why']})")
        if gf["asked"]:
            print(f"Grafana {gf['version']}: the stored token holds "
                  f"{len(gf['permissions'])} permission(s)")
            if gf["writes"]:
                print(f"  it can CHANGE Grafana: {len(gf['writes'])} write permission(s): "
                      + ", ".join(gf["writes"]))
            else:
                print("  no create, write or delete: a reader's token")
            print("  all: " + ", ".join(gf["permissions"]))
        else:
            print(f"Grafana: COULD NOT ASK ({gf['why']})")
    if not nb["asked"] or not gf["asked"]:
        return 2
    return 1 if gf["writes"] else 0


if __name__ == "__main__":
    sys.exit(main())
