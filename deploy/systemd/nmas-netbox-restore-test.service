# TEMPLATE (2026-09-29): the repository is public, so the host's user and paths
# are placeholders. Render it, never copy it:
[Unit]
Description=NMAS: restore the newest NetBox backup into a scratch postgres and compare
# When it ends, either way, the app reads job health at once
# (nmas-job-finished@.service; /jobs/finished).
OnSuccess=nmas-job-finished@%N.service
OnFailure=nmas-job-finished@%N.service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@NMAS_USER@
Group=@NMAS_USER@
SupplementaryGroups=docker
UMask=0077
StateDirectory=nmas-netbox
StateDirectoryMode=0700
EnvironmentFile=/etc/nmas/netbox-backup.env
ExecStart=@NMAS_CHECKOUT@/scripts/nmas-netbox-restore-test
TimeoutStartSec=30min
