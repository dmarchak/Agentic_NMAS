#!/bin/sh
# The commit message's checks, each over the commit being made; CI checks the same rules over
# every pushed range, so a bypass is refused there.
#
# - A commit that changes a file a person installs on the host (the updater, nmas-deploy, the
#   systemd units, the topology renderer) carries a 'Host-Step:' or 'Host-Step-None:' trailer
#   (2026-09-30).
# - A commit that weakens a test (deletes one, adds a skip, xfail or 'pragma: no cover', raises
#   a ceiling or adds to a known-gap list) names each in a 'Test-Weakened: <test or list> —
#   C<n>: <reason>' trailer, C<n> a register row (CLAUDE.md, Measurement and testing).
# - Each new or changed test function fails or errors on the commit's parent, the commit's
#   tests/ over the parent's code (board TI item 1, docs/TEST_INTEGRITY.md); 'Guards-Existing:
#   <test> — <reason>' excuses one that passes there, 'Red-By-Collection: <file> — <reason>' a
#   file that cannot be collected there.
# - A commit that changes a guard (every file here, the gate and its checks, the ratchets,
#   CLAUDE.md, docs/TESTING.md's rule sections; board TI item 2) carries the operator's
#   approval, 'Approved-By: operator — "<the operator's own words, quoted>"'.
# - Each way past a test or a guard a commit adds (a skip, 'pragma: no cover', noqa, a broad
#   except in a test, a mock of the module under test, a raised bound, a guarded word built
#   from pieces) is named in 'Bypass: <file>:<line> — <reason>' (board TI item 3).
# - A premise correction names what was measured, 'Premise-Corrected: <test> — measured:
#   <what, where, the result>', and a message whose prose says a premise was corrected or
#   wrong carries one (board TI item 5).
#
# All run whatever the others answer, so one commit hears every refusal at once.
#
# Install:  ln -sf ../../scripts/hooks/commit-msg .git/hooks/commit-msg
ROOT="$(git rev-parse --show-toplevel)"
# The checks' own copy: the gate sets NMAS_CHECKS_ROOT to a worktree of the parent commit, so
# a commit is judged by the checks it came after, never by the version it brings (C2365).
CHECKS="${NMAS_CHECKS_ROOT:-$ROOT}"
status=0
python3 "$CHECKS/scripts/nmas-host-step-check" --message "$1" || status=1
python3 "$CHECKS/scripts/nmas-test-weakening-check" --message "$1" || status=1
python3 "$CHECKS/scripts/nmas-red-green" --repo "$ROOT" --message "$1" || status=1
python3 "$CHECKS/scripts/nmas-guard-check" --repo "$ROOT" --message "$1" || status=1
python3 "$CHECKS/scripts/nmas-bypass-scan" --repo "$ROOT" --message "$1" || status=1
python3 "$CHECKS/scripts/nmas-premise-check" --message "$1" || status=1
exit $status
