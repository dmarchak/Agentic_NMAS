     "annotations": {
      "description": "s4 emits NMAS-HEARTBEAT every 300 s by its own clock. Window 1005 s, measured from this device's own 45 heartbeat gaps (383.4-429.4 s; clock rate 0.752). None arrived in the window: the device, its logging block, the path to rsyslog, rsyslog, Alloy or Loki has stopped. The heartbeat cannot say which; it says that one of them has.",
      "summary": "No syslog heartbeat from s4 for 1005 s"
     },
     "expr": "",
     "for": "0s",
     "grafana_alert": {
      "condition": "C",
      "data": [
       {
        "datasourceUid": "efxk88ulvh3pcf",
        "model": {
         "expr": "sum(count_over_time({job=\"network_syslog\"} |= \"NMAS-HEARTBEAT\" |~ `%HA_EM-\\d-LOG: NMAS\\-HEARTBEAT: NMAS\\-HEARTBEAT` |~ `\\ss4:\\s` [1005s]))",
