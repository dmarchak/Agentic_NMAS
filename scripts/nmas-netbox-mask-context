#!/usr/bin/env python3
"""Mask a credential NetBox still holds where no import will reach it (C139).

C95 (a) masks a device's config on its way INTO NetBox, and (b)'s re-import
overwrote every copy the import can reach. It cannot reach a device no list
claims: `nmas-retire` keeps the NetBox record by design ("NetBox records what
exists, not what NMAS manages") and removes the device from every path that
would correct its data. Measured 2026-09-28: r5 held three credential-slot
kinds unmasked, and its SNMP community is the value eight managed devices
carry NOW, so the exposure was current, not historical.

**The population is what NetBox HOLDS**, never a list: every device the
secret-storage checker's own scan flags (its pattern is independent of the
redactor that masks). **The authority is the modification record**: NMAS
masks only a context it wrote itself (C131/section 16, "did NMAS write this
value"), and names any other as somebody's data, left alone. It masks with
the import's own function (`netbox_client.masked_context`), so the result is
what an import would have written. A context already partly masked is
refused, because the redactor is not idempotent over its own masks.

    python3 scripts/nmas-netbox-mask-context                # dry run, every flagged device
    python3 scripts/nmas-netbox-mask-context --device r5    # dry run, one device
    python3 scripts/nmas-netbox-mask-context --device r5 --apply

Every write goes through `_nb_patch`: gated on `netbox_allow_writes` and
recorded in `data/netbox_modified.json` like any other. After the write it
READS NetBox back and runs the checker's scan on what NetBox holds.

Exit: 0 nothing to do, or every write read back clean; 1 a device refused,
failed, or still holds a credential after the write; 2 NetBox or the record
could not be read (nothing is known, so nothing is claimed).
"""

import argparse
import importlib.machinery
import importlib.util
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

ENDPOINT = "dcim/devices"


def _checker():
    """The secret-storage checker, loaded as a module: its NetBox scan is the
    one whose pattern does not share a source with the redactor."""
    path = os.path.join(ROOT, "scripts", "nmas-check-secret-storage")
    loader = importlib.machinery.SourceFileLoader("nmas_check_secret_storage", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def nmas_wrote_context(modified: dict, obj_id: int) -> str:
    """When NMAS last recorded writing this device's `local_context_data`, in
    any list's record, or ``""``. The record is keyed by list, and a retired
    device's list may no longer claim it: the WRITE is what gives authority."""
    last = ""
    for _lst, per in (modified or {}).items():
        if not isinstance(per, dict):
            continue
        for e in per.get(ENDPOINT) or []:
            if (str(e.get("id")) == str(obj_id)
                    and "local_context_data" in (e.get("fields") or {})):
                last = max(last, e.get("at") or "")
    return last


def plan(devices: list, modified: dict, scan) -> tuple:
    """``(todo, refused)`` from NetBox's devices and the modification record.
    Pure, so it is tested against real shapes without a NetBox."""
    todo, refused = [], []
    flagged = {f["device"]: f for f in scan(devices)["findings"]}
    for d in devices:
        f = flagged.get(d.get("name") or d.get("id"))
        if not f:
            continue
        lcd = d.get("local_context_data") or {}
        wrote = nmas_wrote_context(modified, d["id"])
        if not wrote:
            refused.append((d, f, "NMAS has no record of writing this context, so it "
                               "is somebody's data: named here, not changed"))
            continue
        if "<redacted" in (lcd.get("running_config") or ""):
            refused.append((d, f, "its running config is partly masked already, and "
                               "masking again would change masked lines too: "
                               "re-import it through its list instead"))
            continue
        after = _masked(lcd)
        todo.append({"device": d, "finding": f, "after": after, "wrote": wrote,
                     "lines": _lines_changed(lcd.get("running_config") or "",
                                             after.get("running_config") or "")})
    return todo, refused


def _masked(lcd: dict) -> dict:
    from modules.netbox_client import masked_context

    return masked_context(lcd)


def _lines_changed(before: str, after: str) -> int:
    b, a = before.splitlines(), after.splitlines()
    return sum(1 for x, y in zip(b, a) if x != y) + abs(len(b) - len(a))


def _read_devices(session, base, device: str = "") -> list:
    url = f"{base}/api/{ENDPOINT}/"
    params = {"limit": 200, **({"name": device} if device else {})}
    out = []
    while url:
        r = session.get(url, params=params, timeout=30)
        r.raise_for_status()
        body = r.json()
        out += body.get("results") or []
        url, params = body.get("next"), None
    return out


def _describe(f: dict) -> str:
    return (f"unmasked: {', '.join(f['slots']) or '-'}"
            f"{' (the positional redactor also finds one)' if f['positional'] else ''}; "
            f"structured communities with a value: {f['communities']}")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--device", default="", help="one NetBox device by name")
    ap.add_argument("--apply", action="store_true", help="write (default: dry run)")
    args = ap.parse_args()

    from modules.netbox_client import _nb_patch, _nb_ready
    from modules.netbox_guard import for_list, read_modified

    ok, err, session, base = _nb_ready()
    if not ok:
        print(f"UNPROVEN: NetBox is not reachable: {err}")
        return 2
    modified, why = read_modified()
    if modified is None:
        print(f"UNPROVEN: the modification record could not be read: {why}")
        return 2
    try:
        devices = _read_devices(session, base, args.device)
    except Exception as exc:                  # noqa: BLE001
        print(f"UNPROVEN: NetBox devices could not be read: {exc}")
        return 2
    if not devices:
        print(f"UNPROVEN: NetBox returned no device{' named ' + args.device if args.device else 's'}, "
              "so nothing was checked")
        return 2

    scan = _checker().scan_netbox_context
    todo, refused = plan(devices, modified, scan)
    print(f"{len(devices)} NetBox device(s) read; {len(todo) + len(refused)} hold an "
          "unmasked credential")
    for t in todo:
        d, lcd = t["device"], t["device"].get("local_context_data") or {}
        print(f"  {d['name']} (id {d['id']}): {_describe(t['finding'])}")
        print(f"      would mask {t['lines']} running-config line(s) and drop "
              f"{t['finding']['communities']} structured community value(s); every other "
              f"context key unchanged ({len(lcd)} keys)")
        print(f"      authority: NMAS wrote this context at {t['wrote']} (modification record)")
    for d, f, why in refused:
        print(f"  {d['name']} (id {d['id']}): {_describe(f)}")
        print(f"      NOT CHANGED: {why}")

    if not todo:
        print("\nNothing this command may change." if refused else "\nNothing to mask.")
        return 1 if refused else 0
    if not args.apply:
        print("\nDRY RUN: nothing was written. Re-run with --apply "
              "(needs netbox_allow_writes on).")
        return 1 if refused else 0

    actor = f"{os.environ.get('USER') or 'unknown'} (nmas-netbox-mask-context)"
    failed = 0
    with for_list("", actor=actor):
        for t in todo:
            d = t["device"]
            try:
                _nb_patch(session, base, f"{ENDPOINT}/{d['id']}/",
                          {"local_context_data": t["after"]})
            except Exception as exc:          # noqa: BLE001
                failed += 1
                print(f"  FAILED {d['name']}: {exc}")
                continue
            # Read what NetBox HOLDS now, with the checker's own scan: the
            # PATCH answering 200 is evidence about the transport.
            try:
                back = _read_devices(session, base, d["name"])
            except Exception as exc:          # noqa: BLE001
                failed += 1
                print(f"  {d['name']}: written, and the read-back failed ({exc}): UNPROVEN")
                continue
            left = scan(back)["findings"]
            if left:
                failed += 1
                print(f"  {d['name']}: written, and NetBox STILL holds: {_describe(left[0])}")
            else:
                print(f"  {d['name']}: written; read back, NetBox holds no unmasked credential")
    done = len(todo) - failed
    print(f"\n{done} masked and read back clean, {failed} not, {len(refused)} refused")
    return 1 if (failed or refused) else 0


if __name__ == "__main__":
    raise SystemExit(main())
