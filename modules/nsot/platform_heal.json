            "^access-list\\s",
            "^ip access-group\\s",
            "^ipv6 traffic-filter\\s",
            "^access-class\\s",
            "^ipv6 access-class\\s",
            "^object-group\\s",
            "^ntp access-group\\s"
          ],
          "sections": ["^ipv6? access-list\\s", "^object-group\\s"]
        },
        "aaa": {
          "words": "AAA",
          "lines": [
            "^aaa\\s",
            "^tacacs(-server)?\\s",
            "^radius(-server)?\\s",
            "^login (authentication|block-for|quiet-mode|on-failure|on-success|delay)\\b",
            "^authorization (exec|commands)\\b",
            "^accounting (exec|commands|connection)\\b"
          ],
          "sections": ["^(tacacs|radius) server\\s", "^aaa group server\\s"]
        },
        "crypto_ssh": {
          "words": "crypto or SSH",
          "lines": ["^crypto\\s", "^ip ssh\\s", "^ip scp server enable$"],
          "sections": ["^crypto\\s"]
        },
        "snmp_restriction": {
          "words": "an SNMP restriction",
          "lines": [
            "^snmp-server (community|group|user|view)\\s",
            "^snmp-server (file-transfer access-group|tftp-server-list)\\b"
          ],
          "sections": []
        },
        "copp": {
          "words": "control-plane policing",
          "lines": ["^control-plane\\b"],
          "sections": ["^control-plane\\b"]
        },
        "port_security": {
          "words": "port security or 802.1X",
          "lines": [
            "^switchport port-security\\b",
            "^dot1x\\s",
            "^authentication (port-control|host-mode|order|priority|periodic|timer|violation|open|event|control-direction)\\b",
            "^mab\\b",
            "^access-session\\s"
          ],
          "sections": []
        },
        "transport_input": {
          "words": "a line's transport input",
          "lines": ["^transport input\\b"],
          "sections": []
        }
      },
      "references": [
        {"object": "acl", "words": "an IPv4 ACL",
         "defines": ["^ip access-list (?:standard |extended |role-based )?(?P<name>\\S+)$",
