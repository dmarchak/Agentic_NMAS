#!/bin/bash
# The laptop kit for the final SDN lab (docs/LAB9_LAPTOP_RUN.md): a separate Mercury installation
# on this laptop, run from a clean worktree at a pinned sha, never the main working tree.
#
#   kit init SHA       the kit folder, the worktree at SHA, NetBox's secrets, images, settings
#   kit repin SHA      the worktree moved to SHA (a fix on lab9-live), Mercury stopped first;
#                      then the settings init again, adding only what is missing
#   kit start [--reveal]  the check, the identity exception, NetBox, Prometheus, Mercury
#                      (loopback only); --reveal opens reveal too, for the S1 sitting only (C2897)
#   kit stop           the identity gates restored (recorded), Mercury, NetBox and Prometheus stopped
#   kit status         what runs, the pinned sha, the last identity exception
#   kit preflight      one PASS/FAIL line per check (kit_preflight.sh)
#   kit check          the settings check alone (kit_check.py)
#   kit netbox-admin   NetBox's superuser, created by the operator (who types its passphrase)
#   kit netbox-writes-on "<reason>"  NetBox writes on, recorded in History (C2548's bridge)
#   kit reset          stop, then delete the kit's data and NetBox's volumes (asks first)
#
# KIT_HOME (default ~/nmas-sdn-lab) holds everything: kit.env, data/ (NMAS_DATA_DIR), netbox/,
# mercury/ (the worktree), run/ (pid and log), code/lab9.git (lab9's code repository, bare).
# Nothing is written to the main checkout. NetBox's and Prometheus's data are volumes of the
# kit's one Compose project (compose.yml); Prometheus's configuration is prometheus.yml here.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO="$(git -C "$HERE" rev-parse --path-format=absolute --git-common-dir | sed 's#/\.git$##')"
KIT_HOME="${KIT_HOME:-$HOME/nmas-sdn-lab}"
export KIT_HOME
# The folder compose.yml mounts Prometheus's configuration from: this script's own.
KIT_FILES="$HERE"
export KIT_FILES
ENV="$KIT_HOME/kit.env"
PY="${KIT_PYTHON:-$HOME/.local/share/nmas-py312/bin/python}"
WT="$KIT_HOME/mercury"
DATA="$KIT_HOME/data"
RUN="$KIT_HOME/run"
COMPOSE=(docker compose -f "$HERE/compose.yml" --project-directory "$KIT_HOME/netbox")
# The Compose project (compose.yml's `name`) and the name its Prometheus container is given
# there: how `kit start` tells the kit's own Prometheus from one started by hand.
PROJECT=nmas-sdn-lab-netbox
PROM=kit-prometheus
# The identity exception's longest life (option (c), C2520): the sitting, never past 14 hours.
EXCEPTION_HOURS=14

die() { echo "kit: $*" >&2; exit 1; }
load() {
  [ -f "$ENV" ] || die "no $ENV: run 'kit init <sha>' first"
  # shellcheck disable=SC1090
  set -a; . "$ENV"; set +a
  : "${MERCURY_PORT:=5080}" "${NETBOX_PORT:=8001}" "${PROMETHEUS_PORT:=9090}"
  # Exported for compose.yml's port and the preflight: a kit.env from before the kit ran
  # Prometheus names no port, and takes this one.
  export PROMETHEUS_PORT
}
in_wt() {        # in_wt CMD...: run Mercury's code from the worktree, on the kit's data only
  (cd "$WT" && env NMAS_DATA_DIR="$DATA" MERCURY_PORT="$MERCURY_PORT" NETBOX_PORT="$NETBOX_PORT" \
    PROMETHEUS_PORT="$PROMETHEUS_PORT" PYTHONDONTWRITEBYTECODE=1 "$@")
}
nmas_names() {   # the NMAS host's LAN address and tunnel name, for the check, never printed
  KIT_NMAS_LAN="$("$REPO/scripts/nmas-host" nmas --field lan 2>/dev/null || true)"
  KIT_NMAS_TUNNEL="$("$REPO/scripts/nmas-host" nmas --field tunnel 2>/dev/null || true)"
  export KIT_NMAS_LAN KIT_NMAS_TUNNEL
}
UNIT=nmas-sdn-kit-mercury
pid_alive() { systemctl --user is-active --quiet "$UNIT"; }
klog() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$RUN/kit.log"; echo "$*"; }

prom_not_ours() {   # refuse a container named kit-prometheus that this kit's Compose did not make
  # The operator's hand-run one (after the Lab 9 sitting, 2026-11-10) holds the name and the
  # port, so the kit's own could not start. The kit adopts no stray and deletes nothing it did
  # not make: it refuses, naming the container and the one command that removes it. Asked
  # before anything is changed (the guard, the identity exception), so a refusal leaves the
  # laptop as it was. `docker container inspect` fails when there is no such container (the
  # ordinary case), or when Docker is not up, which Compose says itself a few lines on.
  local label
  label=$(docker container inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$PROM" 2>/dev/null) || return 0
  [ "$label" = "$PROJECT" ] && return 0
  die "refused to start: a container named $PROM exists that this kit did not make (its Compose project label is '${label:-none}', the kit's is '$PROJECT'). The kit starts its own Prometheus under that name on 127.0.0.1:$PROMETHEUS_PORT, and removes nothing it did not make. Remove that one yourself, then start again: docker rm -f $PROM"
}

guard_on() {     # the lab9guard nftables table: nothing forwarded to or from LAB_IF
  [ -n "${LAB_IF:-}" ] || die "LAB_IF is not set in $ENV: name the lab interface first"
  [[ "$LAB_IF" =~ ^[A-Za-z0-9._-]{1,15}$ ]] || die "LAB_IF '$LAB_IF' is not an interface name"
  ip link show "$LAB_IF" >/dev/null 2>&1 || die "LAB_IF $LAB_IF does not exist on this laptop (ip -br link lists them)"
  echo "lab9guard: installing the forwarding guard on $LAB_IF; sudo asks for your password"
  sed "s/@LAB_IF@/$LAB_IF/g" "$HERE/lab9guard.nft.in" | sudo nft -f - \
    || die "lab9guard could not be installed, so the kit does not start"
  klog "lab9guard: installed (inet lab9guard, forward priority -10, drops iifname and oifname $LAB_IF), by sudo"
}

guard_off() {
  if sudo -n true 2>/dev/null || { echo "lab9guard: removing the forwarding guard; sudo asks for your password"; sudo -v; }; then
    if sudo nft list table inet lab9guard >/dev/null 2>&1; then
      sudo nft delete table inet lab9guard && klog "lab9guard: removed, by sudo"
    else
      klog "lab9guard: not loaded, nothing to remove"
    fi
  else
    klog "lab9guard: NOT removed (sudo refused); remove it with: sudo nft delete table inet lab9guard"
  fi
}

cmd_init() {
  local sha="${1:-}"
  [ -n "$sha" ] || die "usage: kit init <sha> (the newest deployed, CI-green sha)"
  sha="$(git -C "$REPO" rev-parse --verify "$sha^{commit}")" || die "no commit $1"
  install -d -m 0700 "$KIT_HOME" "$DATA" "$KIT_HOME/netbox" "$RUN"
  if [ -d "$WT" ]; then
    [ "$(git -C "$WT" rev-parse HEAD)" = "$sha" ] || die "$WT is at another sha: kit reset first, or move KIT_HOME"
    [ -z "$(git -C "$WT" status --porcelain -- . ':!.nmas-lab-kit')" ] || die "$WT is not clean: the kit runs from a clean worktree only"
  else
    git -C "$REPO" worktree add --detach "$WT" "$sha" >/dev/null
  fi
  # The marker nmas-deploy refuses on: nothing is ever deployed from this installation.
  printf 'the final SDN lab laptop kit, %s\n' "$KIT_HOME" > "$WT/.nmas-lab-kit"
  [ -f "$ENV" ] || cat > "$ENV" <<EOF
# The laptop kit's settings (docs/LAB9_LAPTOP_RUN.md). LAB_IF is the lab Ethernet, WIFI_IF the
# Wi-Fi that keeps the default route, LAB_PROFILE the NetworkManager profile on LAB_IF;
# CONTROLLER_ADDR is filled at the lab.
PIN_SHA=$sha
MERCURY_PORT=5080
NETBOX_PORT=8001
LAB_IF=
WIFI_IF=
LAB_PROFILE=lab9
CONTROLLER_ADDR=
OPENFLOW_PORT=6653
CONTROLLER_REST_PORT=8080
PROMETHEUS_PORT=9090
EOF
  sed -i "s/^PIN_SHA=.*/PIN_SHA=$sha/" "$ENV"
  chmod 0600 "$ENV"
  if [ ! -f "$KIT_HOME/netbox/secrets.env" ]; then
    ( umask 077
      db=$(openssl rand -hex 24); rd=$(openssl rand -hex 24); key=$(openssl rand -hex 40)
      printf 'DB_PASSWORD=%s\nPOSTGRES_PASSWORD=%s\nREDIS_PASSWORD=%s\nREDIS_CACHE_PASSWORD=%s\nSECRET_KEY=%s\n' \
        "$db" "$db" "$rd" "$rd" "$key" > "$KIT_HOME/netbox/secrets.env" )
    echo "netbox: its internal secrets generated, owner-only (never printed)"
  fi
  cmd_ensure_pepper
  load
  "${COMPOSE[@]}" pull -q
  echo "netbox and prometheus: images pulled"
  ensure_code_repo
  in_wt "$PY" "$HERE/kit_settings.py" init
  echo "kit: initialised at $sha in $KIT_HOME; fill LAB_IF and CONTROLLER_ADDR in $ENV at the lab"
}

ensure_code_repo() {   # lab9's code repository, bare and empty on branch main, once
  # The operator's decision of 2026-11-10: Drafts reach it only through Mercury (SDN › Apps,
  # Add an app as a Draft…), so the kit holds one for lab9 (kit_settings init sets lab9's
  # code_repository to it). Made when absent, never replaced: it holds the Drafts added.
  local repo="$KIT_HOME/code/lab9.git"
  if [ -f "$repo/HEAD" ]; then echo "code repository: $repo kept"; return 0; fi
  install -d -m 0700 "$KIT_HOME/code"
  git init -q --bare -b main "$repo" || die "the code repository $repo could not be made"
  echo "code repository: $repo made (bare, empty, branch main)"
}

cmd_ensure_pepper() {   # NetBox's v2-token pepper, in secrets.env, once; never printed
  # NetBox 4.6 refuses to save a v2 token without API_TOKEN_PEPPERS ("Unable to save v2 tokens:
  # API_TOKEN_PEPPERS is not defined", the operator's first run, 2026-11-05). The image builds
  # it from API_TOKEN_PEPPER_1 (its /etc/netbox/config/configuration.py), as the NMAS host's
  # netbox-docker does. At least 50 characters (NetBox's minimum); 64 hex here. Added when
  # missing, never replaced: a new pepper would invalidate every v2 token already issued.
  local f="$KIT_HOME/netbox/secrets.env"
  [ -f "$f" ] || die "no $f: kit init makes NetBox's secrets first"
  if grep -q '^API_TOKEN_PEPPER_1=' "$f"; then
    local n; n=$(grep '^API_TOKEN_PEPPER_1=' "$f" | head -1 | cut -d= -f2- | tr -d '\n' | wc -c)
    [ "$n" -ge 50 ] || die "API_TOKEN_PEPPER_1 in $f is $n characters, under NetBox's 50"
    echo "netbox: the v2-token pepper is set (id 1, $n characters; not printed)"
  else
    ( umask 077; printf 'API_TOKEN_PEPPER_1=%s\n' "$(openssl rand -hex 32)" >> "$f" )
    chmod 0600 "$f"
    echo "netbox: the v2-token pepper generated (id 1, 64 characters, owner-only; not printed); it takes effect at the next kit start"
  fi
}

cmd_repin() {    # the kit moved to another commit (a fix committed on lab9-live), clean, stopped
  local sha="${1:-}"
  [ -n "$sha" ] || die "usage: kit repin <sha>"
  load
  sha="$(git -C "$REPO" rev-parse --verify "$sha^{commit}")" || die "no commit $1"
  pid_alive && die "Mercury runs: kit stop first"
  [ -z "$(git -C "$WT" status --porcelain -- . ':!.nmas-lab-kit')" ] || die "$WT is not clean"
  git -C "$WT" checkout -q --detach "$sha"
  sed -i "s/^PIN_SHA=.*/PIN_SHA=$sha/" "$ENV"
  echo "kit: repinned at $(git -C "$WT" log -1 --format='%h %s' | cut -c1-90)"
  # Every step after the move is the NEW commit's (C2569): bash has already read this
  # function from the old file, and the operator runs this script from the worktree just
  # moved, so the rest runs from the worktree's script as the new commit has it.
  exec "$WT/lab/sdn-laptop/kit" _after-repin
}

cmd_after_repin() {   # the steps a repin runs after the move, read from the new commit's script
  load
  # The new commit's settings (the operator, 2026-11-05): init adds what is missing and keeps
  # every value already stored; kit.env is never rewritten here, only repin's PIN_SHA.
  ensure_code_repo
  in_wt "$PY" "$HERE/kit_settings.py" init
}

cmd_check() {
  load; nmas_names
  python3 -I "$HERE/kit_check.py" "$DATA"
}

cmd_start() {
  load
  [ -d "$WT" ] || die "no worktree: kit init <sha> first"
  [ -z "$(git -C "$WT" status --porcelain -- . ':!.nmas-lab-kit')" ] || die "$WT is not clean"
  pid_alive && die "Mercury already runs (pid $(cat "$RUN/mercury.pid"))"
  cmd_check || die "refused to start: the settings check failed (above)"
  prom_not_ours
  guard_on
  in_wt "$PY" "$HERE/kit_settings.py" last-exception
  local until; until=$(date -u -d "+$EXCEPTION_HOURS hours" +%Y-%m-%dT%H:%MZ)
  # C2897: `kit start --reveal` opens reveal too, for the S1 sitting only (kit_settings.py
  # refuses it after REVEAL_UNTIL); the stop, run by the expiry timer below, closes it.
  in_wt "$PY" "$HERE/kit_settings.py" exception-on "$until" ${REVEAL:+--reveal} \
    || die "the identity exception was not started (above)"
  echo "$until" > "$RUN/exception-until"
  # The expiry is enforced, not only written: a user timer runs the kit's stop at it.
  systemctl --user stop nmas-sdn-kit-expiry.timer >/dev/null 2>&1 || true
  systemd-run --user --quiet --unit=nmas-sdn-kit-expiry --on-active="${EXCEPTION_HOURS}h" \
    --setenv=KIT_HOME="$KIT_HOME" "$HERE/kit" stop \
    && echo "identity exception: the kit's stop is scheduled at $until (nmas-sdn-kit-expiry.timer)" \
    || die "the expiry timer could not be scheduled, so the exception is not started"
  # NetBox and Prometheus, one Compose project. An image not yet on the laptop (a kit made
  # before the kit ran Prometheus has not pulled it) is pulled here, which needs the Wi-Fi.
  "${COMPOSE[@]}" up -d
  echo "prometheus: started as $PROM on 127.0.0.1:$PROMETHEUS_PORT (it scrapes nothing: prometheus.yml says why)"
  # Mercury runs as a transient user unit: detached from this shell (a backgrounded child kept
  # `kit start` waiting on it, 2026-11-05), stopped by its unit's identity, never a pattern.
  systemd-run --user --quiet --unit="$UNIT" --working-directory="$WT" \
    --setenv=NMAS_DATA_DIR="$DATA" --setenv=NMAS_HOST=127.0.0.1 \
    --setenv=NMAS_PORT="$MERCURY_PORT" --setenv=NMAS_HEADLESS=1 \
    --setenv=PYTHONDONTWRITEBYTECODE=1 \
    --property=StandardOutput="append:$RUN/mercury.log" \
    --property=StandardError="append:$RUN/mercury.log" \
    "$PY" app.py || die "Mercury's unit $UNIT could not be started"
  systemctl --user show "$UNIT" -p MainPID --value > "$RUN/mercury.pid"
  echo "mercury: started as $UNIT, pid $(cat "$RUN/mercury.pid"), log $RUN/mercury.log"
  # Ready within 100 s: about 2.5x the ~40 s the NMAS host's warm-up took (C2465).
  for _ in $(seq 1 100); do
    if curl -s -m 2 "http://127.0.0.1:$MERCURY_PORT/health" | grep -q '"ready": *true'; then
      echo "mercury: ready at http://127.0.0.1:$MERCURY_PORT/v2/"; return 0; fi
    pid_alive || die "Mercury exited: read $RUN/mercury.log"
    sleep 1
  done
  echo "mercury: NOT ready after 100 s: kit preflight says why" >&2; return 1
}

cmd_stop() {
  load
  if [ -d "$WT" ]; then in_wt "$PY" "$HERE/kit_settings.py" exception-off "the kit's stop" || true; fi
  rm -f "$RUN/exception-until"
  systemctl --user stop nmas-sdn-kit-expiry.timer >/dev/null 2>&1 || true
  # By identity, never by pattern: the unit the kit started.
  if pid_alive; then
    systemctl --user stop "$UNIT" && echo "mercury: stopped ($UNIT)"
  fi
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
  rm -f "$RUN/mercury.pid"
  "${COMPOSE[@]}" stop >/dev/null 2>&1 && echo "netbox and prometheus: stopped" || true
  guard_off
}

cmd_status() {
  load
  echo "kit: $KIT_HOME, pinned at ${PIN_SHA:-?} ($(git -C "$WT" log -1 --format=%h 2>/dev/null || echo 'no worktree'))"
  pid_alive && echo "mercury: running, pid $(cat "$RUN/mercury.pid")" || echo "mercury: not running"
  # Every service of the kit's Compose project, stopped ones too (`-a`): NetBox's stack, then
  # Prometheus by its container's name and where it is published, said when it was never made.
  local stack prom
  stack=$("${COMPOSE[@]}" ps -a --format '{{.Service}} {{.State}}' 2>/dev/null || true)
  printf '%s\n' "$stack" | sed -e '/^prometheus /d' -e '/^$/d' -e 's/^/netbox stack: /'
  prom=$(printf '%s\n' "$stack" | sed -n 's/^prometheus //p' | head -1)
  echo "prometheus: ${prom:-not created (kit start makes it)} ($PROM, 127.0.0.1:$PROMETHEUS_PORT)"
  [ -d "$WT" ] && in_wt "$PY" "$HERE/kit_settings.py" last-exception || true
}

cmd_preflight() {
  load
  local fails=0
  bash "$HERE/kit_preflight.sh" || fails=$?
  # NetBox can save a v2 token: its running settings hold a pepper of id 1, at least 50
  # characters. Read in the NetBox container (`manage.py shell -c`), the length printed, never
  # the value; read-only. A v2 token's own creation is the operator's (the sheet, step 3).
  local pep
  pep=$("${COMPOSE[@]}" exec -T netbox /opt/netbox/venv/bin/python /opt/netbox/netbox/manage.py \
        shell -c "from django.conf import settings as s; p = getattr(s, 'API_TOKEN_PEPPERS', {}) or {}; print('pepper', 1 in p, len(p.get(1) or ''))" 2>/dev/null | tail -1)
  case "$pep" in
    "pepper True "*) n=${pep##* }
      if [ "$n" -ge 50 ]; then echo "PASS NetBox can save a v2 token: its pepper (id 1) is set, $n characters"
      else echo "FAIL NetBox can save a v2 token: its pepper (id 1) is $n characters, under 50"; fails=$((fails + 1)); fi ;;
    "pepper False "*) echo "FAIL NetBox can save a v2 token: API_TOKEN_PEPPERS has no id 1 (kit init adds it; kit stop and start apply it)"; fails=$((fails + 1)) ;;
    *) echo "FAIL NetBox can save a v2 token: NetBox's settings could not be read (is NetBox up? kit start)"; fails=$((fails + 1)) ;;
  esac
  if [ -d "$WT" ]; then in_wt "$PY" "$HERE/kit_settings.py" safety || fails=$((fails + $?)); fi
  if cmd_check >/dev/null; then echo "PASS settings check"; else echo "FAIL settings check: kit check names each key"; fails=$((fails + 1)); fi
  echo "kit preflight: $fails FAIL in all"
  return "$fails"
}

cmd_netbox_admin() {
  load
  "${COMPOSE[@]}" exec netbox /opt/netbox/venv/bin/python /opt/netbox/netbox/manage.py createsuperuser
}

cmd_reset() {
  load
  echo "This deletes $DATA (the kit's Mercury data) and the kit's NetBox and Prometheus volumes."
  echo "The main checkout, the NMAS host and the lab are untouched. Type RESET to go on:"
  read -r answer
  [ "$answer" = RESET ] || die "not reset"
  cmd_stop || true
  "${COMPOSE[@]}" down -v
  rm -rf -- "$DATA"
  install -d -m 0700 "$DATA"
  echo "kit: data reset; 'kit init $PIN_SHA' writes the settings and lab9 again"
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  repin) shift; cmd_repin "$@" ;;
  _after-repin) cmd_after_repin ;;
  ensure-pepper) cmd_ensure_pepper ;;
  ensure-code-repo) ensure_code_repo ;;
  prometheus-check) load; prom_not_ours; echo "prometheus: no container named $PROM but the kit's own" ;;
  netbox-writes-on) shift; load; [ $# -gt 0 ] || die 'usage: kit netbox-writes-on "<reason>"'
    in_wt "$PY" "$HERE/kit_settings.py" netbox-writes-on "$@" ;;
  start) REVEAL=""; [ "${2:-}" = "--reveal" ] && REVEAL=1; cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  preflight) cmd_preflight ;;
  check) cmd_check ;;
  netbox-admin) cmd_netbox_admin ;;
  reset) cmd_reset ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
