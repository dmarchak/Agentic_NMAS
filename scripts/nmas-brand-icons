#!/usr/bin/env python3
"""Write the Mercury mark's files from modules/brand.py (NSOT_STAGE7_PLAN section 19).

Every SVG in static/img/brand/ is generated from the master geometry: run this after changing
the mark, then commit both. `--check` writes nothing and exits 1 naming each file that differs
from what the module draws (tests/test_v2_brand.py runs the same comparison). The PNG
home-screen icon is rendered from `mercury-icon-square.svg` by a real browser
(tests/browser.py), since no SVG renderer ships here: `--png` writes it, needing a browser.
"""
import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

FOLDER = os.path.join(ROOT, "static", "img", "brand")


def write_png(svg_path: str, png_path: str, size: int) -> None:
    """Render *svg_path* at *size* px square in a real browser and save its screenshot."""
    import base64

    from tests import browser

    ok, why = browser.available()
    if not ok:
        raise SystemExit(f"no browser to render the PNG: {why}")
    svg = open(svg_path, encoding="utf-8").read().replace(
        "<svg ", f'<svg width="{size}" height="{size}" ', 1)
    with browser.Browser() as b:
        b.go("about:blank")
        b.js("document.body.style.margin = '0';"
             "var d = document.createElement('div'); d.id = 'i';"
             "d.style.width = d.style.height = arguments[1] + 'px'; d.style.lineHeight = '0';"
             "d.innerHTML = arguments[0]; document.body.appendChild(d); return 1", svg, size)
        el = b._call("POST", f"/session/{b.session}/element",
                     {"using": "css selector", "value": "#i"})
        eid = list(el.values())[0]
        png = b._call("GET", f"/session/{b.session}/element/{eid}/screenshot")
    with open(png_path, "wb") as fh:
        fh.write(base64.b64decode(png))


def main() -> int:
    from modules import brand

    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--check", action="store_true", help="compare only; write nothing")
    ap.add_argument("--png", action="store_true", help="also render the 180 px PNG icon")
    args = ap.parse_args()
    os.makedirs(FOLDER, exist_ok=True)
    differ = []
    for name, draw in sorted(brand.FILES.items()):
        path = os.path.join(FOLDER, name)
        text = draw()
        current = open(path, encoding="utf-8").read() if os.path.isfile(path) else None
        if current == text:
            continue
        differ.append(name)
        if not args.check:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(text)
            print(f"wrote static/img/brand/{name}")
    if args.png and not args.check:
        write_png(os.path.join(FOLDER, "mercury-icon-square.svg"),
                  os.path.join(FOLDER, "apple-touch-icon.png"), 180)
        print("wrote static/img/brand/apple-touch-icon.png")
    if args.check and differ:
        print("differs from what modules/brand.py draws: " + ", ".join(differ))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
