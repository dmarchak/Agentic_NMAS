#!/usr/bin/env python3
"""Settle a password an ADOPTION staged for the tool's own account and never
cleared, by asking the device. `adopt.recover_tool_account()` is the
implementation.

Adopt stages the tool account's new password before the push. If the record
fails, or the added account cannot be proven removed, the staged file is the
only copy. `nmas-rotation-recover` cannot settle it: that works from an
inventory row, and a device being adopted has none. The address comes from
the sidecar the adoption wrote beside the staged file:

    accepts the staged password  -> recorded; the staged file cleared; run adopt again
    refuses it                   -> nothing changed; the file kept; check by hand
    could not be asked           -> nothing changed

    nmas-adopt-recover r7 --list Default

Exit codes: 0 settled (recorded, or nothing staged), 1 refused (the file is
kept and a person checks the device), 2 could not be settled (nothing
changed). It prints no credential.
"""

import argparse
import getpass
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("device")
    parser.add_argument("--list", dest="list_name", required=True)
    args = parser.parse_args(argv)

    from modules.nsot import adopt

    out = adopt.recover_tool_account(args.list_name, args.device,
                                     actor=f"{getpass.getuser()} (host shell)")
    print(f"state: {out['state']}")
    print(out.get("reason", ""))
    if out["state"] in (adopt.RECOVERED, adopt.NOTHING_STAGED):
        return 0
    if out["state"] == adopt.STAGED_REFUSED:
        return 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
