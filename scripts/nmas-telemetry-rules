#!/usr/bin/env python3
"""Grafana alert rules for model-driven telemetry: one per device and
subscription, each NAMING ITS DEVICE (NSOT_PLAN P.7, the second generator).

**Why it exists** (the operator, 2026-10-01). After the afternoon's redeploy
the hand-built rule "gRPC telemetry stream lost" fired four times and Needs
attention said "the rule names no device": its expression was
``count by (source) (...)``, which drops the series' own ``device`` label, so
an alert carried only ``source``. And its expected set was "a source seen in
the last day" (C168's repair), so a device gone longer than a day stopped
firing, and a device that never streamed was never expected.

**The population is the committed configuration**: every device of every list
whose COMMITTED golden holds ``telemetry ietf subscription <id>`` gets one rule
per subscription, as the device page decides streaming (never from whether a
series exists now, which would make a stopped stream its own excuse).

**The rule**: ``count(last_over_time({device="<d>", subscription="<id>"}[90s]))``,
NoData = Alerting (a stream that stopped yields no series), labelled
``device``, ``subscription`` and ``severity: warning`` (C2970: a lost stream is
visibility lost while the device answers). 90 s is three scrapes of the ``telemetry_mdt``
job (30 s, read from Prometheus's loaded config 2026-10-01), so one missed
scrape never fires.

    nmas-telemetry-rules            # write the file; the Prometheus datasource's
                                    # UID read from Grafana (one, or Grafana's default)
    nmas-telemetry-rules --check    # 0 current, 1 not, 2 unproven

The file is generated on the host and never committed (it carries the
datasource UID); installing it is the same host step as the heartbeat rules',
and the hand-built rule is then deleted in Grafana by the operator, or both
fire. **An empty population is refused, never written.**
"""

import argparse
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

EXIT_OK, EXIT_STALE, EXIT_UNPROVEN = 0, 1, 2
OUT = os.path.join(ROOT, "deploy", "grafana", "provisioning", "alerting",
                   "nmas-telemetry.yaml")
GROUP = "nmas-telemetry"
FOLDER = "NMAS"
#: Three scrapes of the telemetry_mdt job (30 s, measured 2026-10-01).
WINDOW_SECONDS = 90
SUBSCRIPTION = re.compile(r"^telemetry ietf subscription (\d+)\s*$", re.M)
#: Every lost-stream rule's `severity` label (C2970; the operator, 2026-11-10: "Severity follows
#: impact on service, not 'something broke'… Fix it in the provisioned Grafana alert rule (its
#: severity label), not by overriding it in Mercury's display"). A lost stream is visibility
#: lost while its device still answers, so a warning; Needs attention reads the label
#: (`attention.rule_level`) and escalates only by folding (into the device's not-answering
#: row, or one row about the collector).
SEVERITY = "warning"

#: Where Telegraf reads its configuration (its own defaults), and its prometheus_client
#: output's `expiration_interval` when the key is absent (Telegraf's documented "60s").
TELEGRAF_CONF = ("/etc/telegraf/telegraf.conf", "/etc/telegraf/telegraf.d")
TELEGRAF_DEFAULT_EXPIRATION = 60


def _seconds(text: str):
    m = re.fullmatch(r"\s*(\d+)\s*(ms|s|m|h)?\s*", text or "")
    if not m:
        return None
    n, unit = int(m.group(1)), m.group(2) or "s"
    return {"ms": n // 1000, "s": n, "m": n * 60, "h": n * 3600}[unit]


def exporter_expiration(paths=TELEGRAF_CONF) -> tuple:
    """``(seconds, where)``: how long Telegraf's Prometheus exporter keeps a stopped stream's
    series (C2323: 300 s on the lab's host, so the rule's 90 s window saw a stopped stream about
    6.5 min after it stopped). Read from the first uncommented ``[[outputs.prometheus_client]]``
    section of Telegraf's own files; its default when the section names none; ``(None, why)``
    when no file holds the output, so the rule says it was not read."""
    files = []
    for p in paths:
        if os.path.isdir(p):
            files += sorted(os.path.join(p, f) for f in os.listdir(p) if f.endswith(".conf"))
        elif os.path.isfile(p):
            files.append(p)
    for path in files:
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        section = re.search(r"^\s*\[\[outputs\.prometheus_client\]\]\s*$(.*?)(?=^\s*\[|\Z)",
                            text, re.M | re.S)
        if not section:
            continue
        got = re.search(r'^\s*expiration_interval\s*=\s*"([^"]*)"', section.group(1), re.M)
        if not got:
            return TELEGRAF_DEFAULT_EXPIRATION, f"{path} (Telegraf's default)"
        secs = _seconds(got.group(1))
        if secs is None:
            return None, f"{path}: expiration_interval {got.group(1)!r} is not a duration"
        return secs, path
    return None, "no Telegraf file holds an [[outputs.prometheus_client]] section"
_NAME = re.compile(r"^[A-Za-z][A-Za-z0-9._-]*$")


def subscriptions(golden: str) -> list:
    """The subscription ids a committed configuration declares, in order."""
    return sorted(set(SUBSCRIPTION.findall(golden or "")), key=int)


def expected(population=None, golden=None) -> tuple:
    """``({device: [subscription]}, not_streaming, errors)`` over every list."""
    from modules.prometheus_targets import inventory, read_golden

    population, golden = population or inventory, golden or read_golden
    out, quiet, errors = {}, [], []
    for ref, dev in population():
        host = dev.get("hostname") or ""
        try:
            subs = subscriptions(golden(ref, host))
        except Exception as exc:               # noqa: BLE001
            errors.append(f"{host}: its committed golden could not be read ({exc})")
            continue
        if subs:
            out[host] = subs
        else:
            quiet.append(host)
    return out, sorted(quiet), errors


def detection_words(expiry) -> str:
    """When a stopped stream is seen (C2323): Telegraf's exporter keeps its series *expiry*
    seconds after its last sample, then the rule's window must pass, then one evaluation."""
    if expiry is None:
        return ("How long Telegraf's exporter keeps a stopped stream's series was not read, so "
                "how long after a stream stops this rule fires is not known")
    return (f"Telegraf's exporter keeps a stopped stream's series for {expiry} s "
            f"(expiration_interval), so a stopped stream is seen about {expiry + WINDOW_SECONDS} s "
            f"after it stops ({expiry} s, then this rule's {WINDOW_SECONDS} s), within one "
            "evaluation (1 min)")


def rule_for(host: str, sub: str, datasource_uid: str, expiry=None) -> dict:
    if not _NAME.match(host):
        raise ValueError(f"{host!r} is not a usable device name")
    expr = (f'count(last_over_time({{device="{host}", subscription="{sub}"}}'
            f"[{WINDOW_SECONDS}s]))")
    return {
        "uid": (f"nmas-tel-{re.sub(r'[^A-Za-z0-9_-]', '-', host)}-{sub}")[:40],
        "title": f"NMAS telemetry stream lost: {host} subscription {sub}",
        "condition": "C",
        "data": [
            {"refId": "A", "datasourceUid": datasource_uid,
             "relativeTimeRange": {"from": WINDOW_SECONDS, "to": 0},
             "model": {"refId": "A", "expr": expr, "instant": True, "range": False}},
            {"refId": "B", "datasourceUid": "__expr__",
             "model": {"refId": "B", "type": "reduce", "expression": "A", "reducer": "last"}},
            {"refId": "C", "datasourceUid": "__expr__",
             "model": {"refId": "C", "type": "threshold", "expression": "B",
                       "conditions": [{"evaluator": {"type": "lt", "params": [1]}}]}},
        ],
        # A stream that stopped yields NO series: that is the failure.
        "noDataState": "Alerting",
        "execErrState": "Alerting",
        "for": "0s",
        # The real detection time (C2323), read from Telegraf's own configuration, for Needs
        # attention's words (`grafana_alerts.absence_words`); absent when it was not read.
        "labels": {"nmas": "telemetry", "device": host, "subscription": sub,
                   "severity": SEVERITY,
                   **({"detect_seconds": str(expiry + WINDOW_SECONDS)}
                      if expiry is not None else {})},
        "annotations": {
            "summary": f"{host} has stopped streaming telemetry subscription {sub}",
            "description": (
                f"{host}'s committed configuration declares `telemetry ietf subscription {sub}`, "
                f"and Prometheus holds no sample of it in the last {WINDOW_SECONDS} s (three "
                "scrapes of telemetry_mdt). " + detection_words(expiry) + ". The device, its "
                "subscription, the gRPC path to Telegraf, Telegraf or the scrape has stopped; "
                "the rule cannot say which."),
        },
    }


def build(subs_by_host: dict, datasource_uid: str, expiry=None) -> dict:
    if not subs_by_host:
        raise ValueError("the population is empty -- a rule file with no rules alerts on "
                         "nothing and reads like every stream is up")
    if not datasource_uid:
        raise ValueError("no Prometheus datasource UID")
    return {"apiVersion": 1, "groups": [{
        "orgId": 1, "name": GROUP, "folder": FOLDER, "interval": "1m",
        "rules": [rule_for(h, s, datasource_uid, expiry)
                  for h in sorted(subs_by_host) for s in subs_by_host[h]]}]}


def render(doc: dict) -> str:
    import yaml
    head = ("# GENERATED by scripts/nmas-telemetry-rules: one rule per device and "
            "subscription,\n# from each device's committed configuration. Do not edit; "
            "regenerate.\n")
    return head + yaml.safe_dump(doc, sort_keys=False, width=100)


def installed(doc: dict) -> set:
    """``{(device, subscription)}`` a rules document covers."""
    return {(r.get("labels", {}).get("device"), r.get("labels", {}).get("subscription"))
            for g in (doc or {}).get("groups", []) for r in g.get("rules", [])}


def check(have: set, want: dict) -> tuple:
    """(exit code, lines). Every (device, subscription) in one named state."""
    pairs = {(h, s) for h, subs in want.items() for s in subs}
    lines, code = [], EXIT_OK
    for h, s in sorted(have | pairs):
        if (h, s) not in have:
            lines.append(f"MISSING    {h} subscription {s}: configured to stream, no rule")
            code = EXIT_STALE
        elif (h, s) not in pairs:
            lines.append(f"EXTRA      {h} subscription {s}: a rule for a stream no committed "
                         "configuration declares")
            code = EXIT_STALE
        else:
            lines.append(f"current    {h} subscription {s}")
    return code, lines


def grafana_datasource(client=None) -> tuple:
    """``(uid, said)``: the Prometheus datasource the rules query, read from
    Grafana's own front-end settings (the operator, 2026-10-01: the host step
    asked for `--datasource-uid <...>`, a value the person had to go and
    find). Grafana's default when it is a Prometheus source, else the only
    one; several and none the default is a refusal naming them, never a
    guess. Raises ValueError with what was found."""
    from modules.integrations.grafana import GrafanaIntegration
    from modules.readers.grafana_dashboards import FRONTEND, datasources

    g = client or GrafanaIntegration()
    if not g.is_configured():
        raise ValueError("Grafana is not configured (grafana_url), so the datasource "
                         "cannot be read: pass --datasource-uid")
    got = g._get(FRONTEND)                          # noqa: SLF001 - the client's API
    if not got.get("ok"):
        raise ValueError(f"Grafana's {FRONTEND} could not be read: {got.get('error')}")
    proms = [d for d in datasources(got["response"].json()) if d.get("type") == "prometheus"]
    pick = next((d for d in proms if d.get("is_default")), None) or (
        proms[0] if len(proms) == 1 else None)
    if pick is None:
        raise ValueError("Grafana holds " + (
            "no Prometheus datasource" if not proms else
            f"{len(proms)} Prometheus datasources and none is the default ("
            + ", ".join(f"{d['name']} {d['uid']}" for d in proms) + ")")
            + ": pass --datasource-uid")
    return pick["uid"], f"datasource {pick['name']} ({pick['uid']}), read from Grafana"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--datasource-uid", default=os.environ.get("NMAS_GRAFANA_PROM_UID", ""))
    ap.add_argument("--check", action="store_true",
                    help="compare the generated rules file (--out) with the population")
    ap.add_argument("--out", default=OUT)
    args = ap.parse_args(argv)
    try:
        want, quiet, errors = expected()
    except Exception as exc:                   # noqa: BLE001
        print(f"UNPROVEN: {type(exc).__name__}: {exc}")
        return EXIT_UNPROVEN
    if errors:
        # A population with a device left out is a guess about it.
        print("UNPROVEN: " + "; ".join(errors))
        return EXIT_UNPROVEN
    if args.check:
        import yaml
        try:
            with open(args.out, encoding="utf-8") as fh:
                have = installed(yaml.safe_load(fh))
        except FileNotFoundError:
            print(f"STALE: {args.out} does not exist")
            return EXIT_STALE
        code, lines = check(have, want)
        bad = [l for l in lines if not l.startswith("current")]
        print(f"FAILED: {len(bad)} of {len(lines)} stream(s) need attention" if bad else
              f"telemetry rules current for {len(lines)} stream(s)")
        print("\n".join(lines))
        return code
    try:
        uid = args.datasource_uid
        if not uid:
            uid, said = grafana_datasource()
            print(said)
        expiry, where = exporter_expiration()
        print(f"Telegraf's exporter keeps a stopped stream {expiry} s ({where})"
              if expiry is not None else f"Telegraf's exporter expiration not read: {where}")
        doc = build(want, uid, expiry)
    except ValueError as exc:
        print(f"UNPROVEN: {exc}")
        return EXIT_UNPROVEN
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    with open(args.out, "w", encoding="utf-8") as fh:
        fh.write(render(doc))
    for h in sorted(want):
        print(f"  {h:<6} subscription(s) {', '.join(want[h])}")
    for h in quiet:
        print(f"  not streaming: {h} -- its committed configuration declares no subscription")
    print(f"wrote {sum(len(s) for s in want.values())} rule(s) to {args.out}")
    # The rules it no longer generates, for Grafana to delete (C1419): a retired device's
    # streams, which Grafana kept running after its file dropped them.
    from modules import grafana_rule_deletes as GD
    for line in GD.write_beside(doc, "nmas-tel-", args.out, "telemetry"):
        print(line)
    print(hand_built_words())
    return EXIT_OK


#: The hand-built rule these generated rules replace (C304): while it exists, both fire.
HAND_BUILT = "gRPC telemetry stream lost"


def hand_built_words(cached=None) -> str:
    """Whether the hand-built rule is still in Grafana, from the grafana-alerts reader's stored
    rule definitions (no Grafana call here): its uid and folder and the instruction to delete
    it when it is there; that nothing is to be deleted when the store read every rule and it is
    not among them; and that it is not known when the store is unreadable or partial (the
    operator, 2026-11-03: the reminder printed whether or not the rule existed)."""
    from modules import reader_job
    got = reader_job.read_cached("grafana-alerts") if cached is None else cached
    value = ((got.get("doc") or {}).get("last_good") or {}).get("value") or {}
    defs = value.get("rule_definitions")
    if got.get("state") != "ok" or not isinstance(defs, dict):
        why = got.get("why") or "it holds no rule definitions"
        return (f"Whether the hand-built rule \"{HAND_BUILT}\" is still in Grafana is not known: "
                f"the grafana-alerts reader's store is not readable ({why}). Check Grafana: if "
                "it is there, delete it, or both fire.")
    found = [d for d in defs.values() if (d or {}).get("title") == HAND_BUILT]
    if found:
        return "; ".join(f"Then delete the hand-built rule \"{HAND_BUILT}\" in Grafana (uid "
                         f"{d.get('uid')}, folder {d.get('folder')}), or both fire" for d in found)
    if not value.get("rule_definitions_complete"):
        return (f"The hand-built rule \"{HAND_BUILT}\" is not among the {len(defs)} rule(s) the "
                "reader stored, but its read of Grafana's rules was partial ("
                f"{value.get('rule_definitions_why') or 'no reason recorded'}): check Grafana.")
    at = ((got.get("doc") or {}).get("last_good") or {}).get("value_at")
    return (f"The hand-built rule \"{HAND_BUILT}\" is not in Grafana (the reader's "
            f"{len(defs)} rule(s), read whole at {at}): nothing to delete.")


if __name__ == "__main__":
    raise SystemExit(main())
