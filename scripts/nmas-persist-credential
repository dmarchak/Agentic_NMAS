#!/usr/bin/env python3
"""Finish the persistence chain for an ALREADY-ROTATED device.

This is the recovery path for ``rotated_persistence_unverified``: the device
has been rotated, verified and committed, and only the boot-time copy is
behind. Everything here is downstream of the device.

**It never rotates and never touches the device.** There is no session, no
config push and no generation — the credential it publishes is read from this
list's ``devices.csv``, which is the value the rotation's verify proved. A
guard refuses to run at all unless that stored credential still authenticates,
because publishing a credential the device does not accept is how r2 spent an
hour looking like a password problem.

    python3 scripts/nmas-persist-credential r2 [--list Default] [--dry-run]
    python3 scripts/nmas-persist-credential --device r2        # same thing

Stages, in order, each one gating the next:

    oxidized_row     one row of router.db, via the root-owned helper
    oxidized_reload  make Oxidized RE-READ it — writing the file is not enough
    fetch_confirmed  a SUCCESSFUL fetch timestamped after the reload
    clab_sync        harvest into the startup files
    startup_file     the new $9$ hash is in the file that BOOTS the node
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    # Both forms. The sibling script takes --device, and a person who has
    # just run that one should not have to discover that this one differs;
    # a positional also works because it reads naturally.
    ap.add_argument("device", nargs="?", default="")
    ap.add_argument("--device", dest="device_flag", default="")
    ap.add_argument("--list", dest="list_name", default="")
    ap.add_argument("--dry-run", action="store_true",
                    help="check the preconditions and stop")
    args = ap.parse_args()
    device = args.device_flag or args.device
    if not device:
        ap.error("give a device: `nmas-persist-credential r2` or --device r2")

    from modules.config import get_current_list_name, get_list_data_dir
    from modules.device import decrypt_field, load_saved_devices
    from modules.nsot import credential_rotation as cr
    from modules.nsot import hostvars
    from modules.credentials import template_secret_key

    host = device
    list_name = args.list_name or get_current_list_name()
    repo = os.path.join(get_list_data_dir(list_name), "config_repo")

    row = next((d for d in load_saved_devices(cr._csv_path_for(list_name))
                if d.get("hostname") == host), None)
    if row is None:
        print(f"REFUSED: {host} is not in list '{list_name}'")
        return 1
    password = decrypt_field(row.get("password", ""))
    ip = row.get("ip", "")

    print(f"device    : {host}  {ip}   list: {list_name}")
    print(f"credential: from devices.csv (this list) — never regenerated")

    # --- the hash the intent records; what must appear in the boot file ---
    committed = hostvars.read_committed(repo, host) or {}
    ref = next((u.get("secret_ref") for u in (committed.get("users") or [])
                if u.get("name") == row.get("username")), "")
    new_hash = ""
    if ref:
        from modules.credentials import get_template_secret
        new_hash = get_template_secret(template_secret_key(list_name, host, ref)) or ""
    if not new_hash:
        print("REFUSED: no committed type-9 secret for this device — this "
              "script finishes a rotation, it does not start one.")
        return 1
    print(f"hash      : {new_hash.split()[0]} $9$… (from committed intent)")

    # --- the guard: does the device still accept what we are publishing? --
    check = cr.verify_new_credential(row, row.get("username", "admin"),
                                     password, secret=cr.enable_secret(row))
    print(f"precheck  : stored credential authenticates = {check['ok']}"
          f"{'' if check['ok'] else '  ' + str(check.get('error_type'))}")
    if not check["ok"]:
        print("REFUSED: the credential in devices.csv does not authenticate. "
              "Publishing it would strand the device further. Nothing done.")
        return 1

    if args.dry_run:
        print("\n--dry-run: preconditions pass. Nothing written.")
        return 0

    # Aware UTC. confirm_fetch() compares this against Oxidized's timestamps
    # to decide "after this run", and a naive value there is either a
    # TypeError or a silent comparison between two different clocks.
    started = cr.utc_now()
    result = {"device": host, "state": cr.ROTATED_PENDING_PERSIST, "steps": []}
    result = cr.persist(result, mgmt_ip=ip, username=row.get("username", "admin"),
                        password=password, hostname=host, new_hash=new_hash,
                        after_iso=started)

    print()
    for stage in result.get("persistence", []):
        detail = (stage.get("error")
                  or ("already current, nothing written"
                      if stage.get("already_current") else "")
                  or stage.get("end") or stage.get("mechanism")
                  or stage.get("matches", ""))
        print(f"  [{'ok' if stage.get('ok') else 'XX'}] {stage['name']:<16} {detail}")
    print(f"\nstate: {result['state']}")
    print(cr.summarise(result))
    return 0 if result["state"] == cr.ROTATED_PERSISTED else 1


if __name__ == "__main__":
    raise SystemExit(main())
