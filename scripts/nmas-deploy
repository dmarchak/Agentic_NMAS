#!/usr/bin/env python3
"""Fast-forward the deployment host to origin/main, ONLY if CI passed for it.

NSOT_PLAN P.4 step 4 (docs/NSOT_CI.md). It replaces the 25-line
~/bin/nmas-deploy that pulled and restarted with no gate. Install it as a
SYMLINK to this file, so there is one copy (CLAUDE.md, C14):

    ln -sf ~/python/Agentic_NMAS/scripts/nmas-deploy ~/bin/nmas-deploy

    nmas-deploy              # gate on the GitHub Actions result for the target
    nmas-deploy --offline    # no GitHub: run the whole suite HERE, on this
                             # machine's packages, against the target first
    nmas-deploy --to SHA     # EXACTLY that commit, while it is on origin/main
                             # (C436: an older commit CI passed, while the
                             # tip's CI still runs)

The gate is decided on the TARGET commit (origin/main after a fetch, or the
--to commit), before HEAD moves. HEAD never reaches a commit that has not
passed, and moves to exactly the target, never past it.

Exit codes. Each means one thing; none is "probably fine":
  0  deployed (or already at the target) AND confirmed running: /health
     reports the target commit from a process started after the restart
  1  CI FAILED for the target: its LATEST CONCLUSIVE run did not pass.
     Do not deploy it
  7  CI is PENDING for the target: a run is still queued or in progress,
     whatever an earlier run concluded. Wait, then run again; or run with
     --wait, which follows the run and deploys when it passes (bounded:
     still pending after WAIT_BOUND_S is exit 7, saying so)
  8  every CI run for the target was CANCELLED (superseded by a newer push,
     or stopped): no verdict exists. Deploy the newer commit, or re-run CI
  2  COULD NOT ASK: GitHub unreachable, timed out, rate-limited, answered an
     error, or has NO run for the target. Refused. There is no flag that
     deploys an unverified commit; --offline verifies it here instead.
  3  --offline: the suite failed on this machine against the target: refused
  4  refused by local state: edits in the checkout, root-owned files in .git,
     the target is not a fast-forward, or the --to commit is not on origin/main
  5  moved (or already there), but NOT confirmed running: the restart failed,
     or /health never reported the target from a freshly started process. The
     verdict's FIRST line names a mixed version when the service still runs
     another commit, with the command to run
  6  cannot restart from here (sudo needs a password, and there is no
     terminal to type it in): refused BEFORE the checkout moved, so no mixed
     version exists. Run it in a terminal on the host
  9  the Update button's updater is moving the checkout now (C242: both take
     data/update/lock): refused, nothing moved. Run it again when it ends
 10  an operation holds a device (CONCURRENCY_AUDIT R5): the restart would end
     it half-applied, with no receipt, no golden and no rollback. Refused
     before the checkout moved, naming each one. Run it again when it ends.
     Also refused when the service ANSWERS that it cannot read the device
     holds (/health/operations' 500 carrying holds "unreadable", C991): a
     device may be held, so it is treated as held, naming the reason. When
     the service cannot say (not answering, a version that predates
     /health/operations, or any other error, whose reason is printed), the
     deploy continues and says so: a deploy is how a service that cannot
     answer is repaired
 11  FAILED, NOT READY (C2514): moved, restarted and confirmed running the
     target, but /health did not say `ready` within READY_BOUND_S, or a
     warm-up step failed. The verdict names the step and its error, or the
     step still warming at the bound; the release is NOT rolled back (the
     operator, 2026-11-05: "no automatic rollback"), and Needs attention
     raises a critical row whose action is the rollback. A running version
     whose /health has no `ready` key (from before C2465) is said and not
     waited for: that deploy ends 0 as before

"No run found" is exit 2, never a pass. That is the fail-open shape of the
old Jenkins ci_gate, which was skipped silently whenever it could not ask
(NSOT_CI.md section 0), refused here by construction. The one legitimate
no-run case is a push that changed only paths the workflow ignores. It passes
only when every file changed since the last commit CI passed matches the
workflow's own `paths-ignore`, read from .github/workflows/ci.yml rather than
copied, so the two cannot disagree.

TWO VERDICTS, either one green (docs/LOCAL_CI.md, workstream 0). The local CI
runner on this host (scripts/nmas-local-ci, a root-owned service) records a
verdict per commit in a root-owned store; GitHub Actions runs on every push.
A green verdict from EITHER deploys, and the sentence says which ("LOCAL CI
passed ..." or "CI passed ..."); a red from EITHER refuses, naming it, since
two runners of one workflow that disagree are a finding, never a coin toss.
A local green does not wait for GitHub: GitHub's own run for the target is
asked once, and only a FAILED answer changes the outcome.

Every run appends one row to data/deploy_audit.jsonl (0600): who, from, to,
how the target was verified, the verdict and the exit code.
"""

import argparse
import getpass
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

DEFAULT_REPO = os.path.expanduser("~/python/Agentic_NMAS")
SERVICE = "flask-app.service"
#: Every OTHER long-running unit that runs the checkout's code (C1404, 0d run 2: the ZTP
#: responder ran the code it started with, 21 hours and a deployed change behind, and refused
#: a relayed device the new code would serve). Each is restarted after SERVICE is confirmed,
#: by this and by the Update button's updater (`restart_checkout_units`). Held equal to the
#: unit templates (every non-oneshot `deploy/systemd/*.service` whose ExecStart runs the
#: checkout) by tests/test_checkout_units_restart.py.
CHECKOUT_UNITS = ("nmas-ztp-responder.service",)
#: Each unit's new process, waited for: the responder starts in about a second (a Python
#: process binding one socket); 30 s is the bound, generous for a loaded host.
CHECKOUT_UNIT_BOUND_S = 30
USER_AGENT = "nmas-automation/1.0"      # honest; Cloudflare-style checks reject urllib's default
WORKFLOW_PATH = ".github/workflows/ci.yml"

OK, CI_REFUSED, COULD_NOT_ASK, OFFLINE_FAILED, LOCAL_REFUSED, UNHEALTHY = 0, 1, 2, 3, 4, 5
CANNOT_RESTART = 6
#: The file the laptop kit writes in its worktree's root (lab/sdn-laptop/kit): a checkout
#: holding it is a separate installation, and nmas-deploy refuses to run from it.
LAB_KIT_MARKER = ".nmas-lab-kit"
CI_PENDING, CI_CANCELLED = 7, 8
LOCKED = 9
BUSY = 10
#: Its own code, not UNHEALTHY's 5 (C2514): 5 means the target is NOT confirmed running and its
#: remedy is a restart; here the target IS running, and its remedy is a wait or a rollback.
NOT_READY = 11

#: How long the running target has to say `ready` in /health (C2465's warm-up) once it is
#: confirmed running: the host's first pages after a restart waited about 40 s on 2026-11-04
#: (the first AI chip 36.6 s, the first Needs attention count 37.3 s, a first /v2/ 40.8 s), and
#: 100 s is about 2.5x that. Past it, or on a failed warm-up step, the deploy is FAILED (exit
#: NOT_READY) and never rolled back by itself.
READY_BOUND_S = 100

#: The ONE lock this and the Update button's updater both take (C242): whoever
#: holds it moves the checkout, and the other refuses by name.
LOCK_REL = os.path.join("data", "update", "lock")

#: --wait (the operator, 2026-09-28): 35 "still running" refusals across 19
#: waits in 28 hours, a retry loop where the waiting itself was ~33 minutes.
#: The bound comes from a measurement, not a round number (C129): push to
#: green measured median 201 s, p90 259 s over 85 runs (2026-09-27/28), and
#: 600 s was about 2.5x that p90. Measured again 2026-10-11 (C679, `nmas-ci-log
#: times` over runs #629 to #638): each job 4.0 to 7.3 minutes, the slowest job
#: the run's length, a deploy started at the push waiting about 7.5 minutes
#: (454 s for #638), so the bound is 1100 s, about 2.5x that. The poll is paced to GitHub's API allowance, 60 calls an hour
#: unauthenticated for the host's address (C678, measured 2026-10-11: three deploys inside
#: an hour at a 20 s poll, about 18 calls each with the Update page's checks, spent all 60,
#: and the third deploy was refused as unverified). One call a poll; at 45 s a run of about
#: 6 minutes costs about 8, so about 7 deploys fit an hour.
WAIT_BOUND_S = 1100
WAIT_POLL_S = 45
MEASURED_TYPICAL = "typically ~7.5 min, each job 4 to 7.3 min (measured 2026-10-11)"


def can_restart(run=subprocess.run, isatty=None):
    """``(ok, reason)``: can this run restart the service? Asked BEFORE the
    checkout moves (the operator, 2026-09-27): "I can't finish this, so I
    won't start it". Run over SSH with no terminal, the first version moved
    the checkout and then failed at sudo's password prompt, leaving the
    service on the old commit against the new checkout: a mixed version.

    A cached or passwordless sudo passes as it is. With a terminal, `sudo -v`
    asks for the password NOW, before anything moves. With neither, refused.
    A passwordless rule was declined on purpose: CI gates what deploys, a
    person gates when."""
    isatty = sys.stdin.isatty if isatty is None else isatty
    if run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return True, "sudo already authorised"
    if not isatty():
        return False, ("sudo needs a password and there is no terminal to type it in "
                       "(run over SSH without one)")
    if run(["sudo", "-v"]).returncode == 0:
        return True, "sudo authorised"
    return False, "sudo was not authorised"


def git(repo, *args, check=True):
    out = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if check and out.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {out.stderr.strip()}")
    return out.stdout.strip()


# ---------------------------------------------------------------------------
# Mercury's virtualenv (Phase 4 section 8.4, signed off by the operator 2026-10-09): a release
# whose venv identity differs from the running venv's moves the link in the SAME restart, and a
# rollback puts the link back with the commit. A release whose venv is not built and proved is
# refused before anything moves. Before the first switch there is no link, and nothing is
# compared. Root's updater loads this file and runs these with its own programs, as root.
# ---------------------------------------------------------------------------

#: The link every unit's drop-in names, what a rollback points back to, the venvs' prefix, and
#: the mark a build writes last, only when every check passed (section 8.3).
VENV_LINK = "/opt/mercury-venv"
VENV_PREVIOUS = "/opt/mercury-venv.previous"
VENV_PREFIX = "/opt/mercury-venv-"
VENV_PROVED = ".mercury-proved"
#: What a venv is built from, in order: modules.app_interpreter.VENV_INPUTS. Computed here,
#: from git, because root's updater loads this file and never imports the user-writable
#: checkout; tests/test_nmas_deploy.py holds the two computations equal.
VENV_INPUTS = ("requirements.lock", "requirements-test.txt")
#: The programs a terminal deploy uses (its sudo, authorised before anything moves). The
#: updater, root already, passes its own absolute paths and no sudo.
VENV_BINS = {"sudo": ("sudo",), "ln": "ln", "mv": "mv", "rm": "rm", "grep": "grep"}


def venv_id_from(read):
    """The venv identity of a release: the first 12 hex of the sha256 of VENV_INPUTS' bytes, in
    order. *read(name)* returns a file's EXACT bytes at that release (a text read that strips a
    trailing newline names another venv)."""
    import hashlib

    digest = hashlib.sha256()
    for name in VENV_INPUTS:
        digest.update(read(name))
    return digest.hexdigest()[:12]


def git_show_bytes(repo, sha):
    """A `read` for venv_id_from: `git show <sha>:<name>`, its bytes untouched."""
    def read(name):
        return subprocess.run(["git", "-C", repo, "show", f"{sha}:{name}"], capture_output=True,
                              check=True).stdout
    return read


def venv_plan(target_id, link=None, prefix=None):
    """What the deploy does with the venv: ``{"state", "from", "to"}``. *state* is "none" (no
    link: before the first switch, and the release's files are not read), "same", "swap" (the
    target's venv is built and proved) or "unbuilt" (refused before anything moves).
    *target_id* is the identity, or a callable computing it."""
    link = link or VENV_LINK
    prefix = prefix or VENV_PREFIX
    if not os.path.islink(link):
        return {"state": "none", "from": None, "to": None}
    target_id = target_id() if callable(target_id) else target_id
    current = os.path.realpath(link)
    cur_id = current[len(prefix):] if current.startswith(prefix) else os.path.basename(current)
    if cur_id == target_id:
        return {"state": "same", "from": cur_id, "to": target_id}
    try:
        with open(os.path.join(prefix + target_id, VENV_PROVED), encoding="utf-8") as fh:
            proved = fh.readline().strip() == f"id {target_id}"
    except OSError:
        proved = False
    return {"state": "swap" if proved else "unbuilt", "from": cur_id, "to": target_id}


def venv_refusal(plan, target, repo):
    """The refusal for an unbuilt venv: both identities and the step that builds it."""
    return (f"this release ({target[:10]}) needs the venv {plan['to']} (its requirements.lock "
            f"or requirements-test.txt differ from the running venv {plan['from']}), and "
            f"{VENV_PREFIX}{plan['to']} is not built and proved. Build it from a clone of the "
            f"release, never the live checkout: d=$(mktemp -d) && git clone -q --shared {repo} "
            f"\"$d/release\" && git -C \"$d/release\" checkout -q {target[:12]} && bash "
            "\"$d/release/scripts/host-steps/venv-1-build.sh\"")


def point_link(link, venv_id, run=subprocess.run, bins=None):
    """Point *link* at mercury-venv-<venv_id>, relative, by a rename so it is never half there
    (measured 2026-10-09: through the link the venv reports the link)."""
    bins = bins or VENV_BINS
    tmp = link + ".new"
    run([*bins["sudo"], bins["ln"], "-sfn", f"mercury-venv-{venv_id}", tmp], check=True,
        capture_output=True)
    run([*bins["sudo"], bins["mv"], "-T", tmp, link], check=True, capture_output=True)


def swap_venv(plan, run=subprocess.run, bins=None, link=None, previous=None):
    """Record the running venv as the previous one, then point the link at the target's."""
    point_link(previous or VENV_PREVIOUS, plan["from"], run, bins)
    point_link(link or VENV_LINK, plan["to"], run, bins)


def unswap_venv(plan, run=subprocess.run, bins=None, link=None):
    """Point the link back at the venv the rolled-back commit ran."""
    point_link(link or VENV_LINK, plan["from"], run, bins)


def prune_venvs(keep, run=subprocess.run, bins=None, prefix=None, maps=None):
    """Remove PROVED venvs other than *keep* (the current and the previous, the operator's
    decision) that no running process has loaded. An unproved one may be a build in progress
    and is left. Returns (removed, kept_because_loaded)."""
    import glob

    bins = bins or VENV_BINS
    prefix = prefix or VENV_PREFIX
    maps = glob.glob("/proc/[0-9]*/maps") if maps is None else maps
    removed, held = [], []
    for d in sorted(glob.glob(prefix + "*")):
        vid = d[len(prefix):]
        if not re.fullmatch(r"[0-9a-f]{12}", vid) or vid in keep:
            continue
        if not os.path.isfile(os.path.join(d, VENV_PROVED)):
            continue
        if maps and run([*bins["sudo"], bins["grep"], "-qs", "--", d + "/", *maps],
                        capture_output=True).returncode == 0:
            held.append(d)
            continue
        run([*bins["sudo"], bins["rm"], "-rf", "--", d], check=True, capture_output=True)
        removed.append(d)
    return removed, held


# ---------------------------------------------------------------------------
# Where the repository lives on GitHub
# ---------------------------------------------------------------------------

def slug_of(remote_url):
    """`github-nmas:<account>/Agentic_NMAS.git`, `git@github.com:o/r.git` or
    `https://github.com/o/r` -> `o/r`."""
    m = re.search(r"[:/]([^/:]+)/([^/]+?)(?:\.git)?/?$", remote_url.strip())
    if not m:
        raise ValueError(f"cannot read an owner/repo from the origin URL {remote_url!r}")
    return f"{m.group(1)}/{m.group(2)}"


def github_get(path, timeout=10):
    """(status, json or None, reason). Never raises."""
    req = urllib.request.Request(f"https://api.github.com{path}",
                                 headers={"User-Agent": USER_AGENT,
                                          "Accept": "application/vnd.github+json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode()), ""
    except urllib.error.HTTPError as exc:
        remaining = exc.headers.get("X-RateLimit-Remaining") if exc.headers else None
        reason = "rate-limited" if remaining == "0" or exc.code == 429 else f"HTTP {exc.code}"
        if reason == "rate-limited":
            reason += _allowance_words(exc.headers)
        return exc.code, None, reason
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
        return 0, None, f"{type(exc).__name__}: {getattr(exc, 'reason', exc)}"


def _allowance_words(headers) -> str:
    """When GitHub's allowance for this address comes back, from its own headers (C678)."""
    try:
        limit = headers.get("X-RateLimit-Limit") or "?"
        reset = int(headers.get("X-RateLimit-Reset") or 0)
    except (TypeError, ValueError, AttributeError):
        return ""
    if not reset:
        return ""
    return (f": GitHub allows this address {limit} calls an hour unauthenticated, all spent; "
            f"the allowance resets at {time.strftime('%H:%M:%S UTC', time.gmtime(reset))}, "
            "deploy again after it")


# ---------------------------------------------------------------------------
# The workflow's own ignored paths
# ---------------------------------------------------------------------------

#: Never ignorable, whatever any paths-ignore says: a change to the CI itself
#: must be verified by a run, or a commit could switch the check off and be
#: waved through by its own switch.
NEVER_IGNORABLE = (".github/workflows/",)


def ignored_patterns(repo, sha):
    """`paths-ignore` of the push trigger, read from ci.yml AT *sha*.

    The caller passes the last GREEN ancestor, never the target (the
    operator's finding, 2026-09-26): read at the target, a commit that widened
    paths-ignore to '**' would produce no run, and the gate would call that
    expected. The rule that decides whether a run was needed must come from a
    commit CI has already passed."""
    import yaml
    doc = yaml.safe_load(git(repo, "show", f"{sha}:{WORKFLOW_PATH}"))
    triggers = doc.get(True) or doc.get("on") or {}     # YAML 1.1 reads `on` as True
    return list((triggers.get("push") or {}).get("paths-ignore") or [])


def _glob_regex(pattern):
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out += "(?:.*/)?"; i += 3
        elif pattern.startswith("**", i):
            out += ".*"; i += 2
        elif pattern[i] == "*":
            out += "[^/]*"; i += 1
        else:
            out += re.escape(pattern[i]); i += 1
    return re.compile(out + r"\Z")


def only_ignored(paths, patterns):
    rxs = [_glob_regex(p) for p in patterns]
    return bool(paths) and all(
        not p.startswith(NEVER_IGNORABLE) and any(rx.match(p) for rx in rxs)
        for p in paths)


# ---------------------------------------------------------------------------
# The gate
# ---------------------------------------------------------------------------

#: How many ancestors a commit with no run may be judged back through. The
#: walk asks GitHub about each by SHA and stops at the first that HAS runs.
#: Measured 2026-09-28: the longest streak of consecutive commits with no run
#: on main is 4 (204 commits since the first run), so 10 is 2.5x that; past
#: it the gate refuses, naming every commit it asked about.
WALK_BOUND = 10

#: Conclusions that are an ABANDONED attempt, not a verdict (C124).
ABANDONED = ("cancelled", "skipped")


def _run_order(run):
    """Run number, then attempt, then id: never `created_at`, which has one
    second of resolution. Two runs for one SHA created in the same second
    (d7efb9d's #92 and #93) tied, and `max` took the first in the API's
    list, the cancelled one, every time (C124)."""
    return (run.get("run_number") or 0, run.get("run_attempt") or 0, run.get("id") or 0)


def verdict_of_runs(runs):
    """``(state, run, others)`` for a SHA's SET of runs (C124): the question
    is "what is the verdict for this SHA", not "is there a run".

    * any run not completed: PENDING, whatever an earlier run concluded;
    * cancelled and skipped runs are abandoned attempts, never verdicts;
    * otherwise the LATEST CONCLUSIVE run wins, so a re-run that FAILED
      after an earlier pass refuses (the dangerous direction);
    * no conclusive run at all: CANCELLED.
    """
    live = [r for r in runs if r.get("status") != "completed"]
    if live:
        return "PENDING", max(live, key=_run_order), runs
    conclusive = [r for r in runs if r.get("conclusion") not in ABANDONED + (None, "")]
    if not conclusive:
        return "CANCELLED", max(runs, key=_run_order), runs
    latest = max(conclusive, key=_run_order)
    return ("PASSED" if latest.get("conclusion") == "success" else "FAILED"), latest, runs


def _others(runs, chosen):
    rest = [r for r in runs if r is not chosen]
    if not rest:
        return ""
    words = ", ".join(f"#{r.get('run_number', '?')} {r.get('conclusion') or r.get('status')}"
                      for r in sorted(rest, key=_run_order))
    return f" (other runs for this commit: {words})"


#: How many of the checkout's most recent positions (its reflog) a rollback's tree twin is
#: looked for among: far more deploys than a rollback goes back.
TWIN_BOUND = 50


def deployed_shas(repo) -> list:
    """The commits this checkout has been at, newest first, at most TWIN_BOUND: its reflog.
    Every deploy moves HEAD by fast-forward, so each is a commit this host ran."""
    out = git(repo, "reflog", "--format=%H", f"-n{TWIN_BOUND}", check=False)
    seen = []
    for sha in out.split():
        if sha not in seen:
            seen.append(sha)
    return seen


def tree_twin(repo, target, slug, get):
    """``(sha, run, tree)``: a commit this checkout was deployed at whose TREE is *target*'s and
    whose CI passed (a rollback, C1669: the operator, 2026-10-25), else ``(None, None, tree)``.
    The equality is the trees' hashes, read here, never assumed from a message."""
    try:
        tree = git(repo, "rev-parse", f"{target}^{{tree}}")
    except RuntimeError:
        return None, None, ""
    for sha in deployed_shas(repo):
        if sha == target or git(repo, "rev-parse", f"{sha}^{{tree}}", check=False) != tree:
            continue
        status, body, reason = get(f"/repos/{slug}/actions/runs?head_sha={sha}&event=push"
                                   f"&per_page=20")
        runs = [r for r in (body or {}).get("workflow_runs", []) if r.get("path") == WORKFLOW_PATH]
        if runs and verdict_of_runs(runs)[0] == "PASSED":
            return sha, verdict_of_runs(runs)[1], tree
    return None, None, tree


# ---------------------------------------------------------------------------
# The local CI runner's verdicts (docs/LOCAL_CI.md)
# ---------------------------------------------------------------------------

#: The local runner's store: root-owned, world-readable (the host step makes it). A store
#: is a dict so a test can name its own folder and owner; nothing else ever passes one.
LOCAL_CI_STORE = {"path": "/var/lib/nmas-local-ci", "owner": 0}
#: How each source's sentence begins: `verdict_source` reads them, the one place.
LOCAL_PASSED = "LOCAL CI passed"
LOCAL_REUSED = "LOCAL CI's verdict REUSED"
LOCAL_FAILED = "FAILED: the local CI runner failed it"
BOTH_DISAGREE = "FAILED: the two CI runners DISAGREE"
OVERRIDDEN = "OVERRIDDEN: the two CI runners DISAGREE, deployed on the operator's reason"
#: The rule when the two disagree (the operator, 2026-11-03: "keep refuse, scoped. Refuse only
#: when a GitHub red is known at deploy time; never wait for a missing GitHub verdict ... My
#: override, with a reason, is recorded on the deploy"): a red KNOWN at deploy time refuses,
#: whichever runner it came from; a missing verdict is never waited for when the other is
#: green; `--override-ci-red "<reason>"` deploys over a red only when the other runner is
#: green, and the reason, the person and both verdicts go in the audit row. A GitHub red that
#: arrives after the deploy is the ci-agreement reader's Needs attention row.
OVERRIDE_MIN_WORDS = 3
#: The record's states (scripts/nmas-local-ci writes them): two verdicts, and the rest.
LOCAL_STATES = ("queued", "running", "passed", "failed", "error", "skipped", "incomplete")
_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
#: A record is a few kilobytes (about 60 steps); a larger file is not one.
LOCAL_RECORD_MAX = 1 << 20


def _untrusted(st, owner) -> str:
    """Why a store entry cannot be trusted, or "": it must be owned by *owner* (root) and
    writable by nobody else, or anyone who can write it can write a green verdict."""
    if st.st_uid != owner:
        return f"owned by uid {st.st_uid}, not {owner}"
    if st.st_mode & 0o022:
        return f"writable by others (mode {st.st_mode & 0o777:o})"
    return ""


def local_verdict(repo, sha, store=None) -> dict:
    """``{"state", "words", "record"}``: the local runner's verdict for *sha*, read from
    `<store>/verdicts/<sha>.json` and judged here.

    *state* is ``absent`` (no store on this host: said nowhere), ``none`` (no record for this
    commit), ``unreadable`` (a record that cannot be read or does not parse: never a pass),
    ``untrusted`` (the store or record is not root's alone), ``other-tree`` (the record names
    another tree than git does for *sha*: not this commit's verdict), or the record's own
    state: ``queued``, ``running``, ``passed``, ``failed``, ``error`` (the runner could not run
    the workflow, so no verdict), ``skipped`` (superseded by a newer commit's run)."""
    store = store or LOCAL_CI_STORE
    root, owner, short = store["path"], store["owner"], sha[:10]
    if not os.path.lexists(root):
        return {"state": "absent", "words": "", "record": None}
    if not _SHA_RE.match(sha or ""):
        return {"state": "unreadable", "words": f"{sha!r} is not a full commit sha",
                "record": None}
    folder = os.path.join(root, "verdicts")
    path = os.path.join(folder, f"{sha}.json")
    try:
        for p in (root, folder):
            st = os.stat(p, follow_symlinks=False)
            why = _untrusted(st, owner)
            if why:
                return {"state": "untrusted", "words": f"{p} is {why}, so its verdicts are not "
                        "read", "record": None}
        if not os.path.lexists(path):
            return {"state": "none", "words": f"no record for {short} in {folder}",
                    "record": None}
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as fh:
            st = os.fstat(fh.fileno())
            why = _untrusted(st, owner)
            if why:
                return {"state": "untrusted", "words": f"{path} is {why}, so it is not read",
                        "record": None}
            raw = fh.read(LOCAL_RECORD_MAX + 1)
        if len(raw) > LOCAL_RECORD_MAX:
            raise ValueError(f"larger than {LOCAL_RECORD_MAX} bytes")
        rec = json.loads(raw.decode("utf-8"))
        if not isinstance(rec, dict) or rec.get("schema") != 1 or rec.get("sha") != sha \
                or rec.get("state") not in LOCAL_STATES:
            raise ValueError("not a version-1 record of this commit with a known state")
    except (OSError, ValueError) as exc:
        return {"state": "unreadable", "words": f"{path} could not be read ({exc}): never a "
                "pass", "record": None}
    try:
        tree = git(repo, "rev-parse", f"{sha}^{{tree}}")
    except RuntimeError as exc:
        return {"state": "unreadable", "words": f"git could not name {short}'s tree ({exc})",
                "record": rec}
    if rec.get("tree") != tree:
        return {"state": "other-tree", "words": f"{path} names tree "
                f"{str(rec.get('tree'))[:10]}, and git names {short}'s {tree[:10]}: not this "
                "commit's verdict", "record": rec}
    return {"state": rec["state"], "words": local_words(rec, path), "record": rec}


def local_words(rec: dict, path: str) -> str:
    """A record, in a sentence: which runner, what ran, how long, where its record and logs
    are, and for a failure the first step that failed."""
    runner = rec.get("runner") or {}
    by = (f"runner {str(runner.get('sha256') or '?')[:12]}, installed from "
          f"{str(runner.get('installed_from') or 'an unrecorded commit')[:10]}")
    steps = [s for j in rec.get("jobs") or [] for s in j.get("steps") or []]
    ran = [s for s in steps if s.get("result") not in ("skipped", None)]
    took = rec.get("duration_s")
    took = f" in {int(took // 60)}m{int(took % 60):02d}s" if isinstance(took, (int, float)) else ""
    state = rec.get("state")
    if state == "passed":
        return (f"{len(ran)} step(s) of {len(rec.get('jobs') or [])} job(s) passed{took} "
                f"({by}; record {path})")
    if state == "failed":
        first = (rec.get("failed") or [{}])[0]
        return (f"step '{first.get('step', '?')}' in {first.get('job', '?')} "
                f"{first.get('result', 'failed')}{took}, log {first.get('log', '?')} ({by}; "
                f"record {path})")
    if state == "incomplete":
        missing = rec.get("not_run") or [{}]
        return (f"NOT GREEN: {len(rec.get('not_run') or [])} step(s) act did not run, the first "
                f"'{missing[0].get('step', '?')}' in {missing[0].get('job', '?')} "
                f"({missing[0].get('why', '?')}) ({by}; record {path})")
    if state in ("queued", "running"):
        done = [s for s in ran if s.get("result")]
        return (f"{state} since {rec.get('started_at') or rec.get('queued_at') or '?'}, "
                f"{len(done)} step(s) done ({by})")
    return f"{state}: {rec.get('reason') or 'no reason recorded'} (record {path})"


def verdict_source(sentence: str) -> str:
    """Which runner a `ci_verdict` sentence says judged it: "local", "github" or "both" (they
    disagreed). The prefixes are this file's constants, the one owner of the words."""
    s = sentence or ""
    if s.startswith(OVERRIDDEN):
        return "override"
    if s.startswith(BOTH_DISAGREE):
        return "both"
    if s.startswith((LOCAL_PASSED, LOCAL_REUSED, LOCAL_FAILED)):
        return "local"
    if s.startswith("PENDING: the local runner"):
        return "local"
    return "github"


def local_wait_bound(store=None, floor=None) -> int:
    """`--wait`'s bound when the local runner may be the one waited for: about 2.5 times the
    median length of its last ten finished push runs (each record's `duration_s`), never
    below *floor* (WAIT_BOUND_S, GitHub's). With no finished run recorded, the floor."""
    import statistics

    floor = WAIT_BOUND_S if floor is None else floor
    store = store or LOCAL_CI_STORE
    folder = os.path.join(store["path"], "verdicts")
    took = []
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return floor
    recs = []
    for name in names:
        try:
            with open(os.path.join(folder, name), encoding="utf-8") as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            continue
        if (isinstance(rec, dict) and rec.get("kind") == "push"
                and rec.get("state") in ("passed", "failed")
                and isinstance(rec.get("duration_s"), (int, float))):
            recs.append(rec)
    recs.sort(key=lambda r: str(r.get("ended_at") or ""))
    took = [r["duration_s"] for r in recs[-10:]]
    if not took:
        return floor
    return max(floor, int(2.5 * statistics.median(took)))


def local_twin(repo, target, store=None):
    """``(sha, verdict)``: a commit this checkout was deployed at whose TREE is *target*'s and
    whose LOCAL verdict passed (a rollback, C1669, judged by the local runner's record), else
    ``(None, None)``. Asks nothing of GitHub, so an offline rollback finds it too."""
    try:
        tree = git(repo, "rev-parse", f"{target}^{{tree}}")
    except RuntimeError:
        return None, None
    for sha in deployed_shas(repo):
        if sha == target or git(repo, "rev-parse", f"{sha}^{{tree}}", check=False) != tree:
            continue
        lv = local_verdict(repo, sha, store)
        if lv["state"] == "passed":
            return sha, lv
    return None, None


def ci_verdict(repo, target, get=github_get, store=None, override=None):
    """(exit code, sentence naming the SHA, which runner judged it, and what was found).

    Two runners, one workflow (docs/LOCAL_CI.md): the local runner's record for *target*
    (`local_verdict`, from the root-owned store *store*) and GitHub Actions'. A red KNOWN now
    refuses, whichever runner gave it; a missing verdict is never waited for when the other is
    green (the operator's scoped rule, `OVERRIDE_MIN_WORDS`' comment):
    * the local runner FAILED it: refused, naming the step, without asking GitHub;
    * the local runner PASSED it: deployed, whatever GitHub is doing, unless GitHub's own run
      for *target* (asked once, never waited for) has already FAILED it: refused, naming both;
    * otherwise GitHub's verdict (`github_verdict`, below), with the local runner's state said
      when this host has a store; a local run still queued or running while GitHub is pending,
      cancelled or cannot be asked is PENDING, so `--wait` follows whichever ends first.
    *override* (the operator's reason, `--override-ci-red`) deploys over a known red only when
    the OTHER runner passed the commit: never green over nothing."""
    short = target[:10]
    lv = local_verdict(repo, target, store)
    if lv["state"] == "failed":
        refusal = f"{LOCAL_FAILED} for {short}: {lv['words']}."
        if not override:
            return CI_REFUSED, refusal + " Do not deploy this commit."
        code, sentence = github_verdict(repo, target, get, store)
        if code != OK:
            return CI_REFUSED, (refusal + f" Not overridden: GitHub has not passed it either "
                                f"({sentence.rstrip('.')}), and an override needs one green.")
        return OK, (f"{OVERRIDDEN} ({override!r}) for {short}: the local runner failed it "
                    f"({lv['words']}); GitHub: {sentence}")
    if lv["state"] == "passed":
        own, words = github_own(repo, target, get)
        if own == "FAILED":
            if override:
                return OK, (f"{OVERRIDDEN} ({override!r}) for {short}: GitHub's CI failed it "
                            f"({words}); the local runner passed it ({lv['words']})")
            return CI_REFUSED, (f"{BOTH_DISAGREE} for {short}: the local runner passed it "
                                f"({lv['words']}), and GitHub's CI failed it ({words}). Refused: "
                                "rerun GitHub's run once (a green rerun clears it), or deploy "
                                "with --override-ci-red \"<reason>\".")
        # C2753: the local runner skips the container harness, so its green alone never
        # deploys a tree whose harness paths moved; GitHub's harness jobs must be green.
        try:
            moved = harness_paths_changed(repo, target)
        except RuntimeError as exc:
            return CI_REFUSED, (f"{LOCAL_PASSED} for {short}, but whether its tree changes the "
                                f"harness's paths could not be told ({exc}), so the local "
                                "verdict alone does not deploy it.")
        if moved:
            hstate, hwords = github_harness(repo, target, get)
            if hstate != "PASSED":
                named = ", ".join(moved[:5]) + (f" and {len(moved) - 5} more"
                                                if len(moved) > 5 else "")
                code = CI_PENDING if hstate in ("PENDING", "COULD NOT ASK") else CI_REFUSED
                return code, (f"{'PENDING' if code == CI_PENDING else 'REFUSED'}: the local "
                              f"runner passed {short} ({lv['words']}), but its tree changes "
                              f"{len(moved)} path(s) the container harness tests ({named}), "
                              "which the local runner skips; GitHub's harness jobs must be "
                              f"green, and they are {hstate.lower()} ({hwords}).")
            words += f"; the harness paths changed, and GitHub's harness: {hwords}"
        return OK, f"{LOCAL_PASSED} for {short}: {lv['words']}. GitHub's own run: {words}"
    code, sentence = github_verdict(repo, target, get, store)
    said = "" if lv["state"] == "absent" else f" The local runner: {lv['words']}."
    if (lv["state"] in ("queued", "running")
            and code in (COULD_NOT_ASK, CI_PENDING, CI_CANCELLED)):
        return CI_PENDING, (f"PENDING: the local runner is {lv['state']} for {short} "
                            f"({lv['words']}). GitHub: {sentence} Wait, or run "
                            "`nmas-deploy --wait`.")
    if code == OK or not said:
        return code, sentence + said
    return code, sentence.rstrip(".") + "." + said


#: The code the container harness tests (ci.yml's `harness` job): the SDN, app and controller
#: code, in the operator's words (2026-11-08), and the harness itself. The local runner skips
#: that job (its job containers have no Docker: `if: ${{ !env.ACT }}`), so "A local-runner
#: verdict alone never makes deployable a commit that touches the harness's paths ... such a
#: commit needs GitHub's harness job green" (C2753).
HARNESS_PATHS = ("modules/sdn/", "modules/apps/", "deploy/controller/", "lab/lab9/",
                 "tests/containers/", "scripts/nmas-harness")
#: How the harness job's runs are named in ci.yml (`name: container harness (...)`).
HARNESS_JOB = "container harness"


def harness_paths_changed(repo, target, base=None):
    """The paths under `HARNESS_PATHS` that differ between *base* (the checkout's deployed
    HEAD) and *target*, sorted. Raises RuntimeError when git cannot tell (never read as
    none)."""
    base = base or git(repo, "rev-parse", "HEAD").strip()
    names = git(repo, "diff", "--name-only", base, target).split()
    return sorted(n for n in names
                  if any(n == p or (p.endswith("/") and n.startswith(p)) for p in HARNESS_PATHS))


def github_harness(repo, target, get=github_get):
    """``(state, words)`` of GitHub's container harness jobs for *target*: PASSED (every one
    succeeded), FAILED, PENDING, NO JOB (its run has none) or COULD NOT ASK."""
    try:
        slug = slug_of(git(repo, "remote", "get-url", "origin"))
    except (RuntimeError, ValueError) as exc:
        return "COULD NOT ASK", f"could not ask GitHub ({exc})"
    _status, body, reason = get(f"/repos/{slug}/actions/runs?head_sha={target}&event=push"
                                f"&per_page=20")
    if body is None:
        return "COULD NOT ASK", f"could not ask GitHub ({reason})"
    runs = [r for r in body.get("workflow_runs", []) if r.get("path") == WORKFLOW_PATH]
    if not runs:
        return "PENDING", "GitHub has no run yet"
    state, run, _all = verdict_of_runs(runs)
    _status, jobs_body, reason = get(f"/repos/{slug}/actions/runs/{run.get('id')}/jobs"
                                     f"?per_page=100")
    if jobs_body is None:
        return "COULD NOT ASK", f"could not ask GitHub for run #{run.get('run_number')}'s jobs " \
                                f"({reason})"
    jobs = [j for j in jobs_body.get("jobs", []) if str(j.get("name", "")).startswith(HARNESS_JOB)]
    where = f"run #{run.get('run_number', '?')}"
    if not jobs:
        return ("PENDING" if state == "PENDING" else "NO JOB"), f"{where} has no harness job"
    if any(j.get("status") != "completed" for j in jobs):
        return "PENDING", f"{where}'s harness jobs are still running"
    bad = [j.get("name", "") for j in jobs if j.get("conclusion") != "success"]
    if bad:
        return "FAILED", f"{where}: {', '.join(bad)} did not succeed"
    return "PASSED", f"{where}: {len(jobs)} harness job(s) succeeded"


def github_own(repo, target, get=github_get):
    """``(state, words)`` of GitHub's OWN runs for *target*: PASSED, FAILED, PENDING,
    CANCELLED, NO RUN or COULD NOT ASK. One request, no walk and no twin: the question a local
    green asks of GitHub is only "did GitHub fail this commit?"."""
    try:
        slug = slug_of(git(repo, "remote", "get-url", "origin"))
    except (RuntimeError, ValueError) as exc:
        return "COULD NOT ASK", f"could not ask GitHub ({exc})"
    _status, body, reason = get(f"/repos/{slug}/actions/runs?head_sha={target}&event=push"
                                f"&per_page=20")
    if body is None:
        return "COULD NOT ASK", f"could not ask GitHub ({reason})"
    runs = [r for r in body.get("workflow_runs", []) if r.get("path") == WORKFLOW_PATH]
    if not runs:
        return "NO RUN", "no run yet"
    state, run, _all = verdict_of_runs(runs)
    return state, (f"run #{run.get('run_number', '?')} {state.lower()}, "
                   f"{run.get('html_url', '')}").rstrip(", ")


def github_verdict(repo, target, get=github_get, store=None):
    """(exit code, sentence) from GitHub Actions alone. A target whose own CI has not
    concluded, and whose tree is that of a commit this checkout was deployed at and CI passed
    (on GitHub, or by the local runner's record), takes that verdict (a rollback, C1669),
    naming both; a target whose own CI FAILED is refused whatever its twin's said."""
    short = target[:10]
    try:
        slug = slug_of(git(repo, "remote", "get-url", "origin"))
    except (RuntimeError, ValueError) as exc:
        twin, lv = local_twin(repo, target, store)
        if twin:
            return OK, (f"{LOCAL_REUSED}: {short}'s tree is that of {twin[:10]}, which this "
                        f"checkout was deployed at and the local runner passed ({lv['words']}); "
                        f"GitHub could not be asked about {short} ({exc})")
        return COULD_NOT_ASK, f"could not ask CI about {short}: {exc}"

    status, body, reason = get(f"/repos/{slug}/actions/runs?head_sha={target}&event=push&per_page=20")
    if body is None:
        twin, lv = local_twin(repo, target, store)
        if twin:
            return OK, (f"{LOCAL_REUSED}: {short}'s tree is that of {twin[:10]}, which this "
                        f"checkout was deployed at and the local runner passed ({lv['words']}); "
                        f"GitHub could not be asked about {short} ({reason})")
        return COULD_NOT_ASK, (f"could not ask CI about {short} ({reason}). Refused: an "
                               "unverified commit is never deployed. Retry, or run "
                               "`nmas-deploy --offline` to run the suite here.")
    runs = [r for r in body.get("workflow_runs", []) if r.get("path") == WORKFLOW_PATH]
    own = verdict_of_runs(runs)[0] if runs else "NO RUN"
    if own not in ("PASSED", "FAILED"):
        twin, lv = local_twin(repo, target, store)
        if twin:
            return OK, (f"{LOCAL_REUSED}: {short}'s tree is that of {twin[:10]}, which this "
                        f"checkout was deployed at and the local runner passed ({lv['words']}); "
                        f"{short}'s own CI: {own.lower()}")
        twin, trun, tree = tree_twin(repo, target, slug, get)
        if twin:
            return OK, (f"CI's verdict REUSED: {short}'s tree {tree[:10]} is that of {twin[:10]}, "
                        f"which this checkout was deployed at and CI passed (run "
                        f"#{trun.get('run_number', '?')}, {trun.get('html_url', '')}); "
                        f"{short}'s own CI: {own.lower()}")
    if runs:
        state, run, _all = verdict_of_runs(runs)
        url, num = run.get("html_url", ""), run.get("run_number", "?")
        others = _others(runs, run)
        if state == "PENDING":
            return CI_PENDING, (f"PENDING: CI run #{num} is still {run.get('status')} for {short}: "
                                f"{url}{others}. Wait, and run nmas-deploy again when it completes, or run "
                                "`nmas-deploy --wait`, which follows the run and deploys when it passes.")
        if state == "CANCELLED":
            return CI_CANCELLED, (f"CANCELLED: every CI run for {short} was cancelled (superseded by a "
                                  f"newer push, or stopped), so no verdict exists: {url}{others}. "
                                  "Deploy the newer commit, or re-run CI for this one.")
        if state == "PASSED":
            return OK, f"CI passed for {short}: run #{num}, {url}{others}"
        return CI_REFUSED, (f"FAILED: CI's latest conclusive run for {short}, #{num}, concluded "
                            f"{run.get('conclusion')}: {url}{others}. Do not deploy this commit.")

    # No run for the target. Legitimate ONLY for a docs-only push, judged
    # against the NEAREST ANCESTOR THAT HAS A RUN, asked about by SHA like the
    # target itself (the operator's finding, 2026-09-28: the old walk tested
    # each ancestor against ONE filtered listing of passing runs, and a listing
    # that came back without the recent passes produced "no passing ancestor
    # within 100 commits", which described a search it never made). Each
    # commit asked about is named with what was found, and the walk stops at
    # the first commit that HAS runs: it never walks past a failed, cancelled
    # or running commit to an older pass.
    asked = [f"{short}: no run"]
    base = None
    for ancestor in git(repo, "rev-list", f"--max-count={WALK_BOUND + 1}", target).split()[1:]:
        a = ancestor[:10]
        status, body, reason = get(f"/repos/{slug}/actions/runs?head_sha={ancestor}"
                                   f"&event=push&per_page=20")
        if body is None:
            return COULD_NOT_ASK, (f"no CI run for {short}, and asking about its ancestor {a} "
                                   f"failed ({reason}). Asked: {'; '.join(asked)}. Refused.")
        aruns = [r for r in body.get("workflow_runs", []) if r.get("path") == WORKFLOW_PATH]
        if not aruns:
            asked.append(f"{a}: no run")
            continue
        state, run, _all = verdict_of_runs(aruns)
        num = run.get("run_number", "?")
        asked.append(f"{a}: run #{num} {state.lower()}")
        if state == "PENDING":
            return CI_PENDING, (f"PENDING: {short} has no run of its own, and the nearest ancestor "
                                f"with one, {a}, is still running (#{num}). Asked: "
                                f"{'; '.join(asked)}. Wait, or run `nmas-deploy --wait`.")
        if state == "CANCELLED":
            # No verdict at all (superseded by a newer push): keep walking. A
            # CODE commit passed over this way is still refused below, where
            # the change from the base to the target must be ignorable.
            asked[-1] += " (no verdict: keep walking)"
            continue
        if state != "PASSED":
            # A DEFINITE answer, never "could not ask" (the operator,
            # 2026-10-01: GitHub answered #241 failed in 0.6 s, and the Update
            # page said "could_not_ask" and kept waiting for it).
            return CI_REFUSED, (f"FAILED: {short} has no run of its own (its paths are ones CI "
                                f"skips), and the nearest ancestor with one, {a}, failed: run #{num} "
                                f"concluded {run.get('conclusion') or state.lower()}. Its code is in "
                                f"{short}, so {short} is not deployed. Asked: "
                                f"{'; '.join(asked)}.")
        base = ancestor
        break
    if base is None:
        return COULD_NOT_ASK, (f"no CI run for {short}, and none of the {len(asked)} commit(s) "
                               f"asked about has one (the walk stops after {WALK_BOUND} "
                               "ancestors: 2.5x the longest measured streak of commits "
                               f"without a run, 4): {'; '.join(asked)}. Refused.")
    seen = f" Asked: {'; '.join(asked)}."
    # NOTHING CHANGED is decided on its own, by tree IDENTITY (the
    # operator's finding, 2026-09-28). An empty commit carrying a
    # corrected message (41a4149) changes no file, GitHub starts no
    # run for it, and the ignore rule, written for a NON-empty change
    # set, answered "changes more than ignored paths: []": the empty
    # case inherited, and the message printing the evidence against
    # its own verdict. The same tree as a commit CI passed is exactly
    # the code CI verified. Decided on the two tree hashes, which
    # `git()` reads or raises, never on an empty list, which is also
    # what a failed read could look like.
    tree = git(repo, "rev-parse", f"{target}^{{tree}}")
    if tree == git(repo, "rev-parse", f"{base}^{{tree}}"):
        return OK, (f"no CI run for {short}, which is expected: its tree is IDENTICAL "
                    f"to {base[:10]}'s, which CI passed (tree {tree[:10]}), so what "
                    "is deployed is exactly what CI verified." + seen)
    changed = git(repo, "diff", "--name-only", base, target).split()
    if not changed:
        # The trees differ and git names no changed file: the two facts
        # disagree, so nothing can be concluded. Never a pass.
        return COULD_NOT_ASK, (f"no CI run for {short}: its tree differs from "
                               f"{base[:10]}'s (CI passed) and git named no changed "
                               "file. The two disagree, so what changed is unknown." + seen
                               + " Refused.")
    patterns = ignored_patterns(repo, base)   # the GREEN commit's rule
    if only_ignored(changed, patterns):
        return OK, (f"no CI run for {short}, which is expected: every file changed "
                    f"since {base[:10]} (CI passed) matches that commit's "
                    f"paths-ignore {patterns}: {changed}." + seen)
    return COULD_NOT_ASK, (f"no CI run for {short}, and it changes more than ignored "
                           f"paths since {base[:10]}, the last commit CI passed: "
                           f"{[p for p in changed if not only_ignored([p], patterns)][:5]}."
                       + seen + " Refused.")


def parallel_available(tree=None):
    """``(bool, reason)``: run with pytest-xdist only when THIS interpreter has
    the version the target pins in requirements-test.txt (C45). A different
    version of the runner that schedules the tests is how an order-dependent
    finding comes back, so a mismatch runs serially and says so."""
    import importlib.metadata
    try:
        have = importlib.metadata.version("pytest-xdist")
    except importlib.metadata.PackageNotFoundError:
        return False, "serially (pytest-xdist is not installed here)"
    want = None
    try:
        with open(os.path.join(tree or ".", "requirements-test.txt"), encoding="utf-8") as fh:
            for line in fh:
                if line.strip().lower().startswith("pytest-xdist=="):
                    want = line.strip().split("==", 1)[1]
    except OSError:
        pass
    if want is None:
        return False, f"serially (pytest-xdist {have} is installed, and the target pins no version)"
    if have != want:
        return False, f"serially (pytest-xdist {have} is installed; the target pins {want}, as CI runs)"
    return True, f"in parallel on {os.cpu_count()} cores (pytest-xdist {have}, as CI)"


def offline_forecast(repo, tree=None):
    """What --offline is about to cost, said BEFORE it runs (C45): the full
    suite takes minutes on the host, and that is worth knowing rather than
    discovering at the wrong moment. The figure is this machine's own last
    --offline run, from the audit rows; never a constant, which would go
    stale silently."""
    _, how = parallel_available(tree)
    last = None
    try:
        with open(os.path.join(repo, "data", "deploy_audit.jsonl"), encoding="utf-8") as fh:
            for line in fh:
                row = json.loads(line)
                if row.get("gate") == "offline" and row.get("started_at") and row.get("ended_at"):
                    last = row
    except (OSError, ValueError):
        pass
    if last is None:
        seen = "No earlier --offline run is recorded here."
    else:
        start, end = parse_iso(last["started_at"]), parse_iso(last["ended_at"])
        if start is None or end is None:
            seen = f"The last one here ({last['started_at']}) recorded no readable duration."
        else:
            took = end - start
            seen = (f"The last one here took {int(took // 60)}m{int(took % 60):02d}s "
                    f"({last['started_at']}, {'parallel' if last.get('parallel') else 'serial'}).")
    return f"--offline: running the FULL suite here, {how}. {seen}"


def offline_verdict(repo, target, run=subprocess.run):
    """Run the whole suite on THIS machine against the target, not HEAD, in a
    CHECKOUT of the target: the shape of what is deployed.

    Not `git archive`. An archive has no `.git`, and `/health` reads the loaded
    commit from git, so from an archive its test failed on EVERY commit and
    `--offline` could not pass at all. It refused a red commit for the wrong
    reason and would have refused a green one the same way. Found by running it
    on the host (2026-09-26); its tests replaced the suite run with a stub, so
    nothing had ever run the suite inside an archive. `--shared` borrows the
    repository's objects and writes nothing into it.
    """
    with tempfile.TemporaryDirectory(prefix="nmas-deploy-") as tmp:
        tree = os.path.join(tmp, "tree")
        subprocess.run(["git", "clone", "-q", "--shared", "--no-checkout", repo, tree],
                       check=True, capture_output=True)
        subprocess.run(["git", "-C", tree, "checkout", "-q", "--detach", target],
                       check=True, capture_output=True)
        print(offline_forecast(repo, tree), flush=True)
        runner = os.path.join(tree, "scripts", "nmas-test")
        if os.path.exists(runner):
            # C46: confined when this machine can make a network namespace,
            # and SAID when it cannot (the deployment host cannot: AppArmor).
            argv = [runner, "--allow-unconfined", "-q", "-p", "no:cacheprovider"]
        else:
            argv = [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider"]
        if parallel_available(tree)[0]:
            argv += ["-n", "auto"]
        # nmas-test runs ${PYTHON:-python3}: hand it this interpreter, the app's (section 8.1),
        # so the suite tests what the app imports, never a shell's python3.
        out = run(argv, cwd=tree, capture_output=True, text=True,
                  env={**os.environ, "PYTHON": sys.executable})
    lines = (out.stdout or "").strip().splitlines()
    tail = lines[-1:] or ["(no output)"]
    network = next((ln[len("nmas-test: "):] for ln in lines if ln.startswith("nmas-test: network:")),
                   "network: NOT CONFINED (the target has no scripts/nmas-test)").rstrip(".")
    if out.returncode == 0:
        return OK, f"the suite passed HERE against {target[:10]}: {tail[0]}; {network}"
    if out.returncode in (124, 137):
        # nmas-test's bound fired. Its report (the test each process was
        # running, and their stacks) is on STDERR; the last stdout line would
        # name neither, and "FAILED" would read as a test failing.
        report = [ln.strip() for ln in (getattr(out, "stderr", "") or "").splitlines()
                  if ln.startswith("  ") and ": " in ln and "started" in ln]
        return OFFLINE_FAILED, (f"the suite TIMED OUT here against {target[:10]} (nmas-test's "
                                f"bound): running when it stopped: "
                                f"{'; '.join(report) or 'no test named (see nmas-test output)'}; "
                                f"{network}. Refused.")
    return OFFLINE_FAILED, (f"the suite FAILED here against {target[:10]}: {tail[0]}; "
                            f"{network}. Refused.")


# ---------------------------------------------------------------------------

def audit(repo, row):
    path = os.path.join(repo, "data", "deploy_audit.jsonl")
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
    except OSError as exc:
        print(f"WARNING: could not record this deploy in {path}: {exc}", file=sys.stderr)


def iso_ms(epoch: float) -> str:
    import datetime
    return (datetime.datetime.fromtimestamp(epoch, tz=datetime.timezone.utc)
            .isoformat(timespec="milliseconds").replace("+00:00", "Z"))


def parse_iso(text):
    import datetime
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def unit_state(service=SERVICE, systemctl="systemctl"):
    """{"MainPID": int, "start": str} from systemd. The start is
    ExecMainStartTimestamp at MICROSECOND resolution, for the record only:
    identity is decided by the pid, never by comparing times. *systemctl* is
    the program: by name from a login shell, and by ABSOLUTE path from the
    root-owned updater, which never resolves a program by name (C246)."""
    out = subprocess.run([systemctl, "show", service, "-p", "MainPID",
                          "-p", "ExecMainStartTimestamp", "-p", "LoadState", "--timestamp=us"],
                         capture_output=True, text=True).stdout
    props = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    try:
        pid = int(props.get("MainPID", "0"))
    except ValueError:
        pid = 0
    return {"MainPID": pid, "start": props.get("ExecMainStartTimestamp", ""),
            "load": props.get("LoadState", "")}


def restart_checkout_units(restart_unit, unit, clock, sleep, units=CHECKOUT_UNITS,
                           timeout=CHECKOUT_UNIT_BOUND_S, interval=1):
    """``(ok, words)``: each unit in *units* restarted and its new process confirmed by
    IDENTITY (C1404): systemd's MainPID changed from the one it had and is not 0. Called once
    SERVICE runs the target, so each new process loads the checkout the target is in.

    A unit not installed here is said and skipped; one installed and not running (the ZTP
    responder waits on its socket until a device asks) is not started: `try-restart` leaves it,
    and its next start loads this checkout. *restart_unit(u)* is `systemctl try-restart u`
    (sudo here, the absolute path in the root updater); *unit(u)* is :func:`unit_state`."""
    ok, words = True, []
    for u in units:
        before = unit(u)
        if before.get("load") not in ("loaded", ""):
            words.append(f"{u}: not installed here ({before.get('load')}), nothing to restart")
            continue
        if not before.get("MainPID"):
            words.append(f"{u}: not running, so not restarted; its next start loads this "
                         "checkout")
            continue
        try:
            restart_unit(u)
        except (subprocess.CalledProcessError, OSError, subprocess.TimeoutExpired) as exc:
            detail = getattr(exc, "stderr", "") or str(exc)
            ok = False
            words.append(f"{u}: NOT restarted ({str(detail).strip()}): it still runs the code "
                         f"it started with -- run `sudo systemctl restart {u}`")
            continue
        deadline = clock() + timeout
        while True:
            now = unit(u)
            if now.get("MainPID") not in (0, before["MainPID"]):
                words.append(f"{u}: restarted, pid {before['MainPID']} -> {now['MainPID']}")
                break
            if clock() >= deadline:
                ok = False
                words.append(f"{u}: restart issued, but systemd's MainPID is "
                             f"{now.get('MainPID')} after {timeout} s (it was "
                             f"{before['MainPID']}): NOT confirmed running the new code -- "
                             f"run `sudo systemctl restart {u}`")
                break
            sleep(interval)
    return ok, words


def wait_for_running(target, pid_before, health, unit, clock, sleep, timeout=90, interval=2):
    """(ok, seen, reason). Confirmed by IDENTITY, never by time:

    - systemd's MainPID CHANGED (the restart happened);
    - /health answers from THAT pid (the new process is the one answering);
    - /health reports the TARGET commit (it loaded the right code).

    A time comparison was the first version, and it could false-fail a real
    restart: the process start came from /proc arithmetic whose boot time is
    whole seconds, measured 0.66 s early. A 200 alone proves nothing: a process
    that never restarted answers 200 too."""
    deadline = clock() + timeout
    seen, reason = None, "no answer yet"
    while True:
        state = unit()
        status, body = health()
        seen = {"unit": state, "health": body}
        if state["MainPID"] in (0, pid_before):
            reason = (f"systemd's MainPID is {state['MainPID']}, unchanged from "
                      f"{pid_before}: the service has not restarted")
        elif body is None:
            reason = f"/health answered {status}"
        elif body.get("pid") != state["MainPID"]:
            reason = (f"/health answered from pid {body.get('pid')}, not the service's "
                      f"new MainPID {state['MainPID']}")
        elif body.get("commit") != target:
            reason = (f"the running process loaded {str(body.get('commit'))[:10]}, "
                      f"not {target[:10]}")
        else:
            return True, seen, ""
        if clock() >= deadline:
            return False, seen, reason
        sleep(interval)


def _first(rows, states):
    return next((r for r in rows if isinstance(r, dict) and r.get("state") in states), None)


def wait_for_ready(health, clock, sleep, timeout=READY_BOUND_S, interval=2):
    """The running target's warm-up (C2465, C2514), asked of /health once `wait_for_running`
    confirmed it: a dict, the deploy's and the updater's ``ready`` record, whose ``state`` is

    - ``ready``: /health said ``ready: true`` within *timeout*;
    - ``absent``: /health answers with no ``ready`` key (a version from before C2465): said,
      and not waited for;
    - ``failed``: a warm-up step's row says ``failed``; ready cannot follow, so the wait ends
      at once, naming the step and its error;
    - ``warming``: still not ready at *timeout*, naming the step still running (or waiting).

    with the ``step``, its ``error``, the ``seconds`` waited, the ``bound_s``, ``not_ready``
    (/health's own sentence) and ``words``, the sentence a verdict says. It only READS: never a
    restart and never a rollback (the operator, 2026-11-05: "no automatic rollback")."""
    start = clock()
    deadline = start + timeout
    body, status = None, None
    while True:
        status, body = health()
        waited = round(clock() - start, 1)
        out = {"bound_s": timeout, "seconds": waited, "step": "", "error": "",
               "not_ready": "", "warming": []}
        if isinstance(body, dict):
            out.update(not_ready=str(body.get("not_ready") or ""),
                       warming=list(body.get("warming") or []))
            if "ready" not in body:
                return dict(out, state="absent",
                            words="the running version's /health has no `ready` (it predates "
                                  "the warm-up, C2465): readiness not waited for")
            if body.get("ready") is True:
                return dict(out, state="ready", words=f"ready after {waited} s")
            bad = _first(out["warming"], ("failed",))
            if bad:
                step, error = str(bad.get("step") or "?"), str(bad.get("error") or "")
                return dict(out, state="failed", step=step, error=error,
                            words=f"the warm-up step {step} failed: "
                                  f"{error or 'no error recorded'}")
        if clock() >= deadline:
            still = _first(out["warming"], ("running", "waiting")) or {}
            step = str(still.get("step") or "")
            heard = (f"/health answered {status}" if not isinstance(body, dict) else
                     out["not_ready"] or "not ready, and /health gave no reason")
            return dict(out, state="warming", step=step or "the warm-up",
                        words=f"{step or 'the warm-up'} still warming after {timeout} s "
                              f"({heard})")
        sleep(interval)


def main(argv=None, get=github_get, run=subprocess.run, restart=None, health=None,
         clock=time.time, sleep=time.sleep, unit=unit_state, ready=None, host_check=None,
         operations=None, restart_unit=None, unit_of=None, store=None) -> int:
    # In the order it happened: over SSH stdout was block-buffered and the
    # verdict (stderr) printed first, above the lines that led to it.
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(line_buffering=True)
        except (ValueError, OSError):
            pass
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--offline", action="store_true",
                    help="run the suite here against the target instead of asking CI")
    ap.add_argument("--repo", default=DEFAULT_REPO)
    ap.add_argument("--wait", action="store_true",
                    help=f"when CI is still running for the target, follow it (every "
                         f"{WAIT_POLL_S} s, at most {WAIT_BOUND_S} s) and deploy when it "
                         "passes; the gate is unchanged")
    ap.add_argument("--to", metavar="SHA",
                    help="deploy EXACTLY this commit (it must be on origin/main) instead of "
                         "origin/main's tip; the CI gate is the same")
    ap.add_argument("--override-ci-red", metavar="REASON", default=None,
                    help="the operator's override when the two CI runners disagree on the "
                         "target (one passed it, the other failed it): deploys on the green, "
                         "recording REASON in the audit row; never over a red with no green")
    args = ap.parse_args(argv)
    # The final SDN lab's laptop kit (the operator, 2026-11-05: "nmas-deploy refuses to run from
    # this installation"): its worktree carries LAB_KIT_MARKER, and nothing is ever deployed
    # from it, whichever checkout it would deploy (lab/sdn-laptop/kit init writes the marker).
    for where in (os.path.dirname(os.path.dirname(os.path.abspath(__file__))), args.repo):
        if os.path.exists(os.path.join(where, LAB_KIT_MARKER)):
            print(f"nmas-deploy: refused: {os.path.join(where, LAB_KIT_MARKER)} marks the final "
                  "SDN lab's laptop kit, a separate installation nothing is deployed from; "
                  "nothing moved", file=sys.stderr)
            return LOCAL_REFUSED
    if args.override_ci_red is not None and (
            len(args.override_ci_red.split()) < OVERRIDE_MIN_WORDS):
        print(f"--override-ci-red needs a reason of at least {OVERRIDE_MIN_WORDS} words, the "
              f"operator's own; given {args.override_ci_red!r}. Refused.", file=sys.stderr)
        return LOCAL_REFUSED
    repo = args.repo
    # started_at is when the RUN began, ended_at when its row is written: two
    # instants, millisecond resolution, so neither can be read as the other.
    row = {"started_at": iso_ms(clock()), "user": getpass.getuser(),
           "gate": "offline" if args.offline else "ci"}
    if args.offline:
        row["parallel"] = parallel_available(repo)[0]

    def finish(code, message):
        print(message, file=sys.stderr if code else sys.stdout)
        row.update(exit=code, verdict=message, ended_at=iso_ms(clock()))
        audit(repo, row)
        return code

    lock = take_lock(repo)
    if lock is None:
        return finish(LOCKED, "the Update button's updater is moving the checkout now "
                              f"({LOCK_REL} is held): refused, nothing moved. Run nmas-deploy "
                              "again when it has finished (Help > About shows the last update)")
    try:
        code = _deploy(args, repo, row, finish, get, run, restart, health, clock, sleep, unit,
                       ready, operations, restart_unit, unit_of, store)
    finally:
        os.close(lock)
    # LAST on screen: the host steps, when the checkout is at the target (a
    # refusal before anything moved has no steps to take).
    if row.get("to") and git(repo, "rev-parse", "HEAD") == row["to"]:
        report = host_step_report(repo, row.get("from"), row["to"], host_check)
        if report:
            print("\n" + report)
    return code


# ---------------------------------------------------------------------------
# Host steps: what a person must still do on this host, said LAST
# ---------------------------------------------------------------------------

#: `Host-Step:` is done BEFORE the update, `Host-Step-After:` once it runs
#: (modules/host_steps.py); an optional `[check]` names the tool's own check.
HOST_STEP = re.compile(r"^Host-Step(-After)?:\s*(?:\[([a-z0-9-]+)\]\s*)?(.+?)\s*$", re.M)
#: A step naming the updater is checked by the updater's own install check.
UPDATER_STEP = re.compile(r"\bupdater\b", re.I)
INSTALLED_UPDATER = "/usr/local/sbin/nmas-update"


def host_steps(repo, head, target):
    """[{sha, step}] from the `Host-Step:` trailers of head..target, oldest first."""
    if not head or not target or head == target:
        return []
    text = git(repo, "log", "--reverse", "--format=%H%x1f%B%x1e", f"{head}..{target}")
    out = []
    for chunk in text.split("\x1e"):
        sha, _sep, body = chunk.strip().partition("\x1f")
        out += [{"sha": sha, "step": s, "when": "after" if after else "before", "check": chk}
                for after, chk, s in HOST_STEP.findall(body)]
    return out


def updater_check(repo, run=subprocess.run):
    """(exit code, output) of the checkout's `scripts/nmas-update-check`, the
    updater's install check (ownership, the self-test, this release's copy),
    which prints the exact commands when anything is outstanding. None when no
    updater is installed on this host: there is nothing to check."""
    if not os.path.exists(INSTALLED_UPDATER):
        return None
    try:
        out = run([sys.executable, os.path.join(repo, "scripts", "nmas-update-check")],
                  capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        return 3, f"could not run nmas-update-check: {exc}"
    return out.returncode, (out.stdout + out.stderr).strip()


def host_step_report(repo, head, target, check=None):
    """The block printed LAST after a deploy (the operator, 2026-09-30: 08dbee5
    needed the updater re-installed, the terminal deploy said nothing, and the
    updater stayed broken until job health caught it). Every `Host-Step:`
    trailer in the commits just deployed, with where it can be checked whether
    it is still outstanding; and the updater's check on every deploy, since a
    step from an EARLIER release can still be outstanding. "" when there is
    nothing to say."""
    steps = host_steps(repo, head, target)
    checked = (check or updater_check)(repo)
    outstanding = checked is not None and checked[0] != 0
    lines = []
    if steps:
        lines.append(f"HOST STEPS in the commits just deployed ({len(steps)}): each is yours "
                     "to do on this host.")
    for i, s in enumerate(steps, 1):
        lines.append(f"  {i}. {s['sha'][:10]} ({s.get('when', 'before').upper()} the update): {s['step']}")
        if s.get("check") == "updater" or UPDATER_STEP.search(s["step"]):
            if checked is None:
                lines.append("     No updater is installed on this host: nothing to re-install.")
            elif outstanding:
                lines.append("     STILL NEEDED. The updater's check says:")
                lines += ["       " + l for l in checked[1].splitlines()]
            else:
                lines.append("     Done: nmas-update-check reads ok.")
        elif s.get("check"):
            lines.append(f"     Checked by the app ([{s['check']}]): its Update page and Needs "
                         "attention say when it reads done.")
        else:
            lines.append("     Not checkable from here: confirm it is done by hand"
                         + (", then say so on the Update page." if s.get("when") == "after" else "."))
    if outstanding and not any(UPDATER_STEP.search(s["step"]) for s in steps):
        lines.append("HOST STEP OUTSTANDING from an earlier release: the updater's check says:")
        lines += ["  " + l for l in checked[1].splitlines()]
    return "\n".join(lines)


def take_lock(repo):
    """The shared lock's descriptor, held; None when someone else holds it."""
    import fcntl
    path = os.path.join(repo, LOCK_REL)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def _deploy(args, repo, row, finish, get, run, restart, health, clock, sleep, unit, ready,
            operations=None, restart_unit=None, unit_of=None, store=None):
    dirty = git(repo, "status", "--porcelain", "--untracked-files=no")
    if dirty:
        return finish(LOCAL_REFUSED, "local changes present, refused:\n" + dirty)
    foreign = subprocess.run(["find", os.path.join(repo, ".git"), "-not", "-user",
                              getpass.getuser(), "-print", "-quit"],
                             capture_output=True, text=True).stdout.strip()
    if foreign:
        return finish(LOCAL_REFUSED, f"files in .git not owned by {getpass.getuser()} "
                                     f"(first: {foreign}): run `sudo chown -R "
                                     f"{getpass.getuser()}: {repo}/.git`. Refused.")

    git(repo, "fetch", "--quiet", "origin")
    head, tip = git(repo, "rev-parse", "HEAD"), git(repo, "rev-parse", "origin/main")
    target = tip
    if args.to:
        # EXACTLY the commit named (C436), while it is still on origin/main: a later push
        # neither refuses it nor moves the checkout past it.
        try:
            target = git(repo, "rev-parse", "--verify", "-q", f"{args.to}^{{commit}}")
        except RuntimeError:
            target = ""
        if not target:
            return finish(LOCAL_REFUSED, f"--to {args.to} names no commit this checkout has "
                                         "after a fetch. Refused.")
        if subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", target,
                           tip]).returncode != 0:
            return finish(LOCAL_REFUSED, f"{target[:10]} is not on origin/main ({tip[:10]}). "
                                         "Refused.")
    row.update({"from": head, "to": target})
    if subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", head, target]).returncode != 0:
        return finish(LOCAL_REFUSED, f"{'the target' if args.to else 'origin/main'} "
                                     f"({target[:10]}) is not a fast-forward of "
                                     f"HEAD ({head[:10]}). Refused.")

    override = getattr(args, "override_ci_red", None)
    code, message = (offline_verdict(repo, target, run) if args.offline
                     else ci_verdict(repo, target, get, store, override))
    print(message)
    if args.wait and not args.offline and code == CI_PENDING:
        code, message = _wait_for_ci(repo, target, get, clock, sleep, row, store, override)
    if not args.offline:
        row["ci_source"] = verdict_source(message)      # which runner's verdict this was
        if row["ci_source"] == "override":
            # The operator's override, recorded on the deploy (the operator, 2026-11-03).
            row["override"] = {"reason": override, "by": row.get("user"), "verdict": message}
    if code != OK:
        return finish(code, message)

    # Can this run FINISH? Asked before anything moves, so a run that cannot
    # restart leaves the checkout where it was and no mixed version exists.
    able, why = (ready or can_restart)()
    row.update(restart_ready=able, restart_ready_reason=why)
    if not able:
        return finish(CANNOT_RESTART,
                      f"NOT DEPLOYED: cannot restart {SERVICE} from here ({why}). The "
                      f"checkout was NOT moved: still at {head[:10]}, and the target "
                      f"{target[:10]} passed CI. Run nmas-deploy in a terminal on the host.")

    # Is the service in the middle of an operation? Asked before anything moves (R5): the
    # restart would end it half-applied, with no receipt, no golden and no rollback.
    state, ops = (operations or _operations)()
    row.update(operations_state=state)
    if state == "busy":
        row.update(operations=ops)
        return finish(BUSY,
                      f"NOT DEPLOYED: an operation holds a device, and restarting {SERVICE} "
                      "would end it half-applied (no receipt, no golden, no rollback): "
                      f"{operations_words(ops)}. The checkout was NOT moved: still at "
                      f"{head[:10]}. Run nmas-deploy again when it finishes (the in-flight "
                      "panel shows it).")
    if state == "unreadable":
        # It ANSWERED, and what it said is that it cannot read the holds (C991): a device may
        # be held, so this is refused as held is, never continued as a service that cannot say.
        row.update(operations_error=ops)
        return finish(BUSY,
                      f"NOT DEPLOYED: {SERVICE} answered that it cannot read the device holds, "
                      "so an operation may hold a device, and the restart could end it "
                      "half-applied (asked: which devices are held, wanted: none or a list; "
                      f"answered: {ops}). The checkout was NOT moved: still at {head[:10]}. "
                      "Run nmas-deploy again once /health/operations can read the holds.")
    if state == "unknown":
        print(f"Could not ask the service which operations hold a device ({ops}); "
              "continuing, since a deploy is how a service that cannot answer is repaired.")

    # The venv this release needs (section 8.4), asked before anything moves.
    venv = venv_plan(lambda: venv_id_from(git_show_bytes(repo, target)))
    row.update(venv=venv)
    if venv["state"] == "unbuilt":
        return finish(LOCAL_REFUSED, "NOT DEPLOYED: " + venv_refusal(venv, target, repo)
                      + f". The checkout was NOT moved: still at {head[:10]}.")

    if head != target:
        git(repo, "merge", "--ff-only", "--quiet", target)
        what = f"deployed {head[:10]} -> {target[:10]}"
        print(what)
        print(git(repo, "log", "--oneline", f"{head}..{target}"))
    else:
        what = f"already at {target[:10]}"
        print(what)

    # The venv moves just before the restart, so the old process imports from the new venv for
    # no longer than the gap between the two. A link that cannot move puts the checkout back:
    # nothing restarts, and no mixed version runs.
    if venv["state"] == "swap":
        try:
            swap_venv(venv)
        except (subprocess.CalledProcessError, OSError) as exc:
            git(repo, "reset", "--hard", "--quiet", head)
            detail = getattr(exc, "stderr", b"") or str(exc)
            detail = detail.decode(errors="replace") if isinstance(detail, bytes) else detail
            return finish(LOCAL_REFUSED,
                          f"NOT DEPLOYED: the venv link could not be moved from {venv['from']} "
                          f"to {venv['to']} ({detail.strip()}). The checkout was put back at "
                          f"{head[:10]}, and nothing restarted.")
        print(f"venv: {VENV_LINK} -> mercury-venv-{venv['to']} (previous: {venv['from']})")

    # The restart, and proof by IDENTITY that the RUNNING process is the target.
    before = unit()
    row.update(pid_before=before["MainPID"], restart_issued_at=iso_ms(clock()))
    try:
        (restart or (lambda: subprocess.run(["sudo", "systemctl", "restart", SERVICE],
                                            check=True, capture_output=True, text=True)))()
    except (subprocess.CalledProcessError, OSError) as exc:
        detail = getattr(exc, "stderr", "") or str(exc)
        return finish(UNHEALTHY, _mixed_headline(health or _health, target)
                      + f"{what}, NOT restarted: {str(detail).strip()}")
    ok, seen, reason = wait_for_running(target, before["MainPID"], health or _health,
                                        unit, clock, sleep)
    body = (seen or {}).get("health") or {}
    state = (seen or {}).get("unit") or {}
    row.update(pid_after=state.get("MainPID"), systemd_start=state.get("start"),
               running_pid=body.get("pid"), running_commit=body.get("commit"),
               app_started_at=body.get("started_at"))
    if not ok:
        moved = (f" The venv link names {venv['to']}; scripts/host-steps/venv-rollback.sh points "
                 f"it back at {venv['from']}." if venv["state"] == "swap" else "")
        return finish(UNHEALTHY, _mixed_headline(health or _health, target)
                      + f"{what}, restart issued, but NOT confirmed running: {reason}.{moved}")
    # Can it serve (C2514)? Asked once it is confirmed running, and only READ: a release that
    # is not ready is reported FAILED and left running; the rollback is a person's, offered by
    # Needs attention, never taken here (the operator, 2026-11-05).
    ready_now = wait_for_ready(health or _health, clock, sleep)
    row.update(ready={k: ready_now[k] for k in ("state", "step", "error", "seconds", "bound_s",
                                                  "not_ready")})
    print(f"readiness: {ready_now['words']}")
    # The checkout's other long-running units (C1404), once the app runs the target: each
    # restarted and confirmed by its new MainPID, or the verdict says which still runs old code.
    units_ok, units_words = restart_checkout_units(
        restart_unit or (lambda u: subprocess.run(["sudo", "systemctl", "try-restart", u],
                                                  check=True, capture_output=True, text=True,
                                                  timeout=120)),
        unit_of or (lambda u: unit_state(u)), clock, sleep)
    row.update(checkout_units=units_words)
    for line in units_words:
        print(line)
    not_ready = ready_now["state"] in ("failed", "warming")
    if not units_ok:
        return finish(UNHEALTHY, f"{what}, {SERVICE} restarted and running {target[:10]}, but "
                                 "not every unit that runs the checkout was: "
                                 + "; ".join(w for w in units_words if "NOT" in w)
                                 + (f"; and it is NOT READY: {ready_now['words']}"
                                    if not_ready else ""))
    if not_ready:
        back = (f"the previous release, {head[:10]}" if head != target
                else "the release before it")
        return finish(NOT_READY,
                      f"FAILED, NOT READY: {what}, restarted and running {target[:10]} as pid "
                      f"{state.get('MainPID')}, but {ready_now['words']}. It was NOT rolled "
                      f"back: Needs attention offers the rollback to {back}. {message}")
    pruned = ""
    if venv["state"] == "swap":
        # Keep the current venv and the previous one (the operator, 2026-10-09).
        removed, held = prune_venvs({venv["to"], venv["from"]})
        pruned = (f" venv: running {venv['to']}, previous {venv['from']}"
                  + (f"; removed {', '.join(os.path.basename(d) for d in removed)}" if removed
                     else "")
                  + (f"; kept {', '.join(os.path.basename(d) for d in held)} (a running process "
                     "has it loaded)" if held else "") + ".")
    return finish(OK, f"{what}, restarted: pid {before['MainPID']} -> {state.get('MainPID')}, "
                      f"running {target[:10]} since {state.get('start')} (systemd). {message}"
                      + pruned)


def _wait_for_ci(repo, target, get, clock, sleep, row, store=None, override=None):
    """Follow a PENDING verdict for the SAME target until it is anything else,
    or the bound. Each poll prints what the run is doing and how long this has
    waited against the measured typical, so a wait going slowly can be told
    from one going wrong. Any other verdict (passed, failed, cancelled,
    could-not-ask) ends the wait at once and is returned unchanged: the gate
    is the same gate, only the retrying moved from the person to the tool.

    While the run waited for is the LOCAL runner's (its PENDING sentence), the bound is
    `local_wait_bound`: about 2.5 times its own measured runs, never below GitHub's."""
    start = clock()
    code, message = CI_PENDING, ""
    while True:
        waited = clock() - start
        local = verdict_source(message) == "local"
        bound = local_wait_bound(store) if local else WAIT_BOUND_S
        basis = ("~2.5x the local runner's median run" if local and bound > WAIT_BOUND_S
                 else "~2.5x the measured p90")
        if waited >= bound:
            row["waited_s"] = round(waited)
            return CI_PENDING, (f"still PENDING after waiting {round(waited)} s (the bound, "
                                f"{bound} s, is {basis}): {message} "
                                "Not deployed. Look at the run before waiting again.")
        sleep(WAIT_POLL_S)
        code, message = ci_verdict(repo, target, get, store, override)
        waited = clock() - start
        if code != CI_PENDING:
            row["waited_s"] = round(waited)
            print(f"waited {round(waited)} s: {message}")
            return code, message
        print(f"waiting {round(waited)} s of at most {bound} s ({MEASURED_TYPICAL}): "
              f"{message.split('. Wait,')[0]}")


def _mixed_headline(health, target: str) -> str:
    """The FIRST line of a failed verdict when the service runs another commit
    than the checkout: what the state is and the one command that ends it
    (the operator: exit 5 with a paragraph told nobody what to do)."""
    try:
        _status, body = health()
    except Exception:                                  # noqa: BLE001
        body = None
    running = (body or {}).get("commit") or ""
    if not running:
        return (f"POSSIBLY MIXED VERSION: checkout at {target[:10]}, and /health did not say "
                f"what the service runs -- run `sudo systemctl restart {SERVICE}`\n")
    if running != target:
        return (f"MIXED VERSION: checkout at {target[:10]}, service running {running[:10]} "
                f"-- run `sudo systemctl restart {SERVICE}`\n")
    return ""


def operations_words(ops):
    """Each operation holding a device, in words."""
    return "; ".join(f"{o.get('device', '?')} ({o.get('operation', '?')} since "
                     f"{o.get('since', '?')}, list {o.get('list', '?')}, pid {o.get('pid', '?')})"
                     for o in ops)


#: What `/health/operations` answers in its ``holds`` field when it cannot read the device
#: holds (routes/health.py, C988). This script runs apart from the app (the updater loads a
#: root-owned copy), so the value is repeated here, and
#: tests/test_device_holds_unreadable.py holds the two equal through the real route.
HOLDS_UNREADABLE = "unreadable"


def _body_of(exc):
    """The JSON object an HTTP error carried, or {} (a 404 from an older version is HTML)."""
    try:
        body = json.loads(exc.read().decode())
    except (OSError, ValueError, AttributeError):
        return {}
    return body if isinstance(body, dict) else {}


def _operations():
    """``("busy", [ops])`` when the running service holds a device, ``("clear", [])`` when
    it says it holds none, ``("unreadable", why)`` when it ANSWERS that it cannot read the
    holds (C991: refused, a device may be held), ``("unknown", why)`` when it cannot say
    (R5: not answering, a version that predates the route, any other failure)."""
    port = os.environ.get("NMAS_PORT", "5000")
    url = os.environ.get("NMAS_OPERATIONS_URL",
                         f"http://127.0.0.1:{port}/health/operations")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        body = _body_of(exc)
        error = str(body.get("error") or "").strip()
        if body.get("holds") == HOLDS_UNREADABLE:
            return "unreadable", (f"/health/operations answered {exc.code} with holds "
                                  f"{HOLDS_UNREADABLE!r}: "
                                  + (error or "it gave no reason"))
        return "unknown", (f"/health/operations answered {exc.code}"
                           + (": the running version predates it" if exc.code == 404 else "")
                           + (f": {error}" if error else ""))
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return "unknown", f"the service is not answering ({exc})"
    if not isinstance(body, dict) or not body.get("ok"):
        return "unknown", str((body or {}).get("error") or "it answered without a verdict")
    ops = body.get("operations") or []
    return ("busy", ops) if ops else ("clear", [])


def _health():
    """(status, body or None) from the app's /health."""
    port = os.environ.get("NMAS_PORT", "5000")
    url = os.environ.get("NMAS_HEALTH_URL", f"http://127.0.0.1:{port}/health")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except (urllib.error.URLError, OSError, ValueError):
        return 0, None


if __name__ == "__main__":
    # Phase 4 section 8.1: the interpreter flask-app runs. In this block, not at the top: root's
    # updater loads a copy of this file as a module from beside no checkout (it imports nothing
    # outside the standard library at its top, which tests/test_app_interpreter.py holds).
    # realpath, not abspath (C646): DEPLOY_LINUX links this file into ~/bin, and through the
    # link abspath names ~/bin's parent, where there is no checkout.
    sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
    from modules.app_interpreter import adopt
    adopt(__name__)
    sys.exit(main())
