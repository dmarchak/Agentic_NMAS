{
 "NMAS": [
  {
   "interval": "1m",
   "name": "nmas-heartbeat",
   "rules": [
    {
     "annotations": {
      "description": "r1 emits NMAS-HEARTBEAT every 300 s by its own clock. Window 750 s, measured from this device's own 61 heartbeat gaps (299.8-300.3 s; clock rate 1.0). None arrived in the window: the device, its logging block, the path to rsyslog, rsyslog, Alloy or Loki has stopped. The heartbeat cannot say which; it says that one of them has.",
      "summary": "No syslog heartbeat from r1 for 750 s"
     },
     "expr": "",
     "for": "0s",
     "grafana_alert": {
      "condition": "C",
      "data": [
       {
        "datasourceUid": "efxk88ulvh3pcf",
        "model": {
         "expr": "sum(count_over_time({job=\"network_syslog\"} |= \"NMAS-HEARTBEAT\" |~ `%HA_EM-\\d-LOG: NMAS\\-HEARTBEAT: NMAS\\-HEARTBEAT` |~ `\\sr1:\\s` [750s]))",
         "intervalMs": 1000,
         "maxDataPoints": 43200,
         "queryType": "instant",
         "refId": "A"
        },
        "queryType": "instant",
        "refId": "A",
        "relativeTimeRange": {
         "from": 750,
         "to": 0
        }
       },
