#!/usr/bin/env bash
# Run the test suite where NO process it starts can reach a network (C46).
#
#   scripts/nmas-test [pytest arguments]           confined, or refuse
#   scripts/nmas-test --allow-unconfined [args]    confined if possible; if
#                                                  not, run anyway and SAY so
#
# Why: "no test touches a live network" held for the test process and for
# nothing it started. A test ran the lab's sync script with its default URL,
# which on the deployment host IS the NMAS, and the live app logged the
# request on every host run (2026-09-26). Only the kernel covers every child,
# in any language, so the suite runs in a network namespace holding loopback
# alone. The conftest then MEASURES the confinement (a route lookup, no
# packet) and, because this script sets NMAS_REQUIRE_NETWORK_CONFINEMENT=1,
# stops if it does not hold.
#
# How: an unprivileged user namespace mapped to root, only long enough to
# bring loopback up, then a nested one mapped back to your own uid and gid. A
# test running as root would pass every "refuses an unreadable file" check,
# because root reads anything.
#
# Where it cannot run: Ubuntu 24.04 restricts unprivileged user namespaces
# through AppArmor (kernel.apparmor_restrict_unprivileged_userns=1), and the
# deployment host refuses them. There this script REFUSES, naming the reason,
# unless --allow-unconfined is given; then the run is unconfined and the
# first line says so. It never claims a confinement it did not get.

set -u

# No bytecode is written by a test run (C120). A negative control mutates a
# file and restores it from a copy; when the mutation keeps the file's size
# and the restore lands in the same second, the cached .pyc still matches
# (Python compares mtime at 1 s resolution, and size) and the NEXT run
# executes the mutated code while the file on disk reads correct. Measured
# 2026-09-27: `_NEIGHBOR_DROP_TOLERANCE = 1` ran after the file said 0.
export PYTHONDONTWRITEBYTECODE=1

# THE BOUND COMES FROM A MEASUREMENT, not a round number chosen to be safe
# (the operator, 2026-09-28): a timeout "to be safe" converts every hang into
# its full length. The suite measured 121 s of tests, 125 s wall, serial on
# the laptop (5025 tests), and ~78 s parallel on the host; 300 s is 2.5x the
# serial figure. Re-derive it when the serial time moves, and say so here.
TIMEOUT="${NMAS_TEST_TIMEOUT:-300}"

# A TIMEOUT THAT FIRES SAYS WHAT WAS RUNNING. Each test process (the main one,
# or each xdist worker) writes the test it has started into this directory
# and clears it when the test finishes (tests/conftest.py), and dumps every
# thread's stack here when the bound's SIGTERM arrives. A bare "timed out"
# names nothing; the test and its stack are the start of a diagnosis.
INFLIGHT="$(mktemp -d "${TMPDIR:-/tmp}/nmas-test-inflight.XXXXXX")"
export NMAS_TEST_INFLIGHT="$INFLIGHT"
trap 'rm -rf "$INFLIGHT"' EXIT

report_timeout() {
  echo "nmas-test: TIMED OUT after ${TIMEOUT} s (NMAS_TEST_TIMEOUT). Running when it stopped:" >&2
  found=0
  for f in "$INFLIGHT"/running-*; do
    [ -s "$f" ] || continue
    found=1
    IFS=$'\t' read -r nodeid started < "$f"
    echo "  ${f##*/running-}: $nodeid (started $(( $(date +%s) - ${started%.*} )) s before the report)" >&2
  done
  [ "$found" -eq 1 ] || echo "  no test was in progress: the hang is outside a test (collection, a fixture's teardown at session end, or the harness)" >&2
  # When the tests FINISHED (tests/conftest.py writes it as each one does), so
  # a timeout after the last test says how long the session's end had run.
  if [ -s "$INFLIGHT/progress-main" ]; then
    IFS=$'\t' read -r done last < "$INFLIGHT/progress-main"
    msg="${done} test(s) had finished; the last $(( $(date +%s) - ${last%.*} )) s before the report"
    echo "  $msg" >&2
  else
    msg="no test had finished"
  fi
  # In CI the log needs authentication and an annotation does not.
  if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
    echo "::error title=nmas-test timed out::after ${TIMEOUT} s (NMAS_TEST_TIMEOUT): $([ "$found" -eq 1 ] && echo "a test was in progress (see the log)" || echo "no test in progress"); ${msg}"
  fi
  for f in "$INFLIGHT"/stack-*; do
    [ -s "$f" ] || continue
    echo "--- stacks of ${f##*/stack-} at the SIGTERM ---" >&2
    cat "$f" >&2
  done
  # A process with a test in progress and no stack printed: which of the two it was (C567,
  # 2026-10-12: CI run #698's report printed no stack section at all, 4 s into the hang).
  # Absent: the process never opened its stack file; empty: it opened it and the SIGTERM's
  # dump wrote nothing into it.
  for f in "$INFLIGHT"/running-*; do
    [ -s "$f" ] || continue
    p="${f##*/running-}"
    if [ ! -e "$INFLIGHT/stack-$p" ]; then
      echo "  no stack for ${p}: its stack file is absent" >&2
    elif [ ! -s "$INFLIGHT/stack-$p" ]; then
      echo "  no stack for ${p}: its stack file is empty (0 bytes)" >&2
    fi
  done
}

# Run under the bound, then report. Not `exec`: the report runs after.
# Without a terminal (the gate, CI) `timeout` runs the command in a process group of its own and
# signals the whole group, so xdist workers get the SIGTERM too, and --kill-after ends anything
# that ignores it.
#
# WITH A TERMINAL (C1414, the operator, 2026-10-20: a run from a terminal hung for ever in state
# T, and Ctrl+C could not reach it): that group of its own is a BACKGROUND group on the
# terminal, so the first touch of the terminal stops it (SIGTTIN, SIGTTOU) and the terminal's
# Ctrl+C goes to the foreground group it is not in. `--foreground` keeps it in the terminal's
# own group; `timeout` then signals only the command, so on a fired bound what the run left
# (the workers, anything a test started) is ended by IDENTITY: this run's own INFLIGHT folder
# in its environment, never a name pattern.
end_leftovers() {
  local p pids=()
  for p in /proc/[0-9]*; do
    [ "${p#/proc/}" = "$$" ] && continue
    if tr '\0' '\n' < "$p/environ" 2>/dev/null | grep -qxF "NMAS_TEST_INFLIGHT=$INFLIGHT"; then
      pids+=("${p#/proc/}")
    fi
  done
  [ "${#pids[@]}" -eq 0 ] && return 0
  echo "nmas-test: ending ${#pids[@]} process(es) this run left (each names $INFLIGHT): ${pids[*]}" >&2
  kill -TERM "${pids[@]}" 2>/dev/null
  sleep 2
  kill -KILL "${pids[@]}" 2>/dev/null
  return 0
}

run() {
  if [ -t 0 ]; then
    timeout --foreground --kill-after=15 "$TIMEOUT" "$@"
    rc=$?
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then report_timeout; end_leftovers; fi
  else
    timeout --kill-after=15 "$TIMEOUT" "$@"
    rc=$?
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then report_timeout; fi
  fi
  exit "$rc"
}

allow=0
args=()
for a in "$@"; do
  case "$a" in
    --allow-unconfined) allow=1 ;;
    *) args+=("$a") ;;
  esac
done
# THE INTERPRETER IS CI'S (the operator, 2026-10-14: from a terminal whose python3 was 3.14 the
# suite ran on 3.14 without a word, while the gate and CI run the version ci.yml pins). A
# PYTHON given is honoured (the gate and nmas-deploy pass theirs) and said when it is not
# CI's version; otherwise CI's environment (scripts/nmas-ci-env's venv), else python3 only when
# it IS CI's version; anything else refuses, naming both versions and the fix.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ci_py="$(sed -n 's/.*python-version: *"\([0-9.]*\)".*/\1/p' "$here/.github/workflows/ci.yml" 2>/dev/null | head -1)"
ci_env="$HOME/.local/share/nmas-py312/bin/python"
if [ -n "${PYTHON:-}" ]; then
  PY="$PYTHON"; how="PYTHON"
elif [ -x "$ci_env" ]; then
  PY="$ci_env"; how="CI's environment, scripts/nmas-ci-env"
else
  PY="python3"; how="python3 on PATH"
fi
have="$("$PY" -c 'import platform; print(platform.python_version())' 2>/dev/null)"
if [ -z "${PYTHON:-}" ] && [ -n "$ci_py" ] && [ "$have" != "$ci_py" ]; then
  echo "nmas-test: REFUSED: $PY ($how) is Python ${have:-that would not start}; CI runs $ci_py (.github/workflows/ci.yml)." >&2
  echo "  Build CI's environment once: scripts/nmas-ci-env <a Python $ci_py> (docs/TESTING.md, \"CI's interpreter here\")," >&2
  echo "  or name an interpreter: PYTHON=<python> scripts/nmas-test ..." >&2
  exit 2
fi
if [ -n "$ci_py" ] && [ "$have" != "$ci_py" ]; then
  py_line="nmas-test: python: $PY (${have:-unknown}, $how; not CI's $ci_py)"
else
  py_line="nmas-test: python: $PY (${have:-unknown}, $how)"
fi

# WORKERS FROM THE MEMORY AVAILABLE NOW, AND ONE FULL-SUITE RUN AT A TIME (the operator,
# 2026-10-19: the laptop's RAM ran out with the gate's four shards at -n 4 and two agents' runs
# beside them). A -n asked for is lowered to what scripts/nmas-workers allows now (a run that
# is unconfined may start a headless browser, so it counts one), and said; a run naming no test
# file is the full suite, and takes the full-suite lock the gate takes, or refuses naming who
# holds it.
browsers=0
[ "$allow" -eq 1 ] && browsers=1
cap_workers() {
  local req="$1" ask got
  ask="$req"; [ "$req" = "auto" ] && ask=4
  got="$("$PY" "$here/scripts/nmas-workers" --browsers "$browsers" --cap "$ask" 2>/dev/null)" || got="$ask"
  if [ "$req" = "auto" ] || [ "$got" -lt "$ask" ]; then
    echo "nmas-test: -n $req lowered to $got: $("$PY" "$here/scripts/nmas-workers" --browsers "$browsers" --explain 2>/dev/null)" >&2
  fi
  echo "$got"
}
full=1
capped=()
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  a="${args[$i]}"
  case "$a" in
    -n|--numprocesses) capped+=(-n "$(cap_workers "${args[$((i+1))]}")"); i=$((i+2)); continue ;;
    --numprocesses=*) capped+=(-n "$(cap_workers "${a#*=}")") ;;
    -n[0-9]*|-nauto) capped+=(-n "$(cap_workers "${a#-n}")") ;;
    tests/*|*.py|*.py::*) full=0; capped+=("$a") ;;
    *) capped+=("$a") ;;
  esac
  i=$((i+1))
done
args=("${capped[@]}")
if [ "$full" -eq 1 ]; then
  lock="${NMAS_FULL_LOCK:-$HOME/.cache/nmas/full-suite.lock}"
  mkdir -p "$(dirname "$lock")"
  exec 9<>"$lock"
  if ! flock -n 9; then
    echo "nmas-test: REFUSED: another full-suite run holds $lock ($(head -1 "$lock" 2>/dev/null || echo unnamed)): at most one runs at a time (the operator, 2026-10-19); wait for it, or name the test files to run" >&2
    exit 75
  fi
  echo "nmas-test (pid $$)" > "$lock"
fi

why="$(unshare -rn true 2>&1)"
if [ $? -eq 0 ]; then
  echo "nmas-test: network: CONFINED (a loopback-only network namespace, as uid $(id -u))"
  echo "$py_line"
  run unshare -rn sh -c '
    ip link set lo up || { echo "nmas-test: could not bring loopback up" >&2; exit 2; }
    uid="$1"; gid="$2"; py="$3"; shift 3
    exec unshare --map-user="$uid" --map-group="$gid" \
      env NMAS_REQUIRE_NETWORK_CONFINEMENT=1 "$py" -m pytest "$@"
  ' nmas-test "$(id -u)" "$(id -g)" "$PY" "${args[@]}"
fi

why="${why:-unshare failed with no message}"
if [ "$allow" -eq 1 ]; then
  echo "nmas-test: network: NOT CONFINED: no network namespace here ($why). Processes the suite starts CAN reach the network; the test process itself still refuses non-loopback connects."
  echo "$py_line"
  run "$PY" -m pytest "${args[@]}"
fi
echo "nmas-test: REFUSED: no network namespace can be made here: $why" >&2
echo "  Processes the suite starts could reach the network. On Ubuntu 24.04 an ordinary" >&2
echo "  terminal needs a one-time AppArmor profile, or VS Code's terminal (docs/TESTING.md," >&2
echo "  \"From an ordinary terminal\"). To run anyway, and have the run say so:" >&2
echo "  scripts/nmas-test --allow-unconfined ..." >&2
exit 2
