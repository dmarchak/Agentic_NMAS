# TEMPLATE (2026-09-30): the repository is public, so the host's paths are
# placeholders. Render it, never copy it (docs/UPDATE.md has the whole install):
#   d=$(mktemp -d) && scripts/nmas-render-units --out "$d" deploy/systemd/nmas-update.path deploy/systemd/nmas-update.service && sudo install -o root -g root -m 0644 "$d/nmas-update.path" "$d/nmas-update.service" /etc/systemd/system/
# The Update button: the app writes a request into this directory and holds no
# privilege; this unit starts the root-owned updater when a request appears.
# The updater empties the directory every run, so it starts once per request.
[Unit]
Description=NMAS: start the updater when the app writes an update request

[Path]
DirectoryNotEmpty=@NMAS_CHECKOUT@/data/update/requests
Unit=nmas-update.service

[Install]
WantedBy=multi-user.target
