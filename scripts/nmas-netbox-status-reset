#!/usr/bin/env python3
"""Correct the device statuses NMAS wrote from a ping result.

Until 2026-09-24 the sync set a device's NetBox status from the in-memory ping
cache, so a single ICMP or TCP attempt that did not answer within five seconds
of the sync wrote `offline` into the source of truth as a standing claim.
Measured: NetBox called s1 offline while s1 was answering SSH.

The writer is fixed — `status` is gone from the update allowlist — and **that
alone leaves every wrong value in place for ever**, because nothing will ever
write the field again. This corrects them once.

After the change the field means *NMAS onboarded this device*, not *it answered
a ping*. So the target is `active`, and it is claimed only for devices NMAS
created: **provenance governs**, exactly as removal does. A device a human
curated, or deliberately marked `planned`, `staged` or `decommissioning`, is
reported and left alone.

    python3 scripts/nmas-netbox-status-reset              # dry run
    python3 scripts/nmas-netbox-status-reset --apply

Dry run by default. Every change goes through `_nb_patch`, so it is gated on
`netbox_allow_writes` and recorded in the modification log like any other.
"""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

TARGET = "active"


def _collect(session, base, list_name):
    """(eligible, skipped) — devices NMAS created whose status is not active."""
    from modules.netbox_client import _nb_get
    from modules.netbox_guard import has_managed_tag, was_created_by_nmas

    eligible, skipped = [], []
    for dev in _nb_get(session, base, "dcim/devices/"):
        status = (dev.get("status") or {}).get("value") or ""
        if status == TARGET:
            continue
        ours = (has_managed_tag(dev)
                or was_created_by_nmas(list_name, "dcim/devices", dev.get("id")))
        row = {"id": dev.get("id"), "name": dev.get("name") or dev.get("display"),
               "status": status}
        (eligible if ours else skipped).append(row)
    return eligible, skipped


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true",
                    help="actually write; without it nothing is changed")
    ap.add_argument("--list", dest="list_name", default="",
                    help="the device list whose created-id record to consult")
    args = ap.parse_args()

    from modules.netbox_client import _nb_patch, _nb_ready
    from modules.netbox_guard import for_list

    ok, err, session, base = _nb_ready()
    if not ok:
        print(f"UNPROVEN — NetBox is not reachable: {err}")
        print("Nothing was examined. That is not the same as nothing needing "
              "correction.")
        return 2

    list_name = args.list_name
    if not list_name:
        from modules.config import get_current_list_name
        list_name = get_current_list_name()

    eligible, skipped = _collect(session, base, list_name)

    print(f"list: {list_name}")
    print(f"{len(eligible)} device(s) NMAS created with a status other than "
          f"'{TARGET}'")
    for row in eligible:
        print(f"    {row['name']:20s} {row['status'] or '(none)'} → {TARGET}")
    if skipped:
        print(f"\n{len(skipped)} device(s) SKIPPED — NMAS did not create them, "
              "so their status is somebody's decision:")
        for row in skipped:
            print(f"    {row['name']:20s} {row['status'] or '(none)'}")

    if not eligible:
        print("\nNothing to correct.")
        return 0

    if not args.apply:
        print("\nDRY RUN — nothing was written. Re-run with --apply.")
        return 0

    changed = failed = 0
    with for_list(list_name, actor=f"{os.environ.get('USER') or 'unknown'} "
                                   "(nmas-netbox-status-reset)"):
        for row in eligible:
            try:
                _nb_patch(session, base, f"dcim/devices/{row['id']}/",
                          {"status": TARGET})
                changed += 1
            except Exception as exc:
                failed += 1
                print(f"    FAILED {row['name']}: {exc}")

    print(f"\n{changed} corrected, {failed} failed")
    if failed:
        return 1
    print("Recorded in the modification log like any other write — "
          "scripts/nmas-netbox-modified")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
