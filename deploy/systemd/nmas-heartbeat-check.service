# TEMPLATE (2026-09-29): the repository is public, so the host's user and paths
# are placeholders. Render it, never copy it:
# OPEN_FINDINGS C16: re-measure each device's heartbeat rate and compare with
# the installed windows. A moved rate fails this unit, and job_health shows it.
#   scripts/nmas-render-units --out /tmp/nmas-units deploy/systemd/nmas-heartbeat-check.*
#   sudo install -m 0644 /tmp/nmas-units/nmas-heartbeat-check.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nmas-heartbeat-check.timer
[Unit]
Description=NMAS: heartbeat windows still fit each device's measured clock rate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@NMAS_USER@
Group=@NMAS_USER@
Environment=NMAS_LOKI_URL=http://127.0.0.1:3100
ExecStart=@NMAS_CHECKOUT@/scripts/nmas-heartbeat-rules --check
TimeoutStartSec=10min
