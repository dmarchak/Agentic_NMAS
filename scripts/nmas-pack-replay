#!/usr/bin/env python3
"""Replay a past alert's evidence pack, and Explain it before and after (PHASE8_PLAN 15.15's
"tokens and cost per Explain call, before and after, on a replayed incident"; C1712, C1714).

    # on the host, the deployed copy run as a file (it adopts the app's interpreter): the pack
    # as of <time>, written outside the checkout, nothing asked of a model
    nmas-host nmas -- <checkout>/scripts/nmas-pack-replay --network <network> \\
        --device <device> --at <YYYY-MM-DDTHH:MM:SSZ> --out /tmp/pack.json
    # and Explain it twice through the gateway, as <actor>: prompt v1 (the pack alone) and the
    # current prompt (the topology and the health figures)
    nmas-host nmas -- <checkout>/scripts/nmas-pack-replay --network <network> \\
        --device <device> --at <time> --out /tmp/pack.json --explain --actor <actor>

C1547's replay: `--onset 2026-10-22T07:40:44Z --at 2026-10-22T08:20:00Z` with the router whose
OSPF drops were measured, so the health figures' window is 07:25:44 to 08:20:00 (15 minutes
before the onset to the alert's time); the onset reaches the window only through `--onset`.

**The pack is the product's own** (`evidence_pack.build`, `now=` the alert's time): Prometheus
asked as of that time (the neighbours, the health figures), Loki over the windows ending at it
(the log lines, the heartbeats), and the observed topology from the Topology reader's own code
run over Prometheus as it was then (`topology_graph.read` with `prometheus_series(at=)`), given
to the build in place of the reader's stored value, which is today's. What cannot be read as
of then is said in the pack: History leaves out what it recorded after the time, and the Intent
check is of the committed golden now, the section's source says so.

**The alert is synthesized: no Grafana rule in the lab alerts on an OSPF adjacency** (C38,
scheduled: nothing alerts on a protocol adjacency; the rules,
tests/fixtures/grafana/rules_view.json: a heartbeat rule per device, Interface down, gRPC
telemetry stream lost, Critical syslog received (severities 0 to 2; OSPF's ADJCHG is 5),
Device unreachable (SNMP), Interface error rate elevated, Interface output discards, IP SLA
probe failing). It is a firing instance in the alerts reader's own shape (`grafana_alerts`):
rule `--rule` (by default "Replayed: OSPF adjacency drops"), its `device` label the device,
`device_from` label (as a heartbeat rule's), its condition first holding at `--onset` (by
default `--at`), alerting from `--at`, no pending time and no window, so its onset is the
onset given. The pack's trigger says it was replayed, and when.

**`--episode <id>`** rebuilds a past alert's pack from the alert history instead (Monitoring ›
Alerts › History's Build evidence, its own builder, `evidence_pack.build_for_episode`), named
as built by `--actor`: the pack a case of a rebuilt alert is asked on (C1849 to C1851), had
even where the pack record already keeps one of an earlier schema, which stays frozen.

    nmas-host nmas -- <checkout>/scripts/nmas-pack-replay --episode <episode id> \\
        --actor evaluation:<run> --out /tmp/pack.json [--explain --prompt 4]

**Where the pack goes:** `--out` only, never inside the checkout, and never Mercury's pack store:
Explain takes the pack in hand (`explain.explain_pack`), the same checks as a stored one (its
hash, the classification seam, the topology class).

**`--explain`** asks through the real gateway (the allowance, the caps, the egress mask, the
record of AI calls), as `--actor`, twice: v1 (the six sections v1 knew, no topology, no
health) and the current prompt. Per call it prints the input, output, cache-write and cache-read
tokens and the cost from the call's record, then the answer's text as the model wrote it
(masked as recorded) and Mercury's check of it. It stops at a refusal that is not the model's
(hosted AI off, a cap), naming it, with nothing more spent.
"""
import os
import sys

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

import argparse  # noqa: E402
import calendar  # noqa: E402
import json  # noqa: E402
import time  # noqa: E402

RULE = "Replayed: OSPF adjacency drops"
STORE = "replay"
#: Refusals that are Mercury's or the provider's, not the model's: the run stops.
STOPS = ("ai_off", "no_key", "over_cap", "unknown_task", "unknown_model", "prompt",
         "prompt_too_long", "unmasked_secret", "provider_error", "rate_limited",
         "overloaded", "key_refused", "bad_request", "provider_down", "changed", "classified")
TOKENS = ("input_tokens", "output_tokens", "cache_creation_input_tokens",
          "cache_read_input_tokens")


def _iso(ts: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(float(ts)))


def _when(text: str) -> float:
    try:
        return float(calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ")))
    except (TypeError, ValueError):
        raise SystemExit(f"nmas-pack-replay: {text!r} is not a UTC time "
                         "(YYYY-MM-DDTHH:MM:SSZ)") from None


def instance(device: str, at: float, onset: float, rule: str = RULE) -> dict:
    """The synthesized firing instance, in the alerts reader's shape (the docstring says
    why there is no real one)."""
    return {"rule": rule, "rule_uid": "replay", "kind": "condition", "state": "Alerting",
            "value": "", "labels": {"alertname": rule, "device": device, "replay": "true"},
            "device": device, "device_from": "label", "active_at": _iso(onset),
            "starts_at": _iso(at), "fingerprint": "", "for_seconds": 0, "window_seconds": 0,
            "silences": []}


def observed_then(network: str, at: float, source=None) -> dict:
    """The Topology reader's value as of *at*, in its store's shape: the reader's own `read`
    over Prometheus evaluated at that time, for *network* alone (RIP left out: its reader's
    stored answer is today's, and the model does not carry RIP, C1711)."""
    from modules.nsot import listref
    from modules.readers import adjacencies
    from modules.readers import topology_graph as T

    # The network by its one id (C1903): ``--network default`` matched no registered name
    # ``Default`` and read an empty topology. An unknown name raises.
    nid = listref.network_id(network)
    value = T.read(source=source or (lambda: T.prometheus_series(network, at=at)),
                   population=lambda: [x for x in adjacencies.lists()
                                       if listref.network_id(x[1]) == nid],
                   clock=lambda: at, previous={}, rip=lambda clock: ({}, ""))
    return {"value": value, "value_at": _iso(at)}


def build(network: str, device: str, at: float, onset: float, rule: str = RULE,
          observed=None, now=None) -> dict:
    """The pack as of *at*, through the product's own builder."""
    from modules import evidence_pack as EP

    if observed is None:
        observed = observed_then(network, at)
    when = _iso(now if now is not None else time.time())
    return EP.build(instance(device, at, onset, rule), store=STORE, value_at=_iso(at), now=at,
                    observed_read=observed,
                    trigger=(f"replayed by scripts/nmas-pack-replay at {when}: a synthesized "
                             f"alert on {device} as of {_iso(at)}, no Grafana rule alerting "
                             "on what is replayed"))


def _row(call_id: str) -> dict:
    from modules.ai import calls
    return next((r for r in calls.read()["rows"] if r.get("id") == call_id), {})


def explain_twice(pack: dict, actor: str, out=print, ask=None, versions=None) -> int:
    """v1, then the current prompt (or the *versions* named, in order: `--prompt`, a
    candidate's before-and-after); each call's tokens, cost and answer printed. 0 when each
    was asked, 1 when a refusal stopped the run."""
    from modules.ai import explain, triggers

    ask = ask or explain.explain_pack
    prompts = ([("explain", int(v)) for v in versions] if versions
               else [("explain", 1), explain.PROMPT])
    for prompt in prompts:
        # An evaluation run, counted under its run (PHASE8_PLAN 18.3 rule 9).
        got = ask(pack, actor=actor, trigger=triggers.evaluation(actor), prompt=prompt)
        row = _row(got.get("call_id") or "") if got.get("call_id") else {}
        tokens = row.get("tokens") or {}
        out(f"== explain.v{prompt[1]}: "
            + ("answered and checked" if got.get("ok") else
               f"{got.get('error')}: {got.get('detail', '')}"))
        out("   " + ", ".join(f"{k} {int(tokens.get(k) or 0)}" for k in TOKENS)
            + f", cost ${float(row.get('cost_usd') or got.get('cost_usd') or 0):.4f}"
            + (f", call {got['call_id']}" if got.get("call_id") else ""))
        topo = got.get("topology") or {}
        if topo:
            out(f"   topology: {'sent' if topo.get('sent') else 'not sent'}"
                + (f", {len(topo.get('devices') or [])} devices, observed "
                   f"{topo.get('observed')}" if topo.get("sent") else
                   f" ({topo.get('why')})"))
        ctx = got.get("context")
        if ctx:
            # The context budget rule (v6): the level sent, and what was left out to fit.
            out(f"   context: level {ctx['level']}, estimate {ctx['estimate']} of "
                f"{ctx['budget']}; omitted for size: "
                + ("; ".join(ctx["dropped"]) or "nothing")
                + (f" (pack pieces: {ctx['pack_dropped']})" if ctx.get("pack_dropped") else ""))
        out("   answer as the model wrote it (masked as recorded):")
        out("   " + (row.get("response") or "(none: no answer was recorded)"))
        if got.get("error") in STOPS:
            out(f"nmas-pack-replay: stopped at {got['error']}, nothing more is asked")
            return 1
    return 0


def _out_path(out: str):
    """*out* made absolute, or None when it lies inside the checkout (said)."""
    path = os.path.abspath(os.path.expanduser(out))
    if os.path.realpath(path).startswith(os.path.realpath(ROOT) + os.sep):
        print(f"nmas-pack-replay: --out {out} is inside the checkout; write it elsewhere",
              file=sys.stderr)
        return None
    return path


def rebuild_episode(ap, args) -> int:
    """`--episode`: the past alert's pack rebuilt from the alert history by Build evidence's
    builder (`evidence_pack.build_for_episode`), written to --out (owner-only) and never kept in
    the pack record; with --explain, asked as `explain_twice` asks."""
    from modules import alert_history as AH
    from modules import config
    from modules import evidence_pack as EP

    if not (args.out and args.actor):
        ap.error("--episode needs --out and --actor (who the rebuilt pack names as building it)")
    out = _out_path(args.out)
    if out is None:
        return 2
    e, state, error = AH.find(args.episode[:40])
    if e is None:
        print(f"nmas-pack-replay: no past alert {args.episode[:40]} is in the alert history"
              + (f" (it cannot be read: {error})" if state == "unreadable" else ""),
              file=sys.stderr)
        return 1
    pack = EP.build_for_episode(e, actor=args.actor)
    with config.open_secure(out, "w") as fh:
        json.dump(pack, fh, indent=1, sort_keys=True)
    print(f"pack {pack['id']} (schema {pack['schema']}) of {e['rule']} on "
          f"{e['device'] or e['address'] or 'no one device'}, as of {pack['built_at']}, hash "
          f"{pack['hash'][:12]}, written to {out}: "
          + ", ".join(f"{s['name']} {s['state']}" for s in pack["sections"]))
    if not args.explain:
        return 0
    return explain_twice(pack, args.actor, versions=args.prompt)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    ap.add_argument("--network", default="")
    ap.add_argument("--device", default="")
    ap.add_argument("--at", default="", help="the alert's time, UTC, YYYY-MM-DDTHH:MM:SSZ")
    ap.add_argument("--onset", default="", help="when its condition first held (default --at)")
    ap.add_argument("--rule", default=RULE)
    ap.add_argument("--out", default="")
    ap.add_argument("--explain", action="store_true")
    ap.add_argument("--actor", default="")
    ap.add_argument("--prompt", action="append", type=int, default=None,
                    help="ask this Explain prompt version (repeatable, in order) in place of "
                         "v1 and the current one: a candidate's before-and-after")
    ap.add_argument("--pack", default="",
                    help="explain this pack, written earlier by --out, as it was built (its "
                         "hash checked), in place of building one: a pack is frozen once "
                         "built, so a case's five runs and a candidate's ask the same evidence "
                         "(an endpoint read the store no longer holds among it)")
    ap.add_argument("--model", default="",
                    help="ask Explain on this model in place of its pin, in this process "
                         "alone (a comparison: Haiku, Sonnet, Opus)")
    ap.add_argument("--episode", default="",
                    help="rebuild this past alert's pack from the alert history (its episode "
                         "id, as Monitoring › Alerts › History names it), with Build "
                         "evidence's own builder, as --actor: written to --out, never kept in "
                         "the pack record (a pack kept there is frozen, so a pack of a later "
                         "schema for a kept alert is had only this way)")
    args = ap.parse_args(argv)
    if args.explain:
        from modules.ai import cases
        # An evaluation is recorded under its run, never as a person (C1784, C1846).
        args.actor, refusal = cases.evaluation_actor(args.actor, "pack-replay")
        refusal = refusal or cases.measure_on("explain", args.model)
        if refusal:
            print(f"nmas-pack-replay: {refusal}", file=sys.stderr)
            return 2
        print(f"nmas-pack-replay: recorded as {args.actor}"
              + (f", on {args.model} (the pin file unchanged)" if args.model else ""))
    if args.episode:
        return rebuild_episode(ap, args)
    if args.pack:
        if not args.explain:
            ap.error("--pack explains a saved pack: it needs --explain")
        from modules import evidence_pack as EP
        with open(os.path.expanduser(args.pack), encoding="utf-8") as fh:
            pack = json.load(fh)
        if not EP.intact(pack):
            print(f"nmas-pack-replay: {args.pack}'s hash does not match its content; not "
                  "explained", file=sys.stderr)
            return 1
        print(f"pack {pack['id']} as of {pack['built_at']}, hash {pack['hash'][:12]}, read from "
              f"{args.pack}: " + ", ".join(f"{s['name']} {s['state']}"
                                           for s in pack["sections"]))
        return explain_twice(pack, args.actor, versions=args.prompt)
    if not (args.network and args.device and args.at and args.out):
        ap.error("building a pack needs --network, --device, --at and --out (or --pack to "
                 "explain a saved one)")
    at = _when(args.at)
    onset = _when(args.onset) if args.onset else at
    if at > time.time():
        ap.error(f"--at {args.at} is in the future")
    if onset > at:
        ap.error("--onset is after --at")
    out = _out_path(args.out)
    if out is None:
        return 2
    from modules.ai import cases
    args.network, refusal = cases.run_network(args.network)
    if refusal:
        print(f"nmas-pack-replay: {refusal}; no pack is built", file=sys.stderr)
        return 2
    try:
        observed = observed_then(args.network, at)
    except Exception as exc:                            # noqa: BLE001 (said, and stopped)
        print(f"nmas-pack-replay: the topology as of {args.at} could not be read "
              f"({type(exc).__name__}: {exc}); no pack is built", file=sys.stderr)
        return 1
    pack = build(args.network, args.device, at, onset, args.rule, observed=observed)
    from modules import config
    with config.open_secure(out, "w") as fh:
        json.dump(pack, fh, indent=1, sort_keys=True)
    sections = ", ".join(f"{s['name']} {s['state']}" for s in pack["sections"])
    print(f"pack {pack['id']} as of {pack['built_at']}, hash {pack['hash'][:12]}, written to "
          f"{out}: {sections}")
    if not args.explain:
        return 0
    return explain_twice(pack, args.actor, versions=args.prompt)


if __name__ == "__main__":
    sys.exit(main())
