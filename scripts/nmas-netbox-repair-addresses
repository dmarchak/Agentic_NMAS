#!/usr/bin/env python3
"""Give every interface back the addresses its golden config says it has.

**Dry run by default**, like the golden migration: it prints what it would
create and writes nothing unless `--apply` is passed, and `--apply` still
goes through the ordinary write gate.

## Why a repair pass rather than "the next import will fix it"

The import is golden-driven, so the addresses are recoverable -- **nothing
on any device was lost**; r3 still has `10.0.0.15` on Gi1 in its running
config. What was damaged is NetBox, and NetBox is not versioned.

But a re-import **with the old code** would walk the fleet again and
reproduce the same one-object-many-claimants state, because the lookup key
was the address. So the order is: the lookup fix lands, then this runs.
It refuses to run against a tree whose `_ensure_ip_address` is still
address-keyed, because a repair that recreates the damage is worse than no
repair.

## What it creates

One IPAddress per (interface, address) that a golden config declares and
NetBox lacks. Measured on the Lab 1 fleet: five routers each carrying
`GigabitEthernet1 / 10.0.0.15/24` and `2001:DB8::2/64`, where NetBox held
**one v4 object (destroyed on 2026-09-24) and one v6 object (still on r5,
the last writer)** -- so ten objects where there is now one.

It never deletes and never re-points. An address already on its own
interface is left alone; an address on a *different* interface is reported
and not touched, because moving it is what caused this.
"""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)


def _lookup_is_interface_keyed() -> bool:
    """The precondition, checked rather than assumed."""
    import inspect

    from modules import netbox_client as nc

    src = inspect.getsource(nc._ensure_ip_address)
    return "interface_id=interface_id" in src


class UnknownList(Exception):
    """The list argument named nothing. **Refused, never defaulted.**"""


class ExaminedNothing(Exception):
    """No devices resolved. **An examination of zero things is not a
    result**, and for a repair script the wrong conclusion it invites is
    *"the fleet is already correct"*."""


class NoExclusion(Exception):
    """No VRF is excluded, so this mode has nothing it could clean up."""


def resolve_list(list_name: str) -> tuple:
    """``(csv_path, registered_name)``, or refuse.

    **`load_saved_devices()` takes a PATH, not a list name.** Handed a name
    it fails to resolve the owning list, falls through to a CSV that does
    not exist, and returns `[]` — so the loop below ran zero times and every
    count downstream honestly reported zero. `default` and `Default`
    produced identical output, which is the tell: nothing downstream
    depended on the argument at all.

    **Not `get_list_data_dir()`**, which calls `os.makedirs()` — resolving a
    path there *creates* a list, so a typo at a repair script would silently
    make one. The registry is the authority, and a name it does not hold is
    refused with what it does hold.
    """
    import os as _os

    from modules import config as _config
    from modules.device import get_device_lists

    rows = get_device_lists()
    for row in rows:
        if list_name in (row["name"], row["filename"]):
            return (_os.path.join(_config.LISTS_DIR, row["filename"],
                                  "devices.csv"), row["name"])
    known = ", ".join(f"{r['name']} ({r['filename']})" for r in rows) or "none"
    raise UnknownList(f"no device list named {list_name!r}. Known: {known}")


def walk(list_name: str):
    """``(registered, rows)`` — each device with its golden and its NetBox
    interfaces, resolved once.

    Shared by the create plan and the residue scan **so the two cannot
    disagree about which interfaces are excluded.** A second copy of that
    rule is how the import and the clean-up come to hold different opinions,
    which is the defect this whole stage keeps finding one level down.
    """
    from modules.device import load_saved_devices

    # Resolve and count BEFORE opening a session: a refusal here is about
    # the argument, and making the operator configure NetBox to be told
    # their list name was wrong reports the second-most-useful fact first.
    # Same ordering as the census validating its baseline before taking one.
    csv_path, registered = resolve_list(list_name)
    devices = load_saved_devices(csv_path)
    if not devices:
        # THE FLOOR, and it matters more than the defect it guards. A repair
        # that examined nothing and reported "nothing to create" is a
        # vacuous pass wearing a careful parenthetical -- and here the wrong
        # conclusion it invites is "the fleet is already correct".
        raise ExaminedNothing(
            f"{registered!r} resolved no devices. Looked in {csv_path}"
            f" ({'the file is not there' if not os.path.exists(csv_path) else 'the file is there and holds no rows'}).")

    from modules.netbox_client import (_nb_get, _session_from_config,
                                       _scan_device_from_golden,
                                       get_netbox_config)

    cfg = get_netbox_config()
    session = _session_from_config(cfg)
    base = cfg["url"]

    rows, skipped = [], []
    for dev in devices:
        host = dev.get("hostname") or dev.get("name") or ""
        nb_dev = None
        for d in _nb_get(session, base, "dcim/devices/", name=host):
            nb_dev = d
            break
        if not nb_dev:
            skipped.append({"device": host, "why": "not in NetBox"})
            continue

        try:
            facts = _scan_device_from_golden(dev)
        except Exception as exc:
            skipped.append({"device": host, "why": f"no usable golden: {exc}"})
            continue
        if not facts or not facts.get("interfaces"):
            skipped.append({"device": host, "why": "golden declares no interfaces"})
            continue

        ifaces = {i.get("name"): i for i in
                  _nb_get(session, base, "dcim/interfaces/",
                          device_id=nb_dev["id"])}
        rows.append({"device": host, "facts": facts, "ifaces": ifaces})

    return {"list": registered, "csv": csv_path, "rows": rows,
            "skipped": skipped, "examined": len(devices),
            "session": session, "base": base}


def plan(list_name: str) -> dict:
    """What each device's golden config says, against what NetBox holds."""
    from modules.netbox_client import _nb_get, excluded_vrfs

    w = walk(list_name)
    session, base = w["session"], w["base"]
    excluded = excluded_vrfs()

    creates, elsewhere, excluded_rows = [], [], []
    for row in w["rows"]:
        host, ifaces = row["device"], row["ifaces"]
        for intf in row["facts"]["interfaces"]:
            nb_if = ifaces.get(intf.get("name"))
            if not nb_if:
                continue
            wanted = [c for c in ([intf.get("cidr")]
                                  + list(intf.get("secondary_ips") or [])
                                  + list(intf.get("ipv6_addresses") or []))
                      if c]
            # The SAME rule the import applies, from the same source. A
            # repair that recreated what the import excludes would put the
            # damage back one command later -- and would create it in the
            # GLOBAL TABLE, which is how id 84 came to be invisible to the
            # clean-up that went looking for it in a VRF.
            vrf_name = (intf.get("vrf_name") or "")
            if vrf_name and vrf_name.lower() in excluded:
                excluded_rows.extend(
                    {"device": host, "interface": intf["name"],
                     "interface_id": nb_if["id"], "address": c,
                     "vrf_name": vrf_name} for c in wanted)
                continue
            have = {a.get("address") for a in
                    _nb_get(session, base, "ipam/ip-addresses/",
                            interface_id=nb_if["id"])}
            for cidr in wanted:
                if any(_same(cidr, h) for h in have):
                    continue
                holder = _holder_of(session, base, cidr)
                r = {"device": host, "interface": intf["name"],
                     "interface_id": nb_if["id"], "address": cidr,
                     "held_by": holder}
                (elsewhere if holder else creates).append(r)

    return {"creates": creates, "elsewhere": elsewhere,
            "skipped": w["skipped"], "excluded": excluded_rows,
            "excluded_vrfs": sorted(excluded),
            "examined": w["examined"], "list": w["list"], "csv": w["csv"]}


def _same(a, b) -> bool:
    from modules.netbox_client import _same_address

    return _same_address(a, b)


def _holder_of(session, base, cidr):
    """Who currently holds an object with this value, if anyone.

    Reported rather than acted on: **moving an address is what caused
    this**, so a repair never re-points one.
    """
    from modules.netbox_client import _nb_get

    for obj in _nb_get(session, base, "ipam/ip-addresses/", address=cidr):
        if (obj.get("assigned_object_type") or "") == "dcim.interface":
            assigned = obj.get("assigned_object") or {}
            dev = (assigned.get("device") or {}).get("name", "?")
            return f"{dev} {assigned.get('name', '?')} (id {obj['id']})"
    return ""


def excluded_residue(list_name: str) -> dict:
    """Addresses NMAS created on an interface the import no longer models.

    **Keyed on the INTERFACE, from the golden config — not on NetBox's VRF
    field.** The first version matched `ip["vrf"]["name"]` against the
    excluded set and found nothing, while r1's `10.0.0.15/24` sat in NetBox
    as id 84. The reason is in NetBox's own refusal of the other four:
    *"Duplicate IP address found in the **global table**"*. The repair
    created it **with no VRF at all**, so there was no name to match and the
    counters honestly reported zero — *"examined every address in
    clab-mgmt, found none"* about an object that was never in clab-mgmt.

    Matching on the NetBox field was also a **second copy of the exclusion
    rule**, which is how the import and the clean-up come to disagree. The
    rule is defined on the config (`vrf forwarding clab-mgmt`), so both read
    it from there, through the same `walk()`.

    Provenance still governs, and the refusals are separate findings:
    `blocked` (a device's primary IP — deleting it nulls the primary, a
    **modification** rather than a deletion, which the cascade map does not
    cover), and `skipped` (not tagged, or not in NMAS's created record).
    """
    from modules import netbox_guard as guard
    from modules.netbox_client import _nb_get, excluded_vrfs

    excluded = excluded_vrfs()
    if not excluded:
        raise NoExclusion(
            "`netbox_excluded_vrfs` is empty, so no VRF is excluded and "
            "there is nothing this mode could be cleaning up")

    w = walk(list_name)
    session, base = w["session"], w["base"]

    # Interfaces the import now excludes, from the SAME source it uses.
    targets, examined_ifaces = {}, 0
    for row in w["rows"]:
        for intf in row["facts"]["interfaces"]:
            nb_if = row["ifaces"].get(intf.get("name"))
            if not nb_if:
                continue
            examined_ifaces += 1
            vrf_name = (intf.get("vrf_name") or "")
            if vrf_name and vrf_name.lower() in excluded:
                targets[nb_if["id"]] = (row["device"], intf["name"], vrf_name)

    created = guard.get_created(w["list"]) or {}
    recorded = {e.get("id") for e in created.get("ipam/ip-addresses", [])}

    primaries = {}
    for dev in _nb_get(session, base, "dcim/devices/"):
        for field in ("primary_ip4", "primary_ip6"):
            obj = dev.get(field) or {}
            if obj.get("id"):
                primaries[obj["id"]] = f"{dev.get('name')}.{field}"

    eligible, skipped, blocked = [], [], []
    examined_addrs = 0
    for iface_id, (host, iface_name, vrf_name) in sorted(targets.items()):
        for ip in _nb_get(session, base, "ipam/ip-addresses/",
                          interface_id=iface_id):
            examined_addrs += 1
            row = {"id": ip["id"], "address": ip.get("address"),
                   "device": host, "interface": iface_name,
                   "config_vrf": vrf_name,
                   "netbox_vrf": (ip.get("vrf") or {}).get("name") or "global",
                   "description": ip.get("description", "")}
            if ip["id"] in primaries:
                blocked.append(dict(row, why=f"it is {primaries[ip['id']]}"))
            elif not guard.has_managed_tag(ip):
                skipped.append(dict(row, why="no nmas-managed tag — not NMAS's"))
            elif ip["id"] not in recorded:
                skipped.append(dict(row, why="not in NMAS's created record"))
            else:
                eligible.append(row)

    return {"eligible": eligible, "skipped": skipped, "blocked": blocked,
            "excluded": sorted(excluded), "list": w["list"],
            "devices": w["examined"], "interfaces": examined_ifaces,
            "targets": len(targets), "addresses": examined_addrs,
            "device_skips": w["skipped"]}


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("list_name")
    ap.add_argument("--apply", action="store_true",
                    help="actually write (dry run otherwise)")
    ap.add_argument("--remove-excluded", action="store_true",
                    help="instead: delete addresses left in an excluded VRF")
    args = ap.parse_args()

    if not _lookup_is_interface_keyed():
        print("REFUSED — `_ensure_ip_address` is still keyed on the address.")
        print("Repairing now would recreate the damage on the next import. "
              "Land the lookup fix first.")
        return 2

    if args.remove_excluded:
        return _remove_excluded(args)

    # The ARGUMENT is checked before NetBox, so a wrong list name is not
    # reported as a configuration problem. `plan()` resolves and counts
    # before it opens a session.
    try:
        p = plan(args.list_name)
    except (UnknownList, ExaminedNothing) as exc:
        print(f"REFUSED — {exc}")
        print("Nothing was examined, which is not the same as nothing being "
              "wrong.")
        return 2
    except Exception as exc:                    # noqa: BLE001
        print(f"NetBox could not be read: {exc}")
        print("UNPROVEN — no comparison was made.")
        return 2

    print(f"list {p['list']!r}: examined {p['examined']} device(s) "
          f"from {p['csv']}")
    for row in p["skipped"]:
        print(f"skipped {row['device']}: {row['why']}")

    if p["excluded"]:
        # Named, not silent. The repair creating these is what put id 84 in
        # the global table in the first place.
        print(f"\n{len(p['excluded'])} address(es) NOT created — their VRF "
              f"is excluded ({', '.join(p['excluded_vrfs'])}):")
        for r in p["excluded"][:20]:
            print(f"  {r['device']} {r['interface']} {r['address']} "
                  f"(vrf {r['vrf_name']})")

    if p["elsewhere"]:
        print(f"\n{len(p['elsewhere'])} address(es) exist on ANOTHER "
              "interface and will NOT be moved:")
        for r in p["elsewhere"]:
            print(f"  {r['device']} {r['interface']} {r['address']} "
                  f"— currently on {r['held_by']}")
        print("  Moving one is what caused this. Delete it in NetBox if it "
              "is wrong, then re-run.")

    if not p["creates"]:
        print(f"\nNothing to create, against {p['examined']} device(s) "
              "examined.")
        # A repair that found nothing and a repair that could not look must
        # not print the same line. `plan()` refuses the second case outright
        # now, so reaching here means something really was compared.
        print("This is a statement about what was compared, not a claim "
              "that NetBox is correct.")
        return 0

    print(f"\n{len(p['creates'])} address(es) to create:")
    for r in p["creates"]:
        print(f"  {r['device']:16s} {r['interface']:24s} {r['address']}")

    if not args.apply:
        print("\nDry run. Nothing was created. Re-run with --apply.")
        return 0

    from modules import netbox_guard as guard
    from modules.netbox_client import (_ensure_ip_address,
                                       _session_from_config,
                                       get_netbox_config)

    cfg = get_netbox_config()
    session = _session_from_config(cfg)
    made, failed = 0, []
    with guard.for_list(args.list_name):
        for r in p["creates"]:
            try:
                _ensure_ip_address(session, cfg["url"], r["address"],
                                   interface_id=r["interface_id"],
                                   description=f"{r['device']} {r['interface']}")
                made += 1
            except Exception as exc:
                failed.append(f"{r['device']} {r['address']}: {exc}")

    print(f"\ncreated {made}, failed {len(failed)}")
    for f in failed:
        print(f"  {f}")
    return 1 if failed else 0


def _remove_excluded(args) -> int:
    from modules import netbox_guard as guard
    from modules.netbox_client import (_nb_delete, _session_from_config,
                                       get_netbox_config)

    try:
        r = excluded_residue(args.list_name)
    except (UnknownList, ExaminedNothing, NoExclusion) as exc:
        print(f"REFUSED — {exc}")
        print("Nothing was examined, which is not the same as nothing being "
              "wrong.")
        return 2
    except Exception as exc:                    # noqa: BLE001
        print(f"NetBox could not be read: {exc}")
        print("UNPROVEN — nothing was examined.")
        return 2

    # WHAT IT ACTUALLY LOOKED AT. "examined every address in clab-mgmt" was
    # a claim the previous version could not support: it matched a NetBox
    # field that was null and reported a count of zero, which reads as "I
    # looked and there is nothing there".
    print(f"list {r['list']!r}: {r['devices']} device(s), "
          f"{r['interfaces']} interface(s) in NetBox, "
          f"{r['targets']} of them excluded ({', '.join(r['excluded'])}), "
          f"{r['addresses']} address(es) on those interfaces")
    for row in r["device_skips"]:
        print(f"  skipped {row['device']}: {row['why']}")

    if not r["targets"]:
        # Supportable, and different from finding nothing ON them.
        print("\nNo interface in any device's golden config is in an "
              "excluded VRF, so there is nothing this mode applies to.")
        return 0

    for row in r["blocked"]:
        print(f"  BLOCKED {row['address']} (id {row['id']}) — {row['why']}")
        print("          deleting it would null that device's primary IP.")
    for row in r["skipped"]:
        print(f"  left alone {row['address']} (id {row['id']}) — {row['why']}")

    if not r["eligible"]:
        print(f"\nNothing eligible to remove, out of {r['addresses']} "
              f"address(es) on {r['targets']} excluded interface(s).")
        return 0

    print(f"\n{len(r['eligible'])} address(es) to delete:")
    for row in r["eligible"]:
        print(f"  {row['address']:24s} id={row['id']:<6} "
              f"{row['device']} {row['interface']} "
              f"(config vrf {row['config_vrf']}, netbox vrf "
              f"{row['netbox_vrf']})")

    if not args.apply:
        print("\nDry run. Nothing was deleted. Re-run with --apply.")
        return 0

    cfg = get_netbox_config()
    session = _session_from_config(cfg)
    gone, failed = 0, []
    with guard.for_list(r["list"]):
        for row in r["eligible"]:
            if _nb_delete(session, cfg["url"], "ipam/ip-addresses/", row["id"]):
                gone += 1
            else:
                failed.append(f"{row['address']} (id {row['id']})")
    print(f"\ndeleted {gone}, failed {len(failed)}")
    for f in failed:
        print(f"  {f}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
