#!/usr/bin/env python3
"""Prometheus's SNMP scrape targets, generated from the inventory (C232, C229).

    nmas-prometheus-targets                        # dry run: what would be written
    nmas-prometheus-targets --write /etc/prometheus/nmas
    nmas-prometheus-targets --check                # does the running Prometheus match?

Every device of every list, labelled `device` (its hostname) and `role` (the
inventory's, omitted where empty and said). Files, in the directory given:
`nmas-snmp-<dialect>.json` per platform, `nmas-snmp-all.json` for fleet-wide
jobs, `nmas-snmp-ipsla.json` for devices whose committed golden defines an IP
SLA operation. The one-time install that points Prometheus's jobs at them is
docs/PROMETHEUS_TARGETS.md; after it Prometheus re-reads a changed file with
no reload.

The dry run and `--check` write nothing. `--write` writes only files whose
content moved, each 0644, atomically. `--check` asks the running Prometheus
(read-only), and says which of three a difference is: the edit not LOADED
(the config Prometheus runs does not read the files), a change not yet
DISCOVERED (inside one scrape interval of the reload or the write: ask again
at the time named), or a difference past that. Exit 0: written, or
matching; 1: `--check` found the edit not loaded, or a difference; 2:
something could not be done (named, and never read as "fine"); 3: not yet
discovered, nothing wrong yet.

The NMAS writes the files itself when `prometheus_targets_dir` is set
(Settings > Integrations > Prometheus); `--write` is for the one-time install.
"""

import sys

ROOT = __import__("os").path.dirname(__import__("os").path.dirname(
    __import__("os").path.abspath(__file__)))
sys.path.insert(0, ROOT)

import argparse  # noqa: E402

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)


def _print_plan(generated: dict) -> None:
    print(f"{generated.get('inventory', generated['devices'])} device(s) in the inventory, "
          f"{generated['devices']} configured for SNMP (the targets)")
    for name, groups in sorted(generated["files"].items()):
        names = ", ".join(g["labels"]["device"] + ("" if "role" in g["labels"]
                                                   else " (no role)") for g in groups)
        print(f"  {name}: {len(groups)} target(s){': ' + names if names else ''}")
    for note in generated["notes"]:
        print(f"  note: {note}")


def _report_check(r: dict) -> int:
    """Three states, never one sentence for two (the operator, 2026-09-30):
    the edit not LOADED, a change Prometheus has not DISCOVERED yet, and a
    difference past one scrape interval."""
    cfg = r["config"]
    if cfg["read"]:
        print(f"loaded config: loaded {cfg.get('loaded_at') or 'at an unread time'}"
              + ("; its LAST RELOAD FAILED, so it runs the config loaded then"
                 if cfg.get("reload_ok") is False else ""))
    else:
        print(f"loaded config: COULD NOT BE READ ({cfg['error']}); a static target cannot "
              "be told from a change not yet discovered")
    disk = r.get("disk") or {}
    if disk.get("read"):
        print(f"files in {disk['dir']}: "
              + ("current" if not disk["differs"] else "NOT CURRENT: " + "; ".join(disk["differs"])))
    if r["ok"]:
        print(f"MATCHES: {len(r['pools'])} SNMP job(s) scrape exactly the generated targets")
        return 0
    if r["static"]:
        print("NOT LOADED: the config Prometheus has loaded does not read the generated files:")
        for pool in r["static"]:
            for line in r["by_pool"][pool]["lines"]:
                print(f"  {line}")
        print("  (docs/PROMETHEUS_TARGETS.md: the one-time install, then a reload)")
    if r["drift"]:
        print("DIFFERS (past one scrape interval):")
        for line in r["drift"]:
            print(f"  {line}")
    if r["settling"]:
        print("NOT YET DISCOVERED (nothing is wrong yet):")
        for s in r["settling"]:
            print(f"  {s['because']}")
    for name in r["unread"]:
        print(f"  (no SNMP job reads {name})")
    if r["static"] or r["drift"]:
        return 1
    return 3


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--write", metavar="DIR", help="write the files into DIR")
    ap.add_argument("--check", action="store_true",
                    help="compare the running Prometheus with what would be generated now")
    args = ap.parse_args(argv)

    from modules import prometheus_targets as P

    try:
        generated = P.generate()
    except Exception as exc:                            # noqa: BLE001
        print(f"COULD NOT READ THE INVENTORY: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 2
    if not generated["devices"]:
        print(f"REFUSED: of the {generated.get('inventory', 0)} device(s) in the inventory, none is "
              "configured for SNMP with an address; writing would tell Prometheus to scrape "
              "nothing", file=sys.stderr)
        return 2
    _print_plan(generated)

    if args.check:
        r = P.check(generated=generated)
        if r["state"] == "not_configured":
            print("COULD NOT ASK: Prometheus is not configured (prometheus_url)", file=sys.stderr)
            return 2
        if r["state"] == "unknown":
            print(f"COULD NOT ASK Prometheus: {r['error']}", file=sys.stderr)
            return 2
        return _report_check(r)

    if args.write:
        try:
            out = P.write(args.write, generated)
        except Exception as exc:                        # noqa: BLE001
            print(f"NOT WRITTEN: {type(exc).__name__}: {exc}", file=sys.stderr)
            return 2
        print(f"written to {args.write}: {', '.join(out['changed']) or 'nothing changed'}"
              + (f"; unchanged: {', '.join(out['unchanged'])}" if out["unchanged"] else ""))
        return 0
    print("dry run: nothing written (--write DIR writes it)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
