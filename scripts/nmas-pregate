#: The confined run's bound. Measured 2026-11-12 on the laptop at -n 2: the convention set alone
#: took 81 s (no gate running); this tool's own first change, 18 files, took 191 s (a gate
#: starting part way through), so about 14 s a further file. The bound is about 2.5x that
#: estimate.
MEASURED_CONVENTIONS_S = 81
MEASURED_PER_FILE_S = 14


def confined_bound(n_files):
    """Seconds: about 2.5x the measured time of a run of *n_files* (CONVENTIONS counted)."""
    extra = max(0, n_files - len(CONVENTIONS))
    return int(2.5 * (MEASURED_CONVENTIONS_S + MEASURED_PER_FILE_S * extra))


#: The browser run's bound. Measured 2026-11-12 on the laptop, serial, no gate running, each
#: file alone with its Firefox starts: tests/test_v2_layout_in_a_browser.py 175 s (the
#: slowest), test_attention_badge.py 27 s, test_update_button.py 19 s, test_next_steps_act.py
#: 15 s, test_manual.py 7 s; 49 s on average.
MEASURED_BROWSER_FILE_S = 49
MEASURED_BROWSER_SLOWEST_S = 175


def browser_bound(n_files):
    """Seconds: about 2.5x the measured average a file times *n_files*, and never under 2.5x
    the slowest file measured, which a run of one file may be."""
    return int(2.5 * max(MEASURED_BROWSER_FILE_S * max(1, n_files), MEASURED_BROWSER_SLOWEST_S))


#: The message's checks: red-green runs the changed tests on the parent, so it is bounded too.
#: Measured 2026-11-12: about MEASURED_HOOK_S for a commit of a few test files.
MEASURED_HOOK_S = 120
HOOK_BOUND = int(2.5 * MEASURED_HOOK_S)

