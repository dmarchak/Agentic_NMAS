#!/usr/bin/env bash
# Run the test suite where NO process it starts can reach a network (C46).
#
#   scripts/nmas-test [pytest arguments]           confined, or refuse
#   scripts/nmas-test --allow-unconfined [args]    confined if possible; if
#                                                  not, run anyway and SAY so
#
# Why: "no test touches a live network" held for the test process and for
# nothing it started. A test ran the clab sync script with its default URL,
# which on the deployment host IS the NMAS, and the live app logged the
# request on every host run (2026-09-26). Only the kernel covers every child,
# in any language, so the suite runs in a network namespace holding loopback
# alone. The conftest then MEASURES the confinement (a route lookup, no
# packet) and, because this script sets NMAS_REQUIRE_NETWORK_CONFINEMENT=1,
# stops if it does not hold.
#
# How: an unprivileged user namespace mapped to root, only long enough to
# bring loopback up, then a nested one mapped back to your own uid and gid. A
# test running as root would pass every "refuses an unreadable file" check,
# because root reads anything.
#
# Where it cannot run: Ubuntu 24.04 restricts unprivileged user namespaces
# through AppArmor (kernel.apparmor_restrict_unprivileged_userns=1), and the
# deployment host refuses them. There this script REFUSES, naming the reason,
# unless --allow-unconfined is given; then the run is unconfined and the
# first line says so. It never claims a confinement it did not get.

set -u

# No bytecode is written by a test run (C120). A negative control mutates a
# file and restores it from a copy; when the mutation keeps the file's size
# and the restore lands in the same second, the cached .pyc still matches
# (Python compares mtime at 1 s resolution, and size) and the NEXT run
# executes the mutated code while the file on disk reads correct. Measured
# 2026-09-27: `_NEIGHBOR_DROP_TOLERANCE = 1` ran after the file said 0.
export PYTHONDONTWRITEBYTECODE=1

# THE BOUND COMES FROM A MEASUREMENT, not a round number chosen to be safe
# (the operator, 2026-09-28): a timeout "to be safe" converts every hang into
# its full length. The suite measured 121 s of tests, 125 s wall, serial on
# the laptop (5025 tests), and ~78 s parallel on the host; 300 s is 2.5x the
# serial figure. Re-derive it when the serial time moves, and say so here.
TIMEOUT="${NMAS_TEST_TIMEOUT:-300}"

# A TIMEOUT THAT FIRES SAYS WHAT WAS RUNNING. Each test process (the main one,
# or each xdist worker) writes the test it has started into this directory
# and clears it when the test finishes (tests/conftest.py), and dumps every
# thread's stack here when the bound's SIGTERM arrives. A bare "timed out"
# names nothing; the test and its stack are the start of a diagnosis.
INFLIGHT="$(mktemp -d "${TMPDIR:-/tmp}/nmas-test-inflight.XXXXXX")"
export NMAS_TEST_INFLIGHT="$INFLIGHT"
trap 'rm -rf "$INFLIGHT"' EXIT

report_timeout() {
  echo "nmas-test: TIMED OUT after ${TIMEOUT} s (NMAS_TEST_TIMEOUT). Running when it stopped:" >&2
  found=0
  for f in "$INFLIGHT"/running-*; do
    [ -s "$f" ] || continue
    found=1
    IFS=$'\t' read -r nodeid started < "$f"
    echo "  ${f##*/running-}: $nodeid (started $(( $(date +%s) - ${started%.*} )) s before the report)" >&2
  done
  [ "$found" -eq 1 ] || echo "  no test was in progress: the hang is outside a test (collection, a fixture's teardown at session end, or the harness)" >&2
  for f in "$INFLIGHT"/stack-*; do
    [ -s "$f" ] || continue
    echo "--- stacks of ${f##*/stack-} at the SIGTERM ---" >&2
    cat "$f" >&2
  done
}

# Run under the bound, then report. Not `exec`: the report runs after.
# `timeout` signals its whole process group, so xdist workers get the SIGTERM
# too, and --kill-after ends anything that ignores it.
run() {
  timeout --kill-after=15 "$TIMEOUT" "$@"
  rc=$?
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then report_timeout; fi
  exit "$rc"
}

allow=0
args=()
for a in "$@"; do
  case "$a" in
    --allow-unconfined) allow=1 ;;
    *) args+=("$a") ;;
  esac
done
PY="${PYTHON:-python3}"

why="$(unshare -rn true 2>&1)"
if [ $? -eq 0 ]; then
  echo "nmas-test: network: CONFINED (a loopback-only network namespace, as uid $(id -u))"
  run unshare -rn sh -c '
    ip link set lo up || { echo "nmas-test: could not bring loopback up" >&2; exit 2; }
    uid="$1"; gid="$2"; py="$3"; shift 3
    exec unshare --map-user="$uid" --map-group="$gid" \
      env NMAS_REQUIRE_NETWORK_CONFINEMENT=1 "$py" -m pytest "$@"
  ' nmas-test "$(id -u)" "$(id -g)" "$PY" "${args[@]}"
fi

why="${why:-unshare failed with no message}"
if [ "$allow" -eq 1 ]; then
  echo "nmas-test: network: NOT CONFINED: no network namespace here ($why). Processes the suite starts CAN reach the network; the test process itself still refuses non-loopback connects."
  run "$PY" -m pytest "${args[@]}"
fi
echo "nmas-test: REFUSED: no network namespace can be made here: $why" >&2
echo "  Processes the suite starts could reach the network. To run anyway, and" >&2
echo "  have the run say so: scripts/nmas-test --allow-unconfined ..." >&2
exit 2
