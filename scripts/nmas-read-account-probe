#!/usr/bin/env python3
"""Measure, on a real device, what the AI's read-only account may and may not run (C2657): the
command line of `modules/read_account_probe.py`, the probe's one home (board R's R8,
provisional, operator review pending), which Credentials' **Probe…** runs as a Mercury operation
too. Every word of what it asks, refuses and records is that module's (its docstring).

**Refused before anything connects:** a run inside the hypervisor's nightly backup window, 02:30
to 03:30 America/Denver (the window `nmas-tier2-probe` states and decides: this lab tool's own
`in_backup_window`, beside the installation's no-change windows the module asks), and a device
with no read-only account.

    nmas-read-account-probe --network Default --device edge1                  # the preview
    nmas-read-account-probe --network Default --device edge1 --confirm <hash> \\
        --actor you@example.com

Exit 0 the run finished (the verdict, PASS or not, printed and recorded), 1 refused before
anything connected, 2 the device does not accept the read-only account, 3 the run stopped on an
answer it would not decide (the session closed).
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

from modules import read_account_probe as _M  # noqa: E402

GIVEN = _M.GIVEN


def _sibling(name: str):
    """Another probe's helpers, loaded from its file (one home: the backup window is
    `nmas-tier2-probe`'s)."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path = os.path.join(ROOT, "scripts", name)
    loader = SourceFileLoader(name.replace("-", "_"), path)
    spec = importlib.util.spec_from_file_location(loader.name, path, loader=loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


_T2 = _sibling("nmas-tier2-probe")
in_backup_window = _T2.in_backup_window


def refusal(args, now: float = None) -> str:
    """The module's refusal, then the lab's nightly backup window for a run."""
    why = _M.refusal(args, now)
    if why:
        return why
    if args.confirm and in_backup_window(now):
        return ("REFUSED: it is inside the hypervisor's nightly backup window, "
                f"{_T2.backup_window_words(now)}; a measurement taken now measures the "
                "backup. Run it after the window's end.")
    return ""


def main(argv=None) -> int:
    return _M.main(argv, refuse=refusal)


if __name__ == "__main__":
    raise SystemExit(main())
