# TEMPLATE (2026-09-29): the repository is public, so the host's user and paths
# are placeholders. Render it, never copy it:
# /etc/nmas/netbox-backup.env -- root:@NMAS_USER@ 0640. Holds PATHS and a remote
# name, no secret: the gpg file is a PUBLIC key, and the ssh key is a path.
NMAS_BACKUP_ROOT=/var/lib/nmas-netbox
NMAS_BACKUP_COMPOSE_DIR=@NMAS_HOME@/netbox-docker
NMAS_BACKUP_PG_CONTAINER=netbox-docker-postgres-1
NMAS_BACKUP_NETBOX_CONTAINER=netbox-docker-netbox-1
# Public key only. The private key never comes to this host.
NMAS_BACKUP_GPG_RECIPIENT_FILE=/etc/nmas/netbox-backup-recipient.asc
# rrsync -wo account on the Proxmox host; empty = "not configured" (reported).
NMAS_BACKUP_PROXMOX_TARGET=nmas-backup@@HYPERVISOR_LAN@
NMAS_BACKUP_SSH_KEY=@NMAS_HOME@/.ssh/nmas_netbox_backup
# rclone remote:path for dailies; empty = "not configured" (reported).
# e.g. <remote-name>:nmas-netbox-<name>
NMAS_BACKUP_RCLONE_REMOTE=
# Where rclone's config (holding the B2 key) is. Stated rather than left to
# systemd's $HOME, so the unit and a shell read the same file.
RCLONE_CONFIG=@NMAS_HOME@/.config/rclone/rclone.conf
# Off-box retention is the BUCKET'S lifecycle rule and the key cannot delete
# (decided 2026-09-25). Set to 1 only for a remote whose key may delete.
NMAS_BACKUP_OFFBOX_PRUNE=0
