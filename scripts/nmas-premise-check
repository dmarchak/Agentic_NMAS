#!/usr/bin/env python3
"""A premise correction names what was measured (board TI item 5, docs/TEST_INTEGRITY.md; the
operator, 2026-11-03: "each one names the real behaviour measured that the old premise
contradicted, with the measurement").

    scripts/nmas-premise-check --message .git/COMMIT_EDITMSG   # the commit being made
    scripts/nmas-premise-check --commit SHA                    # one commit already made
    scripts/nmas-premise-check --range A..B                    # each commit of a range (CI)

Two rules, both on the commit message alone:

1. **A `Premise-Corrected:` trailer says what was measured:**

       Premise-Corrected: <test> — measured: <what was measured, where, the result>

   one refused without `measured:` and at least MEASURED_MIN_WORDS words after it.
2. **A message whose own prose says a test's premise was corrected or wrong** (PROSE, read
   outside backticks, quotes and the trailers, so a message about this check that quotes the
   phrase is not one) carries at least one such trailer.

Why: a test bent to the code under the word "premise", with no evidence that the code was
right, is a test weakened with a reason that sounds like evidence. The 80 commits since Phase 8
began that corrected a premise or weakened a test are listed for the independent reviewer in
the operator's report of 2026-11-03.

It is the commit-msg hook (scripts/hooks/commit-msg) and a CI step over the pushed range. Exit 0
passes; 1 refuses, naming each commit and what is missing; 2 means git could not be asked,
which is never a pass.
"""

import argparse
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

KEY = "Premise-Corrected"
#: What a measurement needs at least: a few words naming what, where and the result.
MEASURED_MIN_WORDS = 3
ANY_KEY = re.compile(r"^[A-Za-z]+(?:-[A-Za-z]+)*:\s")
SCISSORS = re.compile(r"^# -+ >8 -+$", re.M)
VALUE = re.compile(r"^(?P<test>\S+)\s+(?:—|–|-{1,2})\s+measured:\s*(?P<what>\S.*)$", re.S)
#: The prose that says a premise was corrected: "premise corrected", "the premise was wrong",
#: "corrects its premise", "a corrected premise".
PROSE = re.compile(r"\bpremises?\s+(?:(?:is|was|were)\s+)?(?:corrected|correction|wrong)\b"
                   r"|\bcorrect(?:s|ed|ing)?\s+(?:(?:the|its|a|their)\s+)?premises?\b"
                   r"|\bcorrected\s+premises?\b", re.I)
#: Text that only quotes the phrase: a code span, a double-quoted span.
QUOTED = re.compile(r"`[^`\n]*`|\"[^\"\n]*\"|“[^”\n]*”")
GIT_TIMEOUT = 30


class CannotAsk(Exception):
    pass


def git(*args):
    from modules.nsot.repo import run_git
    try:
        r = run_git(REPO, *args, timeout=GIT_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CannotAsk(f"git {' '.join(args)}: {exc}") from exc
    if r.returncode != 0:
        raise CannotAsk(f"git {' '.join(args)} exited {r.returncode}: {r.stderr.strip()[:300]}")
    return r.stdout


def body(message):
    cut = SCISSORS.search(message)
    if cut:
        message = message[:cut.start()]
    return "\n".join(line for line in message.splitlines() if not line.startswith("#"))


def trailers(message):
    """Each Premise-Corrected value, a wrapped value joined, and the message's prose: every line
    that is not part of a `Key:` trailer."""
    head = re.compile(rf"^{re.escape(KEY)}:[ \t]*", re.I)
    values, prose, cur, in_trailer = [], [], None, False
    for line in body(message).splitlines():
        if head.match(line):
            if cur is not None:
                values.append(cur)
            cur, in_trailer = head.sub("", line).strip(), True
        elif ANY_KEY.match(line):
            if cur is not None:
                values.append(cur)
            cur, in_trailer = None, True
        elif in_trailer and line.strip():
            if cur is not None:
                cur += " " + line.strip()
        else:
            in_trailer = False
            if cur is not None:
                values.append(cur)
                cur = None
            prose.append(line)
    if cur is not None:
        values.append(cur)
    return values, "\n".join(prose)


def problems(message):
    """What the message lacks, as sentences; empty when it passes."""
    values, prose = trailers(message)
    out = []
    for value in values:
        m = VALUE.match(value)
        if not m:
            out.append(f"a {KEY} trailer without ' — measured: <what, where, the result>' "
                       f"(\"{value[:100]}\")")
        elif len(m.group("what").split()) < MEASURED_MIN_WORDS:
            out.append(f"a {KEY} trailer whose measurement is under {MEASURED_MIN_WORDS} words "
                       f"(\"{value[:100]}\")")
    said = PROSE.search(QUOTED.sub("", prose))
    if said and not values:
        out.append(f"the message says \"{said.group(0)}\" and carries no {KEY}: <test> — "
                   "measured: <what was measured, where, the result> trailer")
    return out


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", maxsplit=1)[0])
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--message", help="the commit message file (the commit-msg hook)")
    g.add_argument("--commit", help="one commit already made")
    g.add_argument("--range", help="A..B: each commit of a range (CI)")
    a = ap.parse_args(argv)
    try:
        if a.message:
            with open(a.message, encoding="utf-8") as fh:
                found = [("the commit being made", problems(fh.read()))]
        else:
            shas = ([a.commit] if a.commit else
                    git("rev-list", "--no-merges", "--reverse", a.range).split())
            found = [(sha[:12], problems(git("show", "-s", "--format=%B", sha)))
                     for sha in shas]
    except (CannotAsk, OSError) as exc:
        print(f"nmas-premise-check: COULD NOT ASK: {exc}", file=sys.stderr)
        return 2
    refused = [(where, p) for where, ps in found for p in ps]
    for where, p in refused:
        print(f"nmas-premise-check: REFUSED: {where}: {p}", file=sys.stderr)
    if not refused:
        print(f"nmas-premise-check: {len(found)} message(s): every premise correction names "
              "what was measured")
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main())
