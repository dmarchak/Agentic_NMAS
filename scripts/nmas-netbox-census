#!/usr/bin/env python3
"""A census of NetBox: what is there, per type, by identity — not just how many.

Stage 4C.0. Built so the Stage 4C probe's **teardown can be measured rather
than eyeballed**. The provenance-based Remove has existed since Phase 0 and
has never been exercised against objects it created itself; the probe is the
first time, and "Remove cleaned up" has to be a number, not an impression.

**IDENTITY, not counts.** Counts can match while the contents differ: Remove
deletes the probe's prefix, something else creates one during the run, the
total returns to baseline, and the probe's object is gone-but-replaced. *"The
same objects"* is the claim. *"The same number"* is a proxy for it, and this
project has spent a week on that difference.

**Tagged counted separately from the total.** The real NetBox already holds
`nmas-managed` objects from the Lab 1 import, and **the population Remove may
touch is the tagged one** — so the tagged before/after is the number that
actually tests the provenance gate. A total that matched while the tagged set
drifted would be a pass hiding a failure.

Read-only. It performs GETs and nothing else.

    python scripts/nmas-netbox-census                     # print + snapshot
    python scripts/nmas-netbox-census --out before.json
    python scripts/nmas-netbox-census --compare before.json

**Three exit codes, because two cannot say "unproven".** `--compare` exits
**0** when every counted type holds exactly the objects it held, **1** when
something differs, and **2** when there is no usable baseline to compare
against. A missing baseline used to raise `FileNotFoundError` and exit 1 --
*the same code as a teardown that left objects behind* -- so the probe's
central claim going unmeasured was indistinguishable from it failing. Same
distinction as `inconclusive` is to `failed` everywhere else here: a
teardown that cannot be measured has not passed.
"""

import argparse
import datetime
import json
import os
import sys

#: `--compare`'s answers. The third exists because the first two cannot
#: express "nothing was measured", and a reader who sees a non-zero exit
#: will otherwise assume the teardown failed.
EXIT_PASS, EXIT_DIFFERS, EXIT_UNPROVEN = 0, 1, 2

#: What the modification record could say. Four, not two: `none` and
#: `no-record` both count zero and mean opposite things, and `unknown` is
#: weaker than `none` rather than equal to it. The headline is chosen from
#: these -- never by matching the printed sentence, which is how a check
#: comes to depend on its own prose.
MODS_NONE, MODS_SOME, MODS_UNKNOWN, MODS_NO_RECORD = (
    "none", "some", "unknown", "no-record")

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

#: Every object type the NetBox tab shows, plus the ones the sync creates
#: underneath them. Ordered as a reader would want them.
#:
#: **What this does NOT count is part of the claim**, the same rule as
#: `nmas-check-secret-storage`: an object type absent from this list is not
#: reported as unchanged, it is not reported at all. See `--list-types`.
ENDPOINTS = (
    ("devices",        "dcim/devices/"),
    ("sites",          "dcim/sites/"),
    ("regions",        "dcim/regions/"),
    ("interfaces",     "dcim/interfaces/"),
    ("cables",         "dcim/cables/"),
    ("device-types",   "dcim/device-types/"),
    ("device-roles",   "dcim/device-roles/"),
    ("manufacturers",  "dcim/manufacturers/"),
    ("platforms",      "dcim/platforms/"),
    ("prefixes",       "ipam/prefixes/"),
    ("ip-addresses",   "ipam/ip-addresses/"),
    ("vrfs",           "ipam/vrfs/"),
    ("vlans",          "ipam/vlans/"),
)

#: Types this census deliberately does not walk, and why. Printed, so the
#: edge of the claim is visible rather than implied.
NOT_COUNTED = {
    "extras/tags": "the tag definitions themselves; Remove never deletes one",
    "extras/custom-fields": "schema, not data",
    "extras/config-templates": "schema, not data",
    "ipam/roles": "not created by the sync",
    "dcim/roles": "not created by the sync",
}


def _identity(obj: dict) -> str:
    """A stable, readable identity. The id is what makes it unambiguous.

    `display` rather than `name`: an IP address, a prefix and a cable have no
    `name`, and falling back to the id alone would make a diff unreadable at
    exactly the moment somebody needs to read it.
    """
    label = (obj.get("display") or obj.get("name") or obj.get("prefix")
             or obj.get("address") or "")
    return f"{obj.get('id')}:{label}"


def _is_tagged(obj: dict, slug: str) -> bool:
    return any((t or {}).get("slug") == slug for t in (obj.get("tags") or []))


def take(verbose: bool = False) -> dict:
    """The census. Raises if NetBox cannot be reached — a census that could
    not be taken must not be written to a file that looks like one."""
    from modules.netbox_client import _nb_get, _nb_ready
    from modules.netbox_guard import MANAGED_TAG_SLUG

    ok, err, session, base = _nb_ready()
    if not ok:
        raise SystemExit(f"NetBox is not reachable: {err}")

    out = {"tag": MANAGED_TAG_SLUG, "types": {}, "not_counted": NOT_COUNTED}
    for name, path in ENDPOINTS:
        objects = _nb_get(session, base, path)
        ids = sorted(_identity(o) for o in objects)
        tagged = sorted(_identity(o) for o in objects
                        if _is_tagged(o, MANAGED_TAG_SLUG))
        out["types"][name] = {"total": len(ids), "objects": ids,
                              "tagged": len(tagged), "tagged_objects": tagged}
        if verbose:
            print(f"  {name:15s} {len(ids):5d} total  {len(tagged):5d} tagged")
    return out


def _print(census: dict) -> None:
    print(f"{'type':16s} {'total':>7s} {'tagged':>7s}")
    print("-" * 33)
    total = tagged = 0
    for name, row in census["types"].items():
        print(f"{name:16s} {row['total']:7d} {row['tagged']:7d}")
        total += row["total"]
        tagged += row["tagged"]
    print("-" * 33)
    print(f"{'ALL':16s} {total:7d} {tagged:7d}")
    print(f"\ntagged with: {census['tag']}")
    print("\nNOT counted by this census — absence here is not a claim of "
          "'unchanged':")
    for what, why in census.get("not_counted", {}).items():
        print(f"  {what:28s} {why}")


def _modification_report(since: str = "") -> list:
    """``(status, lines)`` stating what NMAS has MODIFIED.

    The census compares objects by identity, and an update changes neither the
    id nor the display -- measured: an address moved between interfaces reads
    `41:10.0.0.15/24` on both sides and `compare()` returns nothing. So a
    census PASS has never meant *"nothing changed"*; it has meant *"no object
    was created or destroyed"*, and the difference is exactly the class that
    caused the 2026-09-24 incident. This says which claim is being made.
    """
    from modules.netbox_guard import modified_since

    got = modified_since(since=since)
    if not got["ok"]:
        return MODS_UNKNOWN, [
            "modifications: UNKNOWN — the record could not be read: "
            + got["reason"],
            "  So this census cannot say whether NMAS changed anything "
            "in place. That is weaker than 'none', not equal to it."]

    if not got["exists"]:
        return MODS_NO_RECORD, [
            "modifications: NO RECORD EXISTS — nothing has ever been "
            "written to data/netbox_modified.json.",
            "  On an install that has run an import, that means the "
            "recorder is not reaching the file, so read this as "
            "'unknown', not as 'none'."]

    scope = ("since this baseline" if got["scope"] == "since"
             else "all time — the baseline carries no taken_at, so this "
                  "could not be scoped to the run")
    lines = [f"modifications: {got['count']} object(s) modified by NMAS "
             f"({scope}), out of {got['total_recorded']} recorded in total"]
    if got["unknown_before"]:
        lines.append(f"  {got['unknown_before']} of them could not be read "
                     "before the write, so WHAT changed is unknown")
    for e in got["entries"][:12]:
        fields = e.get("fields") or {}
        if e.get("before_unknown"):
            detail = "before-state unreadable"
        else:
            detail = ", ".join(
                f"{k}: {v['before']} → {v['after']}" for k, v in fields.items())
        lines.append(f"  {e['at']}  {e['endpoint']}/{e['id']} "
                     f"{e.get('name') or ''}  [{e.get('actor')}]  {detail}")
    if got["count"] > 12:
        lines.append(f"  … and {got['count'] - 12} more")
    return (MODS_SOME if got["count"] else MODS_NONE), lines


def read_baseline(path: str):
    """``(census, None)`` or ``(None, reason)`` -- never a traceback.

    Every way this can fail is a **named** reason, because the caller turns
    it into an exit code that means *unproven* rather than *failed*, and a
    reason of "it did not work" would leave the reader deciding which.
    """
    if not os.path.exists(path):
        return None, (f"no baseline at {path} — step 2 was skipped, so this "
                      "teardown cannot be measured")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except json.JSONDecodeError as err:
        return None, f"the baseline at {path} is not readable JSON: {err}"
    except OSError as err:
        return None, f"the baseline at {path} could not be read: {err}"
    if not isinstance(data, dict) or not isinstance(data.get("types"), dict):
        return None, (f"{path} is not a census — it has no 'types', so it is "
                      "some other JSON file with the right name")
    if not data["types"]:
        return None, (f"the baseline at {path} counted nothing, so every "
                      "comparison against it passes vacuously")
    return data, None


def compare(before: dict, after: dict) -> list:
    """Differences, per type, by identity **and** by tagged membership."""
    findings = []
    types = sorted(set(before["types"]) | set(after["types"]))

    for name in types:
        b = before["types"].get(name)
        a = after["types"].get(name)
        if b is None or a is None:
            findings.append(f"{name}: present in only one census — the two "
                            "were taken by different versions of this script")
            continue

        for label, key in (("", "objects"), ("nmas-managed ", "tagged_objects")):
            gone = sorted(set(b[key]) - set(a[key]))
            new = sorted(set(a[key]) - set(b[key]))
            if gone:
                findings.append(f"{name}: {len(gone)} {label}object(s) REMOVED "
                                "that were there before: " + ", ".join(gone[:6])
                                + ("…" if len(gone) > 6 else ""))
            if new:
                findings.append(f"{name}: {len(new)} {label}object(s) LEFT "
                                "BEHIND: " + ", ".join(new[:6])
                                + ("…" if len(new) > 6 else ""))

        # Stated separately, because it is the shape this exists to catch: a
        # total that matches while the contents differ.
        if b["total"] == a["total"] and set(b["objects"]) != set(a["objects"]):
            findings.append(
                f"{name}: the COUNT matches ({a['total']}) and the objects do "
                "not — something was created while something else was removed")
    return findings


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", help="write the snapshot here (JSON)")
    ap.add_argument("--compare", metavar="SNAPSHOT",
                    help="take a census now and diff it against SNAPSHOT")
    ap.add_argument("--list-types", action="store_true",
                    help="print what is and is not counted, and exit")
    args = ap.parse_args()

    if args.list_types:
        print("counted:")
        for name, path in ENDPOINTS:
            print(f"  {name:16s} {path}")
        print("\nNOT counted:")
        for what, why in NOT_COUNTED.items():
            print(f"  {what:28s} {why}")
        return 0

    if args.compare:
        # BEFORE the census, not after. The old order spent a full pass over
        # live NetBox and then raised on the open() -- and the traceback
        # exited 1, which is "the teardown left something behind".
        before, refusal = read_baseline(args.compare)
        if refusal:
            print(f"UNPROVEN - {refusal}")
            print()
            print("This is NOT a pass, and it is not a failure either: "
                  "nothing was measured.")
            print("The teardown is what this probe exists to prove, and the "
                  "baseline is the only thing it can be proved against. "
                  "A baseline taken now would contain the probe's own "
                  "objects, so it cannot be recovered after the fact -- "
                  "record the run as unmeasured rather than taking one.")
            return EXIT_UNPROVEN

    census = take()

    if args.compare:
        findings = compare(before, census)
        _print(census)
        print()
        print(f"baseline taken: {before.get('taken_at') or 'unrecorded'}")
        mod_status, mod_lines = _modification_report(
            since=before.get("taken_at") or "")
        for line in mod_lines:
            print(line)
        print()

        if not findings:
            # WHICH CLAIM. "PASS" used to be read as "nothing changed" and has
            # only ever meant "nothing was created or destroyed" -- so it is
            # stated, and qualified in the headline when modifications exist,
            # because a reader skimming for the word PASS will not read the
            # paragraph under it.
            head = {
                MODS_SOME:      "PASS (with modifications — read them above)",
                MODS_UNKNOWN:   "PASS (modifications UNKNOWN — read above)",
                MODS_NO_RECORD: "PASS (modifications UNKNOWN — read above)",
                MODS_NONE:      "PASS",
            }[mod_status]
            print(f"{head} — every counted type holds exactly the objects it "
                  f"held in {os.path.basename(args.compare)}.")
            print("Identity, not counts: the same objects, not the same number.")
            print("THE CLAIM THIS MAKES: no object was created or destroyed. "
                  "It does NOT say nothing changed — an in-place update "
                  "changes neither an object's id nor its display, so this "
                  "comparison cannot see one. That is what the "
                  "modifications line above is for.")
            return EXIT_PASS
        print(f"{len(findings)} difference(s):")
        for f in findings:
            print(f"  {f}")
        return EXIT_DIFFERS

    _print(census)
    print()
    for line in _modification_report()[1]:
        print(line)
    if args.out:
        from modules.config import open_secure

        # WHEN it was taken travels with it. A baseline taken after the
        # probe began writing contains the probe's own objects and would
        # report a teardown clean while leaving them behind -- worse than
        # having none, and unreadable from the file without this.
        census["taken_at"] = datetime.datetime.now(
            datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        with open_secure(args.out, "w", encoding="utf-8") as fh:
            json.dump(census, fh, indent=2)
        print(f"\nsnapshot written to {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
