#!/usr/bin/env python3
"""Write each device's startup SOURCE for a tool building boot files elsewhere (plan item 4).

The source is the list's newest EARNED baseline, with every credential family
taken from the device's CURRENT golden (`modules/nsot/startup_source.py`).
Runs on the NMAS host beside the checkout, reading the list's repository
directly: the files hold credentials, so no HTTP route serves them (B11, C77).

    nmas-startup-source --out DIR --list NAME

The list is REQUIRED (C482): it writes files a lab boots, a write path, and a write path
carries its list. Falling back to the installation's active list made the sync build a
second network's sources the moment someone switched the active list on today's page.

Writes DIR/<host>.cfg for each device it can build (0600) and DIR/sources.tsv:
a `# baseline<TAB><tag><TAB><commit>` line, then one `<host><TAB>ok|refused
<TAB><detail>` line per device. Exit 0 with a baseline (a device refused is a
row, never the run), 2 when there is none or it could not be read.
"""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

EXIT_OK, EXIT_UNPROVEN = 0, 2


def _write(path: str, text: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)


def _check(list_name: str) -> int:
    """The redeploy's pre-flight (the operator, 2026-10-19): one line per device, facts only.
    A built file fails when a credential family differs from its current golden, a placeholder
    is in it, its golden is older than its last rotation, the last drift run could not read the
    device, or it lacks something `startup_source._carries()` names."""
    import time

    from modules.nsot.startup_source import check
    try:
        got = check(list_name)
    except Exception as exc:                       # noqa: BLE001
        print(f"UNPROVEN: the pre-flight could not run: {type(exc).__name__}: {exc}",
              file=sys.stderr)
        return EXIT_UNPROVEN
    if not got["ok"]:
        print(f"UNPROVEN: {got['error']}", file=sys.stderr)
        return EXIT_UNPROVEN
    base = got["baseline"]
    print(f"baseline {base['tag']} at {base['commit'][:10]}")
    failing = []
    for host, r in got["devices"].items():
        if not r["built"]:
            print(f"{host}: NOT BUILT: {r.get('why')}")
            failing.append(host)
            continue
        problems = []
        if not r["credentials_current"]:
            problems.append("credentials differ from its current golden: " + ", ".join(
                n for n, f in r["families"].items() if not f["equal"]))
        if r["placeholders"]:
            problems.append(f"{r['placeholders']} placeholder line(s)")
        if r["golden_after_rotation"] is False:
            problems.append(f"its golden is older than its last rotation ({r['rotated_at']})")
        if not r["read_by_drift"]:
            problems.append("the last drift run did not read it")
        if r["lacks"]:
            problems.append("lacks " + ", ".join(r["lacks"]))
        if not r["config_current"]:
            # C1454: the file is the baseline's configuration, and the device's golden moved on.
            problems.append(
                f"a redeploy would undo {r['lines_undone']} configuration line(s) committed "
                f"after {base['tag']}: " + ("; ".join(r["undoes"]) or "its commits could not "
                                            "be listed") + " (Save All earns a current baseline)")
        at = (time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime(r["drift_at"]))
              if r.get("drift_at") else "never")
        fams = ", ".join(f"{n} {f['lines']}" for n, f in r["families"].items())
        print(f"{host}: {'FAILS: ' + '; '.join(problems) if problems else 'ok'} | golden "
              f"{r['baseline_golden']} (baseline) / {r['latest_golden']} (latest), "
              f"{r['commits_since']} newer | credentials current: {r['credentials_current']} "
              f"({fams}) | golden after last rotation: {r['golden_after_rotation']} "
              f"({r['rotated_at'] or 'no rotation'}) | read by drift: {r['read_by_drift']} "
              f"({at}) | carries: {', '.join(r['carries'])}")
        if problems:
            failing.append(host)
    print(f"{len(got['devices']) - len(failing)} of {len(got['devices'])} pass"
          + (f"; failing: {', '.join(failing)}" if failing else ""))
    return 1 if failing else EXIT_OK


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", help="where the sources are written (not with --check)")
    ap.add_argument("--list", dest="list_name", required=True,
                    help="the network whose lab startup files are built")
    ap.add_argument("--check", action="store_true",
                    help="write nothing: print each device's facts for a redeploy's pre-flight "
                         "(never a value) and exit 1 when any built file fails one")
    args = ap.parse_args(argv)
    if args.check:
        return _check(args.list_name)
    if not args.out:
        ap.error("--out is required unless --check")
    try:
        from modules.nsot.startup_source import build
        list_name = args.list_name
        got = build(list_name)
    except Exception as exc:                       # noqa: BLE001
        print(f"UNPROVEN: the startup sources could not be built: {type(exc).__name__}: {exc}",
              file=sys.stderr)
        return EXIT_UNPROVEN
    if not got["ok"]:
        print(f"UNPROVEN: {got['error']}", file=sys.stderr)
        return EXIT_UNPROVEN
    os.makedirs(args.out, exist_ok=True)
    rows = [f"# baseline\t{got['baseline']['tag']}\t{got['baseline']['commit']}"]
    for host, d in sorted(got["devices"].items()):
        if d["state"] == "ok":
            _write(os.path.join(args.out, f"{host}.cfg"), d["text"])
            detail = ("credentials from its current golden: " + ", ".join(d["replaced"])
                      if d["replaced"] else "no credential lines")
            if d.get("nested"):
                detail += ("; a secret inside a stanza differs from the current one and is "
                           "the baseline's: " + "; ".join(d["nested"]))
            rows.append(f"{host}\tok\t{detail}")
        else:
            rows.append(f"{host}\trefused\t{d['why']}")
    _write(os.path.join(args.out, "sources.tsv"), "\n".join(rows) + "\n")
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())
