#!/usr/bin/env python3
"""The commit gate, as ONE program (the operator, 2026-10-02: five rules about the gate lived
only in CLAUDE.md and in memory, each behind a past incident). In order, each step able to stop
everything after it:

  1. stage:         git add -A (the gate tests what it commits, C224);
  2. stage guard:   scripts/nmas-stage-guard refuses a secret or a stray, and lists new files;
  3. the suite:     CI's command in CI's interpreter (docs/TESTING.md, "CI's interpreter
                    here"), its WHOLE output kept in a result file that is removed FIRST, so a
                    run that did not happen leaves nothing to read (e986e66);
  4. the verdict:   from that file AND the exit status: the last line must read "N passed"
                    with no failure or error anywhere (a pipe into tail decides nothing,
                    195fdbe; d0ce454 shipped two failures), and NO browser test skipped: CI
                    runs them in this suite, with CI's workers (2026-10-03, "The browser
                    tests" in docs/TESTING.md);
  5. browser tests: optional (--browser), unconfined, in one clean process, the same verdict
                    rule: an extra, never a stand-in for step 3's;
  6. the message:   its first line must start with --expect (a failed write leaves the
                    previous message, df17b55, 17e9c7d), and "@SUITE@" in it is replaced by
                    the run's own result line (a count is never written before the run that
                    makes it, 71ed99e);
  7. commit:        git commit -F, the hooks running as usual;
  8. push:          optional (--push), naming the pushed sha.

    scripts/nmas-gate --message MSG --expect "Subject prefix" [--browser] [--push]

Exit 0 committed; 1 refused at a step (named, with where its evidence is kept); 2 usage.
For tests only, NMAS_GATE_SUITE and NMAS_GATE_BROWSER replace the two commands.
"""
import argparse
import os
import re
import shlex
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
#: CI's `-n auto` on GitHub's hosted Ubuntu runner for a public repository: 4 vCPUs (GitHub's
#: runner specification; each run's own count is in its nmas-env-facts notice). The gate ran
#: `-n 2` until 2026-10-03 and so never placed tests in CI's workers.
CI_WORKERS = 4
#: The suite as CI runs it: confined, CI's workers, coverage, AND the browser tests among the
#: rest. CI's runner has a Firefox that starts inside the loopback namespace; the laptop's snap
#: Firefox does not, so the gate puts BROWSER_DIR's (a Mozilla build and geckodriver,
#: docs/TESTING.md) first on PATH, and refuses a run in which any browser test was skipped:
#: from ca52963 to 64d4377 they ran only in a separate clean process here, and CI was red for
#: five commits on a failure no local run could meet (a Socket.IO test client earlier in the
#: same worker, 2026-10-03).
#: CI runs it as four jobs at once (2026-10-03; four since C614), each its shard of the files
#: (`scripts/nmas-shards`): the gate runs the SAME four commands, at once, each with CI's
#: workers, so each job's company in a worker is the one CI's has (C349).
SHARDS = ("browser1", "browser2", "a", "b")
SUITE = ("{py} -c 0 && PYTHON={py} COVERAGE_CORE=sysmon NMAS_TEST_TIMEOUT=740 NMAS_REQUIRE_PG=1 "
         f"scripts/nmas-test -q -p no:cacheprovider -n {CI_WORKERS} --cov=modules --cov=routes "
         "--cov=app --cov-report= -rEfs $({py} scripts/nmas-shards {shard})")
BROWSER_DIR = os.environ.get("NMAS_GATE_BROWSER_DIR",
                             os.path.expanduser("~/.local/share/nmas-browser"))
#: The records tests' PostgreSQL, unpacked without root (docs/TESTING.md, "CI's interpreter
#: here"): CI installs libpq5, so here its unpacked libpq goes on the suite's library path. The
#: suite requires them as CI does (NMAS_REQUIRE_PG=1): a laptop without it fails the gate,
#: naming why, rather than passing by skipping them.
PG_LIB = os.environ.get("NMAS_GATE_PG_LIB",
                        os.path.expanduser("~/.local/share/nmas-pg/usr/lib/x86_64-linux-gnu"))
#: The words tests/browser.py's skip says when no browser can start.
BROWSER_SKIPPED = "no real browser here"
BROWSER_TESTS = ("tests/test_update_button.py tests/test_profile_apply_v2.py tests/test_manual.py "
                 "tests/test_v2_layout_in_a_browser.py tests/test_attention_badge.py "
                 "tests/test_device_capture_v2.py tests/test_device_persist_v2.py "
                 "tests/test_device_rotate_v2.py tests/test_next_steps_act.py "
                 "tests/test_device_deploy_v2.py")
BROWSER = "{py} -m pytest -q -p no:cacheprovider -rEf " + BROWSER_TESTS
DEFAULT_PY = os.path.expanduser("~/.local/share/nmas-py312/bin/python")
#: The last line of a run that passed: "7592 passed, 28 skipped in 181.19s (0:03:01)".
PASSED_LINE = re.compile(r"^\d+ passed(, \d+ (skipped|deselected|xfailed|xpassed))* in [\d.]+s")
FAILED_ANY = re.compile(r"^(FAILED|ERROR) |\b\d+ (failed|errors?)\b", re.M)


def say(msg):
    print(f"nmas-gate: {msg}", flush=True)


def refuse(step, why, evidence=None):
    say(f"REFUSED at {step}: {why}" + (f" (the whole output: {evidence})" if evidence else ""))
    sys.exit(1)


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        refuse("git " + args[0], (r.stderr or r.stdout).strip()[:400])
    return r


def verdict(path, rc):
    """None if the run in *path* passed, else why not. A file that is not there is a run that
    did not happen, never a pass."""
    if not os.path.isfile(path):
        return "no result file: the run did not happen"
    text = open(path, encoding="utf-8", errors="replace").read()
    lines = [ln for ln in text.splitlines() if ln.strip()]
    last = lines[-1] if lines else ""
    if rc != 0:
        return f"the run exited {rc}; its last line: {last[:200]!r}"
    if FAILED_ANY.search(text):
        return f"a failure or error is reported; its last line: {last[:200]!r}"
    if not PASSED_LINE.match(last):
        return f"the last line does not say what passed: {last[:200]!r}"
    return None


def browser_skipped(path):
    """None, or why the suite is not CI's run: a browser test skipped because no browser could
    start, where CI's runner starts one (the gap, 2026-10-03)."""
    text = open(path, encoding="utf-8", errors="replace").read()
    n = text.count(BROWSER_SKIPPED)
    if not n:
        return None
    return (f"{n} browser test skip(s) ({BROWSER_SKIPPED!r}): CI runs them in this suite, "
            f"so a pass here would not be CI's. Put a Firefox that starts confined and its "
            f"geckodriver in {BROWSER_DIR} (docs/TESTING.md, \"The browser tests\")")


def run_to_file(cmd, repo, path, env=None):
    try:
        os.remove(path)                    # step 3's rule: nothing from an earlier run survives
    except FileNotFoundError:
        pass
    with open(path, "w", encoding="utf-8") as fh:
        rc = subprocess.run(cmd, shell=True, cwd=repo, stdout=fh, stderr=subprocess.STDOUT,
                            env=env).returncode
    return rc


def run_all_to_files(runs, repo, env):
    """Run every ``{name: (cmd, path)}`` at once, each to its own file (each removed first:
    step 3's rule), and wait for all; ``{name: exit code}``."""
    procs = {}
    for name, (cmd, path) in runs.items():
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        fh = open(path, "w", encoding="utf-8")
        procs[name] = (subprocess.Popen(cmd, shell=True, cwd=repo, stdout=fh,
                                        stderr=subprocess.STDOUT, env=env), fh)
    codes = {}
    for name, (proc, fh) in procs.items():
        codes[name] = proc.wait()
        fh.close()
    return codes


def last_line(path):
    lines = [ln for ln in open(path, encoding="utf-8", errors="replace").read().splitlines()
             if ln.strip()]
    return lines[-1] if lines else ""


#: What CI installs into its interpreter (`.github/workflows/ci.yml`; `scripts/nmas-ci-env` builds
#: the gate's from the same three, with --no-deps).
CI_FILES = ("requirements.lock", "requirements-ci.txt", "requirements-test.txt")


def _norm(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def interpreter_differs(py, repo):
    """``[words]``: each package CI's three files pin that *py* lacks or holds at another
    version (C594: the lock gained boto3, the gate's interpreter never did, and CI went red on
    what the gate had not run). Empty when they match; the interpreter's extras are not a
    difference (pip itself, setuptools)."""
    pins = {}
    for f in CI_FILES:
        with open(os.path.join(repo, f), encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"\s*([A-Za-z0-9_.\-]+)(?:\[[^\]]*\])?==([^;\s]+)", line)
                if m:
                    pins[_norm(m.group(1))] = (m.group(1), m.group(2))
    out = subprocess.run([py, "-m", "pip", "list", "--format=freeze",
                          "--disable-pip-version-check"], capture_output=True, text=True)
    if out.returncode != 0:
        return [f"{py} -m pip list failed: {(out.stderr or out.stdout).strip()[-200:]}"]
    have = {}
    for line in out.stdout.splitlines():
        if "==" in line:
            n, v = line.split("==", 1)
            have[_norm(n)] = v.strip()
    diffs = []
    for key, (name, want) in sorted(pins.items()):
        got = have.get(key)
        if got is None:
            diffs.append(f"{name}=={want} is not installed")
        elif got != want:
            diffs.append(f"{name} is {got}, CI installs {want}")
    return diffs


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--message", required=True, help="the commit message file")
    ap.add_argument("--expect", required=True, help="what its first line must start with")
    ap.add_argument("--browser", action="store_true", help="also run the browser tests, unconfined")
    ap.add_argument("--push", action="store_true", help="push after committing")
    ap.add_argument("--repo", default=None, help="the repository (default: this checkout)")
    ap.add_argument("--python", default=os.environ.get("NMAS_GATE_PYTHON", DEFAULT_PY),
                    help="CI's interpreter (default: the venv scripts/nmas-ci-env builds)")
    a = ap.parse_args(argv)
    if not a.expect.strip():
        ap.error("--expect must name the subject: an empty prefix matches every message")
    repo = a.repo or subprocess.run(["git", "-C", HERE, "rev-parse", "--show-toplevel"],
                                    capture_output=True, text=True).stdout.strip()
    gitdir = git(repo, "rev-parse", "--absolute-git-dir").stdout.strip()

    # 6 (checked early as well as at the end: a wrong message should not cost a suite run).
    def first_line():
        try:
            return open(a.message, encoding="utf-8").readline().rstrip("\n")
        except OSError as exc:
            refuse("the message", f"cannot read {a.message}: {exc}")
    if not first_line().startswith(a.expect):
        refuse("the message", f"its first line is {first_line()!r}, not one starting {a.expect!r}: "
                              "a failed write leaves the previous message in place")

    say("1. git add -A")
    git(repo, "add", "-A")
    say("2. the stage guard")
    guard = subprocess.run([sys.executable, os.path.join(HERE, "nmas-stage-guard"),
                            "--repo", repo], capture_output=True, text=True)
    sys.stdout.write(guard.stdout)
    if guard.returncode != 0:
        refuse("the stage guard", (guard.stderr or guard.stdout).strip()[-400:])

    suite_out = os.path.join(gitdir, "nmas-gate-suite.out")
    if not os.environ.get("NMAS_GATE_SUITE"):       # the gate's own tests stand a suite in
        say("3. CI's interpreter holds what CI installs")
        diffs = interpreter_differs(a.python, repo)
        if diffs:
            refuse("CI's interpreter", f"{a.python} differs from what CI installs from "
                   f"{', '.join(CI_FILES)}: " + "; ".join(diffs[:8])
                   + (f"; and {len(diffs) - 8} more" if len(diffs) > 8 else "")
                   + ". Rebuild it: scripts/nmas-ci-env <CI's python> (docs/TESTING.md)")
    say("4. the suite, CI's four commands in CI's interpreter, at once, the browser tests "
        "among them")
    path = os.pathsep.join([BROWSER_DIR, os.path.join(BROWSER_DIR, "firefox"),
                            os.environ.get("PATH", "")])
    env = dict(os.environ, PATH=path)
    if os.path.isdir(PG_LIB):
        env["LD_LIBRARY_PATH"] = os.pathsep.join(
            p for p in (PG_LIB, os.environ.get("LD_LIBRARY_PATH", "")) if p)
    if os.environ.get("NMAS_GATE_SUITE"):           # the gate's own tests: one stand-in run
        runs = {"suite": (os.environ["NMAS_GATE_SUITE"], suite_out)}
    else:
        runs = {s: (SUITE.format(py=shlex.quote(a.python), shard=s),
                    os.path.join(gitdir, f"nmas-gate-suite-{s}.out")) for s in SHARDS}
    codes = run_all_to_files(runs, repo, env)
    whys, lines = [], []
    for name, (_cmd, out) in runs.items():
        why = verdict(out, codes[name]) or browser_skipped(out)
        if why:
            whys.append((name, why, out))
        lines.append((f"{name}: " if len(runs) > 1 else "")
                     + (last_line(out) if os.path.isfile(out) else "(no output)"))
    result_line = "; ".join(lines)
    say(f"4. the suite: {result_line}")
    if whys:
        name, why, out = whys[0]
        refuse("the suite", (f"job {name}: " if len(runs) > 1 else "") + why
               + (f" (and {len(whys) - 1} more)" if len(whys) > 1 else ""), out)

    browser_line = ""
    if a.browser:
        browser_out = os.path.join(gitdir, "nmas-gate-browser.out")
        say("5. the browser tests, unconfined")
        cmd = os.environ.get("NMAS_GATE_BROWSER") or BROWSER.format(py=shlex.quote(a.python))
        rc = run_to_file(cmd, repo, browser_out)
        why = verdict(browser_out, rc)
        browser_line = last_line(browser_out) if os.path.isfile(browser_out) else ""
        say(f"   {browser_line or '(no output)'}")
        if why:
            refuse("the browser tests", why, browser_out)

    say("6. the message")
    if not first_line().startswith(a.expect):
        refuse("the message", f"its first line changed during the run to {first_line()!r}")
    body = open(a.message, encoding="utf-8").read()
    result = result_line + (f"; browser tests: {browser_line}" if browser_line else "")
    body = body.replace("@SUITE@", result)
    final = os.path.join(gitdir, "nmas-gate-message.txt")
    with open(final, "w", encoding="utf-8") as fh:
        fh.write(body)

    say("7. commit")
    git(repo, "commit", "-q", "-F", final)
    sha = git(repo, "rev-parse", "--short", "HEAD").stdout.strip()
    say(f"   committed {sha}: {body.splitlines()[0]}")
    if a.push:
        say("8. push")
        git(repo, "push", "-q")
        say(f"   pushed {sha}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
