#!/usr/bin/env python3
"""Rotate one device's login credential. Run INTERACTIVELY on the NMAS.

    cd ~/python/Agentic_NMAS
    python3 scripts/nmas-rotate-credential --device r2

WHY THE CONFIRM IS IN THIS SCRIPT
    `require_person_for_confirm` gates the HTTP routes. A script calling
    plan()/rotate()/persist() directly does not pass through them, so it would
    bypass the gate entirely. Rather than pretend otherwise, the confirm lives
    here: the screen is printed, the operator types the hostname, and anything
    else refuses.

    It also refuses a non-interactive stdin. A typed confirmation that can be
    piped in is not a confirmation.

WHAT THE ACTOR MEANS HERE
    A local CLI session is NOT Cloudflare Access-verified. It proves somebody
    had a shell on this host, which is a weaker claim than a verified email, so
    it is recorded as its own kind — `person_cli` — rather than being written
    into the audit trail as if it were the same thing.
"""

import argparse
import getpass
import os
import socket
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def _banner(text):
    print()
    print("=" * 74)
    print(f"  {text}")
    print("=" * 74)


def confirm_screen(plan, oob_node):
    print()
    print(f"  Rotate login credential — {plan['device']} ({plan['mgmt_ip']})")
    print()
    print(f"    user              {plan['username']} (privilege {plan['privilege']})")
    print(f"    current form      {plan['current_form']}")
    print()
    program = plan.get("new_program") or [plan["new_form"]]
    kind = plan.get("entry_kind") or "unknown"
    print(f"    the device now has a  {kind}  entry for this user"
          f"{'' if plan.get('live_read_ok') else '  (READ FROM THE GOLDEN — the'}")
    if not plan.get("live_read_ok"):
        print( "                      device could not be read)")
    print()
    print( "    EXACTLY these commands are sent, in this order:")
    for i, line in enumerate(program, 1):
        print(f"                      {i}. {line}")
    print( "                      → the device stores a type 9 (scrypt) hash")
    if len(program) > 1:
        print( "                      → the account is REMOVED and recreated: a")
        print( "                        secret is refused on a username that still")
        print( "                        has a password entry. The held session")
        print( "                        stays authenticated across the removal —")
        print( "                        that is what makes the revert possible.")
    else:
        print( "                      → ONE command: a secret replaces a secret")
        print( "                        cleanly on this image, so the account is")
        print( "                        NOT removed and there is no window in")
        print( "                        which it does not exist.")
    if plan.get("discrepancy"):
        print()
        print(f"    !! {plan['discrepancy']}")
    print()
    print(f"    new password      generated at apply time, {plan['length']} chars "
          f"from {plan['charset_size']}")
    print( "                      never displayed, never logged, never in the audit")
    print(f"    confirm binds     device · user · privilege · algorithm · charset ·")
    print(f"                      length · capture {plan['capture_hash']}")
    print(f"                      fingerprint {plan['fingerprint']}")
    print( "                      (the random value is deliberately NOT bound —")
    print( "                       you cannot confirm bytes you may not see)")
    print()
    print( "    consumers")
    for c in plan["consumers"]:
        print(f"                      {c['name']:<18} {c['action']}")
    print()
    print( "    lockout defence   a dedicated session is opened and PROVEN, then held")
    print( "                      open until the new credential succeeds on a SEPARATE")
    print( "                      fresh login. If it does not, the original line is")
    print( "                      restored on that still-open session and re-proven.")
    print( "                      No session ⇒ no push at all.")
    print()
    print( "    out-of-band       ssh dmarchak@10.0.0.210")
    print(f"                      docker exec -it {oob_node} telnet localhost 5000")
    print( "                      you land UNAUTHENTICATED at  >  (privilege 1)")
    print( "                      type  enable  — no password — for privilege 15")
    print( "                      exit with  ^]  then  quit   — ONE session only")
    print()
    print( "    NOT changed       the template (no approval revocation)")
    print( "                      any other device · any shared credential profile")
    print()
    print( "    history           the old cleartext stays in git history. After this")
    print( "                      it is a DEAD credential. Rotation is what makes that")
    print( "                      true; nothing can remove it from history.")
    print()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--device", required=True)
    ap.add_argument("--list", dest="list_name", default="")
    ap.add_argument("--oob-node", default="")
    ap.add_argument("--skip-persist", action="store_true",
                    help="stop after the commit; leaves ROTATED_PENDING_PERSIST")
    args = ap.parse_args()

    if not sys.stdin.isatty():
        print("REFUSED: stdin is not a terminal. A typed confirmation that can "
              "be piped in is not a confirmation.", file=sys.stderr)
        return 2

    from modules.config import get_current_list_name
    from modules.nsot import credential_rotation as cr

    list_name = args.list_name or get_current_list_name()
    device = args.device
    oob = args.oob_node or f"clab-rcn-lab1-{device}"

    _banner(f"PLAN — {device} in list {list_name!r}")
    plan = cr.plan(list_name, device)
    if not plan.get("ok"):
        print("  REFUSED by preflight:")
        for c in plan.get("preflight", {}).get("checks", []):
            if not c["ok"]:
                print(f"    [XX] {c['name']}  {c['detail']}")
        print(f"\n  {plan.get('error','')}")
        return 1
    for c in plan["preflight"]["checks"]:
        print(f"    [ok] {c['name']}")

    confirm_screen(plan, oob)

    typed = input(f"  Type the hostname to confirm ({device}): ").strip()
    if typed != device:
        print(f"\n  REFUSED — you typed {typed!r}, expected {device!r}. "
              "Nothing was sent.")
        return 1

    actor = f"{getpass.getuser()}@{socket.gethostname()}"
    # Aware UTC, for the same reason persist uses it: confirm_fetch compares
    # this against Oxidized's timestamps. A formatted gmtime string parses
    # back as naive, and a naive/aware comparison is a TypeError.
    started = cr.utc_now()

    _banner(f"ROTATE — {device}  (actor {actor}, local CLI, NOT Access-verified)")
    result = cr.rotate(list_name, device,
                       confirmed_fingerprint=plan["fingerprint"],
                       actor=actor, actor_kind="person_cli")
    for step in result["steps"]:
        print(f"    [{'ok' if step['ok'] else 'XX'}] {step['name']:<28} "
              f"{step.get('detail','')}")
    print(f"\n    state: {result['state']}")
    print(f"    {cr.summarise(result)}")

    try:
        from modules import reveal_audit
        reveal_audit.record(actor=actor, kind="person_cli",
                            what="credential_rotation", target=device,
                            detail=result["state"], peer="local-cli",
                            extra={"access_verified": False,
                                   "commit": (result.get("commit") or {}).get("commit", "")})
    except Exception as exc:                  # noqa: BLE001
        print(f"    (audit record failed: {exc})")

    if result["state"] != cr.ROTATED_PENDING_PERSIST:
        return 0 if result["state"] == cr.REVERTED else 1

    if args.skip_persist:
        print("\n  --skip-persist: stopping. The device IS rotated; persistence "
              "is not verified.")
        return 0

    _banner(f"PERSIST — {device}   (this NEVER reverts the device)")
    # rotate() carries these: the hash is the one the VERIFY saw, not one
    # re-derived from a later read of the device.
    new_hash = result.get("new_hash", "")
    password = _password_from_inventory(list_name, device)
    if not new_hash or not password:
        print("    REFUSED: the rotation did not carry the hash or the new "
              "credential. The device IS rotated — recover the plaintext from "
              f"{result.get('repo','')}/.nsot/staging/credential/ if present.")
        return 1

    result = cr.persist(result, mgmt_ip=plan["mgmt_ip"],
                        username=plan["username"], password=password,
                        hostname=device, new_hash=new_hash,
                        after_iso=started)
    for stage in result.get("persistence", []):
        print(f"    [{'ok' if stage.get('ok') else 'XX'}] {stage['name']:<20} "
              f"{stage.get('error') or stage.get('end') or stage.get('matches','')}")
    print(f"\n    state: {result['state']}")
    print(f"    {cr.summarise(result)}")
    return 0 if result["state"] == cr.ROTATED_PERSISTED else 1


def _password_from_inventory(list_name, hostname):
    """The credential just written to devices.csv — this row, this list.

    The list is carried. Reading whichever list happens to be active would
    hand persist() another network's credential for this device's name.
    """
    from modules.device import decrypt_field, load_saved_devices
    from modules.nsot.credential_rotation import _csv_path_for

    csv_path = _csv_path_for(list_name)
    row = next((d for d in load_saved_devices(csv_path)
                if d.get("hostname") == hostname), {})
    return decrypt_field(row.get("password", "")) if row else ""


if __name__ == "__main__":
    raise SystemExit(main())
