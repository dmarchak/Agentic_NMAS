#!/usr/bin/env python3
"""The commit gate, as ONE program (the operator, 2026-10-02: five rules about the gate lived
only in CLAUDE.md and in memory, each behind a past incident). In order, each step able to stop
everything after it:

  0. the base:      the gate's own code is the base commit's (HEAD), extracted to a throwaway
                    worktree and run with --repo, never this working tree's (C2457, the
                    operator, 2026-11-04);
  1. the index:     the gate judges the index EXACTLY as staged and stages nothing itself
                    (C2457; it tests what it commits, C224); with --only PATH ..., the staged
                    set must be exactly under those paths and each must be staged, refused
                    otherwise (the operator, 2026-10-26: a commit that must leave a file out
                    names what it holds, never hides the file); a part of a file is staged
                    with `git apply --cached`, and kept as staged;
  1b. the contents: the files the commit will contain, listed before anything runs; without
                    --only, also each modified tracked file it sweeps in that this session's
                    Edit and Write tools did not touch (the edit ledger, `<git dir>/
                    nmas-edited-paths`, written by scripts/hooks/claude-record-edits: a change
                    made through the shell or by another session is named, never refused);
  1c. with --only:  the list is built from the files the work changed, never from the
                    working tree's status (a list read from status is `git add -A` by
                    another name: the operator, 2026-10-26); so each tracked file modified
                    and left out of the commit is named, and each named file the edit ledger
                    did not see (a shell edit, an applied patch, another session's);
  2. stage guard:   scripts/nmas-stage-guard refuses a secret or a stray, and lists new files;
  2b. the snapshot: the staged tree (`git write-tree`) checked out in a worktree of its own,
                    where every step after this one runs and the commit is made, so the
                    working tree is never locked: an edit made during the run is simply not in
                    this commit (the operator, 2026-10-25). The branch moves to the commit only
                    if it still points where the gate began (compare and swap), and only when
                    the committed tree IS the tested one; the snapshot is removed either way;
  3. the suite:     CI's command in CI's interpreter (docs/TESTING.md, "CI's interpreter
                    here"), its WHOLE output kept in a result file that is removed FIRST, so a
                    run that did not happen leaves nothing to read (e986e66);
  4. the verdict:   from that file AND the exit status: the last line must read "N passed"
                    with no failure or error anywhere (a pipe into tail decides nothing,
                    195fdbe; d0ce454 shipped two failures), and NO browser test skipped: CI
                    runs them in this suite, with CI's workers (2026-10-03, "The browser
                    tests" in docs/TESTING.md);
  4c. root's files: the tests of root's real files (`real_root_files`), deselected in step 4,
                    run unconfined, required (C2455);
  4d. the skips:    every skip in the runs' JUnit files is one tests/skip_reasons.py declares
                    for the gate (`scripts/nmas-skip-check`, C2412); the browser shards run
                    with NMAS_REQUIRE_BROWSER=1, so a browser that cannot start fails there;
  4b. the ratchet:  CI's coverage job over the four shards' measurement (each measures by tier,
                    as CI's do): combined, then `nmas-coverage report --check`; a failure
                    refuses, naming the module and both figures (C808: the gate passed and
                    CI's ratchet failed afterwards);
  5. browser tests: optional (--browser), unconfined, in one clean process, the same verdict
                    rule: an extra, never a stand-in for step 3's;
  6. the message:   its first line must start with --expect (a failed write leaves the
                    previous message, df17b55, 17e9c7d), and "@SUITE@" in it is replaced by
                    the run's own result line (a count is never written before the run that
                    makes it, 71ed99e);
  7. commit:        git commit -F in the snapshot, the hooks running as usual;
  8. push:          optional (--push), naming the pushed sha.

  0. With --push, first: CI's newest verdict on main (`nmas-ci-log main-ci`). Red refuses,
     naming the run, so nothing stacks on a red CI (C791: three commits did, 2026-10-15, the
     run never read); the commit that fixes it forward says so with --fixes-red <run number>,
     which must name that very run. A verdict that cannot be read refuses too, never a guess.

    scripts/nmas-gate --message MSG --expect "Subject prefix" [--browser] [--push]
                      [--fixes-red N] [--only PATH ...]

Exit 0 committed; 1 refused at a step (named, with where its evidence is kept); 2 usage.
For tests only, NMAS_GATE_SUITE, NMAS_GATE_RATCHET and NMAS_GATE_BROWSER replace the three
commands.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
#: CI's `-n auto` on GitHub's hosted Ubuntu runner for a public repository: 4 vCPUs (GitHub's
#: runner specification; each run's own count is in its nmas-env-facts notice). The gate ran
#: `-n 2` until 2026-10-03 and so never placed tests in CI's workers.
CI_WORKERS = 4
#: The suite as CI runs it: confined, CI's workers, coverage, AND the browser tests among the
#: rest. CI's runner has a Firefox that starts inside the loopback namespace; the laptop's snap
#: Firefox does not, so the gate puts BROWSER_DIR's (a Mozilla build and geckodriver,
#: docs/TESTING.md) first on PATH, and refuses a run in which any browser test was skipped:
#: from ca52963 to 64d4377 they ran only in a separate clean process here, and CI was red for
#: five commits on a failure no local run could meet (a Socket.IO test client earlier in the
#: same worker, 2026-10-03).
#: CI runs it as five jobs at once (2026-10-03; four since C614, five since 2026-10-24, C1637),
#: each its shard of the files (`scripts/nmas-shards`): the gate runs the SAME commands, at once, each with CI's
#: workers, so each job's company in a worker is the one CI's has (C349).
SHARDS = ("browser1", "browser2", "browser3", "a", "b")
#: Each shard measures by tier into its own data file and records its tiers in one folder, as
#: CI's tests step does (NMAS_COVERAGE_TIERS=1, C773), so step 4b can run CI's ratchet.
SUITE = ("{py} -c 0 && PYTHON={py} COVERAGE_CORE=sysmon NMAS_COVERAGE_TIERS=1 "
         "COVERAGE_FILE={cov}/.coverage.{shard} NMAS_TEST_TIERS={cov}/tiers "
         "NMAS_TEST_TIMEOUT={bound} NMAS_REQUIRE_PG=1 NMAS_REQUIRE_BROWSER={req} "
         "scripts/nmas-test -q -p no:cacheprovider -n {n} -o faulthandler_timeout=270 "
         "--cov=modules --cov=routes "
         "--cov=app --cov-report= --junitxml={cov}/junit-{shard}.xml -rEfs "
         "$({py} scripts/nmas-shards {shard})")
#: The five shards run at once, three of them starting a headless browser: each shard's `-n` is
#: the memory rule's (scripts/nmas-workers, the operator 2026-10-19), never more than CI's
#: CI_WORKERS, measured before step 4 and said.
BROWSER_SHARDS = 3
#: Each shard's bound at CI_WORKERS workers: 2.5x the slowest shard measured at -n 4 (about
#: 5 min, docs/TESTING.md). A shard's time goes as 1/n, so its bound does too
#: (`suite_bound`): 740 s at -n 4, 2960 s at -n 1.
BOUND_AT_CI_WORKERS = 740


def suite_bound(n: int) -> int:
    """Each shard's NMAS_TEST_TIMEOUT at *n* workers: BOUND_AT_CI_WORKERS scaled by CI_WORKERS/n."""
    return int(BOUND_AT_CI_WORKERS * CI_WORKERS / max(1, n))


def _workers_module():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("nmas_workers",
                                                  os.path.join(HERE, "nmas-workers"))
    spec = importlib.util.spec_from_loader("nmas_workers", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def hold_full_suite(who: str):
    """The full-suite lock (scripts/nmas-workers `hold_full`): the open file, or the refusal."""
    return _workers_module().hold_full(who)


def suite_workers(available: int = None) -> tuple:
    """``(n, words)``: each shard's workers from the memory available now (or *available*
    bytes), the four shards and their two browsers counted, and the choice in words."""
    w = _workers_module()
    available = w.mem_available() if available is None else available
    n = min(CI_WORKERS, w.workers(available, runs=len(SHARDS), browsers=BROWSER_SHARDS))
    return n, w.explain(available, runs=len(SHARDS), browsers=BROWSER_SHARDS)
#: Step 4b, CI's coverage job (C808, the operator's decision of 2026-10-15: the gate passed and
#: CI's ratchet failed afterwards, a red found only after the push): the four shards' data
#: combined, then the report with --check against tests/coverage_baseline.json. Measured
#: 2026-10-15 on the laptop: see docs/TESTING.md, "Where it runs".
RATCHET = ("{py} -m coverage combine --keep --data-file={cov}/.coverage {files} && "
           "{py} scripts/nmas-coverage report --data {cov}/.coverage --tiers {cov}/tiers --check")
#: The header the ratchet's failures follow (scripts/nmas-coverage).
RATCHET_HEADER = "THE RATCHET:"
BROWSER_DIR = os.environ.get("NMAS_GATE_BROWSER_DIR",
                             os.path.expanduser("~/.local/share/nmas-browser"))
#: The records tests' PostgreSQL, unpacked without root (docs/TESTING.md, "CI's interpreter
#: here"): CI installs libpq5, so here its unpacked libpq goes on the suite's library path. The
#: suite requires them as CI does (NMAS_REQUIRE_PG=1): a laptop without it fails the gate,
#: naming why, rather than passing by skipping them.
PG_LIB = os.environ.get("NMAS_GATE_PG_LIB",
                        os.path.expanduser("~/.local/share/nmas-pg/usr/lib/x86_64-linux-gnu"))
#: The words tests/browser.py's skip says when no browser can start.
BROWSER_SKIPPED = "no real browser here"
#: Step 4c (C2455): the tests of root's real files, deselected in the confined step 4 (root's
#: files read as another uid there), run unconfined; none collected fails (pytest's exit 5).
ROOT_FILES = ("{py} -m pytest -q -p no:cacheprovider -rEfs -m real_root_files "
              "--junitxml={cov}/junit-rootfiles.xml tests/test_update_button.py")
#: Step 4d (C2412): every skip in the runs' JUnit files is one declared for the gate.
SKIP_CHECK = "{py} {check} --where gate {files}"
BROWSER_TESTS = ("tests/test_update_button.py tests/test_profile_apply_v2.py tests/test_manual.py "
                 "tests/test_v2_layout_in_a_browser.py tests/test_attention_badge.py "
                 "tests/test_device_capture_v2.py tests/test_device_persist_v2.py "
                 "tests/test_device_rotate_v2.py tests/test_next_steps_act.py "
                 "tests/test_device_deploy_v2.py")
BROWSER = "{py} -m pytest -q -p no:cacheprovider -rEf " + BROWSER_TESTS
DEFAULT_PY = os.path.expanduser("~/.local/share/nmas-py312/bin/python")
#: The last line of a run that passed: "7592 passed, 28 skipped in 181.19s (0:03:01)".
PASSED_LINE = re.compile(r"^\d+ passed(, \d+ (skipped|deselected|xfailed|xpassed))* in [\d.]+s")
FAILED_ANY = re.compile(r"^(FAILED|ERROR) |\b\d+ (failed|errors?)\b", re.M)


#: CI's verdict on main, as one JSON line (scripts/nmas-ci-log main-ci). For tests only,
#: NMAS_GATE_CI_LOG replaces the command.
CI_VERDICT = "{py} " + shlex.quote(os.path.join(HERE, "nmas-ci-log")) + " main-ci"


def say(msg):
    print(f"nmas-gate: {msg}", flush=True)


def red_ci(fixes_red):
    """Why a push must wait on CI's verdict on main, or "" (step 0): red, unless *fixes_red*
    names that very run; unreadable, always."""
    cmd = os.environ.get("NMAS_GATE_CI_LOG") or CI_VERDICT.format(py=shlex.quote(sys.executable))
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    try:
        v = json.loads((r.stdout.strip().splitlines() or [""])[-1])
        state, run = v["state"], v.get("run") or {}
    except (ValueError, KeyError, TypeError):
        return (f"CI's verdict on main could not be read (nmas-ci-log main-ci exit {r.returncode}: "
                f"{(r.stderr or r.stdout).strip()[-300:] or 'no output'}): a push waits until it can")
    if state == "green":
        say(f"0. CI on main is green: #{run.get('run_number')} on "
            f"{str(run.get('head_sha'))[:8]}")
        return ""
    if state != "red":
        return "CI has no completed run on main to judge by: a push waits for one"
    named = (f"#{run.get('run_number')} on {str(run.get('head_sha'))[:8]} "
             f"({run.get('conclusion')}, {run.get('html_url')})")
    if fixes_red is not None and fixes_red == run.get("run_number"):
        say(f"0. CI on main is RED, {named}; this commit fixes it forward (--fixes-red)")
        return ""
    return (f"CI on main is red: {named}. Fix it forward first; the commit that does says "
            f"--fixes-red {run.get('run_number')}"
            + (f" (--fixes-red {fixes_red} names another run)" if fixes_red is not None else ""))


def refuse(step, why, evidence=None):
    say(f"REFUSED at {step}: {why}" + (f" (the whole output: {evidence})" if evidence else ""))
    sys.exit(1)


def git(repo, *args, check=True, env=None):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        refuse("git " + args[0], (r.stderr or r.stdout).strip()[:400])
    return r


#: Files outside git that tests read in the checkout (measured 2026-10-25: the whole suite run
#: once with an audit hook recording every file each test opened, then `git check-ignore`):
#: the snapshot gets the same, or a test the gate runs would see less than the one the operator
#: runs (the publication scan's real values, the secret file's mode, a generated rule file).
#: Each is copied, its mode kept, only if present, into the owner-only snapshot that is removed
#: after the run. `logs/` and `data/` themselves start empty there, as in CI.
SNAPSHOT_LOCAL = (".env", "data/lab_hosts.json", "data/publication_denylist.txt",
                  "deploy/grafana/provisioning/alerting/nmas-heartbeat.yaml", "setup.cfg")


#: The doc job's name (`scripts/nmas-shards docs`): the doc set alone, for a docs-only tree.
DOC_SHARD = "docs"


#: The tree this gate's own code came from, once the launcher ran it from the base commit's
#: throwaway (C2457): its checks and their data are then the base's, never the working tree's.
#: None in a repository whose base holds no gate: there the snapshot's own rules judge, as
#: before.
BASE_TREE = None


def own_or_snapshot(rel, snap) -> tuple:
    """``(path, whose)``: *rel* in the base's tree (the gate's own code, C2457), or, where the
    base predates it, the snapshot's, said so (the commit that adds a check is judged by it)."""
    mine = os.path.join(BASE_TREE, rel) if BASE_TREE else ""
    if mine and os.path.exists(mine):
        return mine, "the base's"
    return os.path.join(snap, rel), "the commit's own (the base has none)"


#: The gate's own code (C2457): its program, the helpers it loads, its checks and their data,
#: and the hooks. A commit that changes any of it gets a second pass with its own versions.
GATE_CODE = ("scripts/nmas-gate", "scripts/nmas-stage-guard", "scripts/nmas-workers",
             "scripts/nmas-ci-log", "scripts/nmas-skip-check", "tests/skip_reasons.py",
             "tests/doc_tests.py", "scripts/hooks/", "scripts/nmas-test-weakening-check",
             "scripts/nmas-red-green", "scripts/nmas-guard-check", "scripts/nmas-bypass-scan",
             "scripts/nmas-premise-check", "scripts/nmas-host-step-check",
             "scripts/check_removed_definitions.py", "tests/ratchet_lists.py")


def gate_code_changed(changed) -> list:
    """The paths of *changed* that are the gate's own code."""
    return sorted(p for p in changed
                  if any(p == c or (c.endswith("/") and p.startswith(c)) for c in GATE_CODE))


def second_pass(repo, snap, message, junits, py, changed, docs_base) -> tuple:
    """C2457's second pass, for a commit that changes the gate's own code: the commit's OWN
    stage guard, skip check, docs-only rule and commit-msg hooks, run on the same staged tree
    and the same runs' results after the base's passed. ``(refusals, flags)``: a refusal where
    the commit's own version refuses what the base passed (CI runs the commit's own, so it
    would be red); a flag where they judge otherwise and the base's judgement stands."""
    refusals, flags = [], []

    def run(argv, **kw):
        return subprocess.run(argv, capture_output=True, text=True, **kw)

    guard = os.path.join(snap, "scripts", "nmas-stage-guard")
    if os.path.exists(guard):
        r = run([sys.executable, guard, "--repo", repo])
        if r.returncode:
            refusals.append(f"the commit's own stage guard refuses what the base's passed: "
                            f"{(r.stdout + r.stderr).strip()[-300:]}")
    check = os.path.join(snap, "scripts", "nmas-skip-check")
    if os.path.exists(check) and junits and all(os.path.exists(j) for j in junits):
        r = run([py, check, "--where", "gate", *junits], cwd=snap)
        if r.returncode:
            refusals.append(f"the commit's own skip check refuses what the base's passed: "
                            f"{(r.stdout.strip().splitlines() or [''])[-1]}")
    own_docs = _docs_only_by(os.path.join(snap, "tests", "doc_tests.py"), changed)
    if own_docs != docs_base:
        flags.append(f"the docs-only rule: the base's says {docs_base}, the commit's own says "
                     f"{own_docs}; the base's stands")
    hook = os.path.join(snap, "scripts", "hooks", "commit-msg")
    base_hook = os.path.join(BASE_TREE, "scripts", "hooks", "commit-msg") if BASE_TREE else ""
    if not os.path.exists(hook) and base_hook and os.path.exists(base_hook):
        # C2396 (the operator, 2026-11-04): a commit whose own hooks are missing is flagged.
        flags.append("the commit's own commit-msg hook is MISSING where the base has one; the "
                     "base's judges it at step 7")
    if os.path.exists(hook):
        import tempfile
        with tempfile.NamedTemporaryFile("w", suffix=".msg", delete=False) as fh:
            fh.write(open(message, encoding="utf-8").read())
        try:
            r = run([hook, fh.name], cwd=repo, env=dict(os.environ, NMAS_CHECKS_ROOT=snap))
        finally:
            os.unlink(fh.name)
        if r.returncode:
            refusals.append(f"the commit's own commit-msg hooks refuse it: "
                            f"{(r.stdout + r.stderr).strip()[-300:]}")
        else:
            flags.append(OWN_HOOKS_PASSED)
    return refusals, flags


#: The second pass's note that the commit's own commit-msg hooks passed it: should the base's
#: refuse it at step 7, the commit's own are WEAKER, and the refusal says so (C2396).
OWN_HOOKS_PASSED = "the commit's own commit-msg hooks pass it"


def _docs_only_by(path, changed) -> bool:
    """*changed* judged by the `docs_only` rule in the tests/doc_tests.py at *path*."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("doc_tests_own", path)
    if spec is None or not os.path.isfile(path):
        return False
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.docs_only(changed)


def _docs_only(snap, changed) -> bool:
    """Does every one of *changed* lie under docs/, by the BASE commit's rule (C2457; its
    tests/doc_tests.py `docs_only`, the one CI's scope job applies through nmas-shards), or the
    snapshot's where the base has none? A commit cannot loosen the rule that judges it."""
    import importlib.util
    path, _whose = own_or_snapshot(os.path.join("tests", "doc_tests.py"), snap)
    spec = importlib.util.spec_from_file_location("doc_tests", path)
    if spec is None or not os.path.isfile(spec.origin):
        return False                                  # no rule there: everything runs
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.docs_only(changed)


#: Every snapshot's folder begins so (in the temporary directory, owner-only by `mkdtemp`).
SNAPSHOT_PREFIX = "nmas-gate-snapshot-"


#: The file in a snapshot's folder naming the gate process that owns it.
SNAPSHOT_OWNER = "owner.pid"


#: A snapshot folder with no readable owner (an earlier gate's) is stale only when older than
#: this: 4x the longest gate measured (29 min, 2026-10-23 to 25). A younger one may belong to
#: a gate still running; 2026-10-25's first snapshot run lost its snapshot mid-suite to a
#: cleanup that judged an ownerless folder stale.
OWNERLESS_STALE_S = 2 * 3600


def _owner_alive(parent) -> bool:
    """May the gate that made the snapshot folder *parent* still be running? Its owner's pid,
    asked: no such process is gone; a process this one may not signal (another user, or outside
    the suite's namespace) is ALIVE. With no readable owner: alive while younger than
    OWNERLESS_STALE_S."""
    try:
        pid = int(open(os.path.join(parent, SNAPSHOT_OWNER), encoding="utf-8").read().strip())
    except (OSError, ValueError):
        try:
            import time
            return time.time() - os.stat(parent).st_mtime < OWNERLESS_STALE_S
        except OSError:
            return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def remove_stale_snapshots(repo):
    """Remove every snapshot a gate that is no longer running left behind (killed, so its
    `finally` never ran): it holds `.env`, so it is never left. A snapshot whose gate still
    runs (another gate, or the gate's own tests inside a gate's suite) is never touched. Each
    of *repo*'s worktrees under such a folder, then any such folder of this user left in the
    temporary directory. ``[folders removed]``."""
    import tempfile

    gone = []
    for line in git(repo, "worktree", "list", "--porcelain", check=False).stdout.splitlines():
        path = line[len("worktree "):] if line.startswith("worktree ") else ""
        parent = os.path.dirname(path)
        if os.path.basename(parent).startswith(SNAPSHOT_PREFIX) and not _owner_alive(parent):
            git(repo, "worktree", "remove", "--force", path, check=False)
            shutil.rmtree(parent, ignore_errors=True)
            gone.append(parent)
    tmp = tempfile.gettempdir()
    for name in os.listdir(tmp):
        full = os.path.join(tmp, name)
        if (name.startswith(SNAPSHOT_PREFIX) and full not in gone and os.path.isdir(full)
                and os.stat(full).st_uid == os.getuid() and not _owner_alive(full)):
            shutil.rmtree(full, ignore_errors=True)
            gone.append(full)
    git(repo, "worktree", "prune", check=False)
    return gone


def _exit_on_signal(signum, _frame):
    """SIGTERM and SIGHUP end the gate as an exit does, so its `finally` removes the snapshot
    (Python's default for them ends the process without running it)."""
    raise SystemExit(128 + signum)


def make_snapshot(repo, tree, head):
    """A worktree of *head*, set to exactly *tree* (index and files), with SNAPSHOT_LOCAL
    copied in: ``(path, remove)``. Its folder is owner-only (0700, `mkdtemp`'s mode, checked).
    Nothing in *repo* changes."""
    import tempfile

    parent = tempfile.mkdtemp(prefix=SNAPSHOT_PREFIX)     # 0700, whatever the umask
    with open(os.path.join(parent, SNAPSHOT_OWNER), "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    snap = os.path.join(parent, "tree")
    git(repo, "worktree", "add", "-q", "--detach", snap, head)

    def remove():
        git(repo, "worktree", "remove", "--force", snap, check=False)
        shutil.rmtree(parent, ignore_errors=True)
        git(repo, "worktree", "prune", check=False)
    r = git(snap, "read-tree", "-u", "--reset", tree, check=False)
    if r.returncode != 0:
        remove()
        refuse("the snapshot", (r.stderr or r.stdout).strip()[:400])
    for rel in SNAPSHOT_LOCAL:
        src = os.path.join(repo, rel)
        if os.path.isfile(src):
            os.makedirs(os.path.dirname(os.path.join(snap, rel)), exist_ok=True)
            shutil.copy2(src, os.path.join(snap, rel))
    return snap, remove


#: The parent commit's tree, the hooks' and checks' own copy (C2365).
JUDGE_PREFIX = "nmas-gate-judge-"


def commit_judged_by_parent(repo, snap, parent, message):
    """`git commit` in *snap*, its hooks and the checks they run taken from *parent*, the commit
    it comes after, never from the working tree or the commit being made (C2365; the operator,
    2026-11-03: "nmas-gate's commit step runs the tested snapshot's hook, not the working tree's.
    Where the commit changes the hook or any protected guard, the guard checks run from the
    parent commit's version, never the version being committed").

    Before, `.git/hooks/commit-msg` was a symlink to the working copy's `scripts/hooks/`, so the
    commit ran whatever that file held then, uncommitted edits included, and a commit that
    loosened a check was judged by its own looser version. Now a worktree of *parent* is made in
    a fresh owner-only folder, `core.hooksPath` names its `scripts/hooks`, and `NMAS_CHECKS_ROOT`
    names it to the hooks, which run its `scripts/` against the commit being made (`--repo`, the
    hook's own working directory). Where no guard changes, the parent's checks are the
    commit's. The worktree is removed whatever happens. Returns the commit's
    `subprocess.CompletedProcess`."""
    import tempfile

    base = tempfile.mkdtemp(prefix=JUDGE_PREFIX)        # 0700, whatever the umask
    judge = os.path.join(base, "tree")
    try:
        git(repo, "worktree", "add", "-q", "--detach", judge, parent)
        env = dict(os.environ, NMAS_CHECKS_ROOT=judge)
        return git(snap, "-c", f"core.hooksPath={os.path.join(judge, 'scripts', 'hooks')}",
                   "commit", "-q", "-F", message, check=False, env=env)
    finally:
        git(repo, "worktree", "remove", "--force", judge, check=False)
        shutil.rmtree(base, ignore_errors=True)
        git(repo, "worktree", "prune", check=False)


def verdict(path, rc):
    """None if the run in *path* passed, else why not. A file that is not there is a run that
    did not happen, never a pass."""
    if not os.path.isfile(path):
        return "no result file: the run did not happen"
    text = open(path, encoding="utf-8", errors="replace").read()
    lines = [ln for ln in text.splitlines() if ln.strip()]
    last = lines[-1] if lines else ""
    if rc != 0:
        return f"the run exited {rc}; its last line: {last[:200]!r}"
    if FAILED_ANY.search(text):
        return f"a failure or error is reported; its last line: {last[:200]!r}"
    if not PASSED_LINE.match(last):
        return f"the last line does not say what passed: {last[:200]!r}"
    return None


def browser_required(shard):
    """`NMAS_REQUIRE_BROWSER`'s value for *shard*: "1" on a browser shard, as CI's tests step
    sets it (C2412), so a browser that cannot start fails there; empty elsewhere."""
    return "1" if shard.startswith("browser") else "''"


def browser_skipped(path):
    """None, or why the suite is not CI's run: a browser test skipped because no browser could
    start, where CI's runner starts one (the gap, 2026-10-03)."""
    text = open(path, encoding="utf-8", errors="replace").read()
    n = text.count(BROWSER_SKIPPED)
    if not n:
        return None
    return (f"{n} browser test skip(s) ({BROWSER_SKIPPED!r}): CI runs them in this suite, "
            f"so a pass here would not be CI's. Put a Firefox that starts confined and its "
            f"geckodriver in {BROWSER_DIR} (docs/TESTING.md, \"The browser tests\")")


def ratchet_failed(path, rc):
    """None if the ratchet (step 4b) held, else why not: its own failures, each naming the
    module or test and both figures (scripts/nmas_coverage.py `ratchet`), or, when it failed
    before judging (the combine, the report), its last line."""
    if not os.path.isfile(path):
        return "no result file: the ratchet did not run"
    if rc == 0:
        return None
    text = open(path, encoding="utf-8", errors="replace").read()
    if RATCHET_HEADER in text:
        found = [ln.strip() for ln in text.split(RATCHET_HEADER, 1)[1].splitlines() if ln.strip()]
        return "; ".join(found[:6]) + (f"; and {len(found) - 6} more" if len(found) > 6 else "")
    lines = [ln for ln in text.splitlines() if ln.strip()]
    return f"it exited {rc} before judging; its last line: {(lines[-1] if lines else '')[:200]!r}"


def run_to_file(cmd, repo, path, env=None):
    try:
        os.remove(path)                    # step 3's rule: nothing from an earlier run survives
    except FileNotFoundError:
        pass
    with open(path, "w", encoding="utf-8") as fh:
        rc = subprocess.run(cmd, shell=True, cwd=repo, stdout=fh, stderr=subprocess.STDOUT,
                            env=env).returncode
    return rc


def run_all_to_files(runs, repo, env):
    """Run every ``{name: (cmd, path)}`` at once, each to its own file (each removed first:
    step 3's rule), and wait for all; ``{name: exit code}``."""
    procs = {}
    for name, (cmd, path) in runs.items():
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        fh = open(path, "w", encoding="utf-8")
        procs[name] = (subprocess.Popen(cmd, shell=True, cwd=repo, stdout=fh,
                                        stderr=subprocess.STDOUT, env=env), fh)
    codes = {}
    for name, (proc, fh) in procs.items():
        codes[name] = proc.wait()
        fh.close()
    return codes


def last_line(path):
    lines = [ln for ln in open(path, encoding="utf-8", errors="replace").read().splitlines()
             if ln.strip()]
    return lines[-1] if lines else ""


#: What CI installs into its interpreter (`.github/workflows/ci.yml`; `scripts/nmas-ci-env` builds
#: the gate's from the same three, with --no-deps).
CI_FILES = ("requirements.lock", "requirements-ci.txt", "requirements-test.txt")


def _norm(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def interpreter_differs(py, repo):
    """``[words]``: each package CI's three files pin that *py* lacks or holds at another
    version (C594: the lock gained boto3, the gate's interpreter never did, and CI went red on
    what the gate had not run). Empty when they match; the interpreter's extras are not a
    difference (pip itself, setuptools)."""
    pins = {}
    for f in CI_FILES:
        with open(os.path.join(repo, f), encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"\s*([A-Za-z0-9_.\-]+)(?:\[[^\]]*\])?==([^;\s]+)", line)
                if m:
                    pins[_norm(m.group(1))] = (m.group(1), m.group(2))
    out = subprocess.run([py, "-m", "pip", "list", "--format=freeze",
                          "--disable-pip-version-check"], capture_output=True, text=True)
    if out.returncode != 0:
        return [f"{py} -m pip list failed: {(out.stderr or out.stdout).strip()[-200:]}"]
    have = {}
    for line in out.stdout.splitlines():
        if "==" in line:
            n, v = line.split("==", 1)
            have[_norm(n)] = v.strip()
    diffs = []
    for key, (name, want) in sorted(pins.items()):
        got = have.get(key)
        if got is None:
            diffs.append(f"{name}=={want} is not installed")
        elif got != want:
            diffs.append(f"{name} is {got}, CI installs {want}")
    return diffs


#: The edit ledger in the git dir: one path per line, relative to the checkout, appended by
#: scripts/hooks/claude-record-edits for every Edit and Write; a committed path leaves it.
LEDGER = "nmas-edited-paths"


def staged(repo) -> list:
    """``[(status, path)]`` of what is staged against HEAD (renames as a delete and an add)."""
    out = git(repo, "diff", "--cached", "--name-status", "--no-renames", "HEAD").stdout
    return [tuple(line.split("\t", 1)) for line in out.splitlines() if "\t" in line]


def named(path, only) -> bool:
    """Whether *path* is one of *only* or under one of its folders."""
    return any(path == p or path.startswith(p + "/") for p in only)


def edited(gitdir):
    """The edit ledger's paths, or None where no ledger exists (nothing to judge against)."""
    path = os.path.join(gitdir, LEDGER)
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as fh:
        return {line.strip() for line in fh if line.strip()}


def forget(gitdir, paths) -> None:
    """Take committed *paths* out of the edit ledger (a later edit adds them again)."""
    have = edited(gitdir)
    if have is None:
        return
    keep = sorted(have - set(paths))
    tmp = os.path.join(gitdir, LEDGER + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("".join(f"{p}\n" for p in keep))
    os.replace(tmp, os.path.join(gitdir, LEDGER))


#: Set by the launcher in the gate it runs from the base commit (C2457): that process IS the
#: base's code, and runs the gate itself.
FROM_BASE = "NMAS_GATE_FROM_BASE"


def from_base(repo, argv, *, has_repo) -> "int | None":
    """C2457 (the operator, 2026-11-04): the gate runs its own code from the BASE commit, never
    from the working tree, so an uncommitted edit to the gate, a helper, a hook or a check can
    neither loosen nor break another commit's verdict. The base (HEAD) is extracted to a
    throwaway worktree and its own `scripts/nmas-gate` runs with `--repo`: every constant,
    helper (`HERE`), check and hook is then the base's. None when this process is itself that
    run, or when the base holds no gate (a repository without one: this one runs, and says so);
    else the base gate's exit status. The folder is a snapshot folder with its owner, so a killed
    gate's is swept by `remove_stale_snapshots`."""
    if os.environ.get(FROM_BASE):
        # This is the base's run. The marker leaves its environment at once, so nothing it
        # starts (the suite, whose gate tests start gates of their own) inherits it.
        os.environ.pop(FROM_BASE)
        global BASE_TREE
        BASE_TREE = os.path.dirname(HERE)
        return None
    head = git(repo, "rev-parse", "--verify", "-q", "HEAD", check=False).stdout.strip()
    if not head or git(repo, "cat-file", "-e", f"{head}:scripts/nmas-gate",
                       check=False).returncode:
        say("0. the base commit holds no gate: this file runs (a repository without one)")
        return None
    import tempfile
    base = tempfile.mkdtemp(prefix=SNAPSHOT_PREFIX + "base-")
    with open(os.path.join(base, SNAPSHOT_OWNER), "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    tree = os.path.join(base, "tree")
    try:
        git(repo, "worktree", "add", "-q", "--detach", tree, head)
        say(f"0. the gate's own code is the base commit's ({head[:12]}), run from a throwaway "
            "worktree of it, never this working tree's (C2457)")
        args = list(argv) + ([] if has_repo else ["--repo", repo])
        return subprocess.run([sys.executable, os.path.join(tree, "scripts", "nmas-gate"), *args],
                              env=dict(os.environ, **{FROM_BASE: head})).returncode
    finally:
        git(repo, "worktree", "remove", "--force", tree, check=False)
        shutil.rmtree(base, ignore_errors=True)
        git(repo, "worktree", "prune", check=False)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--message", required=True, help="the commit message file")
    ap.add_argument("--expect", required=True, help="what its first line must start with")
    ap.add_argument("--browser", action="store_true", help="also run the browser tests, unconfined")
    ap.add_argument("--push", action="store_true", help="push after committing")
    ap.add_argument("--fixes-red", type=int, default=None, metavar="N",
                    help="this commit fixes CI's red run N on main forward (step 0)")
    ap.add_argument("--repo", default=None, help="the repository (default: this checkout)")
    ap.add_argument("--python", default=os.environ.get("NMAS_GATE_PYTHON", DEFAULT_PY),
                    help="CI's interpreter (default: the venv scripts/nmas-ci-env builds)")
    ap.add_argument("--only", nargs="+", default=None, metavar="PATH",
                    help="commit exactly these paths (files or folders, relative to the "
                         "repository); refused when anything else is staged")
    a = ap.parse_args(argv)
    if not a.expect.strip():
        ap.error("--expect must name the subject: an empty prefix matches every message")
    repo = a.repo or subprocess.run(["git", "-C", HERE, "rev-parse", "--show-toplevel"],
                                    capture_output=True, text=True).stdout.strip()
    rc = from_base(repo, argv if argv is not None else sys.argv[1:], has_repo=bool(a.repo))
    if rc is not None:
        return rc
    gitdir = git(repo, "rev-parse", "--absolute-git-dir").stdout.strip()

    # 6 (checked early as well as at the end: a wrong message should not cost a suite run).
    def first_line():
        try:
            return open(a.message, encoding="utf-8").readline().rstrip("\n")
        except OSError as exc:
            refuse("the message", f"cannot read {a.message}: {exc}")
    if not first_line().startswith(a.expect):
        refuse("the message", f"its first line is {first_line()!r}, not one starting {a.expect!r}: "
                              "a failed write leaves the previous message in place")
    if a.push:
        why = red_ci(a.fixes_red)
        if why:
            refuse("CI on main", why)

    if a.only:
        only = sorted({os.path.relpath(os.path.abspath(p), repo) if os.path.isabs(p)
                       else os.path.normpath(p) for p in a.only})
        if any(p == ".." or p.startswith("../") for p in only):
            refuse("stage", f"--only names a path outside {repo}: {only}")
        held = staged(repo)
        extra = sorted(p for _s, p in held if not named(p, only))
        if extra:
            refuse("stage", f"staged and not named by --only: {extra}; unstage them "
                            "(git reset -q -- <path>) or name them")
        unstaged = sorted(p for p in only if not any(named(s, [p]) for _x, s in held))
        if unstaged:
            refuse("stage", f"named by --only and not staged: {unstaged}; the gate judges the "
                            "index exactly as staged and stages nothing itself (C2457): stage "
                            "them (git add -- <path>, or git apply --cached for a part)")
        say(f"1. the staged tree, as staged (the gate stages nothing, C2457): "
            f"{len(held)} file(s), each under {' '.join(only)}")
    else:
        if not staged(repo):
            refuse("stage", "nothing is staged; the gate judges the index exactly as staged and "
                            "stages nothing itself (C2457): stage the commit's files first")
        say("1. the staged tree, as staged (the gate stages nothing, C2457)")
    files = staged(repo)
    say(f"1b. the commit will contain {len(files)} file(s):")
    for status, path in files:
        say(f"     {status} {path}")
    if not a.only:
        ledger = edited(gitdir)
        if ledger is not None:
            unseen = [p for s, p in files if s in ("M", "D") and p not in ledger]
            if unseen:
                say(f"1b. swept in, modified and not touched by this session's Edit or Write "
                    f"tools: {', '.join(unseen)} (a shell edit or another session's; check "
                    "it belongs here, or commit with --only)")
    else:
        # An --only list is the work's own files, never the working tree's status (the
        # operator, 2026-10-26: a list read from status is git add -A by another name). So
        # both ways it can be wrong are named: a tracked file modified and left out of the
        # commit, and a named file this session's Edit and Write tools never touched.
        left = sorted(p for p in git(repo, "diff", "--name-only").stdout.split() if p)
        if left:
            say(f"1c. modified and left out of this commit: {', '.join(left)} (check none of "
                "them belongs to it)")
        ledger = edited(gitdir)
        if ledger is not None:
            unseen = [p for s, p in files if p not in ledger]
            if unseen:
                say(f"1c. named, and not touched by this session's Edit or Write tools: "
                    f"{', '.join(unseen)} (a shell edit, an applied patch or another "
                    "session's; check each belongs here)")
    say("2. the stage guard")
    guard = subprocess.run([sys.executable, os.path.join(HERE, "nmas-stage-guard"),
                            "--repo", repo], capture_output=True, text=True)
    sys.stdout.write(guard.stdout)
    if guard.returncode != 0:
        refuse("the stage guard", (guard.stderr or guard.stdout).strip()[-400:])

    tree = git(repo, "write-tree").stdout.strip()
    head = git(repo, "rev-parse", "HEAD").stdout.strip()
    branch = git(repo, "symbolic-ref", "-q", "HEAD", check=False).stdout.strip()
    if not branch:
        refuse("the snapshot", "HEAD is detached: the gate commits onto a branch")
    for stale in remove_stale_snapshots(repo):
        say(f"2b. removed a snapshot an earlier run left behind: {stale}")
    import signal
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _exit_on_signal)
    snap, remove = make_snapshot(repo, tree, head)
    say(f"2b. the snapshot: tree {tree[:10]} of {head[:10]}, tested in {snap}; the working "
        "tree is free")
    try:
        rc = _tested(a, repo, snap, gitdir, tree, head, branch, first_line)
    finally:
        remove()
    if rc == 0:
        # Only what the working tree still holds as committed: a file edited again while the
        # suite ran keeps its ledger line (2026-10-26: three documents edited during a gate
        # were dropped from the ledger at its commit, and the next gate's 1c named them as
        # untouched by this session).
        committed = [p for _s, p in files]
        moved = set(git(repo, "diff", "--name-only", "HEAD", "--", *committed).stdout.split()) \
            if committed else set()
        forget(gitdir, [p for p in committed if p not in moved])
    return rc


def _tested(a, repo, snap, gitdir, tree, head, branch, first_line):
    """Steps 3 to 8, in the snapshot *snap* of *tree*; the commit made there moves *branch*
    only if it still points at *head*, and only when its tree is *tree*."""
    suite_out = os.path.join(gitdir, "nmas-gate-suite.out")
    if not os.environ.get("NMAS_GATE_SUITE"):       # the gate's own tests stand a suite in
        say("3. CI's interpreter holds what CI installs")
        diffs = interpreter_differs(a.python, snap)
        if diffs:
            refuse("CI's interpreter", f"{a.python} differs from what CI installs from "
                   f"{', '.join(CI_FILES)}: " + "; ".join(diffs[:8])
                   + (f"; and {len(diffs) - 8} more" if len(diffs) > 8 else "")
                   + ". Rebuild it: scripts/nmas-ci-env <CI's python> (docs/TESTING.md)")
    say("4. the suite, CI's four commands in CI's interpreter, at once, the browser tests "
        "among them")
    cov = os.path.join(gitdir, "nmas-gate-coverage")
    shutil.rmtree(cov, ignore_errors=True)          # step 3's rule, for the measurement too
    os.makedirs(os.path.join(cov, "tiers"))
    path = os.pathsep.join([BROWSER_DIR, os.path.join(BROWSER_DIR, "firefox"),
                            os.environ.get("PATH", "")])
    env = dict(os.environ, PATH=path)
    if os.path.isdir(PG_LIB):
        env["LD_LIBRARY_PATH"] = os.pathsep.join(
            p for p in (PG_LIB, os.environ.get("LD_LIBRARY_PATH", "")) if p)
    # Docs only (the operator, 2026-10-25): a tree whose every changed path is under docs/ runs
    # the doc set alone (tests/doc_tests.py, `nmas-shards docs`), as CI's doc job does.
    changed = git(repo, "diff-tree", "-r", "--name-only", head, tree).stdout.split()
    docs_only = _docs_only(snap, changed)
    shards = (DOC_SHARD,) if docs_only else SHARDS
    if docs_only:
        say(f"4. docs only: every one of the {len(changed)} changed path(s) is under docs/, so "
            "the doc set runs (tests/doc_tests.py) and the rest does not")
    if os.environ.get("NMAS_GATE_SUITE"):           # the gate's own tests: one stand-in run
        runs = {"suite": (os.environ["NMAS_GATE_SUITE"], suite_out)}
    else:
        n, words = suite_workers()
        if docs_only:
            n = min(CI_WORKERS, n * len(SHARDS))     # one run has the five runs' memory
        say(f"4. workers, from the memory available now: {words}; each shard bound at "
            f"{suite_bound(n)} s")
        runs = {s: (SUITE.format(py=shlex.quote(a.python), shard=s, cov=shlex.quote(cov), n=n,
                                 bound=suite_bound(n),
                                 req=browser_required(s)),
                    os.path.join(gitdir, f"nmas-gate-suite-{s}.out")) for s in shards}
    # AT MOST ONE FULL-SUITE RUN AT A TIME (the operator, 2026-10-19): held for the suite and
    # the ratchet; another gate, or a bare scripts/nmas-test, refuses naming this one.
    held = hold_full_suite(f"nmas-gate (pid {os.getpid()})")
    if isinstance(held, str):
        refuse("the full-suite lock", held)
    codes = run_all_to_files(runs, snap, env)
    whys, lines = [], []
    for name, (_cmd, out) in runs.items():
        why = verdict(out, codes[name]) or browser_skipped(out)
        if why:
            whys.append((name, why, out))
        lines.append((f"{name}: " if len(runs) > 1 else "")
                     + (last_line(out) if os.path.isfile(out) else "(no output)"))
    result_line = "; ".join(lines)
    say(f"4. the suite: {result_line}")
    if whys:
        name, why, out = whys[0]
        refuse("the suite", (f"job {name}: " if len(runs) > 1 else "") + why
               + (f" (and {len(whys) - 1} more)" if len(whys) > 1 else ""), out)

    stand_in = bool(os.environ.get("NMAS_GATE_SUITE"))
    junits = [os.path.join(cov, f"junit-{s}.xml") for s in shards]
    if docs_only:
        say("4c. the tests of root's real files: not run, docs only (the code is its parent's)")
    else:
        roots_out = os.path.join(gitdir, "nmas-gate-rootfiles.out")
        cmd = os.environ.get("NMAS_GATE_ROOTFILES") or (
            None if stand_in else ROOT_FILES.format(py=shlex.quote(a.python),
                                                    cov=shlex.quote(cov)))
        if cmd is None:
            say("4c. the tests of root's real files: not run, the suite is a stand-in")
        else:
            say("4c. the tests of root's real files, unconfined (deselected in step 4, C2455)")
            why = verdict(roots_out, run_to_file(cmd, snap, roots_out))
            say(f"    {last_line(roots_out) if os.path.isfile(roots_out) else '(no output)'}")
            if why:
                refuse("the tests of root's real files", why, roots_out)
            junits.append(os.path.join(cov, "junit-rootfiles.xml"))
    skips_out = os.path.join(gitdir, "nmas-gate-skips.out")
    checker, whose = own_or_snapshot(os.path.join("scripts", "nmas-skip-check"), snap)
    cmd = os.environ.get("NMAS_GATE_SKIP_CHECK") or (
        None if stand_in else SKIP_CHECK.format(
            py=shlex.quote(a.python), check=shlex.quote(checker),
            files=" ".join(shlex.quote(j) for j in junits)))
    if cmd is None:
        say("4d. every skip declared: not run, the suite is a stand-in")
    else:
        say(f"4d. every skip is one the skip list declares for the gate (C2412), by {whose} "
            "check and list (C2457)")
        rc = run_to_file(cmd, snap, skips_out)
        say(f"    {last_line(skips_out) if os.path.isfile(skips_out) else '(no output)'}")
        if rc:
            refuse("the declared skips", f"scripts/nmas-skip-check exited {rc}: "
                   f"{last_line(skips_out) if os.path.isfile(skips_out) else 'no output'}",
                   skips_out)

    if docs_only:
        say("4b. the coverage ratchet: not run, docs only (the code, and so its coverage, is "
            "its parent's; CI's coverage job skips it the same way)")
    else:
        say("4b. the coverage ratchet, CI's coverage job over the four shards' measurement")
        ratchet_out = os.path.join(gitdir, "nmas-gate-ratchet.out")
        cmd = os.environ.get("NMAS_GATE_RATCHET") or RATCHET.format(
            py=shlex.quote(a.python), cov=shlex.quote(cov),
            files=" ".join(shlex.quote(os.path.join(cov, f".coverage.{s}")) for s in SHARDS))
        rc = run_to_file(cmd, snap, ratchet_out, env)
        why = ratchet_failed(ratchet_out, rc)
        if why:
            refuse("the coverage ratchet", why, ratchet_out)
        say("4b. the coverage ratchet holds")

    browser_line = ""
    if a.browser:
        browser_out = os.path.join(gitdir, "nmas-gate-browser.out")
        say("5. the browser tests, unconfined")
        cmd = os.environ.get("NMAS_GATE_BROWSER") or BROWSER.format(py=shlex.quote(a.python))
        rc = run_to_file(cmd, snap, browser_out)
        why = verdict(browser_out, rc)
        browser_line = last_line(browser_out) if os.path.isfile(browser_out) else ""
        say(f"   {browser_line or '(no output)'}")
        if why:
            refuse("the browser tests", why, browser_out)

    touched = gate_code_changed(changed)
    flags = []
    if touched and not stand_in:
        say(f"6a. the commit changes the gate's own code ({', '.join(touched)}): a second pass "
            "with its own versions (C2457)")
        refusals, flags = second_pass(repo, snap, a.message, junits, a.python, changed,
                                      docs_only)
        for f in flags:
            if f != OWN_HOOKS_PASSED:
                say(f"    FLAGGED: {f}")
        if refusals:
            refuse("the second pass", "; ".join(refusals))
        shown = [f for f in flags if f != OWN_HOOKS_PASSED]
        say(f"    the commit's own checks agree{' (flagged above)' if shown else ''}")
    elif touched:
        say("6a. the second pass: not run, the suite is a stand-in")

    say("6. the message")
    if not first_line().startswith(a.expect):
        refuse("the message", f"its first line changed during the run to {first_line()!r}")
    body = open(a.message, encoding="utf-8").read()
    result = result_line + (f"; browser tests: {browser_line}" if browser_line else "")
    body = body.replace("@SUITE@", result)
    final = os.path.join(gitdir, "nmas-gate-message.txt")
    with open(final, "w", encoding="utf-8") as fh:
        fh.write(body)

    say("7. commit, in the snapshot, judged by the parent commit's hooks")
    r = commit_judged_by_parent(repo, snap, head, final)
    if r.returncode != 0:
        weaker = (" FLAGGED (C2396): the commit's own commit-msg hooks passed what the base's "
                  "refuse, so its own are WEAKER" if OWN_HOOKS_PASSED in flags else "")
        refuse("git commit", (r.stderr or r.stdout).strip()[:4000] + weaker)
    new = git(snap, "rev-parse", "HEAD").stdout.strip()
    committed = git(snap, "rev-parse", f"{new}^{{tree}}").stdout.strip()
    if committed != tree:
        refuse("the commit", f"its tree {committed[:10]} is not the tested tree {tree[:10]} (a "
                             f"hook changed what is committed): {branch} was not moved")
    # Compare and swap: the branch moves to the commit only if it still points where the gate
    # began; the working tree and the index keep whatever was done during the run.
    r = git(repo, "update-ref", "-m", "nmas-gate: the tested snapshot", branch, new, head,
            check=False)
    if r.returncode != 0:
        now = git(repo, "rev-parse", branch, check=False).stdout.strip()
        refuse("the branch", f"{branch} moved during the run (from {head[:10]} to {now[:10]}), "
                             f"so the tested commit {new[:10]} was not put on it")
    sha = new[:8]
    say(f"   committed {sha}: {body.splitlines()[0]}")
    if a.push:
        say("8. push")
        git(repo, "push", "-q")
        say(f"   pushed {sha}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
