#!/usr/bin/env python3
"""Measure, on a real device, what each Tier 2 command asks and does, before Tier 2 is built.

Tier 2 ("Run a privileged command…", docs/NSOT_TIER2_PRIVILEGED.md, approved 2026-10-08) sends
recoverable exec commands with a preview, a confirm and a record. Its build waits for three
measurements on one device of each platform (section 5): the exact confirm prompt each command
asks (so the operation answers only that prompt: send, read, decide), whether a soft BGP refresh
resets anything, and how long ARP takes to come back after it is cleared (verify's settle
window, about 2.5 times that). Nothing is assumed from documentation: each is asked of the
device.

For each step, on the named device, holding it (C98) for the whole run:

  1. read the BEFORE (the read Tier 2's preview will take), masked, kept in the record;
  2. send the command, once, and read what comes back WITHOUT answering anything;
  3. if it ends in exactly ``[confirm]``, answer it with Enter, once, and read again; any other
     question is NOT answered: the run stops, the session is closed (which abandons the
     command), and the record names the question;
  4. read the AFTER, masked, and say what moved;
  5. clear arp-cache only: read the interface's ARP entries every second, up to `ARP_WAIT`, until
     as many are back as before, and record the seconds.

Each step is RECOVERABLE by design (Tier 2): counters count again, ARP relearns, a soft refresh
re-sends routes, a cleared buffer fills again, and undebug turns debugs off. The log buffer and
the counters it clears are KEPT in the record first (T2-4), masked and capped. Nothing is
configured or saved.

**What it touches is chosen narrowly, and refused otherwise:**
- ``clear counters`` on ONE data interface the operator names (``--interface``), never all;
- ``clear arp-cache interface`` only on an interface the operator names (``--arp-interface``);
- NEITHER on the interface carrying the device's management address (read from
  ``show ip interface brief``, the address Mercury reaches it on): clearing its ARP could cut
  the session the probe runs on, and its counters are not a data interface's (C583: the first
  version defaulted counters to Loopback0, which carries that address in this lab);
- ``clear ip bgp <peer> soft`` only with ``--allow-live-bgp``: it acts on a live session. The
  peer is the first Established one in ``show ip bgp summary`` unless ``--bgp-peer`` names one;
  the verdict compares the peer's Up/Down before and after (a reset starts it again), and the
  neighbour's own read (``show ip bgp neighbors <peer>``, kept) says whether a connection
  dropped and a refresh was sent;
- ``clear ip bgp <peer>``, the HARD clear self-healing's session clear sends (board H, H21),
  only when ``--step bgp-hard`` names it (never in a run of every step), with
  ``--allow-live-bgp`` and ``--bgp-peer``: it RESETS that one session. A planned window is
  declared on the device BEFORE it is sent, naming the neighbour's interface
  (`restarts.record_planned`, C2702's lesson: a drop no window explains is an unexplained
  row), or nothing is sent; then the neighbour is read every second, up to `BGP_WAIT`, until it
  is Established again, and the seconds are recorded: the settle time the session clear's
  verify bound is 2.5 times of;
- ``clear ip ospf <process> process`` (``--step ospf-reset``) and ``clear ipv6 ospf <process>
  process`` (``--step ospfv3-reset``), the process resets self-healing's R8 proposal sends
  (board H, H5; C2374), only when the step names it, with ``--allow-live-ospf`` and
  ``--ospf-process``: every adjacency of the process drops. A planned window is declared
  first, naming each neighbour committed intent expects as a far end (C2749), or nothing is
  sent; the reset's own question ("Reset OSPF process N? [no]:") alone is answered ``yes``;
  then the neighbour table is read every 2 s, up to `OSPF_WAIT`, until every adjacency formed
  before is formed again, counted only once a drop is seen; the commands are
  `privileged.PROCESS_RESETS`', the one home of their text;
- ``--bgp-family ipv6`` runs either clear on an IPv6 neighbour (``clear bgp ipv6 unicast
  <peer>``, its summary ``show bgp ipv6 unicast summary``); the commands are
  `privileged.SESSION_CLEARS`', the one home of their text;
- never inside the hypervisor's nightly backup window, 02:30 to 03:30 in the hypervisor's zone
  (08:30 to 09:30 UTC under MDT, 09:30 to 10:30 under MST; a measurement taken then measures
  the backup), refused naming the window; refused too when the zone cannot be read.

A step that cannot be measured (no BGP, a flag not given, no ARP interface named) is recorded as
NOT MEASURED with the reason, never as a result.

    nmas-tier2-probe                                                   # dry run: the plan
    nmas-tier2-probe --list Default --device <device> --apply --actor you@example.com \\
        --interface GigabitEthernet2 --arp-interface GigabitEthernet2 --allow-live-bgp \\
        --out ~/nmas-probe-out/tier2-<device>.json
    nmas-tier2-probe --step bgp-hard --allow-live-bgp --bgp-peer 192.0.2.3      # its dry run
    nmas-tier2-probe --list Default --device <device> --apply --actor you@example.com \\
        --step bgp-hard --allow-live-bgp --bgp-peer 192.0.2.3 \\
        --out ~/nmas-probe-out/tier2-<device>-bgp-hard.json

Run it on one device of each platform (cisco_iosxe, cisco_ios). Exit 0 measured (whatever the
results), 1 refused before touching the device, 2 stopped on a question it would not answer.
"""

import argparse
import json
import os
import re
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

#: The steps, in the order they run. ``{interface}``, ``{arp_interface}`` and ``{peer}`` are
#: filled from the arguments (each one token of its shape).
STEPS = (
    {"key": "clear-counters", "command": "clear counters {interface}", "needs": "interface",
     "before": "show interfaces {interface}", "after": "show interfaces {interface}"},
    {"key": "clear-arp", "command": "clear arp-cache interface {arp_interface}",
     "before": "show ip arp {arp_interface}", "after": "show ip arp {arp_interface}",
     "needs": "arp_interface"},
    {"key": "clear-logging", "command": "clear logging",
     "before": "show logging", "after": "show logging"},
    {"key": "undebug-all", "command": "undebug all",
     "before": "show debugging", "after": "show debugging"},
    {"key": "bgp-soft", "command": "clear ip bgp {peer} soft",
     "before": "show ip bgp summary", "after": "show ip bgp summary", "needs": "peer",
     "clear": "clear-bgp-soft"},
    # H21: the hard clear resets the session, so it runs only when --step names it.
    {"key": "bgp-hard", "command": "clear ip bgp {peer}",
     "before": "show ip bgp summary", "after": "show ip bgp summary", "needs": "peer",
     "clear": "clear-bgp-peer", "drops": True, "named_only": True},
    # C2374 (board H, H5; H11's lab measurements): an OSPF process reset drops every adjacency
    # of its process, so it runs only when --step names it, with --allow-live-ospf and
    # --ospf-process; its text is `privileged.PROCESS_RESETS`', the one home of it.
    {"key": "ospf-reset", "reset": "clear-ospf-process", "needs": "ospf", "drops": True,
     "named_only": True},
    {"key": "ospfv3-reset", "reset": "clear-ipv6-ospf-process", "needs": "ospf", "drops": True,
     "named_only": True},
)
#: The one question a process reset is answered (send, read, decide): IOS's "Reset OSPF
#: process N? [no]:" and its ALL and IPv6 forms. Any other question is never answered.
RESET_PROMPT = re.compile(r"^Reset (ALL )?(IPv6 )?OSPF(v3)? process(es)?( \d+)?\? *\[no\]: *$")
RESET_ANSWER = "yes"
#: A reset's adjacencies are watched up to this long, every 2 s, until every one formed before
#: is formed again. Unmeasured: the probe measures it; 300 s is past OSPF's 40 s dead time and a
#: DR election's wait several times over.
OSPF_WAIT = 300
#: The summary each address family's clear reads before and after.
SUMMARY_READ = {"ipv4": "show ip bgp summary", "ipv6": "show bgp ipv6 unicast summary"}
#: A hard clear's return to Established is watched up to this long, every second. Unmeasured:
#: the probe measures it, and a return slower than this is recorded as "not back within 300 s"
#: with the last state read. 300 s is past IOS's 180 s default hold time and its connect retry.
BGP_WAIT = 300
#: The planned window a hard clear declares runs this long past its watch (the read after).
BGP_WINDOW_MARGIN_S = 60

#: ARP's return is watched up to this long; every second. Unmeasured: the probe measures it, and
#: a return slower than this is recorded as "not back within 120 s" with the count reached.
ARP_WAIT = 120
#: A kept before-state's cap, the reads engine's measured answer cap (reads.CAP_KIB).
KEEP_BYTES = 32 * 1024
#: The hypervisor's nightly backup, in the hypervisor's OWN local time (CLAUDE.md, standing
#: facts): the job is scheduled at 02:30 in its zone, so in UTC it moves with daylight saving,
#: 08:30 to 09:30 UTC under MDT and 09:30 to 10:30 UTC under MST (measured 2026-11-06 from the
#: hypervisor's task list: 02:30 local every night either side of 2026-11-01; C2613).
#: The END, 03:30, beside what it bounds: the last three jobs ended 03:05:00, 03:06:11 and
#: 03:06:42 local (2026-11-04 to 06), 33.1 to 36.6 minutes over the 11 retained, and the job
#: has grown from about 30 minutes (2026-10-04 and 05) to about 37, so 03:10 left 3 minutes;
#: 60 minutes is about 1.6 times the longest measured run, with room for that growth (the
#: operator, 2026-11-06). Every guard on the window states these three values
#: (tests/test_backup_window.py).
BACKUP_ZONE = "America/Denver"
BACKUP_WINDOW = ((2, 30), (3, 30))

_TOKEN = re.compile(r"[A-Za-z][A-Za-z0-9/.:-]{0,63}\Z")
_ADDRESS = re.compile(r"[0-9A-Fa-f.:]{3,45}\Z")
_UPTIME = re.compile(r"(?:(\d+)y)?(?:(\d+)w)?(?:(\d+)d)?(?:(\d+)h)?\Z")


def _backup_local(now: float):
    """*now* in the backup's zone, or None when this machine cannot read the zone."""
    import datetime
    try:
        from zoneinfo import ZoneInfo
        return datetime.datetime.fromtimestamp(now, ZoneInfo(BACKUP_ZONE))
    except Exception:                    # no zone data: the guard cannot ask, so it refuses
        return None


def in_backup_window(now: float = None) -> bool:
    """Inside the window, or the zone unreadable (a guard that cannot ask refuses)."""
    t = _backup_local(time.time() if now is None else now)
    if t is None:
        return True
    (start_h, start_m), (end_h, end_m) = BACKUP_WINDOW
    minute = t.hour * 60 + t.minute
    return start_h * 60 + start_m <= minute < end_h * 60 + end_m


def backup_window_words(now: float = None) -> str:
    """The window as its zone states it, with that day's UTC: "02:30 to 03:30 America/Denver
    (09:30 to 10:30 UTC on 2026-11-06)", or why it cannot be said."""
    import datetime
    now = time.time() if now is None else now
    (start_h, start_m), (end_h, end_m) = BACKUP_WINDOW
    local = f"{start_h:02d}:{start_m:02d} to {end_h:02d}:{end_m:02d} {BACKUP_ZONE}"
    t = _backup_local(now)
    if t is None:
        return f"{local} (this machine cannot read the zone {BACKUP_ZONE}, so it refuses)"
    utc = datetime.timezone.utc
    a = t.replace(hour=start_h, minute=start_m, second=0, microsecond=0).astimezone(utc)
    b = t.replace(hour=end_h, minute=end_m, second=0, microsecond=0).astimezone(utc)
    return f"{local} ({a:%H:%M} to {b:%H:%M} UTC on {t:%Y-%m-%d})"


def confirm_prompt(text: str) -> str:
    """The last line when it is a confirm Enter answers, else ``""``."""
    last = next((ln.strip() for ln in reversed((text or "").splitlines()) if ln.strip()), "")
    return last if last.endswith("[confirm]") else ""


def question(text: str) -> str:
    """The last line when it asks something other than a confirm (``[yes/no]``, ``?``, a ``]``
    the probe does not know), else ``""``: never answered."""
    last = next((ln.strip() for ln in reversed((text or "").splitlines()) if ln.strip()), "")
    if not last or last.endswith("[confirm]") or re.search(r"[#>]\s*$", last):
        return ""
    return last if re.search(r"(\]|\?|:)\s*$", last) else ""


def uptime_seconds(text: str):
    """``show ip bgp summary``'s Up/Down as seconds (``01:02:03``, ``4d13h``, ``2w3d``), or
    None for ``never`` or a form not known."""
    text = (text or "").strip()
    m = re.fullmatch(r"(\d+):(\d\d):(\d\d)", text)
    if m:
        return int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3))
    m = _UPTIME.fullmatch(text)
    if not m or not any(m.groups()):
        return None
    y, w, d, h = (int(g or 0) for g in m.groups())
    return (((y * 365 + w * 7 + d) * 24) + h) * 3600


def bgp_peers(summary: str) -> dict:
    """``{peer: {"up": text, "seconds": int|None, "state": text, "established": bool}}`` from
    ``show ip bgp summary``'s (or ``show bgp ipv6 unicast summary``'s) neighbour table, read by
    THE one BGP summary reader (`modules.bgp_summary`, which joins an IPv6 neighbour's wrapped
    row)."""
    from modules.bgp_summary import parse_bgp_summary

    out = {}
    for p in parse_bgp_summary(summary or "")["peers"]:
        up, state = p.get("up_down") or "", p.get("state") or ""
        out[p["neighbor"]] = {"up": up, "seconds": uptime_seconds(up), "state": state,
                              "established": bool(p.get("established"))}
    return out


def management_interface(brief: str, address: str) -> str:
    """The interface ``show ip interface brief`` names with *address*, or ``""``."""
    for line in (brief or "").splitlines():
        cols = line.split()
        if len(cols) >= 2 and cols[1] == address:
            return cols[0]
    return ""


def arp_entries(text: str) -> int:
    """How many entries ``show ip arp`` lists (its rows begin ``Internet``)."""
    return sum(1 for ln in (text or "").splitlines() if ln.startswith("Internet"))


def bgp_verdict(before: dict, after: dict) -> dict:
    """A soft refresh resets nothing: Up/Down only grows. A session whose Up/Down fell, or that
    is no longer Established, was reset; one whose time cannot be read decides nothing."""
    if not before or not after:
        return {"verdict": "unknown", "why": "the peer is missing from a summary"}
    b, a = before.get("seconds"), after.get("seconds")
    if not after.get("established"):
        return {"verdict": "reset", "why": f"the peer is {after.get('state')!r} after"}
    if b is None or a is None:
        return {"verdict": "unknown",
                "why": f"Up/Down {before.get('up')!r} then {after.get('up')!r} cannot be compared"}
    if a < b:
        return {"verdict": "reset", "why": f"Up/Down fell from {before['up']} to {after['up']}"}
    return {"verdict": "not reset", "why": f"Up/Down {before['up']} then {after['up']}"}


def plan(args) -> list:
    """Each step with its arguments filled, or why it is not measured."""
    from modules.nsot.privileged import SESSION_CLEARS

    fill = {"interface": args.interface, "arp_interface": args.arp_interface,
            "peer": args.bgp_peer or "<the first Established peer>"}
    family = getattr(args, "bgp_family", "") or "ipv4"
    out = []
    chosen = getattr(args, "step", None) or [s["key"] for s in STEPS if not s.get("named_only")]
    for s in (s for s in STEPS if s["key"] in chosen):
        row = {k: v.format(**fill) if isinstance(v, str) else v for k, v in s.items()}
        if s.get("clear"):
            spec = SESSION_CLEARS[s["clear"]]
            row.update(peer=args.bgp_peer or "",
                       command=spec["command"][family].format(peer=fill["peer"]),
                       before=SUMMARY_READ[family], after=SUMMARY_READ[family], family=family,
                       neighbour=spec["read"][family].format(peer=fill["peer"]))
        if s.get("reset"):
            from modules.nsot.privileged import PROCESS_RESETS
            spec = PROCESS_RESETS[s["reset"]]
            process = getattr(args, "ospf_process", "") or ""
            row.update(command=spec["command"].format(process=process or "<process>"),
                       before=spec["read"], after=spec["read"], process=process)
            if not getattr(args, "allow_live_ospf", False):
                row["unmeasured"] = ("a process reset drops every adjacency of the process: "
                                     "--allow-live-ospf not given")
            elif not process:
                row["unmeasured"] = "no --ospf-process named (the process the reset names)"
        if s.get("needs") == "interface" and not args.interface:
            row["unmeasured"] = "no --interface named (a data interface)"
        if s.get("needs") == "arp_interface" and not args.arp_interface:
            row["unmeasured"] = "no --arp-interface named"
        if s.get("needs") == "peer" and not args.allow_live_bgp:
            row["unmeasured"] = (f"a {'hard clear' if s.get('drops') else 'soft refresh'} acts "
                                 "on a live session: --allow-live-bgp not given")
        elif s.get("drops") and s.get("clear") and not args.bgp_peer:
            row["unmeasured"] = ("a hard clear resets the session it names: --bgp-peer not "
                                 "given (it is never the first peer found)")
        out.append(row)
    return out


def refusal(args, now: float = None) -> str:
    unknown = sorted(set(getattr(args, "step", None) or []) - {s["key"] for s in STEPS})
    if unknown:
        return (f"REFUSED: no such step: {', '.join(unknown)} (the steps: "
                f"{', '.join(s['key'] for s in STEPS)})")
    for name, value in (("--interface", args.interface), ("--arp-interface", args.arp_interface)):
        if value and not _TOKEN.match(value):
            return f"REFUSED: {name} {value!r} is not one interface name"
    if args.bgp_peer and not _ADDRESS.match(args.bgp_peer):
        return f"REFUSED: --bgp-peer {args.bgp_peer!r} is not an address"
    process = getattr(args, "ospf_process", "") or ""
    if process and not process.isdigit():
        return f"REFUSED: --ospf-process {process!r} is not one token of digits"
    family = getattr(args, "bgp_family", "") or "ipv4"
    if family not in SUMMARY_READ:
        return f"REFUSED: --bgp-family {family!r} is ipv4 or ipv6"
    if args.bgp_peer:
        from modules.nsot.privileged import family_of
        if family_of(args.bgp_peer) != family:
            return (f"REFUSED: --bgp-peer {args.bgp_peer} is an {family_of(args.bgp_peer) or '?'}"
                    f" address, and --bgp-family is {family}")
    if args.apply:
        if not (args.list_name and args.device and args.actor):
            return "REFUSED: --apply needs --list, --device and --actor (who is accountable)"
        if in_backup_window(now):
            return ("REFUSED: it is inside the hypervisor's nightly backup window, "
                    f"{backup_window_words(now)}; a measurement taken now measures the backup. "
                    "Run it after the window's end.")
    return ""


def _session(device):
    """The device's session (tests replace it)."""
    from modules.connection import open_ssh, stored_connection_params
    conn = open_ssh(stored_connection_params(device), owner="probe:tier2")
    conn.enable()
    return conn


def measure(conn, steps: list, device: dict, values: dict, sleep=time.sleep,
            clock=time.time, declare=None) -> tuple:
    """``(results, stopped)``: each step measured on *conn*; *stopped* names a question the
    probe would not answer (the run ends there). *declare(device, interface, seconds, why)*
    records a hard clear's planned window (`restarts.record_planned`'s answer); a window not
    recorded sends nothing."""
    from modules.commands import run_device_command
    from modules.redact import redact_text

    def read(cmd):
        return redact_text(run_device_command(conn, cmd, read_timeout=120) or "", values)

    def raw_send(cmd):
        return conn.send_command_timing(cmd, strip_prompt=False, strip_command=False,
                                        read_timeout=30, last_read=2.0) or ""

    results, stopped = {}, ""
    brief = read("show ip interface brief")
    mgmt = management_interface(brief, device.get("ip", ""))
    for s in steps:
        row = {"command": s["command"]}
        if s.get("unmeasured"):
            results[s["key"]] = {**row, "result": "not measured", "why": s["unmeasured"]}
            continue
        if s.get("needs") in ("interface", "arp_interface") and mgmt \
                and s["command"].split()[-1] == mgmt:
            results[s["key"]] = {**row, "result": "not measured",
                                 "why": f"{mgmt} carries the management address the probe's "
                                        "session runs on"}
            continue
        before = read(s["before"])
        peer, was = None, {}
        if s.get("clear"):
            from modules.nsot.privileged import SESSION_CLEARS, bgp_session
            spec, family = SESSION_CLEARS[s["clear"]], s.get("family") or "ipv4"
            peers = bgp_peers(before)
            if "<the first" in s["command"]:
                peer = next((p for p, v in peers.items() if v["established"]), None)
            else:
                named = (s.get("peer") or s["command"].split()[-2 if s["command"].endswith(
                    " soft") else -1]).lower()
                peer = next((p for p in peers if p.lower() == named), None)
            if not peer:
                results[s["key"]] = {**row, "result": "not measured",
                                     "why": f"no such Established BGP peer in {s['before']}"}
                continue
            row["command"] = s["command"] = spec["command"][family].format(peer=peer)
            neighbour = spec["read"][family].format(peer=peer)
            text = read(neighbour)
            was = bgp_session(text)
            row.update(neighbour_read=neighbour, neighbour_before=text[:KEEP_BYTES],
                       session_before={k: was.get(k) for k in (
                           "state", "up_for", "connections", "dropped", "received",
                           "refresh_sent", "interface", "last_reset")})
            if s.get("drops"):
                # A hard clear resets the session: its planned window first (C2702), naming the
                # neighbour's interface, or nothing is sent.
                w = (declare or _declare)(device, was.get("interface") or "",
                                          BGP_WAIT + BGP_WINDOW_MARGIN_S,
                                          f"{s['command']} measured by scripts/nmas-tier2-probe "
                                          f"(board H, H21): the session to {peer} resets and "
                                          "forms again")
                rec = (w or {}).get("record") or {}
                row["planned_window"] = ({k: rec.get(k) for k in ("from", "until", "via",
                                                                   "interfaces")}
                                         if (w or {}).get("ok") else
                                         {"error": (w or {}).get("error") or "not recorded"})
                if not (w or {}).get("ok"):
                    results[s["key"]] = {**row, "result": "not measured", "why": (
                        "the planned window for the clear could not be recorded "
                        f"({row['planned_window']['error']}); nothing was sent")}
                    continue
        was_formed = None
        if s.get("reset"):
            from modules.nsot.privileged import formed
            was_formed = formed(before)
            row["formed_before"] = was_formed
            if not was_formed:
                results[s["key"]] = {**row, "result": "not measured", "why": (
                    f"{s['before']} shows no adjacency formed before the reset "
                    f"({'unreadable' if was_formed is None else 'none'}), so its return cannot "
                    "be measured; nothing was sent")}
                continue
            # The reset drops every adjacency of the process: its planned window first, naming
            # each neighbour's device as a far end (C2749), or nothing is sent.
            w = (declare or _declare)(device, "", OSPF_WAIT + BGP_WINDOW_MARGIN_S,
                                      f"{s['command']} measured by scripts/nmas-tier2-probe "
                                      "(board H, H5): every adjacency of the process drops "
                                      "and forms again", reset=s["reset"])
            rec = (w or {}).get("record") or {}
            row["planned_window"] = ({k: rec.get(k) for k in ("from", "until", "via")}
                                     | {"far_ends": (rec.get("expected") or {}).get(
                                         "far_ends") or []}
                                     if (w or {}).get("ok") else
                                     {"error": (w or {}).get("error") or "not recorded"})
            if not (w or {}).get("ok"):
                results[s["key"]] = {**row, "result": "not measured", "why": (
                    "the planned window for the reset could not be recorded "
                    f"({row['planned_window']['error']}); nothing was sent")}
                continue
        row["before"] = before[:KEEP_BYTES]
        row["before_cut"] = len(before.encode()) > KEEP_BYTES
        started = clock()
        first = raw_send(s["command"])
        row["first_answer"] = redact_text(first, values)
        prompt, asked = confirm_prompt(first), question(first)
        if prompt:
            row["prompt"] = prompt
            row["after_enter"] = redact_text(raw_send("\n"), values)
        elif asked and s.get("reset") and RESET_PROMPT.match(asked):
            # The reset's own question, and only it, is answered (send, read, decide).
            row["prompt"], row["answer"] = asked, RESET_ANSWER
            row["after_answer"] = redact_text(raw_send(RESET_ANSWER), values)
        elif asked:
            row["unanswered"] = asked
            results[s["key"]] = {**row, "result": "stopped",
                                 "why": f"the device asked {asked!r}; it was not answered"}
            stopped = asked
            break
        row["took_s"] = round(clock() - started, 2)
        if re.search(r"^%", first, re.M):
            row["result"] = "refused"
        after = read(s["after"])
        row["after"] = after[:KEEP_BYTES]
        if s["key"] == "clear-arp":
            want, waited, got = arp_entries(before), 0.0, arp_entries(after)
            while got < want and waited < ARP_WAIT:
                sleep(1.0)
                waited += 1.0
                got = arp_entries(read(s["after"]))
            row["arp"] = {"before": want, "after": got,
                          "back_after_s": waited if got >= want else None,
                          "words": (f"{got} of {want} entries back after {waited:g} s"
                                    if got >= want else
                                    f"{got} of {want} entries, not back within {ARP_WAIT} s")}
        if s.get("reset") and row.get("result") != "refused":
            # The reset's settle time: the table read every 2 s until every adjacency formed
            # before is formed again, counted only once a drop has been seen (a read taken
            # before the teardown is no return).
            from modules.nsot.privileged import formed
            waited, back, last, dropped = 0.0, None, None, False
            while waited <= OSPF_WAIT:
                last = formed(read(s["after"]))
                if last is not None and last < was_formed:
                    dropped = True
                if dropped and last is not None and last >= was_formed:
                    back = round(clock() - started, 1)
                    break
                sleep(2.0)
                waited += 2.0
            row["ospf"] = {"formed_before": was_formed, "formed_after": last, "dropped": dropped,
                           "back_after_s": back,
                           "words": (f"{last} of {was_formed} adjacencies formed again {back} s "
                                     "after the send" if back is not None else
                                     ("no drop was seen in the reads" if not dropped else
                                      f"{last} of {was_formed} formed, not back within "
                                      f"{OSPF_WAIT} s"))}
            row["settle_s"] = back
        if s.get("clear") and s.get("drops") and row.get("result") != "refused":
            # The hard clear's settle time: the session read every second until Established.
            seen, waited, back = [], 0.0, None
            while waited <= BGP_WAIT:
                sess = bgp_session(read(neighbour))
                if sess.get("state") and (not seen or seen[-1] != sess["state"]):
                    seen.append(sess["state"])
                if sess.get("established"):
                    back = round(clock() - started, 1)
                    break
                sleep(1.0)
                waited += 1.0
            row["bgp"] = {"back_after_s": back, "states": seen,
                          "dropped": (was.get("dropped"), sess.get("dropped")),
                          "words": (f"Established again {back} s after the send (states seen: "
                                    f"{' > '.join(seen)})" if back is not None else
                                    f"not back within {BGP_WAIT} s (last state "
                                    f"{(seen or ['not read'])[-1]})")}
        elif s.get("clear"):
            from modules.nsot.privileged import clear_verify
            sess = bgp_session(read(neighbour))
            row["bgp"] = bgp_verdict(bgp_peers(before).get(peer), bgp_peers(after).get(peer))
            row["session"] = clear_verify({"variant": "soft", "peer": peer}, was, sess)
        if s.get("clear"):
            row["session_after"] = {k: sess.get(k) for k in (
                "state", "up_for", "connections", "dropped", "received", "refresh_sent",
                "last_reset")}
        row.setdefault("result", "measured")
        results[s["key"]] = row
    return results, stopped


def _declare(device: dict, interface: str, seconds: float, why: str, reset: str = "") -> dict:
    """No window without a list and an actor to record it under (`main` gives `_window_for`'s):
    a hard clear measured with this sends nothing."""
    return {"ok": False, "error": "no list or actor to record a window under"}


def _window_for(args):
    """The hard clear's planned window on *args*' device, recorded BEFORE it is sent
    (`restarts.record_planned`, naming the neighbour's interface, as the probe's actor)."""
    def declare(device: dict, interface: str, seconds: float, why: str,
                reset: str = "") -> dict:
        from modules import restarts

        from modules.heal.bounce import committed_intents_of
        from modules.neighbours import expected, peer_device

        # C2749: the window covers the neighbour's device too, when committed intent holds
        # the peer's address (an outside peer has none to name); a process reset's covers
        # every neighbour of that protocol committed intent expects.
        host = device.get("hostname", "")
        intents, err = committed_intents_of(args.list_name)
        if intents is None:                           # C2795: unreadable is not "names none"
            return {"ok": False, "error": f"committed intent could not be read ({err}), so "
                                          + ("the reset's neighbours" if reset else
                                             "the cleared peer's device") + " cannot be named"}
        if reset:
            proto = "ospfv3" if "ipv6" in reset else "ospf"
            fars = sorted({(e["peer"], "") for e in expected(intents, host)
                           if e["proto"] == proto and e["peer"] and e["peer"] != host})
        else:
            far = peer_device(intents or {}, args.bgp_peer) if args.bgp_peer else ""
            fars = [(far, "")] if far and far != host else []
        now = time.time()
        try:
            return restarts.record_planned([host], now, now + seconds,
                                           args.actor, why, "nmas-tier2-probe",
                                           list_name=args.list_name,
                                           interfaces=[interface] if interface else [],
                                           far_ends=fars)
        except Exception as exc:                      # noqa: BLE001 (nothing sent, said)
            return {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
    return declare


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", dest="list_name", default="")
    ap.add_argument("--device", default="")
    ap.add_argument("--actor", default="")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--interface", default="")
    ap.add_argument("--arp-interface", default="")
    ap.add_argument("--allow-live-bgp", action="store_true")
    ap.add_argument("--bgp-peer", default="")
    ap.add_argument("--bgp-family", default="ipv4", choices=sorted(SUMMARY_READ))
    ap.add_argument("--allow-live-ospf", action="store_true")
    ap.add_argument("--ospf-process", default="")
    ap.add_argument("--step", action="append", default=[],
                    help="measure only this step (repeatable): " + ", ".join(s["key"] for s in STEPS))
    ap.add_argument("--out", default="")
    args = ap.parse_args()

    why = refusal(args)
    if why:
        print(why)
        return 1
    steps = plan(args)
    if not args.apply:
        print("DRY RUN: nothing connects. Each step: what is read before and after, and what "
              "is sent (a [confirm] is answered with Enter; any other question stops the run):\n")
        for s in steps:
            print(f"{s['key']}: {s['command']}"
                  + (f"   NOT MEASURED: {s['unmeasured']}" if s.get("unmeasured") else ""))
            print(f"  before: {s['before']}\n  after:  {s['after']}")
            if s.get("neighbour"):
                print(f"  the neighbour, before and after (kept): {s['neighbour']}")
            if s.get("reset"):
                print(f"  first: a planned window of {OSPF_WAIT + BGP_WINDOW_MARGIN_S} s on the "
                      "device, naming each neighbour committed intent expects as a far end "
                      "(nothing is sent without it); the reset's own question alone answered "
                      f"{RESET_ANSWER!r}; then the table read every 2 s, up to {OSPF_WAIT} s, "
                      "until every adjacency formed before is formed again")
            elif s.get("drops"):
                print(f"  first: a planned window of {BGP_WAIT + BGP_WINDOW_MARGIN_S} s on the "
                      "device, naming the neighbour's interface (nothing is sent without it); "
                      f"then the neighbour read every second, up to {BGP_WAIT} s, until "
                      "Established")
        print("\n--apply --list <list> --device <device> --actor <you> measures them.")
        return 0

    from modules.nsot import device_ops
    from modules.nsot.platform import platform_for_device
    from modules.nsot.restore import _devices_of
    from modules.redact import known_secret_values

    device = next((d for d in _devices_of(args.list_name)
                   if d.get("hostname") == args.device), None)
    if device is None:
        print(f"REFUSED: {args.device} is not in list {args.list_name}")
        return 1
    record = {"device": args.device, "platform": platform_for_device(device),
              "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "actor": args.actor}
    with device_ops.hold(args.list_name, args.device, "probe", args.actor, detail="tier 2"):
        conn = _session(device)
        try:
            record["results"], stopped = measure(conn, steps, device, known_secret_values(),
                                                 declare=_window_for(args))
        finally:
            conn.disconnect()
    if stopped:
        print(f"STOPPED: {args.device} asked {stopped!r}, which the probe does not answer; the "
              "session was closed, abandoning the command. The steps before it are recorded.")
    for key, row in record["results"].items():
        extra = row.get("prompt") or row.get("why") or (row.get("arp") or {}).get("words") \
            or (row.get("bgp") or {}).get("why") or (row.get("bgp") or {}).get("words") \
            or (row.get("ospf") or {}).get("words") or ""
        print(f"{key}: {row['result']}" + (f"  ({extra})" if extra else ""))
    text = json.dumps(record, indent=2, sort_keys=True)
    if args.out:
        from modules.config import open_secure
        with open_secure(args.out, "w") as fh:
            fh.write(text + "\n")
        print(f"written: {args.out}")
    else:
        print(text)
    return 2 if stopped else 0


if __name__ == "__main__":
    raise SystemExit(main())
