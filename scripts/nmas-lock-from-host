#!/usr/bin/env python3
"""Print requirements.lock from THIS machine's installed packages (register C37).

Run it ON THE DEPLOYMENT HOST, from the checkout, and commit what it prints:

    python3 scripts/nmas-lock-from-host > /tmp/requirements.lock
    diff requirements.lock /tmp/requirements.lock      # read it, then copy it in

Read-only: it writes nothing, and prints the lock on stdout and its findings
on stderr.

The names are the current lock's names, plus every third-party module the
code imports (an AST scan of app.py, modules/, routes/ and scripts/), mapped
to distributions through IMPORT_TO_DIST. Then it adds this machine's
dependency closure of those, and pins each at the version installed HERE.

A name the code imports and this machine lacks is NAMED on stderr, never
dropped silently. `minio` is optional by design; anything else missing is a
finding about the host. Exit 0 always prints a lock; exit 1 means something
the code imports is missing and not declared optional.
"""

import ast
import importlib.metadata as md
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

#: Import name -> distribution, for names whose distribution differs or
#: which apt metadata cannot map. A new third-party import not listed here
#: is refused by tests/test_requirements_lock.py.
IMPORT_TO_DIST = {
    "anthropic": "anthropic", "cryptography": "cryptography",
    "dotenv": "python-dotenv", "flask": "Flask", "flask_socketio": "Flask-SocketIO",
    "jinja2": "Jinja2", "jsonschema": "jsonschema", "jwt": "PyJWT",
    "minio": "minio", "ncclient": "ncclient", "netmiko": "netmiko",
    "paramiko": "paramiko", "ping3": "ping3", "psutil": "psutil",
    "pysnmp": "pysnmp", "requests": "requests", "urllib3": "urllib3",
    "werkzeug": "Werkzeug", "yaml": "PyYAML",
    "packaging": "packaging",   # this script's own marker evaluation
}
#: Imported, and absent on the host by design.
OPTIONAL = {"minio"}
#: Local packages and paths, not distributions.
LOCAL = {"modules", "routes", "tests", "app", "telnetlib", "conftest", "fixtures"}

HEADER = """\
# requirements.lock: the versions the DEPLOYMENT HOST runs (register C37).
#
# Generated by scripts/nmas-lock-from-host on the host (Python {py}), for every
# distribution the code imports or the suite loads, plus the host's own
# dependency closure of those. CI installs THIS file, so a green run describes
# the machine that runs in production. requirements.txt describes no machine:
# see docs/OPEN_FINDINGS.md C37 for the measured differences.
#
# Absent here by design: {optional}. cffi is resolved by pip (Ubuntu ships its
# backend without a distribution).
"""


def static_imports(root=ROOT):
    """Third-party top-level module names the code imports."""
    paths = [os.path.join(root, "app.py")]
    for top in ("modules", "routes", "scripts"):
        for dirpath, _dirs, files in os.walk(os.path.join(root, top)):
            for name in files:
                if name.endswith(".py") or (top == "scripts" and "." not in name):
                    paths.append(os.path.join(dirpath, name))
    found = set()
    for path in paths:
        try:
            with open(path, encoding="utf-8") as fh:
                tree = ast.parse(fh.read())
        except (SyntaxError, UnicodeDecodeError, OSError):
            continue
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                found |= {a.name.split(".")[0] for a in node.names}
            elif isinstance(node, ast.ImportFrom) and node.module and not node.level:
                found.add(node.module.split(".")[0])
    return sorted(n for n in found if n not in sys.stdlib_module_names and n not in LOCAL)


def lock_names(path):
    names = []
    if os.path.exists(path):
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if "==" in line:
                    names.append(line.split("==")[0])
    return names


def _norm(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def closure(names):
    """{norm: (Name, version)} for *names* and their installed dependencies,
    and the list of names not installed here."""
    from packaging.markers import default_environment
    from packaging.requirements import Requirement

    env = default_environment()
    seen, missing, stack = {}, [], list(names)
    while stack:
        name = stack.pop()
        key = _norm(name)
        if key in seen or key in missing:
            continue
        try:
            dist = md.distribution(name)
        except md.PackageNotFoundError:
            missing.append(key)
            continue
        seen[key] = (dist.metadata["Name"], dist.version)
        for raw in dist.requires or []:
            req = Requirement(raw)
            if req.marker and not req.marker.evaluate({**env, "extra": ""}):
                continue
            stack.append(req.name)
    return seen, sorted(missing)


def main() -> int:
    imported = static_imports()
    unmapped = [n for n in imported if n not in IMPORT_TO_DIST]
    if unmapped:
        print(f"REFUSED: imports with no distribution mapping: {unmapped}. Add them "
              "to IMPORT_TO_DIST.", file=sys.stderr)
        return 2
    wanted = set(lock_names(os.path.join(ROOT, "requirements.lock")))
    wanted |= {IMPORT_TO_DIST[n] for n in imported}
    seen, missing = closure(sorted(wanted))
    needed = {_norm(IMPORT_TO_DIST[n]) for n in imported} - {_norm(IMPORT_TO_DIST[n]) for n in OPTIONAL}
    lacking = sorted(set(missing) & needed)
    print(HEADER.format(py=sys.version.split()[0], optional=", ".join(sorted(OPTIONAL))), end="")
    for _key, (name, version) in sorted(seen.items(), key=lambda kv: kv[1][0].lower()):
        print(f"{name}=={version}")
    print(f"not installed here: {missing}", file=sys.stderr)
    if lacking:
        print(f"MISSING and imported by the code: {lacking}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
