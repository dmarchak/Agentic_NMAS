#!/usr/bin/env python3
"""Render deploy/systemd's TEMPLATES into installable units.

    d=$(mktemp -d) && scripts/nmas-render-units --out "$d" deploy/systemd/nmas-startup-check.service \
      deploy/systemd/nmas-startup-check.timer && sudo install -m 0644 "$d/nmas-startup-check.service" \
      "$d/nmas-startup-check.timer" /etc/systemd/system/

Render into a FRESH directory and install exactly the files named: --out is
refused when it already holds a file, since a shared folder (the old
/tmp/nmas-units) held units rendered for earlier installs, and a glob over it
would have reinstalled them (the operator, 2026-10-01).

The repository is public (the operator, 2026-09-29), so the units in
`deploy/systemd/` carry placeholders instead of the host's user, paths and
addresses. This fills them from the local, gitignored `data/lab_hosts.json`,
the same file `scripts/nmas-host` reads:

    @NMAS_USER@       the "nmas" entry's user
    @NMAS_HOME@       its "home", else that user's home directory on THIS machine
    @NMAS_CHECKOUT@   its "checkout", else the checkout this script is in
    @HYPERVISOR_LAN@  the "pve" entry's LAN address

It REFUSES, and writes nothing, when the hosts file is missing or unreadable,
when a value a template uses cannot be established, or when any `@NAME@`
placeholder would remain: a unit installed with a placeholder in it fails at
start, or worse, runs as the wrong user.
"""

import argparse
import json
import os
import pwd
import re
import sys
from importlib.machinery import SourceFileLoader

HERE = os.path.dirname(os.path.realpath(__file__))

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

ROOT = os.path.dirname(HERE)
PLACEHOLDER = re.compile(r"@([A-Z][A-Z_]*)@")
EXIT_REFUSED = 78


def _hosts_doc() -> tuple:
    nmas_host = SourceFileLoader("nmas_host", os.path.join(HERE, "nmas-host")).load_module()
    path = nmas_host.hosts_path()
    try:
        with open(path, encoding="utf-8") as fh:
            return path, json.load(fh)
    except FileNotFoundError:
        raise SystemExit(_refuse(f"{path} does not exist"))
    except (OSError, ValueError) as exc:
        raise SystemExit(_refuse(f"{path} could not be read: {exc}"))


def _refuse(why: str, hosts: bool = True) -> int:
    print(f"nmas-render-units: refused: {why}. Nothing was written."
          + (" The hosts' values are kept out of the public repository, in "
             "data/lab_hosts.json (gitignored)." if hosts else ""),
          file=sys.stderr)
    return EXIT_REFUSED


def values(doc: dict) -> dict:
    """The placeholder values this machine can establish; a missing one is absent."""
    nmas, pve = doc.get("nmas") or {}, doc.get("pve") or {}
    out = {}
    if nmas.get("user"):
        out["NMAS_USER"] = nmas["user"]
        home = nmas.get("home")
        if not home:
            try:
                home = pwd.getpwnam(nmas["user"]).pw_dir
            except KeyError:
                home = ""
        if home:
            out["NMAS_HOME"] = home
    out["NMAS_CHECKOUT"] = nmas.get("checkout") or ROOT
    if pve.get("lan"):
        out["HYPERVISOR_LAN"] = pve["lan"]
    return out


def render(text: str, vals: dict) -> tuple:
    """(rendered text, [placeholders that could not be filled])."""
    missing = sorted({m for m in PLACEHOLDER.findall(text) if m not in vals})
    return PLACEHOLDER.sub(lambda m: vals.get(m.group(1), m.group(0)), text), missing


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="nmas-render-units", description=__doc__.split("\n")[0])
    ap.add_argument("--out", required=True, help="directory for the rendered units")
    ap.add_argument("templates", nargs="+")
    args = ap.parse_args(argv)
    path, doc = _hosts_doc()
    vals = values(doc)
    rendered = {}
    for tpl in args.templates:
        with open(tpl, encoding="utf-8") as fh:
            text, missing = render(fh.read(), vals)
        if missing:
            return _refuse(f"{tpl} uses {', '.join('@' + m + '@' for m in missing)}, which "
                           f"{path} does not establish on this machine")
        rendered[os.path.basename(tpl)] = text
    # A FRESH directory only (the operator, 2026-10-01): a host step installed
    # `/tmp/nmas-units/*.service`, and that shared folder still held units
    # rendered for earlier installs, which it would have reinstalled silently.
    # Render into `d=$(mktemp -d)` and install exactly the files named.
    if not args.out.strip():
        return _refuse("--out is empty: render into a fresh directory, d=$(mktemp -d)",
                       hosts=False)
    if os.path.isdir(args.out) and os.listdir(args.out):
        held = sorted(os.listdir(args.out))
        return _refuse(f"{args.out} already holds {len(held)} file(s) ({', '.join(held[:5])}"
                       f"{', ...' if len(held) > 5 else ''}), so installing from it could install "
                       "a unit rendered for something else: render into a fresh directory, "
                       "d=$(mktemp -d)", hosts=False)
    os.makedirs(args.out, exist_ok=True)
    for name, text in rendered.items():
        with open(os.path.join(args.out, name), "w", encoding="utf-8") as fh:
            fh.write(text)
        print(os.path.join(args.out, name))
    return 0


if __name__ == "__main__":
    sys.exit(main())
