#!/usr/bin/env python3
"""A census of NetBox: what is there, per type, by identity — not just how many.

Stage 4C.0. Built so the Stage 4C probe's **teardown can be measured rather
than eyeballed**. The provenance-based Remove has existed since Phase 0 and
has never been exercised against objects it created itself; the probe is the
first time, and "Remove cleaned up" has to be a number, not an impression.

**IDENTITY, not counts.** Counts can match while the contents differ: Remove
deletes the probe's prefix, something else creates one during the run, the
total returns to baseline, and the probe's object is gone-but-replaced. *"The
same objects"* is the claim. *"The same number"* is a proxy for it, and this
project has spent a week on that difference.

**Tagged counted separately from the total.** The real NetBox already holds
`nmas-managed` objects from the Lab 1 import, and **the population Remove may
touch is the tagged one** — so the tagged before/after is the number that
actually tests the provenance gate. A total that matched while the tagged set
drifted would be a pass hiding a failure.

**The journal is reconciled, not compared** (board H, H6; the operator, 2026-11-04). It grows
with every heal, so `extras/journal-entries/` is read whole and checked against the heal step
log read where the census runs (`modules/heal/steplog.py`): every entry added between the two
snapshots must match a step record on the same NetBox device with the same heal (the entry's
first line, `modules/heal/journal.py`'s `HEAL_LINE`), and every heal step in the window that
wrote the journal must have its entry. Either mismatch is a difference; a step log that cannot
be read, or a baseline taken before the journal was read, is unproven.

Read-only. It performs GETs and nothing else.

    python scripts/nmas-netbox-census                     # print + snapshot
    python scripts/nmas-netbox-census --out before.json
    python scripts/nmas-netbox-census --compare before.json

**Three exit codes, because two cannot say "unproven".** `--compare` exits
**0** when every counted type holds exactly the objects it held, **1** when
something differs, and **2** when there is no usable baseline to compare
against. A missing baseline used to raise `FileNotFoundError` and exit 1 --
*the same code as a teardown that left objects behind* -- so the probe's
central claim going unmeasured was indistinguishable from it failing. Same
distinction as `inconclusive` is to `failed` everywhere else here: a
teardown that cannot be measured has not passed.
"""

import argparse
import datetime
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

#: `--compare`'s answers. The third exists because the first two cannot
#: express "nothing was measured", and a reader who sees a non-zero exit
#: will otherwise assume the teardown failed.
EXIT_PASS, EXIT_DIFFERS, EXIT_UNPROVEN = 0, 1, 2

#: What the modification record could say. Four, not two: `none` and
#: `no-record` both count zero and mean opposite things, and `unknown` is
#: weaker than `none` rather than equal to it. The headline is chosen from
#: these -- never by matching the printed sentence, which is how a check
#: comes to depend on its own prose.
MODS_NONE, MODS_SOME, MODS_UNKNOWN, MODS_NO_RECORD = (
    "none", "some", "unknown", "no-record")

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

#: Every object type the NetBox tab shows, plus the ones the sync creates
#: underneath them. Ordered as a reader would want them.
#:
#: **What this does NOT count is part of the claim**, the same rule as
#: `nmas-check-secret-storage`: an object type absent from this list is not
#: reported as unchanged, it is not reported at all. See `--list-types`.
ENDPOINTS = (
    ("devices",        "dcim/devices/"),
    ("sites",          "dcim/sites/"),
    ("regions",        "dcim/regions/"),
    ("interfaces",     "dcim/interfaces/"),
    ("cables",         "dcim/cables/"),
    ("device-types",   "dcim/device-types/"),
    ("device-roles",   "dcim/device-roles/"),
    ("manufacturers",  "dcim/manufacturers/"),
    ("platforms",      "dcim/platforms/"),
    ("prefixes",       "ipam/prefixes/"),
    ("ip-addresses",   "ipam/ip-addresses/"),
    ("vrfs",           "ipam/vrfs/"),
    ("vlans",          "ipam/vlans/"),
    # C467 (2026-10-05): every other type the tool reads AND may create, so a PASS covers what
    # SERVICE_ACCOUNTS 1.6 relies on it for (the view the `nmas` account was given on each).
    ("ipam-roles",     "ipam/roles/"),
    ("tags",           "extras/tags/"),
    ("custom-fields",  "extras/custom-fields/"),
    ("config-templates", "extras/config-templates/"),
    ("tunnels",        "vpn/tunnels/"),
    ("tunnel-terminations", "vpn/tunnel-terminations/"),
)

#: Types READ to prove the account may read them, never compared: they change with every write
#: and every token, so comparing them would fail any census taken across ordinary work.
READ_ONLY = (
    ("object-changes", "core/object-changes/"),
    ("tokens",         "users/tokens/"),
)

#: Types this census deliberately does not walk, and why. Printed, so the
#: edge of the claim is visible rather than implied.
NOT_COUNTED = {
    "core/object-changes": "the change log grows with every write: READ (proving the view), "
                           "never compared",
    "users/tokens": "the token list changes with every token: READ (proving the view), never "
                    "compared",
    "dcim/roles": "NetBox 3.x's name for device roles; 4.x answers dcim/device-roles, counted",
    "ipam/vlan-groups": "the import only READS a site's VLAN groups, for a subinterface's VLAN "
                        "(C1492), and never writes one",
}

#: The journal: read whole and RECONCILED, never compared as a type (board H, H6; the
#: operator, 2026-11-04, in place of an exclusion). It grows with every heal, so a compare by
#: identity would fail every census taken across one; instead every entry added between the two
#: snapshots must match a heal step record (same NetBox device, same heal), and every heal step
#: in the window that wrote the journal must have its entry (`reconcile_journal`).
JOURNAL = ("journal-entries", "extras/journal-entries/")
#: The assigned object a heal's entry is on (`netbox_client.add_journal_entry`).
JOURNAL_DEVICE = "dcim.device"


class CensusUnreadable(RuntimeError):
    """A type the census must read was refused or failed: the census is UNPROVEN, never a
    difference (exit 2, naming the type), and no snapshot is written."""


def _http_reason(exc) -> str:
    resp = getattr(exc, "response", None)
    if resp is None:
        return type(exc).__name__
    try:
        detail = (resp.json() or {}).get("detail") or ""
    except Exception:                                   # noqa: BLE001
        detail = ""
    return f"HTTP {resp.status_code}" + (f": {detail}" if detail else "")


def _identity(obj: dict) -> str:
    """A stable, readable identity. The id is what makes it unambiguous.

    `display` rather than `name`: an IP address, a prefix and a cable have no
    `name`, and falling back to the id alone would make a diff unreadable at
    exactly the moment somebody needs to read it.
    """
    label = (obj.get("display") or obj.get("name") or obj.get("prefix")
             or obj.get("address") or "")
    return f"{obj.get('id')}:{label}"


def _is_tagged(obj: dict, slug: str) -> bool:
    return any((t or {}).get("slug") == slug for t in (obj.get("tags") or []))


def take(verbose: bool = False) -> dict:
    """The census. Raises if NetBox cannot be reached — a census that could
    not be taken must not be written to a file that looks like one."""
    from modules.netbox_client import _nb_get, _nb_ready
    from modules.netbox_guard import MANAGED_TAG_SLUG

    ok, err, session, base = _nb_ready()
    if not ok:
        raise SystemExit(f"NetBox is not reachable: {err}")

    out = {"tag": MANAGED_TAG_SLUG, "types": {}, "not_counted": NOT_COUNTED, "read_only": {}}
    for name, path in READ_ONLY:
        try:
            r = session.get(f"{base}/api/{path}", params={"limit": 1}, timeout=15)
            r.raise_for_status()
        except Exception as exc:                        # noqa: BLE001
            raise CensusUnreadable(f"{path} could not be read ({_http_reason(exc)})") from exc
        out["read_only"][name] = "read"
    for name, path in ENDPOINTS:
        try:
            objects = _nb_get(session, base, path)
        except Exception as exc:                        # noqa: BLE001
            raise CensusUnreadable(f"{path} could not be read ({_http_reason(exc)})") from exc
        ids = sorted(_identity(o) for o in objects)
        tagged = sorted(_identity(o) for o in objects
                        if _is_tagged(o, MANAGED_TAG_SLUG))
        out["types"][name] = {"total": len(ids), "objects": ids,
                              "tagged": len(tagged), "tagged_objects": tagged}
        if verbose:
            print(f"  {name:15s} {len(ids):5d} total  {len(tagged):5d} tagged")
    try:
        # Every page (`_nb_get` follows `next`), never one: a read of exactly a page is cut.
        entries = _nb_get(session, base, JOURNAL[1])
    except Exception as exc:
        raise CensusUnreadable(f"{JOURNAL[1]} could not be read ({_http_reason(exc)})") from exc
    out["journal"] = journal_snapshot(entries)
    return out


def journal_entry(obj: dict) -> dict:
    """One journal entry as the census keeps it: its id, the object it is on, and the heal its
    comments' first line names (`modules.heal.journal.heal_id`; ``""`` for any other entry).
    Never its text: the snapshot is a file."""
    from modules.heal.journal import heal_id

    return {"id": obj.get("id"), "object_type": obj.get("assigned_object_type") or "",
            "object_id": obj.get("assigned_object_id"), "heal": heal_id(obj.get("comments"))}


def journal_snapshot(objects) -> dict:
    """The journal as a snapshot keeps it: every entry (`journal_entry`), by id."""
    kept = sorted((journal_entry(o) for o in objects or []), key=lambda e: str(e["id"]))
    return {"total": len(kept), "entries": kept}


def read_heal_steps() -> dict:
    """Every heal step record that wrote a journal entry, from every network's step log, read
    where the census runs (the data folder, or the records store once moved: `steplog.read`):
    ``{"state": "ok"|"unreadable", "steps", "networks", "error"}``. A registry or a step log
    that cannot be read is UNREADABLE, naming which, never no steps; an absent log is a
    network with no heals. Each step: its row id, network, device, heal (its decision), time,
    and the entry's id and NetBox device as the write returned them."""
    from modules.heal import steplog
    from modules.nsot import listref

    try:
        networks = listref.names()
    except Exception as exc:
        return {"state": "unreadable", "steps": [], "networks": 0,
                "error": f"the network registry could not be read ({type(exc).__name__}: "
                         f"{exc})"}
    steps = []
    for net in networks:
        got = steplog.read(net)
        if got["state"] == "unreadable":
            return {"state": "unreadable", "steps": [], "networks": len(networks),
                    "error": f"{net}'s heal step log could not be read ({got['error']})"}
        for r in got["rows"]:
            wrote = (r.get("records") or {}).get("journal") or {}
            if r.get("row") == "act" and wrote.get("state") == "written":
                steps.append({"step": r.get("id") or "", "network": net,
                              "device": r.get("device") or "", "heal": r.get("decision") or "",
                              "at": r.get("at") or "", "entry": wrote.get("id"),
                              "device_id": wrote.get("device_id")})
    return {"state": "ok", "steps": steps, "networks": len(networks), "error": ""}


def _entry_key(e: dict) -> tuple:
    on = e.get("object_id") if e.get("object_type") == JOURNAL_DEVICE else None
    return on, e.get("heal") or ""


def _step_key(s: dict) -> tuple:
    return s.get("device_id"), s.get("heal") or ""


def _entry_words(e: dict) -> str:
    on = (f"NetBox device {e.get('object_id')}" if e.get("object_type") == JOURNAL_DEVICE
          else f"{e.get('object_type') or 'no object'} {e.get('object_id')}")
    return f"journal entry {e.get('id')} (on {on}, heal {e.get('heal') or 'none named'})"


def _step_words(s: dict) -> str:
    return (f"heal step {s.get('step')} ({s.get('network')}, {s.get('device')}, heal "
            f"{s.get('heal') or 'none'}, at {s.get('at')}: wrote entry {s.get('entry')} on "
            f"NetBox device {s.get('device_id')})")


def reconcile_journal(before: dict, after: dict, heal: dict, until: str = "") -> tuple:
    """``(findings, unproven, lines)``: the journal reconciled with the heal step log.

    Every entry ADDED (in *after*, its id not in *before*) must match a step record on the same
    NetBox device with the same heal, one entry per step (a step that names its entry's id
    matches only that entry). Every step in the window (at or after the baseline's
    ``taken_at``, at or before *until*, this census's stamp; either bound absent is open) that
    wrote the journal must have its entry in *after*. Each mismatch is a finding naming both
    operands. ``unproven`` is the reason nothing could be said: a baseline with no journal (it
    predates this read), or a step log that could not be read (*heal*'s state)."""
    bj, aj = (before or {}).get("journal"), (after or {}).get("journal")
    if not isinstance(bj, dict):
        return [], ("the baseline holds no journal entries (it was taken before the census "
                    "read them), so which entries were added cannot be said"), []
    if not isinstance(aj, dict):
        return [], "this census holds no journal entries", []
    heal = heal or {}
    if heal.get("state") != "ok":
        return [], f"the heal step log is unreadable: {heal.get('error') or 'no answer'}", []
    since = (before or {}).get("taken_at") or ""
    known = {e.get("id") for e in bj.get("entries") or []}
    held = aj.get("entries") or []
    added = [e for e in held if e.get("id") not in known]
    steps = heal.get("steps") or []
    findings, used = [], set()
    for e in added:
        fits = [s for s in steps if s["step"] not in used and _step_key(s) == _entry_key(e)
                and s.get("entry") in (e.get("id"), None)]
        if fits:
            used.add(sorted(fits, key=lambda s: s.get("entry") != e.get("id"))[0]["step"])
            continue
        named = [s for s in steps if s.get("entry") == e.get("id")]
        if named:
            findings.append(f"journal: {_entry_words(e)} was ADDED, and the step that names it "
                            f"is another device or heal: {_step_words(named[0])}")
        else:
            findings.append(
                f"journal: {_entry_words(e)} was ADDED, and no heal step record matches it: "
                f"none of the {len(steps)} step(s) that wrote the journal, read across "
                f"{heal.get('networks', 0)} network(s), is on that device with that heal")
    window = [s for s in steps if (not since or (s.get("at") or "") >= since)
              and (not until or (s.get("at") or "") <= until)]
    for s in window:
        has = [e for e in held if _entry_key(e) == _step_key(s)
               and (s.get("entry") is None or e.get("id") == s.get("entry"))]
        if not has:
            same = [e for e in held if e.get("id") == s.get("entry")]
            found = (f"entry {s.get('entry')} is {_entry_words(same[0])}" if same else
                     f"entry {s.get('entry')} is not among them")
            findings.append(f"journal: {_step_words(s)}, and this census's {len(held)} journal "
                            f"entr(ies) hold none on that device for that heal ({found})")
    lines = [f"journal entries: {len(held)} held, {len(added)} added since the baseline; "
             f"{len(steps)} heal step(s) wrote the journal across {heal.get('networks', 0)} "
             f"network(s), {len(window)} of them in the window "
             f"({since or 'all time'} to {until or 'now'})"]
    return findings, "", lines


def _print(census: dict) -> None:
    print(f"{'type':16s} {'total':>7s} {'tagged':>7s}")
    print("-" * 33)
    total = tagged = 0
    for name, row in census["types"].items():
        print(f"{name:16s} {row['total']:7d} {row['tagged']:7d}")
        total += row["total"]
        tagged += row["tagged"]
    print("-" * 33)
    print(f"{'ALL':16s} {total:7d} {tagged:7d}")
    print(f"\ntagged with: {census['tag']}")
    if isinstance(census.get("journal"), dict):
        print(f"{JOURNAL[0]}: {census['journal']['total']} read, reconciled with the heal step "
              "log on --compare (never compared as a type)")
    print("\nNOT counted by this census — absence here is not a claim of "
          "'unchanged':")
    for what, why in census.get("not_counted", {}).items():
        print(f"  {what:28s} {why}")


def _baseline_ids(before: dict) -> dict:
    """``{endpoint: {id, ...}}`` for every type the baseline counted."""
    types = (before or {}).get("types") or {}
    out = {}
    for name, path in ENDPOINTS:
        if name in types:
            ids = set()
            for o in types[name].get("objects") or []:
                try:
                    ids.add(int(str(o).split(":", 1)[0]))
                except ValueError:
                    pass
            out[path.strip("/")] = ids
    return out


def _against_baseline(entry: dict, ids: dict) -> str:
    """WHICH object moved, measured against the baseline rather than read by a
    person (the operator, before R2b, 2026-09-28): an object that EXISTED at
    the baseline is somebody's or the fleet's, and one created since is the
    run's own. A type the census does not count cannot be placed."""
    endpoint = str(entry.get("endpoint", "")).strip("/")
    if endpoint not in ids:
        return "uncounted"
    return "existed" if entry.get("id") in ids[endpoint] else "created"


def _modification_report(since: str = "", taking: str = "",
                         before: dict = None) -> list:
    """``(status, lines)`` stating what NMAS has MODIFIED.

    The census compares objects by identity, and an update changes neither the
    id nor the display -- measured: an address moved between interfaces reads
    `41:10.0.0.15/24` on both sides and `compare()` returns nothing. So a
    census PASS has never meant *"nothing changed"*; it has meant *"no object
    was created or destroyed"*, and the difference is exactly the class that
    caused the 2026-09-24 incident. This says which claim is being made.
    """
    from modules.netbox_guard import modified_since

    got = modified_since(since=since)
    if not got["ok"]:
        return MODS_UNKNOWN, [
            "modifications: UNKNOWN — the record could not be read: "
            + got["reason"],
            "  So this census cannot say whether NMAS changed anything "
            "in place. That is weaker than 'none', not equal to it."]

    if not got["exists"]:
        return MODS_NO_RECORD, [
            "modifications: NO RECORD EXISTS — nothing has ever been "
            "written to data/netbox_modified.json.",
            "  On an install that has run an import, that means the "
            "recorder is not reaching the file, so read this as "
            "'unknown', not as 'none'."]

    # WHY it is all time, named correctly (the operator, R1, 2026-09-28): a
    # run that TAKES a baseline has no baseline to scope by, and saying "the
    # baseline carries no taken_at" there sent the reader to fix a snapshot
    # that carried one.
    if got["scope"] == "since":
        scope = "since this baseline"
    elif taking:
        scope = (f"all time: this run is TAKING the baseline, and a --compare "
                 f"against it counts only what NMAS modified from {taking} on")
    else:
        scope = ("all time — the baseline carries no taken_at, so this "
                 "could not be scoped to the run")
    lines = [f"modifications: {got['count']} object(s) modified by NMAS "
             f"({scope}), out of {got['total_recorded']} recorded in total"]
    if got["unknown_before"]:
        lines.append(f"  {got['unknown_before']} of them could not be read "
                     "before the write, so WHAT changed is unknown")
    entries = got["entries"]
    if before is not None:
        ids = _baseline_ids(before)
        kinds = {}
        for e_ in entries:
            e_["_vs"] = _against_baseline(e_, ids)
            kinds[e_["_vs"]] = kinds.get(e_["_vs"], 0) + 1
        lines.append(
            f"  against the baseline: {kinds.get('existed', 0)} on objects that "
            f"EXISTED at it (read each: somebody's or the fleet's object moved), "
            f"{kinds.get('created', 0)} on objects created since (the run's "
            f"own), {kinds.get('uncounted', 0)} on types this census does not "
            f"count (cannot be placed)")
        # Every pre-existing one is listed, never cut by the limit below: it
        # is the line the check exists for.
        entries = (sorted([e_ for e_ in entries if e_["_vs"] == "existed"],
                          key=lambda e_: e_.get("at") or "")
                   + [e_ for e_ in entries if e_["_vs"] != "existed"])
    shown = max(12, sum(1 for e_ in entries if e_.get("_vs") == "existed"))
    for e in entries[:shown]:
        fields = e.get("fields") or {}
        if e.get("before_unknown"):
            detail = "before-state unreadable"
        else:
            detail = ", ".join(
                f"{k}: {v['before']} → {v['after']}" for k, v in fields.items())
        mark = {"existed": "EXISTED  ", "created": "created  ",
                "uncounted": "uncounted "}.get(e.get("_vs"), "")
        lines.append(f"  {mark}{e['at']}  {e['endpoint']}/{e['id']} "
                     f"{e.get('name') or ''}  [{e.get('actor')}]  {detail}")
    if got["count"] > shown:
        lines.append(f"  … and {got['count'] - shown} more")
    return (MODS_SOME if got["count"] else MODS_NONE), lines


def read_baseline(path: str):
    """``(census, None)`` or ``(None, reason)`` -- never a traceback.

    Every way this can fail is a **named** reason, because the caller turns
    it into an exit code that means *unproven* rather than *failed*, and a
    reason of "it did not work" would leave the reader deciding which.
    """
    if not os.path.exists(path):
        return None, (f"no baseline at {path} — step 2 was skipped, so this "
                      "teardown cannot be measured")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except json.JSONDecodeError as err:
        return None, f"the baseline at {path} is not readable JSON: {err}"
    except OSError as err:
        return None, f"the baseline at {path} could not be read: {err}"
    if not isinstance(data, dict) or not isinstance(data.get("types"), dict):
        return None, (f"{path} is not a census — it has no 'types', so it is "
                      "some other JSON file with the right name")
    if not data["types"]:
        return None, (f"the baseline at {path} counted nothing, so every "
                      "comparison against it passes vacuously")
    return data, None


def compare(before: dict, after: dict) -> list:
    """Differences, per type, by identity **and** by tagged membership."""
    findings = []
    types = sorted(set(before["types"]) | set(after["types"]))

    for name in types:
        b = before["types"].get(name)
        a = after["types"].get(name)
        if b is None or a is None:
            findings.append(f"{name}: present in only one census — the two "
                            "were taken by different versions of this script")
            continue

        for label, key in (("", "objects"), ("nmas-managed ", "tagged_objects")):
            gone = sorted(set(b[key]) - set(a[key]))
            new = sorted(set(a[key]) - set(b[key]))
            if gone:
                findings.append(f"{name}: {len(gone)} {label}object(s) REMOVED "
                                "that were there before: " + ", ".join(gone[:6])
                                + ("…" if len(gone) > 6 else ""))
            if new:
                findings.append(f"{name}: {len(new)} {label}object(s) LEFT "
                                "BEHIND: " + ", ".join(new[:6])
                                + ("…" if len(new) > 6 else ""))

        # Stated separately, because it is the shape this exists to catch: a
        # total that matches while the contents differ.
        if b["total"] == a["total"] and set(b["objects"]) != set(a["objects"]):
            findings.append(
                f"{name}: the COUNT matches ({a['total']}) and the objects do "
                "not — something was created while something else was removed")
    return findings


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", help="write the snapshot here (JSON)")
    ap.add_argument("--compare", metavar="SNAPSHOT",
                    help="take a census now and diff it against SNAPSHOT")
    ap.add_argument("--list-types", action="store_true",
                    help="print what is and is not counted, and exit")
    args = ap.parse_args()

    if args.list_types:
        print("counted:")
        for name, path in ENDPOINTS:
            print(f"  {name:16s} {path}")
        print("\nread (the account must be able to), never compared:")
        for name, path in READ_ONLY:
            print(f"  {name:16s} {path}")
        print("\nreconciled with the heal step log, never compared:")
        print(f"  {JOURNAL[0]:16s} {JOURNAL[1]}")
        print("\nNOT counted:")
        for what, why in NOT_COUNTED.items():
            print(f"  {what:28s} {why}")
        return 0

    if args.compare:
        # BEFORE the census, not after. The old order spent a full pass over
        # live NetBox and then raised on the open() -- and the traceback
        # exited 1, which is "the teardown left something behind".
        before, refusal = read_baseline(args.compare)
        if refusal:
            print(f"UNPROVEN - {refusal}")
            print()
            print("This is NOT a pass, and it is not a failure either: "
                  "nothing was measured.")
            print("The teardown is what this probe exists to prove, and the "
                  "baseline is the only thing it can be proved against. "
                  "A baseline taken now would contain the probe's own "
                  "objects, so it cannot be recovered after the fact -- "
                  "record the run as unmeasured rather than taking one.")
            return EXIT_UNPROVEN

    # Stamped BEFORE the read, never after: a modification made while the
    # census is being read must fall INSIDE a later --compare's window. A
    # stamp taken after the read could leave it out, which is the direction
    # that misses; stamping first can only over-report.
    started = datetime.datetime.now(
        datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        census = take()
    except CensusUnreadable as exc:
        # C467: a refused read used to raise, and the traceback exited 1, which reads as "a
        # type differs". It is UNPROVEN: nothing was measured for that type.
        print(f"UNPROVEN - {exc}")
        print("A type the census reads was refused or failed, so no claim is made and no "
              "snapshot is written. A refusal usually means the token lacks view on it "
              "(docs/SERVICE_ACCOUNTS.md 1.3).")
        return EXIT_UNPROVEN

    if args.compare:
        findings = compare(before, census)
        # The step log AFTER NetBox's read: a step recorded by then wrote its entry before it.
        j_findings, j_unproven, j_lines = reconcile_journal(
            before, census, read_heal_steps(), until=started)
        findings += j_findings
        _print(census)
        print()
        print(f"baseline taken: {before.get('taken_at') or 'unrecorded'}")
        mod_status, mod_lines = _modification_report(
            since=before.get("taken_at") or "", before=before)
        for line in mod_lines + j_lines:
            print(line)
        print()

        if not findings and j_unproven:
            print(f"UNPROVEN - the journal cannot be reconciled: {j_unproven}")
            print("Every counted type holds the objects it held, and that is NOT a pass: an "
                  "entry added with no heal behind it, or a heal with no entry, cannot be "
                  "ruled out.")
            return EXIT_UNPROVEN
        if not findings:
            # WHICH CLAIM. "PASS" used to be read as "nothing changed" and has
            # only ever meant "nothing was created or destroyed" -- so it is
            # stated, and qualified in the headline when modifications exist,
            # because a reader skimming for the word PASS will not read the
            # paragraph under it.
            head = {
                MODS_SOME:      "PASS (with modifications — read them above)",
                MODS_UNKNOWN:   "PASS (modifications UNKNOWN — read above)",
                MODS_NO_RECORD: "PASS (modifications UNKNOWN — read above)",
                MODS_NONE:      "PASS",
            }[mod_status]
            print(f"{head} — every counted type holds exactly the objects it "
                  f"held in {os.path.basename(args.compare)}.")
            print("Identity, not counts: the same objects, not the same number.")
            print("THE CLAIM THIS MAKES: no object was created or destroyed. "
                  "It does NOT say nothing changed — an in-place update "
                  "changes neither an object's id nor its display, so this "
                  "comparison cannot see one. That is what the "
                  "modifications line above is for.")
            return EXIT_PASS
        print(f"{len(findings)} difference(s):")
        for f in findings:
            print(f"  {f}")
        return EXIT_DIFFERS

    _print(census)
    print()
    for line in _modification_report(taking=started if args.out else "")[1]:
        print(line)
    if args.out:
        from modules.config import open_secure

        # WHEN it was taken travels with it. A baseline taken after the
        # probe began writing contains the probe's own objects and would
        # report a teardown clean while leaving them behind -- worse than
        # having none, and unreadable from the file without this.
        census["taken_at"] = started
        with open_secure(args.out, "w", encoding="utf-8") as fh:
            json.dump(census, fh, indent=2)
        print(f"\nsnapshot written to {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
