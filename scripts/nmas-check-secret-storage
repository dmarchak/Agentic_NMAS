#!/usr/bin/env python3
"""Where is each secret stored, and is it encrypted at rest? Names, never values.

Stage 3.2 asked a simple question before migrating two keys into the settings
schema: **how are they stored now?** The schema is where encryption at rest is
declared, and a key that never reaches the schema never reaches
`secrets_store`.

The answer turned out to be that the question was wrong. `anthropic_api_key`
and the Jenkins credentials are not in `user_settings.json` at all --
`/settings` routes them to two other stores -- so "they bypass the schema" is
true in a stronger sense than intended.

This script reports, for every secret-bearing key the program knows about:

* which file holds it,
* whether a value is present,
* whether that value is **encrypted** (`enc:v1:`) or **plaintext**,
* the file's permission bits.

**It never prints a value.** Presence, length class, prefix and mode are
enough to answer "is this plaintext on disk", and a diagnostic that copies
the secret it is auditing has become a second place the secret lives -- the
rule already written for `data/reveal_audit.jsonl`.

Run it on the host, where the files are::

    python scripts/nmas-check-secret-storage

Exit code is 1 if any secret is present and unencrypted, so it can gate.
"""

import json
import os
import stat
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)


#: Owner-only. Anything looser on a file holding a credential -- or on the key
#: the others are encrypted with -- is a finding.
REQUIRED_FILE_MODE = 0o600
REQUIRED_DIR_MODE = 0o700


def _mode_bits(path: str):
    try:
        return stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        return None


def _mode_verdict(path: str, required: int):
    """``(text, ok)``. Group or other access on a secret file is a failure."""
    bits = _mode_bits(path)
    if bits is None:
        return "—", True
    if bits & 0o077:
        who = []
        if bits & 0o070:
            who.append("group")
        if bits & 0o007:
            who.append("other")
        return f"{bits:04o}  ⚠ {' and '.join(who)} readable", False
    if bits != required:
        return f"{bits:04o}  (expected {required:04o})", True
    return f"{bits:04o}", True


def _classify(value) -> str:
    """What KIND of thing is stored. Never the thing itself."""
    from modules.secrets_store import is_encrypted

    if not isinstance(value, str) or not value:
        return "unset"
    if is_encrypted(value):
        return "encrypted"
    return f"PLAINTEXT ({len(value)} chars)"


def _read_json(path: str) -> dict:
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def _read_env(path: str) -> dict:
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def _holds_a_secret(path: str):
    """``(True/False, reason)`` -- or ``(None, reason)`` when it cannot tell.

    Positional redaction, not a value search: it masks whatever occupies a
    secret's syntactic slot regardless of length and regardless of whether
    the credential store has ever seen it. So this catches a credential from
    a device NMAS was never told about, which is the case a value-based scan
    misses entirely.

    Never prints what it found. The finding is *that* there is one.
    """
    try:
        from modules.redact import redact_positional

        with open(path, encoding="utf-8") as fh:
            raw = fh.read()
        return redact_positional(raw) != raw, ""
    except Exception as exc:
        return None, str(exc)


# ---------------------------------------------------------------------------
# NETBOX'S CONFIG CONTEXT (register C95 (d)): a store outside data/
# ---------------------------------------------------------------------------
#
# The import writes each device's running config and SNMP communities into
# NetBox's `local_context_data`, readable by every NetBox user and token and
# by the off-site NetBox backups. Its masking was a SECOND redactor that had
# never matched anything on this fleet (C95), true in the code and false in
# effect. So this reads what NetBox HOLDS, not what the import intends, and
# with a check that does not share a source with the redactor: a value in a
# credential slot is read with its own pattern (the forms measured on the
# fleet), and `redact_positional` is asked as well. Either finding one is a
# finding. Counts and the slot's KIND only, never a value.

import re as _re

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

#: A credential slot and the value in it, independent of `redact.py`.
_SLOT = _re.compile(r"^\s*(username \S+ (?:privilege \d+ )?(?:secret|password)(?: \d)?|"
                    r"snmp-server community|"
                    # The trap destination's community: found by this check's
                    # own second opinion (the positional redactor) on
                    # 2026-09-28; the first version of this pattern missed it.
                    r"snmp-server host \S+(?: (?:informs|traps))?(?: version \S+)?|"
                    r"enable (?:secret|password)(?: \d)?|"
                    r"key-string(?: \d)?)\s+(\S+)", _re.M)


def _positional_finds_one(text: str) -> bool:
    """The positional redactor's second opinion, asked only of lines that
    hold no mask. It is not idempotent over text it already masked: with the
    slot's value a mask it falls back to the next token, masking the hash
    type in `secret 9 <redacted>` or the keyword `version` in
    `snmp-server host <addr> version 2c <redacted>` (measured 2026-09-28,
    harmless, and on raw fleet lines it masks the right token). A masked
    line is judged by `_SLOT`; an unmasked line it would change is a find."""
    from modules.redact import redact_positional

    return any(redact_positional(line) != line for line in text.splitlines()
               if "<redacted" not in line and "REMOVED" not in line)


def _is_mask(value: str) -> bool:
    return value.startswith("<redacted") or "REMOVED" in value


def _slot_kind(line_head: str) -> str:
    head = _re.sub(r"^username \S+", "username <name>", line_head.strip())
    return _re.sub(r"^snmp-server host \S+", "snmp-server host <address>", head)


def scan_netbox_context(devices: list) -> dict:
    """*devices*: NetBox device objects. ``{"read": n, "findings": [...]}``,
    one finding per device that holds an unmasked credential, naming the
    KINDS of slot, never a value."""
    out = {"read": 0, "findings": []}
    for d in devices:
        out["read"] += 1
        lcd = d.get("local_context_data") or {}
        rc = lcd.get("running_config") or ""
        kinds = sorted({_slot_kind(m.group(1)) for m in _SLOT.finditer(rc)
                        if not _is_mask(m.group(2))})
        positional = bool(rc) and _positional_finds_one(rc)
        comm = [c for c in ((lcd.get("snmp") or {}).get("communities") or [])
                if isinstance(c, dict) and c.get("community") and not _is_mask(c["community"])]
        if kinds or positional or comm:
            out["findings"].append({"device": d.get("name") or d.get("id"), "slots": kinds,
                                    "positional": positional, "communities": len(comm)})
    return out


def database_receipts_section(read=None, networks=None) -> list:
    """C635: once the receipts move to the records database, a receipt is written THERE and
    the files keep what they held at the move, so scanning the files alone checks nothing
    written since. Each network's lines are read through the one reader
    (`records_migrate.table_lines`, *read*) and asked the same positional question as the
    files. Findings are named by network, never by value."""
    import json as _json

    from modules.nsot import receipts
    from modules.redact import redact_positional

    print("\nReceipts in the records database")
    try:
        on = receipts.on_database()
    except Exception as exc:                           # noqa: BLE001
        print(f"  UNPROVEN — where the receipts are could not be read: {exc}")
        return [f"the receipts' store could not be named: {exc}"]
    if not on:
        print("  not in use: the receipts are the files above")
        return []
    if read is None:
        from modules.records_migrate import table_lines as read
    if networks is None:
        from modules.device import get_device_lists
        networks = [entry["name"] for entry in get_device_lists()]
    failures = []
    for name in networks:
        try:
            lines = read(name)
        except Exception as exc:                       # noqa: BLE001
            print(f"  {name}: UNPROVEN — {exc}")
            failures.append(f"{name}'s receipts in the database could not be scanned: {exc}")
            continue
        raw = "\n".join(_json.dumps(line, sort_keys=True) for line in lines)
        if redact_positional(raw) != raw:
            print(f"  {name}: SECRET-SHAPED CONTENT FOUND in {len(lines)} line(s) — a receipt "
                  "row was written unmasked: a defect in modules/nsot/receipts.py")
            failures.append(f"{name}'s receipts in the database hold something in a secret "
                            "position")
        else:
            print(f"  {name}: {len(lines)} line(s), no secret-shaped content")
    return failures


def netbox_section() -> list:
    """Print NetBox's config-context verdict; return findings for `failures`."""
    print("\nNetBox config context (local_context_data), what NetBox HOLDS")
    try:
        from modules.netbox_client import _nb_ready

        ok, err, session, base = _nb_ready()
        if not ok:
            print(f"  UNPROVEN: NetBox is not reachable: {err}")
            return [f"NetBox config context could not be read: {err}"]
        devices, url, params = [], f"{base}/api/dcim/devices/", {"limit": 200}
        while url:
            r = session.get(url, params=params, timeout=30)
            if not r.ok:
                print(f"  UNPROVEN: NetBox answered HTTP {r.status_code}")
                return [f"NetBox config context could not be read: HTTP {r.status_code}"]
            body = r.json()
            devices += body.get("results") or []
            url, params = body.get("next"), None
    except Exception as exc:                  # noqa: BLE001
        print(f"  UNPROVEN: {exc}")
        return [f"NetBox config context could not be read: {exc}"]
    result = scan_netbox_context(devices)
    if not result["read"]:
        print("  UNPROVEN: NetBox returned no devices, so nothing was checked")
        return ["NetBox config context: no devices read, which is not clean"]
    for f in result["findings"]:
        print(f"  {f['device']}: unmasked in running_config: {', '.join(f['slots']) or '-'}"
              f"{' (the positional redactor also finds one)' if f['positional'] else ''}; "
              f"structured communities with a value: {f['communities']}")
    print(f"  {result['read']} device(s) read; {len(result['findings'])} hold an unmasked credential")
    return [f"NetBox holds an unmasked credential for {f['device']}" for f in result["findings"]]


# ---------------------------------------------------------------------------
# EVERY FILE UNDER data/, classified -- so a NEW store is noticed, not missed
# ---------------------------------------------------------------------------
#
# The store list below was the whole claim, and "a secret in a store this
# script does not know about is not reported at all" kept coming true:
# netbox_modified.json, netbox_created_ids.json, then (measured 2026-09-25)
# credential_profiles.json -- the MAIN credential store, 0664 -- and
# secret.key, Flask's session key, 0664. This run printed "every file holding
# a secret is owner-only" over both.
#
# So every file under data/ must match a declared class, and a file that
# matches none is UNCLASSIFIED and fails the run: a store is noticed the first
# time this runs after it is created, instead of the day somebody looks.
# First match wins; `*` crosses directories (fnmatch).
#
#   secret     -- holds a credential or key: MUST be 0600
#   no-secret  -- must contain no credential at all: scanned (below)
#   config     -- device configuration, which carries secrets by nature
#                 (goldens, backups, caches, AI transcripts). Protected by
#                 data/ being 0700; reported, not failed on mode
#   plain      -- nothing secret by nature
DATA_CLASSES = (
    ("key.key", "secret"), ("secret.key", "secret"),
    ("user_settings.json", "secret"), ("user_settings.json.*", "secret"),
    ("jenkins_checks.json", "secret"),
    ("credential_profiles.json", "secret"), ("credential_profiles.json.*", "secret"),
    ("lists/*/devices.csv", "secret"), ("lists/*/devices.csv.*", "secret"),
    # Both SNMP communities, plaintext (register C55). Unclassified until
    # 2026-09-27: absent on an install that never saved the Monitoring tab,
    # so the one run that could have named it may never have seen it.
    ("lists/*/collector_config.json", "secret"), ("lists/*/collector_config.json.*", "secret"),
    # Found 2026-09-27 by deriving the population from the CODE's writers
    # rather than from the files this host happens to hold (the operator's
    # question after C55: "the checker would have said" is how
    # collector_config.json was missed). Each holds what its class says:
    # received traps carry their community; the legacy top-level CSV holds
    # device credentials like any list's.
    ("snmp_traps.json", "secret"), ("lists/*/snmp_traps.json", "secret"),
    ("Devices.csv", "secret"),
    ("lists/*/drift_cache.json", "config"), ("global_kb.json", "config"),
    # Templates › Coverage's kept answer: golden lines, masked before they are written.
    ("lists/*/template_coverage.json", "config"),
    # P.11's expected islands: device, reason, who, when (modules/topology_expected.py).
    ("lists/*/topology_expected.json", "no-secret"),
    ("lists/*/topology_expected_log.jsonl", "no-secret"),
    # Credentials › Profiles' change record: who, which profile, the fields set; no value.
    ("credential_changes.jsonl", "no-secret"),
    ("startup_check.json", "no-secret"),
    ("netflow_flows.json", "plain"), ("lists/*/netflow_flows.json", "plain"),
    ("pending_restart.json", "plain"), ("trap_analysis_state.json", "plain"),
    ("netbox_modified.json", "no-secret"), ("netbox_created_ids.json", "no-secret"),
    # What each NetBox Remove deleted, skipped and was refused (C121): object
    # names and ids, and NetBox's refusal text. Scanned below: a refusal's
    # reason is text from outside, and "no secret" is checked, not assumed.
    ("netbox_removals.jsonl", "no-secret"),
    # What an adoption found in NetBox and recorded as ADOPTED (7.3): object
    # names and ids, who, when, why. Scanned below like the created record.
    ("netbox_adopted.json", "no-secret"),
    # The Prometheus targets keeper's last run (C232): a time, a reason, a
    # directory, file names, a count and an exception's text. No credential
    # is read to generate the targets.
    ("prometheus_targets_sync.json", "no-secret"),
    # A device's role edits (C225): device, role before and after, who and the
    # stated reason. Scanned below: a reason is a person's text.
    ("lists/*/inventory_edits.jsonl", "no-secret"),
    # When each monitoring gap was first seen (C236): list, device and
    # integration names and a time.
    ("monitoring_coverage.json", "no-secret"),
    ("reveal_audit.jsonl", "no-secret"), ("terminal_audit.jsonl", "no-secret"),
    ("rotation_audit.jsonl", "no-secret"), ("deploy_audit.jsonl", "no-secret"),
    # The Update button: who requested which commit, and the request files
    # the root-owned updater takes and removes (modules/update_op.py).
    ("update_requests.jsonl", "no-secret"), ("update/*", "no-secret"),
    # Host steps a person said done: step text, who, when (modules/host_steps.py).
    ("host_steps_done.jsonl", "no-secret"),
    # Heartbeat re-measures written from the app (NSOT_PLAN P.7): who, when,
    # the fingerprint and each device's window, numbers only
    # (modules/heartbeat_windows.py).
    ("heartbeat_rules.jsonl", "no-secret"),
    # Device restarts and the planned windows (modules/restarts.py): device, times, the
    # device's own reload reason, who planned it and why. A person's acknowledgement of
    # an event row (modules/acknowledgements.py): row, event, who, why, masked on the way in.
    ("restarts.jsonl", "no-secret"), ("planned_restarts.jsonl", "no-secret"),
    ("acknowledgements.jsonl", "no-secret"),
    # Deploy receipts (C60): the program each deploy SENT, masked on the way
    # in. Scanned below like the modification record, because "masked on the
    # way in" is a claim about the writer and this is how it is checked.
    ("lists/*/deploy_receipts.jsonl", "no-secret"),
    # Onboarding's Verify and Abandon runs (7.1): steps, reasons and the
    # verify diagnosis, masked on the way in. Scanned below with the receipts,
    # because a reason is text from a device or a service.
    ("lists/*/onboarding_runs.jsonl", "no-secret"),
    ("lists/*/config_repo/*", "config"), ("lists/*/backups/*", "config"),
    ("lists/*/golden_configs/*", "config"), ("lists/*/pre_change/*", "config"),
    ("lists/*/playbooks/*", "config"), ("lists/*/change_log.json", "config"),
    ("lists/*/approval_queue.json", "config"), ("lists/*/network_kb.json", "config"),
    ("lists/*/variables.json", "config"),
    ("config_cache/*", "config"), ("chat_histories/*", "config"),
    ("checkpoints/*", "config"), ("pipeline_audit/*", "config"),
    ("ai_debug.log", "config"),
    ("lists/*/topology_*.json", "plain"), ("lists/*/proto_topology_*.json", "plain"),
    ("lists/*/remote.json", "plain"), ("lists/*/pipeline_commits.json", "plain"),
    ("lists/*/compliance_policy.json", "plain"), ("lists/*/drift_state.json", "plain"),
    ("lists/*/source.json", "plain"), ("lists/*/netbox_inventory_cache.json", "plain"),
    ("provider_config.json", "plain"), ("quick_actions.json", "plain"),
    ("device_lists.json", "plain"), ("drift_state.json", "plain"),
    ("netbox_sync_status.json", "plain"), ("agent_activity.json", "plain"),
    ("agent_timers.json", "plain"), ("ai_usage_log.jsonl", "plain"),
)

#: Stores OUTSIDE data/: they cannot be discovered, only declared. Each is
#: checked when present and named when absent.
EXTERNAL_SECRETS = (
    ("rclone.conf (B2 key)", "~/.config/rclone/rclone.conf"),
    ("NetBox env", "~/netbox-docker/env/netbox.env"),
    ("NetBox postgres env", "~/netbox-docker/env/postgres.env"),
    ("backup push key", "~/.ssh/nmas_netbox_backup"),
)


def classify_data_tree(data_dir: str) -> dict:
    """``{"counts", "unclassified", "loose"}`` for every file under data/."""
    import fnmatch

    counts, unclassified, loose = {}, [], []
    for base, _dirs, files in os.walk(data_dir):
        for name in files:
            path = os.path.join(base, name)
            rel = os.path.relpath(path, data_dir).replace(os.sep, "/")
            kind = next((k for pat, k in DATA_CLASSES
                         if fnmatch.fnmatch(rel, pat)), None)
            if kind is None:
                unclassified.append(rel)
                continue
            counts[kind] = counts.get(kind, 0) + 1
            if kind == "secret":
                bits = _mode_bits(path)
                if bits is not None and bits & 0o077:
                    loose.append((rel, oct(bits)))
    return {"counts": counts, "unclassified": sorted(unclassified),
            "loose": sorted(loose)}


def main() -> int:
    if "--netbox" in sys.argv[1:]:
        # Just NetBox's config context: the before/after check around C95 (b).
        findings = netbox_section()
        if findings:
            print(f"{len(findings)} finding(s). Counts and slot kinds only, never values.")
            return 1
        print("Pass: NetBox holds no unmasked credential in any device's config context.")
        return 0
    from modules.config import DATA_DIR, KEY_FILE
    from modules.secrets_store import SECRET_KEYS

    settings_path = os.path.join(DATA_DIR, "user_settings.json")
    jenkins_path  = os.path.join(DATA_DIR, "jenkins_checks.json")
    env_path      = os.path.join(ROOT, ".env")

    failures = []

    # ── The key everything else depends on ────────────────────────────────
    # First, and on its own. The encryption in the files below is worth
    # exactly what this file's mode is worth: a group-readable key.key means
    # the "encrypted" values beside it were never meaningfully protected.
    print("Fernet key")
    for path, required, label in ((DATA_DIR, REQUIRED_DIR_MODE, "data/"),
                                  (KEY_FILE, REQUIRED_FILE_MODE, "key.key")):
        exists = os.path.exists(path)
        text, ok = _mode_verdict(path, required)
        print(f"  {label:14s} {'present' if exists else 'ABSENT':8s} mode {text}")
        if exists and not ok:
            failures.append(f"{label} is {text.split()[0]}; everything encrypted "
                            "with this key is only as protected as this mode")

    # ── Stores ────────────────────────────────────────────────────────────
    stores = [
        ("user_settings.json", settings_path, _read_json(settings_path),
         list(SECRET_KEYS), "encrypted"),
        # A RETIRED store (P.4 removed Jenkins). Still checked while it
        # exists, because it may hold credentials; its presence is a finding
        # of its own, below.
        ("jenkins_checks.json", jenkins_path, _read_json(jenkins_path),
         ["jenkins_api_key", "jenkins_token"], "encrypted"),
        # PLAINTEXT BY DESIGN. See docs/SECRETS.md: an env-style secret is a
        # normal pattern, and moving it into the encrypted store would have
        # the app decrypting its own API key at startup for no gain -- the
        # key and the ciphertext would sit in the same directory, readable by
        # the same user, so nothing is protected that the file mode was not
        # already protecting. Its mode is therefore the whole control, and is
        # checked rather than assumed.
        (".env", env_path, _read_env(env_path),
         ["ANTHROPIC_API_KEY"], "plaintext-by-design"),
    ]

    for label, path, data, keys, policy in stores:
        exists = os.path.exists(path)
        text, ok = _mode_verdict(path, REQUIRED_FILE_MODE)
        print(f"\n{label}  —  {path}")
        print(f"  exists: {exists}" + (f"   mode {text}" if exists else ""))
        if not exists:
            continue
        if not ok:
            failures.append(f"{label} is {text.split()[0]}")
        for key in keys:
            verdict = _classify(data.get(key))
            if policy == "plaintext-by-design":
                shown = ("plaintext by design, mode ok" if verdict.startswith("PLAINTEXT")
                         and ok else verdict)
                print(f"    {key:28s} {shown}")
                # NOT a finding on its own -- only the mode is.
                continue
            print(f"    {key:28s} {verdict}")
            if verdict.startswith("PLAINTEXT"):
                failures.append(f"{key} is plaintext in {label}")

    # ── Retired stores ──────────────────────────────────────────────────────
    # Nothing reads these any more, so a credential in one has no owner: it
    # cannot be rotated through the tool and nothing would notice it leak.
    if os.path.exists(jenkins_path):
        failures.append(
            "jenkins_checks.json is a RETIRED store: Jenkins was removed in P.4 "
            "and nothing reads it. Delete it (and revoke its credentials at the "
            "Jenkins server, if they were ever real)")

    # ── Records that must hold NO secret at all ───────────────────────────
    #
    # A DIFFERENT SHAPE OF CHECK, and it needs one. The stores above are
    # named keys whose values are classified encrypted or plaintext. These
    # are arbitrary blobs whose whole policy is "nothing in here should ever
    # look like a credential" -- so the check is a scan, using the same
    # positional redactor the log filter uses, and the finding is that
    # redacting the file CHANGES it.
    #
    # `netbox_modified.json` is here because the fix for a provenance gap
    # created a new place a credential lived: the first recorder capped
    # strings and not structures, so a sync wrote two whole running configs
    # per device, one carrying `secret 9 $9$…` and a `username … password 0`
    # line. That is exactly this file's own warning -- a secret in a store
    # this script does not know about is not reported at all -- arriving in
    # a store created after the warning was written.
    import glob as _glob

    blobs = [("netbox_modified.json", os.path.join(DATA_DIR, "netbox_modified.json")),
             ("netbox_created_ids.json", os.path.join(DATA_DIR, "netbox_created_ids.json")),
             ("netbox_removals.jsonl", os.path.join(DATA_DIR, "netbox_removals.jsonl")),
             ("netbox_adopted.json", os.path.join(DATA_DIR, "netbox_adopted.json"))]
    blobs += [(os.path.relpath(p, DATA_DIR), p) for p in sorted(
        _glob.glob(os.path.join(DATA_DIR, "lists", "*", "deploy_receipts.jsonl")))]
    blobs += [(os.path.relpath(p, DATA_DIR), p) for p in sorted(
        _glob.glob(os.path.join(DATA_DIR, "lists", "*", "onboarding_runs.jsonl")))]
    for label, path in blobs:
        exists = os.path.exists(path)
        text, ok = _mode_verdict(path, REQUIRED_FILE_MODE)
        print(f"\n{label}  —  {path}")
        print(f"  exists: {exists}" + (f"   mode {text}" if exists else ""))
        if not exists:
            print("    policy: must contain no secret at all (absent, so it "
                  "does not — which is not the same as having been checked)")
            continue
        if not ok:
            failures.append(f"{label} is {text.split()[0]}")
        leaking, why = _holds_a_secret(path)
        if leaking is None:
            print(f"    UNPROVEN — {why}")
            failures.append(f"{label} could not be scanned for secrets: {why}")
        elif leaking:
            remedy = ("run scripts/nmas-netbox-modified --sanitise"
                      if label.startswith("netbox_") else
                      "a receipt row was written unmasked: a defect in "
                      "modules/nsot/receipts.py; the rows are append-only, so "
                      "rewrite them through redact_text before anything else")
            print(f"    SECRET-SHAPED CONTENT FOUND — {remedy}")
            failures.append(f"{label} holds something in a secret position")
        else:
            print("    no secret-shaped content")
    failures += database_receipts_section()

    print("\n" + "=" * 68)
    # ── Every file under data/ ────────────────────────────────────────────
    tree = classify_data_tree(DATA_DIR)
    print("\nEvery file under data/, classified")
    print("  " + ", ".join(f"{k}: {n}" for k, n in sorted(tree["counts"].items())))
    for rel, bits in tree["loose"]:
        print(f"  LOOSE  {rel}  mode {bits} (a secret store must be 0600)")
        failures.append(f"{rel} is {bits}")
    for rel in tree["unclassified"]:
        print(f"  UNCLASSIFIED  {rel}  -- declare it in DATA_CLASSES")
        failures.append(f"{rel} is in no declared class")

    failures += netbox_section()

    print("\nDeclared stores outside data/")
    for label, path in EXTERNAL_SECRETS:
        full = os.path.expanduser(path)
        if not os.path.exists(full):
            print(f"  {label:26s} absent ({path})")
            continue
        text, ok = _mode_verdict(full, REQUIRED_FILE_MODE)
        print(f"  {label:26s} mode {text}")
        if not ok:
            failures.append(f"{label} ({path}) is {text.split()[0]}")

    if failures:
        print(f"{len(failures)} finding(s):")
        for f in failures:
            print(f"    {f}")
        print("\nNames and modes only, never values.")
        return 1

    print("Pass: no plaintext where encryption is expected, and every file")
    print("holding a secret is owner-only.")
    print("\nInside data/ every file is classified, so a new store fails this")
    print("run until it is declared. OUTSIDE data/ the list above is the whole")
    print("claim: a store there that is not declared is not reported at all.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
