#!/usr/bin/env python3
"""Read this repository's CI runs, and a failing run's log, with the
operator's fine-grained Actions-read token (the operator, 2026-10-01).

    nmas-ci-log runs [--limit N]          the latest runs and their verdicts
    nmas-ci-log failed [RUN_ID]           the failing tests of RUN_ID (default:
                                          the newest failed run): each failed
                                          job's log, its FAILED/ERROR lines and
                                          the assertion lines under them; the
                                          whole log saved with --out DIR
    nmas-ci-log times [--limit N]         each completed run's jobs and their
                                          minutes, then each job's slowest run,
                                          one past TRIGGER_MINUTES said (C614)
    nmas-ci-log run RUN_ID [--log JOB] [--artifact NAME --out DIR]
                                          a run's jobs and artifacts; one job's
                                          log; one artifact's files unpacked

The token: ~/.config/nmas/github-actions-read.token (or NMAS_CI_TOKEN_FILE).
It is read from that file and nowhere else, refused when the file or its
directory can be read by anyone but its owner, and sent ONLY in the
Authorization header of requests to https://api.github.com. Never printed,
logged or passed on a command line. GitHub serves a job's log by REDIRECTING
to a storage host, and Python's redirect handler forwards the Authorization
header, so redirects are followed by hand and the storage host is asked
without it.

Its expiry is read from GitHub's own answer (the
`github-authentication-token-expiration` header) on every call, and fewer
than WARN_DAYS left is said first, on stderr.

Exit: 0 ok; 1 the token file refused; 2 GitHub could not be asked or refused.
"""

import argparse
import datetime
import json
import os
import re
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "https://api.github.com"


def _repo_slug() -> str:
    """<account>/<repo> from this checkout's `origin` (the account is never
    written into a file the public repository holds)."""
    import subprocess
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    url = subprocess.run(["git", "-C", here, "remote", "get-url", "origin"],
                         capture_output=True, text=True).stdout.strip()
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
    return m.group(1) if m else ""


REPO = _repo_slug()
TOKEN_FILE = os.path.expanduser("~/.config/nmas/github-actions-read.token")
USER_AGENT = "nmas-automation/1.0"
WARN_DAYS = 14
EXIT_TOKEN, EXIT_GITHUB = 1, 2
#: C614 (the operator, 2026-10-09): CI's job bound is 14 minutes, and a job whose slowest run
#: passes 10 (about 70% of it) is due a split. The browser job was split at 9.0 (C614, closed).
TRIGGER_MINUTES = 10
FAILURE_LINE = re.compile(r"(?:^|\s)(FAILED|ERROR) tests/\S+|^E\s{2,}|Error: |##\[error\]")


class TokenRefused(Exception):
    pass


def read_token(path: str = None) -> str:
    """The token, from its file only. Refused when the file or its directory
    is reachable by anyone but the owner, or the file is not a regular file."""
    path = path or os.environ.get("NMAS_CI_TOKEN_FILE") or TOKEN_FILE
    try:
        st = os.stat(path, follow_symlinks=False)
    except FileNotFoundError:
        raise TokenRefused(f"no token file at {path}") from None
    if not stat.S_ISREG(st.st_mode):
        raise TokenRefused(f"{path} is not a regular file")
    if st.st_mode & 0o077:
        raise TokenRefused(f"{path} is mode {stat.S_IMODE(st.st_mode):04o}: refused, "
                           "anyone but its owner can reach it (chmod 600)")
    parent = os.stat(os.path.dirname(os.path.abspath(path)))
    if parent.st_mode & 0o077:
        raise TokenRefused(f"its directory is mode {stat.S_IMODE(parent.st_mode):04o}: refused "
                           "(chmod 700)")
    with open(path, encoding="utf-8") as fh:
        token = fh.read().strip()
    if not token:
        raise TokenRefused(f"{path} is empty")
    return token


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Hand every redirect back: the caller decides who sees the token."""

    def redirect_request(self, *a, **k):
        return None


def _opener():
    return urllib.request.build_opener(_NoRedirect)


class Answer:
    def __init__(self, status, body, headers):
        self.status, self.body, self.headers = status, body, headers


def get(path: str, token: str, opener=None, timeout: int = 30) -> Answer:
    """GET *path* from the API with the token; a redirect is followed WITHOUT
    it (a job log lives on another host)."""
    opener = opener or _opener()
    url = API + path
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28", "User-Agent": USER_AGENT})
    try:
        r = opener.open(req, timeout=timeout)
        return Answer(r.status, r.read(), dict(r.headers))
    except urllib.error.HTTPError as exc:
        if exc.code in (301, 302, 303, 307, 308) and exc.headers.get("Location"):
            first = dict(exc.headers)
            loc = exc.headers["Location"]
            if urllib.parse.urlparse(loc).scheme != "https":
                raise RuntimeError("GitHub redirected to a non-https location: refused") from None
            plain = urllib.request.Request(loc, headers={"User-Agent": USER_AGENT})
            r = opener.open(plain, timeout=timeout)
            return Answer(r.status, r.read(), {**first, **dict(r.headers)})
        # Never the request: it carries the token.
        raise RuntimeError(f"GitHub answered {exc.code} for {path}") from None
    except urllib.error.URLError as exc:
        raise RuntimeError(f"GitHub could not be asked ({exc.reason})") from None


def expiry_warning(headers: dict, now: datetime.datetime = None) -> str:
    """'' when the token has WARN_DAYS or more left; else what to do."""
    raw = next((v for k, v in headers.items()
                if k.lower() == "github-authentication-token-expiration"), "")
    if not raw:
        return ""
    try:
        when = datetime.datetime.strptime(raw.replace(" UTC", " +0000"), "%Y-%m-%d %H:%M:%S %z")
    except ValueError:
        return f"the token's expiry reads {raw!r}, which this cannot parse"
    now = now or datetime.datetime.now(datetime.timezone.utc)
    left = (when - now).days
    if left < WARN_DAYS:
        return (f"the CI-log token expires {when:%Y-%m-%d} ({max(left, 0)} day(s) left): ask the "
                "operator for a new one before then")
    return ""


def _json(answer: Answer):
    return json.loads(answer.body.decode("utf-8"))


def unzip_into(data: bytes, out: str) -> list:
    """An artifact's zip (*data*) unpacked into *out*, which is made; returns the files' names.
    The archive comes from elsewhere: a member naming a path outside *out* (absolute, or
    climbing with ..) is refused, and nothing of the archive is written."""
    import io
    import zipfile

    root = os.path.realpath(out)
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        names = z.namelist()
        for n in names:
            target = os.path.realpath(os.path.join(root, n))
            if os.path.isabs(n) or not (target == root or target.startswith(root + os.sep)):
                raise RuntimeError(f"the artifact names a path outside {out}: {n!r}: refused")
        os.makedirs(root, exist_ok=True)
        z.extractall(root)
    return [n for n in names if not n.endswith("/")]


def runs(token, limit=10, opener=None):
    a = get(f"/repos/{REPO}/actions/runs?per_page={limit}", token, opener)
    return a, _json(a).get("workflow_runs", [])


def job_minutes(job: dict):
    """A finished job's minutes (started to completed), or None when either time is missing."""
    try:
        start, end = (datetime.datetime.strptime(job[k], "%Y-%m-%dT%H:%M:%SZ")
                      for k in ("started_at", "completed_at"))
    except (KeyError, TypeError, ValueError):
        return None
    return (end - start).total_seconds() / 60


def slowest(rows: list) -> dict:
    """{job name: (minutes, run number)} the slowest of *rows*, each (run number, name,
    minutes); a job whose minutes are unknown is left out."""
    out = {}
    for number, name, minutes in rows:
        if minutes is not None and minutes > out.get(name, (-1, 0))[0]:
            out[name] = (minutes, number)
    return out


def failing_lines(log: str, limit: int = 60) -> list:
    """The lines that say what failed: pytest's FAILED/ERROR lines, assertion
    lines under them, and the runner's error lines, timestamps stripped."""
    out = []
    for line in log.splitlines():
        text = re.sub(r"^\d{4}-\d\d-\d\dT[\d:.]+Z\s", "", line)
        if FAILURE_LINE.search(text):
            out.append(text.rstrip())
    return out[:limit]


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="nmas-ci-log", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("runs")
    r.add_argument("--limit", type=int, default=10)
    f = sub.add_parser("failed")
    f.add_argument("run_id", nargs="?")
    f.add_argument("--out", help="a directory to save each failed job's whole log in")
    t = sub.add_parser("times")
    t.add_argument("--limit", type=int, default=20)
    # Lab 7 (2026-10-14): a run's jobs, minutes and artifacts, and one job's log by name (the
    # coverage job's report is in its log and summary, whatever its conclusion).
    u = sub.add_parser("run")
    u.add_argument("run_id")
    u.add_argument("--log", help="print this job's log (its name, e.g. 'coverage')")
    u.add_argument("--artifact", help="save this artifact's files (its name) into --out")
    u.add_argument("--out", help="the directory --artifact unpacks into")
    args = ap.parse_args(argv)

    try:
        token = read_token()
    except TokenRefused as exc:
        print(f"nmas-ci-log: {exc}", file=sys.stderr)
        return EXIT_TOKEN
    try:
        first, items = runs(token, 30 if args.cmd == "failed" else getattr(args, "limit", 1))
        warn = expiry_warning(first.headers)
        if warn:
            print(f"nmas-ci-log: WARNING: {warn}", file=sys.stderr)
        if args.cmd == "runs":
            for run in items[: args.limit]:
                print(f"#{run['run_number']} {run['head_sha'][:7]} {run['status']} "
                      f"{run.get('conclusion') or '-'} attempt {run.get('run_attempt', 1)} "
                      f"{run['created_at']} id {run['id']}")
            return 0
        if args.cmd == "times":
            rows = []
            done = [x for x in items[: args.limit] if x.get("status") == "completed"]
            for run in done:
                jobs = _json(get(f"/repos/{REPO}/actions/runs/{run['id']}/jobs", token))["jobs"]
                words = []
                for job in jobs:
                    m = job_minutes(job)
                    rows.append((run["run_number"], job["name"], m))
                    words.append(f"{job['name']} {'?' if m is None else f'{m:.1f}'}")
                print(f"#{run['run_number']} {run['head_sha'][:7]} {run['created_at']}: "
                      + "; ".join(words))
            print(f"slowest of {len(done)} completed runs (minutes; the trigger is "
                  f"{TRIGGER_MINUTES}):")
            for name, (m, number) in sorted(slowest(rows).items()):
                past = "  PAST THE TRIGGER" if m > TRIGGER_MINUTES else ""
                print(f"  {name}: {m:.1f} in #{number}{past}")
            return 0
        if args.cmd == "run":
            run = _json(get(f"/repos/{REPO}/actions/runs/{args.run_id}", token))
            print(f"#{run['run_number']} {run['head_sha'][:7]} {run.get('conclusion') or run['status']}"
                  f" {run['html_url']}")
            jobs = _json(get(f"/repos/{REPO}/actions/runs/{args.run_id}/jobs", token))["jobs"]
            for job in jobs:
                m = job_minutes(job)
                print(f"  job {job['name']}: {job.get('conclusion')}, "
                      f"{'?' if m is None else f'{m:.1f}'} min, {job['html_url']}")
            arts = _json(get(f"/repos/{REPO}/actions/runs/{args.run_id}/artifacts",
                             token)).get("artifacts", [])
            for a in arts:
                print(f"  artifact {a['name']}: {a['size_in_bytes']} bytes, "
                      f"{run['html_url']}/artifacts/{a['id']}")
            if args.artifact:
                # The mutation night's report.json (the operator, 2026-10-14: its survivors seed
                # the debt list from the run's own structured record, never from log text).
                if not args.out:
                    print("nmas-ci-log: --artifact needs --out DIR", file=sys.stderr)
                    return 1
                a = next((x for x in arts if x["name"] == args.artifact), None)
                if a is None:
                    print(f"nmas-ci-log: no artifact named {args.artifact}", file=sys.stderr)
                    return 1
                data = get(f"/repos/{REPO}/actions/artifacts/{a['id']}/zip", token,
                           timeout=120).body
                for n in unzip_into(data, args.out):
                    print(f"  saved {os.path.join(args.out, n)}")
            if args.log:
                job = next((j for j in jobs if j["name"].split(" ")[0] == args.log
                            or j["name"] == args.log), None)
                if job is None:
                    print(f"nmas-ci-log: no job named {args.log}", file=sys.stderr)
                    return 1
                log = get(f"/repos/{REPO}/actions/jobs/{job['id']}/logs", token).body.decode(
                    "utf-8", "replace")
                for line in log.splitlines():
                    print(re.sub(r"^\d{4}-\d\d-\d\dT[\d:.]+Z\s", "", line))
            return 0
        run_id = args.run_id or next((str(x["id"]) for x in items
                                      if x.get("conclusion") == "failure"), "")
        if not run_id:
            print("nmas-ci-log: no failed run among the latest 30", file=sys.stderr)
            return 0
        jobs = _json(get(f"/repos/{REPO}/actions/runs/{run_id}/jobs", token))["jobs"]
        for job in jobs:
            print(f"job {job['id']} {job['name']}: {job.get('conclusion')}")
            if job.get("conclusion") not in ("failure", "cancelled", "timed_out"):
                continue
            log = get(f"/repos/{REPO}/actions/jobs/{job['id']}/logs", token).body.decode(
                "utf-8", "replace")
            if args.out:
                os.makedirs(args.out, exist_ok=True)
                with open(os.path.join(args.out, f"job-{job['id']}.log"), "w",
                          encoding="utf-8") as fh:
                    fh.write(log)
            for line in failing_lines(log):
                print("  " + line)
        return 0
    except RuntimeError as exc:
        print(f"nmas-ci-log: {exc}", file=sys.stderr)
        return EXIT_GITHUB


if __name__ == "__main__":
    sys.exit(main())
