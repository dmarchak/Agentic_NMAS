      "properties": {
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "rate_kbps": {
          "title": "Rate Kbps",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
