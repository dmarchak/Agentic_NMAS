# TEMPLATE (2026-09-29): the repository is public, so the host's user and paths
# are placeholders. Render it, never copy it:
# Register C53: does each device's STARTUP config carry the credential NMAS
# holds? Read-only (two show commands per device); writes
# data/startup_check.json, which job health reads.
#   scripts/nmas-render-units --out /tmp/nmas-units deploy/systemd/nmas-startup-check.*
#   sudo install -m 0644 /tmp/nmas-units/nmas-startup-check.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nmas-startup-check.timer
[Unit]
Description=NMAS: every device's startup config carries the credential NMAS holds
# When it ends, either way, the app reads job health at once
# (nmas-job-finished@.service; /jobs/finished).
OnSuccess=nmas-job-finished@%N.service
OnFailure=nmas-job-finished@%N.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@NMAS_USER@
Group=@NMAS_USER@
WorkingDirectory=@NMAS_CHECKOUT@
ExecStart=@NMAS_CHECKOUT@/scripts/nmas-startup-check
# Exit 1 (a device would boot a credential NMAS does not hold) is a failure of
# the unit, so job health shows it from the journal as well as from the file.
TimeoutStartSec=20min
