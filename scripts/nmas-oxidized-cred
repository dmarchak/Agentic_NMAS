#!/usr/bin/python3 -I
"""Update or remove exactly one row of Oxidized's router.db, or list its addresses.
Root-owned helper.

THREE ACTS, each one row or none
    (default)     replace one row's username and password (from STDIN);
    --remove      remove one row, a retired device's (C398); reads no credential;
    --addresses   print the addresses only, never a credential (job health compares them
                  with the devices the tool manages).

THE SHEBANG IS PART OF THE SECURITY OF THIS SCRIPT
    ``/usr/bin/python3`` absolutely, not ``/usr/bin/env python3``: ``env``
    resolves the interpreter through ``PATH``, and a root-run script must not
    let its caller choose which interpreter runs it.

    ``-I`` is isolated mode: ignore ``PYTHONPATH``, ``PYTHONHOME`` and the rest
    of the ``PYTHON*`` environment, and skip the user site-packages directory.
    Without it, a writable ``~/.local/lib/pythonX/site-packages`` belonging to
    the *calling* user is on the path of a root process.

    sudo's ``env_reset`` and ``secure_path`` give both properties too — but
    they are defaults in a file someone else maintains. A script that is safe
    only while a sudoers option stays set is safe by coincidence.

    sudo /usr/local/sbin/nmas-oxidized-cred --file <router.db> --ip <device-ip>
    (credentials arrive as JSON on STDIN: {"username": …, "password": …})

WHY THIS EXISTS AS A SEPARATE, ROOT-OWNED SCRIPT
    router.db is 0600 oxidized:oxidized and holds every device's password. The
    NMAS app runs as an ordinary user, so it cannot write the file — and
    granting it read access would hand it every password in there, which is
    strictly more than "change this one device's row".

    One fully-qualified sudoers entry lets it change one row and learn nothing:

        <user> ALL=(root) NOPASSWD: /usr/local/sbin/nmas-oxidized-cred

    Install root-owned and not writable by the calling user:

        sudo install -o root -g root -m 0755 nmas-oxidized-cred \
             /usr/local/sbin/nmas-oxidized-cred

    **This file must not import anything from a user-writable path.** A root
    script that imports from a user's home is a privilege escalation with extra
    steps, which is why the row-editing logic lives here rather than in
    `modules/` — and why the tests drive this script as a subprocess instead.

WHY THE PASSWORD IS ON STDIN
    argv is world-readable in /proc for the lifetime of the process. A password
    passed as a command-line argument is visible to every user on the box.

WHAT IT GUARANTEES
    Backup, then parse, then change only the target row, then write a temp file,
    then VALIDATE it, then replace atomically. A validation failure leaves the
    original untouched. Nothing is printed except a JSON result that contains no
    credential.

    ONE FILE (C414): as root it acts only on the router.db named in the root-owned
    ``/etc/nmas/oxidized-cred.conf`` (PIN) and refuses any other ``--file``, naming both.

    FEW BACKUPS (C415): after a successful write it keeps the newest KEEP_BACKUPS backups
    and removes older ones, so credentials rotated away do not stay on disk.

    IDEMPOTENT: if the target row already holds the intended credential, it
    reports ``changed: 0, already_current: true`` and writes nothing. Any
    other row differing, or the target differing in any way other than to the
    intended value, is still refused.
"""

import argparse
import json
import os
import re
import shutil
import stat
import sys
import tempfile
import time

FIELDS = 4
IPV4 = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}$")

#: THE ONE router.db (C414, the operator's review, 2026-10-04: the root helper edited whatever
#: file its caller named). As root, the helper acts only on the path this root-owned file
#: names, and refuses any other --file, naming both. One absolute path; '#' lines are comments.
PIN = "/etc/nmas/oxidized-cred.conf"
#: Who must own the pin: root.
TRUSTED_UID = 0

#: Backups kept after a successful write (C415): each holds every device's password at that
#: moment, so old ones keep credentials rotated away. Three: the state before the last write,
#: before the one before (a rotation and its rollback are two writes), and one more for a
#: person who finds a mistake a write late. Older ones are removed by the helper itself.
KEEP_BACKUPS = 3
BACKUP_STAMP = re.compile(r"\d{8}-\d{6}")


def pinned_path(given, euid=None, pin=None, trusted_uid=None):
    """The router.db to act on. As root: the path *pin* names, which must be a regular file
    owned by *trusted_uid* and writable by no one else; *given* must be that path (compared
    resolved). Not root: *given*, because the helper then holds no privilege its caller lacks.
    Raises ValueError naming what was compared."""
    euid = os.geteuid() if euid is None else euid
    if euid != 0:
        return given
    pin = pin or PIN
    trusted_uid = TRUSTED_UID if trusted_uid is None else trusted_uid
    try:
        st = os.lstat(pin)
    except FileNotFoundError:
        raise ValueError(f"no router.db is pinned: {pin} is absent. Install it root-owned, "
                         "naming the one router.db this helper edits") from None
    if not stat.S_ISREG(st.st_mode):
        raise ValueError(f"{pin} is not a regular file")
    if st.st_uid != trusted_uid or st.st_mode & 0o022:
        raise ValueError(f"{pin} must be root-owned and writable by no one else "
                         f"(owner uid {st.st_uid}, mode {oct(st.st_mode & 0o777)})")
    with open(pin, encoding="utf-8") as fh:
        named = [l.strip() for l in fh if l.strip() and not l.strip().startswith("#")]
    if len(named) != 1 or not os.path.isabs(named[0]):
        raise ValueError(f"{pin} must name exactly one absolute path; it names {len(named)}"
                         + ("" if len(named) != 1 else f" ({named[0]!r} is not absolute)"))
    pinned = os.path.realpath(named[0])
    if os.path.realpath(given) != pinned:
        raise ValueError(f"--file {given} is not the pinned router.db {named[0]} "
                         f"(from {pin}): refused")
    return pinned


def prune_backups(path, keep=KEEP_BACKUPS):
    """Remove all but the newest *keep* of *path*'s backups (``<path>.nmas-bak-<stamp>``,
    the stamp sorting by time). Returns the names removed."""
    folder, base = os.path.split(path)
    prefix = f"{base}.nmas-bak-"
    names = sorted(n for n in os.listdir(folder or ".")
                   if n.startswith(prefix) and BACKUP_STAMP.fullmatch(n[len(prefix):]))
    gone = names[:-keep] if keep else names
    for name in gone:
        os.unlink(os.path.join(folder or ".", name))
    return gone


def _fail(message, **extra):
    print(json.dumps({"ok": False, "error": message, **extra}))
    raise SystemExit(1)


def parse_rows(text, allow_empty=False):
    """``[(ip, model, username, password)]``. Raises on a malformed file.

    A malformed row is refused rather than skipped: this file is the only thing
    standing between Oxidized and every device, and quietly dropping a line
    would remove a device from the harvest with no error anywhere.
    """
    rows = []
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(":")
        if len(parts) != FIELDS:
            raise ValueError(
                f"line {lineno}: expected {FIELDS} colon-separated fields, "
                f"found {len(parts)}")
        if not IPV4.match(parts[0]):
            raise ValueError(f"line {lineno}: {parts[0]!r} is not an IPv4 address")
        if not parts[1] or not parts[2]:
            raise ValueError(f"line {lineno}: empty model or username")
        rows.append(tuple(parts))
    if not rows and not allow_empty:
        raise ValueError("no rows found")
    return rows


def render(rows):
    return "\n".join(":".join(r) for r in rows) + "\n"


def validate(before, after, target_ip):
    """Every way this edit could have gone wrong, checked before it lands."""
    if len(after) != len(before):
        raise ValueError(f"row count changed: {len(before)} -> {len(after)}")

    before_ips = [r[0] for r in before]
    after_ips = [r[0] for r in after]
    if before_ips != after_ips:
        raise ValueError("the set or order of device addresses changed")

    for row in after:
        if len(row) != FIELDS:
            raise ValueError(f"row for {row[0]} has {len(row)} fields")
        if any(":" in field for field in row):
            raise ValueError(f"row for {row[0]} contains a colon inside a field")
        if not row[3]:
            raise ValueError(f"row for {row[0]} has an empty password")

    differing = [b[0] for b, a in zip(before, after) if b != a]
    if differing != [target_ip]:
        raise ValueError(
            f"expected exactly one changed row ({target_ip}), "
            f"changed: {differing or 'none'}")


def validate_removal(before, after, target_ip):
    """Removing ONE row (C398, a retired device): exactly that address leaves, and every other
    row is unchanged, in its order."""
    if len(after) != len(before) - 1:
        raise ValueError(f"row count changed: {len(before)} -> {len(after)}, expected one fewer")
    if target_ip in [r[0] for r in after]:
        raise ValueError(f"{target_ip} is still present")
    if after != [r for r in before if r[0] != target_ip]:
        raise ValueError("a row other than the removed one changed, or the order moved")


def write_checked(path, before, after, check, no_backup):
    """Back up, write a temp file, re-read and validate WHAT WAS WRITTEN with *check*, then
    replace atomically. Returns the backup's path ("" with *no_backup*); fails leaving the
    original untouched."""
    backup = ""
    if not no_backup:
        backup = f"{path}.nmas-bak-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(path, backup)
        os.chmod(backup, stat.S_IRUSR | stat.S_IWUSR)

    st = os.stat(path)
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".router.db.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(render(after) if after else "")
        # Re-read what was actually written, and validate THAT — not the list
        # we intended to write. A short write or an encoding surprise is
        # exactly the failure this ordering catches.
        written = parse_rows(open(tmp, encoding="utf-8").read(), allow_empty=True)
        check(before, written)
        os.chmod(tmp, stat.S_IMODE(st.st_mode))
        os.chown(tmp, st.st_uid, st.st_gid)
        os.replace(tmp, path)
    except Exception as exc:                  # noqa: BLE001
        if os.path.exists(tmp):
            os.unlink(tmp)
        _fail(f"write failed, original untouched: {type(exc).__name__}: {exc}")
    return backup


LOCK_WAIT_S = 5.0
# One whole run of this helper measured 35 ms (200 rows, 2026-10-04), so a lock held for
# seconds is a hung holder, never a busy one. The bound is not 2.5x that run: rotations
# queue, and a fleet rotation can put several writers behind one another. 5 s is "a few
# seconds" (the operator, 2026-10-04), and it covers a queue of about a hundred such runs.


def hold_router_db(path, act, ip):
    """An exclusive `flock` beside *path*, held until this process ends (CONCURRENCY_AUDIT R40).

    Two rotations of different devices each hold only their own device, so both ran this
    helper at once: each read the whole of router.db, replaced its own row and wrote the file
    back, and the later replace put the other device's row back to its old password, so
    Oxidized could no longer log in to it. Every write here now reads and replaces under this
    lock; a second writer waits (a write takes milliseconds), for at most LOCK_WAIT_S, and then
    refuses, changing nothing and naming the lock and the holder its record names (the
    operator, 2026-10-04: an unbounded wait behind a hung helper would hang every later
    rotation). The lock file is `.router.db.nmas-lock`, never a name the backup pruning
    counts; the holder writes its pid, act, address and start time into it."""
    import fcntl

    lock = os.path.join(os.path.dirname(path) or ".",
                        f".{os.path.basename(path)}.nmas-lock")
    fd = os.open(lock, os.O_RDWR | os.O_CREAT, stat.S_IRUSR | stat.S_IWUSR)
    deadline = time.monotonic() + LOCK_WAIT_S
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(fd)
                _fail(f"{lock} is still held after {LOCK_WAIT_S:g} s; nothing was changed. "
                      f"{_holder_words(lock)}", lock=lock)
            time.sleep(0.05)
    os.ftruncate(fd, 0)
    os.pwrite(fd, json.dumps({"pid": os.getpid(), "since": time.strftime(
        "%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "act": act, "ip": ip}).encode(), 0)
    return fd


def _holder_words(lock):
    """Who holds *lock*, from the record its holder writes once it has the lock. A holder that
    has not written yet (the first milliseconds), or a helper older than the record, leaves
    none, and this says so rather than guessing."""
    try:
        with open(lock, encoding="utf-8") as fh:
            held = json.loads(fh.read() or "{}")
        pid = int(held["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        return "No holder is recorded in it."
    try:
        os.kill(pid, 0)
        alive = "running"
    except ProcessLookupError:
        alive = "no longer running"
    except PermissionError:
        alive = "running"
    return (f"Recorded holder: pid {pid} ({alive}), {held.get('act', '?')} for "
            f"{held.get('ip') or '?'} since {held.get('since', '?')}.")


def pruned(path, backup):
    """The result's pruning fields, after a successful write: the write is done whatever
    pruning finds, so a pruning failure is said, never a failed write."""
    if not backup:
        return {"backups_removed": 0}
    try:
        return {"backups_removed": len(prune_backups(path))}
    except OSError as exc:
        return {"backups_removed": 0, "prune_error": f"{type(exc).__name__}: {exc}"}


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--file", required=True)
    ap.add_argument("--ip")
    ap.add_argument("--remove", action="store_true",
                    help="remove the --ip row (a retired device); reads no credential")
    ap.add_argument("--addresses", action="store_true",
                    help="print the addresses only, never a credential")
    ap.add_argument("--no-backup", action="store_true",
                    help="tests only; the real path always backs up")
    args = ap.parse_args()

    if args.remove and args.addresses:
        _fail("--remove and --addresses are two different acts: give one")
    if not args.addresses and not args.ip:
        _fail("--ip is required")
    if args.no_backup and os.geteuid() == 0:
        _fail("--no-backup is for tests only, never as root: the real path always backs up")
    try:
        path = pinned_path(args.file)
    except (ValueError, OSError) as exc:
        _fail(str(exc))
    if not args.addresses and os.path.exists(path):
        hold_router_db(path, "remove" if args.remove else "rotate", args.ip)   # read→replace (R40)
    if args.remove or args.addresses:
        if not os.path.exists(path):
            _fail(f"{path} does not exist")
        try:
            before = parse_rows(open(path, encoding="utf-8").read(), allow_empty=True)
        except ValueError as exc:
            _fail(f"refusing to read a malformed router.db: {exc}")
        if args.addresses:
            # ADDRESSES ONLY: the caller compares them with its managed devices (C398's job
            # health); a username or password never leaves this process.
            print(json.dumps({"ok": True, "rows": len(before),
                              "addresses": [r[0] for r in before]}))
            return
        if args.ip not in [r[0] for r in before]:
            # ALREADY ABSENT is success: a retirement run again finds its row gone.
            print(json.dumps({"ok": True, "ip": args.ip, "rows": len(before), "backup": "",
                              "removed": 0, "already_absent": True}))
            return
        after = [r for r in before if r[0] != args.ip]
        try:
            validate_removal(before, after, args.ip)
        except ValueError as exc:
            _fail(f"validation failed, nothing written: {exc}")
        backup = write_checked(path, before, after,
                               lambda b, w: validate_removal(b, w, args.ip), args.no_backup)
        print(json.dumps({"ok": True, "ip": args.ip, "rows": len(after), "backup": backup,
                          "removed": 1, **pruned(path, backup)}))
        return

    try:
        payload = json.load(sys.stdin)
        username = payload["username"]
        password = payload["password"]
    except Exception as exc:                  # noqa: BLE001
        _fail(f"could not read credentials from stdin: {type(exc).__name__}")
    if not username or not password:
        _fail("username and password must both be non-empty")
    if any(":" in v or "\n" in v for v in (username, password)):
        _fail("username and password must not contain ':' or a newline — "
              "router.db is colon-delimited and one would split the row")

    if not os.path.exists(path):
        _fail(f"{path} does not exist")

    original = open(path, encoding="utf-8").read()
    try:
        before = parse_rows(original)
    except ValueError as exc:
        _fail(f"refusing to edit a malformed router.db: {exc}")

    if args.ip not in [r[0] for r in before]:
        _fail(f"{args.ip} is not in router.db", known=len(before))

    after = [(r[0], r[1], username, password) if r[0] == args.ip else r
             for r in before]

    # ALREADY CURRENT is success, not failure.
    #
    # `after` is built from `before` by replacing only the target row, so
    # `after == before` can mean exactly one thing: that row already holds the
    # intended username and password. No other row can have converged, because
    # no other row was touched.
    #
    # The "exactly one row changed" rule is right for catching a wrong write,
    # but it used to reject this case — which is the case the persist-only
    # recovery path exists to handle. A chain that re-runs after a partial
    # failure will find earlier stages already done, so treating "already
    # correct" as an error makes the recovery tool fail precisely when it is
    # needed.
    if after == before:
        print(json.dumps({"ok": True, "ip": args.ip, "rows": len(before),
                          "backup": "", "changed": 0, "already_current": True}))
        return

    try:
        validate(before, after, args.ip)
    except ValueError as exc:
        _fail(f"validation failed, nothing written: {exc}")

    backup = write_checked(path, before, after,
                           lambda b, w: validate(b, w, args.ip), args.no_backup)

    print(json.dumps({"ok": True, "ip": args.ip, "rows": len(after),
                      "backup": backup, "changed": 1, **pruned(path, backup)}))


if __name__ == "__main__":
    main()
