[Unit]
Description=NMAS: back up NetBox (dump + media + config; encrypted copies shipped)
# When it ends, either way, the app reads job health at once
# (nmas-job-finished@.service; /jobs/finished).
OnSuccess=nmas-job-finished@%N.service
OnFailure=nmas-job-finished@%N.service
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@NMAS_USER@
Group=@NMAS_USER@
SupplementaryGroups=docker
UMask=0077
StateDirectory=nmas-netbox
StateDirectoryMode=0700
EnvironmentFile=/etc/nmas/netbox-backup.env
ExecStart=@NMAS_CHECKOUT@/scripts/nmas-netbox-backup
Nice=10
TimeoutStartSec=30min
