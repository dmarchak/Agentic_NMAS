#!/usr/bin/env python3
"""Append generated snmp_exporter modules to the exporter's snmp.yml, proven.

    nmas-snmp-add-modules                                   # dry run: what would change
    sudo nmas-snmp-add-modules --apply                      # back up, append, prove
    nmas-snmp-add-modules --replace                         # dry run of replacing in place
    sudo nmas-snmp-add-modules --replace --apply            # back up, replace, prove (C700)

The operator's host step (PROMETHEUS_TARGETS.md). Defaults: the fragment
`deploy/snmp_exporter/routing-modules.yml` (ospf, ospfv3, cisco_bgp_peer2)
and `/etc/snmp_exporter/snmp.yml`. The file is appended to as text, the way
the ipsla and lldp modules were added (2026-09-12), never rewritten, so the
1.5 MB generated file and its auths keep their bytes.

Refused, writing nothing: the config unreadable, `modules:` not its LAST
top-level key (an append would land in the wrong map), or a module name
already there. After the append the file is parsed again and REQUIRED to
hold every module it held before, unchanged, plus exactly the new ones;
otherwise the backup is put back. It never prints a community (the auths
section is not read into any output).

Exit 0: dry run clean, or appended and proven; 1: refused (named); 2: the
append did not prove and the backup was restored.
"""

import argparse
import os
import shutil
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

FRAGMENT = os.path.join(ROOT, "deploy", "snmp_exporter", "routing-modules.yml")
CONFIG = "/etc/snmp_exporter/snmp.yml"


def _top_level_keys(text: str) -> list:
    return [line.split(":", 1)[0] for line in text.splitlines()
            if line and not line[0].isspace() and not line.startswith("#") and ":" in line]


def _blocks(text: str) -> list:
    """The `modules:` map's entries as text, ``[(name, block)]`` in order: each from its
    two-space-indented ``  name:`` line to the next one (or the end)."""
    out, name, lines = [], None, []
    for line in text.splitlines(keepends=True):
        key = line[2:].split(":", 1)[0] if (line.startswith("  ") and not line.startswith("   ")
                                            and line.rstrip().endswith(":")) else None
        if key is not None:
            if name is not None:
                out.append((name, "".join(lines)))
            name, lines = key, [line]
        elif name is not None:
            lines.append(line)
    if name is not None:
        out.append((name, "".join(lines)))
    return out


def _replace(text: str, frag: str) -> str:
    """*text* with each module *frag* holds replaced, as text, in place; everything before
    `modules:` and every other module keeps its bytes."""
    head, sep, body = text.partition("\nmodules:\n")
    if text.startswith("modules:\n"):
        head, sep, body = "", "modules:\n", text[len("modules:\n"):]
    new = dict(_blocks(frag))
    return head + sep + "".join(new.get(n, b) for n, b in _blocks(body))


def main(argv=None) -> int:
    import yaml

    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--config", default=CONFIG)
    ap.add_argument("--fragment", default=FRAGMENT)
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--replace", action="store_true",
                    help="replace the fragment's modules, each already in the config, in place "
                         "(C700: the routing modules regenerated), instead of appending them")
    args = ap.parse_args(argv)

    try:
        text = open(args.config, encoding="utf-8").read()
        frag = open(args.fragment, encoding="utf-8").read()
    except OSError as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 1
    keys = _top_level_keys(text)
    if not keys or keys[-1] != "modules":
        print(f"REFUSED: `modules:` is not the last top-level key of {args.config} "
              f"(keys in order: {keys}); an append would land in the wrong map", file=sys.stderr)
        return 1
    before = (yaml.safe_load(text) or {}).get("modules") or {}
    new = (yaml.safe_load("modules:\n" + frag) or {}).get("modules") or {}
    if not new:
        print(f"REFUSED: {args.fragment} holds no module", file=sys.stderr)
        return 1
    if args.replace:
        return _main_replace(args, text, frag, before, new, yaml)
    clash = sorted(set(new) & set(before))
    if clash:
        print(f"REFUSED: {args.config} already has module(s) {clash}; nothing changed",
              file=sys.stderr)
        return 1
    print(f"{args.config}: {len(before)} module(s); would add {sorted(new)} "
          f"({len(frag.splitlines())} lines appended)")
    if not args.apply:
        print("dry run: nothing written (--apply backs up, appends and proves)")
        return 0

    backup = f"{args.config}.bak-routing-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"
    shutil.copy2(args.config, backup)
    with open(args.config, "a", encoding="utf-8") as fh:
        if not text.endswith("\n"):
            fh.write("\n")
        fh.write(frag)
    after = (yaml.safe_load(open(args.config, encoding="utf-8").read()) or {}).get("modules") or {}
    ok = (all(after.get(k) == v for k, v in before.items())
          and set(after) == set(before) | set(new)
          and all(after[k] == v for k, v in new.items()))
    if not ok:
        shutil.copy2(backup, args.config)
        print(f"NOT PROVEN: the file after the append did not hold every module unchanged "
              f"plus exactly {sorted(new)}; the backup {backup} was put back", file=sys.stderr)
        return 2
    print(f"appended and proven: {len(after)} module(s), the {len(before)} before unchanged; "
          f"backup {backup}")
    print("next: `docker exec snmp-exporter /bin/snmp_exporter --config.file=/etc/snmp_exporter/snmp.yml "
          "--dry-run`, then `docker restart snmp-exporter`")
    return 0


def _main_replace(args, text, frag, before, new, yaml) -> int:
    """--replace: each module of the fragment, already in the config, replaced in place as text.
    Proven after: every other module and every other top-level key unchanged, the replaced
    ones exactly the fragment's; otherwise the backup goes back."""
    missing = sorted(set(new) - set(before))
    if missing:
        print(f"REFUSED: {args.config} has no module(s) {missing} to replace (it has "
              f"{len(before)}); add them without --replace. Nothing changed", file=sys.stderr)
        return 1
    candidate = _replace(text, frag)
    changed = sorted(k for k in new if before[k] != new[k])
    print(f"{args.config}: {len(before)} module(s); would replace {sorted(new)} in place "
          f"({', '.join(changed) or 'none'} differ from what the config holds)")
    if not args.apply:
        print("dry run: nothing written (--apply backs up, replaces and proves)")
        return 0
    backup = f"{args.config}.bak-routing-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"
    shutil.copy2(args.config, backup)
    with open(args.config, "w", encoding="utf-8") as fh:
        fh.write(candidate)
    whole_before = yaml.safe_load(text) or {}
    written = open(args.config, encoding="utf-8").read()
    whole_after = yaml.safe_load(written) or {}
    after = whole_after.get("modules") or {}
    # YAML keeps the last of two equal keys, so a module written twice would parse as one:
    # each name must appear once in the text.
    names = [n for n, _b in _blocks(written.partition("\nmodules:\n")[2])]
    ok = (len(names) == len(set(names))
          and {k: v for k, v in whole_after.items() if k != "modules"}
          == {k: v for k, v in whole_before.items() if k != "modules"}
          and set(after) == set(before)
          and all(after[k] == v for k, v in before.items() if k not in new)
          and all(after[k] == v for k, v in new.items()))
    if not ok:
        shutil.copy2(backup, args.config)
        print(f"NOT PROVEN: the file after the replace did not hold every other module and key "
              f"unchanged and exactly the fragment's {sorted(new)}; the backup {backup} was put "
              "back", file=sys.stderr)
        return 2
    print(f"replaced and proven: {sorted(new)}; the other {len(before) - len(new)} module(s) "
          f"and every other key unchanged; backup {backup}")
    print("next: `docker exec snmp-exporter /bin/snmp_exporter --config.file=/etc/snmp_exporter/snmp.yml "
          "--dry-run`, then `docker restart snmp-exporter`")
    return 0


if __name__ == "__main__":
    sys.exit(main())
