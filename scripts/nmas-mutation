#!/usr/bin/env python3
"""nmas-mutation: the nightly mutation run's three steps around mutmut (docs/TESTING.md,
"Mutation testing"; .github/workflows/mutation-nightly.yml; the logic is scripts/nmas_mutation.py).

    nmas-mutation plan --state S --head SHA --out DIR [--summary F] [--also PATH::QUALNAME]...
                       [--reach DRILLDOWN --reach-commit SHA --reach-run ID --reach-date WHEN]
                       [--stale-map refresh|defer] [--cap N]
        the functions to mutate tonight: those the record S keeps (unfinished, or holding an
        open survivor) whose text is unchanged, then the automation functions changed since S's
        commit (or HEAD~1 on the first night); at most N, the oldest first, the rest left in the
        record. Writes DIR/plan.json, DIR/patterns.txt (mutmut's names) and ./setup.cfg
        (mutmut's configuration: the planned modules and the canary, and the night's tests: for
        a function the drill-down holds at its text tonight, by text hash, the tests it saw
        execute it; for any other, the tests tonight's refresh of the map saw execute it, run
        once per test over its module, the test files the map's module index says reach it
        (the whole suite with no index: `refresh`, the default), or it waits in the record
        (`defer`, or a refresh that could not finish)). With nothing to mutate, writes
        "nothing to mutate" to F and S's next record, and DIR/patterns.txt is empty; exit 1
        then when a function it was to mutate was not (C1616: a named one deferred or capped,
        or any whose refresh measured nothing), or the debt list grew.
    nmas-mutation run --out DIR
        mutmut, one mutant at a time, in three runs: the canary's in-process function (which
        also collects mutmut's statistics and each test's tier); then, each test that starts a
        child of ours run once with coverage in its children and added to the functions they
        ran (to every function when its children could not be measured), the canary's in-child
        function;
        then the night's mutants, each classified first from mutmut's copy of its module
        (logging, MESSAGE or VERDICT: scripts/nmas_mutation.py, `classify`), a logging call's
        never run, the rest by name. Stops after a run that fails. Exit: 0, or the failing
        run's (3 when the canary survived).
    nmas-mutation report --plan DIR/plan.json --summary F --state-out S --mutmut-exit N
                         [--budget MIN]
        reads mutmut's results and each survivor's diff; checks the canary (every mutant
        killed) and the scope (only planned functions ran); merges the record's kept results;
        writes the summary to F, the report to DIR/report.json and, unless the measurement or
        the run failed, the next record to S. Exit 1 when the measurement or the run failed,
        when an open VERDICT survivor remains (not killed, not listed in
        tests/mutation_equivalent.py), or when a function it was to mutate was not (C1616:
        `nmas_mutation.not_mutated`); MESSAGE survivors are listed and kept open, never
        failing it; 0 otherwise.
"""
import argparse
import glob
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import nmas_mutation as M  # noqa: E402

#: What mutmut copies beside the mutated modules: the whole program and its tests.
ALSO_COPY = ("modules/", "routes/", "app.py", "telnetlib.py", "tests/", "scripts/", "templates/",
             "static/", "deploy/", "docs/", "lab/", "pytest.ini", "requirements.txt",
             "requirements.lock", "requirements-ci.txt", "requirements-test.txt",
             "requirements-overrides.txt")
STATS = os.path.join(M.ROOT, "mutants", "mutmut-stats.json")


def _mutmut(*args) -> str:
    return subprocess.run([sys.executable, "-m", "mutmut", *args], cwd=M.ROOT,
                          capture_output=True, text=True).stdout


def _mutmut_run(names, log, env=None) -> int:
    """One `mutmut run`, serial (docs/TESTING.md: parallel children share the test store). The
    tests run in mutmut's copy, `mutants/`, which has no git index of its own:
    `NMAS_COPY_OF` names the checkout it copies (tests/source_index.py; the first GitHub
    night found 0 of 9 configs there). Its output goes to the log as it comes and is kept
    whole in *log*, so a failure's own lines can reach the summary."""
    print(f"nmas-mutation: mutmut run over {len(names)} name(s)", flush=True)
    env = dict(os.environ if env is None else env, NMAS_COPY_OF=M.ROOT)
    proc = subprocess.Popen([sys.executable, "-m", "mutmut", "run", "--max-children", "1",
                             *names], cwd=M.ROOT, env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, errors="replace")
    with open(log, "w", encoding="utf-8") as fh:
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            fh.write(line)
    return proc.wait()


#: The bound on one run of the night's tests in mutmut's copy, measured ON THE RUNNER: 299 s on
#: night #9 and 340 s on night #10 (3,405 tests, 17 functions planned; copy-run.log), so about
#: 2.5 times the larger. 400 s, from a laptop run (78 s, 2,725 tests, 2026-10-14) and a runner
#: guessed twice as slow, fired on night #11 (53 functions, 3,477 tests; C832).
COPY_RUN_TIMEOUT_S = 850


def _fails_in_the_copy(p, out) -> list:
    """The night's tests that fail in mutmut's copy (`mutants/`, once mutmut has made it) with
    no mutant active: run once, every failure collected (never stopping at the first, as
    mutmut's own run does). Its whole output is kept in *out*/copy-run.log. Nothing when the
    copy does not exist or the run did not end with failures (an error of the run itself is
    the night's, reported as mutmut's)."""
    mutants = os.path.join(M.ROOT, "mutants")
    if not os.path.isdir(mutants):
        return []
    env = dict(os.environ, MUTANT_UNDER_TEST="", NMAS_COPY_OF=M.ROOT)
    try:
        r = subprocess.run([sys.executable, "-m", "pytest", "-q", "-rfE", "-p", "no:cacheprovider",
                            "-n", "auto", *p["tests"], M.CANARY_TESTS], cwd=mutants, env=env,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                           errors="replace", timeout=COPY_RUN_TIMEOUT_S)
        text, code = r.stdout, r.returncode
    except subprocess.TimeoutExpired as e:
        # The partial output arrives as BYTES even with text=True (CPython's TimeoutExpired):
        # night #11 crashed adding a str to it, so the bound's firing was never said (C832).
        partial = e.stdout or b""
        if isinstance(partial, bytes):
            partial = partial.decode("utf-8", "replace")
        text = partial + f"\nnmas-mutation: the copy's run passed its {COPY_RUN_TIMEOUT_S} s bound"
        code = None
    with open(os.path.join(out, "copy-run.log"), "w", encoding="utf-8") as fh:
        fh.write(text if isinstance(text, str) else text.decode("utf-8", "replace"))
    print(f"nmas-mutation: the night's tests in mutmut's copy: exit {code}", flush=True)
    return M.failing_tests(text) if code == 1 else []


#: The bound on collecting the selected tests' files at plan time (`_collected`): the laptop's
#: plan of a capped night took 64 s, nearly all of it this collection (2026-10-15, 20 functions,
#: 51 files whole and 412 test functions), and the runner runs tests about 2.2 times slower
#: (night #12's copy run, 0.218 s a test, against the laptop's 0.100 s): about 2.5 times 140 s.
COLLECT_TIMEOUT_S = 360


def _collected(files: list) -> set:
    """The test ids pytest collects at head from *files* (`--collect-only -q`); None when the
    collection itself failed or passed its bound (the caller then runs those files whole)."""
    try:
        r = subprocess.run([sys.executable, "-m", "pytest", "--collect-only", "-q",
                            "-p", "no:cacheprovider", *files], cwd=M.ROOT, capture_output=True,
                           text=True, errors="replace", timeout=COLLECT_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        print(f"nmas-mutation: collecting the selected tests passed its {COLLECT_TIMEOUT_S} s "
              "bound: their files run whole", flush=True)
        return None
    if r.returncode != 0:
        print(f"nmas-mutation: collecting the selected tests exited {r.returncode}: their files "
              "run whole", flush=True)
        return None
    return {ln.strip() for ln in r.stdout.splitlines() if ln.startswith("tests/") and "::" in ln}


#: THE CAP (C834): at most this many functions a night, the oldest unfinished first; the rest
#: wait in the record. From the laptop's walk of the record night #12 left (2026-10-15; 20 of
#: its 92 functions, 1,833 tests): the copy run 183 s, and everything before the first mutant
#: (two statistics runs, the copy run, the children, three clean runs) about 27 minutes; the
#: mutants about 0.32 s each. At the runner's 2.2 times: the copy run about 400 s (C832's bound
#: is 850 s), the setup about 60 minutes, the plan's 1,301 mutants about 15 minutes: inside the
#: 120-minute budget with room. Uncapped, night #12's 97 functions never left the setup.
NIGHT_CAP = 20


#: The bound on the run that measures the child-starting tests' children (`_measure_children`):
#: 21 tests in 9 s on the laptop (the capped walk, 2026-10-15), about 20 s at the runner's 2.2
#: times, so about 2.5 times that. Past it, what did not finish is unmeasured and joins every
#: function: slower, never wrong.
CHILD_RUN_TIMEOUT_S = 60


def _measure_children(population, paths, functions, out) -> dict:
    """Run each test of *population* once, in the checkout, with coverage in every child of ours
    it starts (`M.child_rc`, through the spawn guard), and read which of *functions* each test's
    children ran (`M.child_reach`). Its output is kept in *out*/child-run.log, the children's
    data in *out*/child-coverage/. A run past its bound measures what finished; a test it did not
    reach is unmeasured, and joins every function."""
    data_dir = os.path.join(os.path.abspath(out), "child-coverage")
    tiers = os.path.join(os.path.abspath(out), "child-tiers")
    for d in (data_dir, tiers):
        os.makedirs(d, exist_ok=True)
    rc = os.path.join(os.path.abspath(out), "child-coverage.rc")
    with open(rc, "w", encoding="utf-8") as fh:
        fh.write(M.child_rc(paths, data_dir))
    env = dict(os.environ, NMAS_CHILD_COVERAGE=rc, NMAS_TEST_TIERS=tiers)
    # A measurement of its own: none of an outer run's coverage settings (the gate's and CI's
    # NMAS_COVERAGE_TIERS and COVERAGE_FILE measured nothing of the children: the canary's
    # child read as reaching nothing when the suite ran under them, 2026-10-15).
    for name in ("MUTANT_UNDER_TEST", "NMAS_COVERAGE_TIERS", "COVERAGE_FILE",
                 "COVERAGE_PROCESS_START"):
        env.pop(name, None)
    print(f"nmas-mutation: measuring the children of {len(population)} test(s)", flush=True)
    try:
        r = subprocess.run([sys.executable, "-m", "pytest", "-q", "-rfE", "-p", "no:cacheprovider",
                            "-n", "auto", *population], cwd=M.ROOT, env=env,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                           errors="replace", timeout=CHILD_RUN_TIMEOUT_S)
        text = r.stdout
    except subprocess.TimeoutExpired as e:
        partial = e.stdout or b""
        if isinstance(partial, bytes):
            partial = partial.decode("utf-8", "replace")
        text = partial + (f"\nnmas-mutation: the children's measurement passed its "
                          f"{CHILD_RUN_TIMEOUT_S} s bound")
    with open(os.path.join(out, "child-run.log"), "w", encoding="utf-8") as fh:
        fh.write(text)
    measured = M.read_child_data(data_dir, paths)
    return M.child_reach(functions, measured, M.load_tier_records(tiers), population,
                         failed=set(M.failing_tests(text)))


#: The bound on the refresh (`_refresh`): the whole suite, confined, per-test contexts over the
#: stale functions' modules. Measured on the laptop (2026-10-15, fcd1e4f6, 11,053 tests, 4
#: workers): 521 s over 7 modules, and 825 s over 1 in the planted walk while other suites
#: loaded the laptop; at the runner's 2.2 times, about 1,150 to 1,800 s. On the runner itself
#: the coverage nightly's four shards' test steps (the same suite per test, every module, with
#: branches) summed 1,988 s (run #2), 1,646 s (run #3) and 2,070 s (run #4, af2a439a): the
#: bound is about 2.5 times the largest. Past it the refresh measured nothing usable, and its
#: stale functions wait (defer). The workflow's job bound carries it.
REFRESH_TIMEOUT_S = 5200


def _refresh(stale: list, out: str, head: str, files=None) -> dict:
    """Refresh the coverage map for *stale* (`path::qualname`) tonight (M.STALE_REFRESH): the
    test *files* that reach their modules (M.refresh_scope, C1640), or the whole suite when
    *files* is None, once, through scripts/nmas-test (confined, as the coverage nightly), with
    the C tracer's per-test contexts measuring only their modules and each test's tier
    recorded. A
    run that passed whole is complete; one that ended with failing tests runs those once more
    alone, and is complete when that run ends (those failing again fail at head and can kill
    no mutant: named), else used in part (its stale functions' survivors labelled stale map);
    any other end (its bound, a crash, no data) measured nothing usable, and the stale
    functions wait. Returns `{"paths", "exit",
    "seconds", "failed", "rerun", "why", "reach": {"functions", "tiers", "complete"} or None}`;
    the runs' output is kept in *out*/refresh.log and refresh-rerun.log."""
    import time
    paths = M.stale_paths(stale)
    out = os.path.abspath(out)
    data = os.path.join(out, "refresh.coverage")
    tiers = os.path.join(out, "refresh-tiers")
    os.makedirs(tiers, exist_ok=True)
    env = dict(os.environ, COVERAGE_CORE="ctrace", COVERAGE_FILE=data, NMAS_TEST_TIERS=tiers,
               NMAS_TEST_TIMEOUT=str(REFRESH_TIMEOUT_S), PYTHON=sys.executable)
    # A measurement of its own (as `_measure_children`'s): none of an outer run's coverage or
    # mutmut settings.
    for name in ("MUTANT_UNDER_TEST", "NMAS_COVERAGE_TIERS", "COVERAGE_PROCESS_START",
                 "NMAS_CHILD_COVERAGE"):
        env.pop(name, None)
    # The per-test bound is the coverage nightly's, 450 s (C1616): under the C tracer a slow
    # setup passes pytest.ini's 120 s, and the dump inside an xdist worker takes it down.
    cmd = [os.path.join(M.ROOT, "scripts", "nmas-test"), "-q", "-rfE", "-p", "no:cacheprovider",
           "-n", "auto", "-o", "faulthandler_timeout=450",
           *[f"--cov={p[:-3].replace('/', '.')}" for p in paths],
           "--cov-report=", "--cov-context=test"]
    scope = "the whole suite" if files is None else f"{len(files)} test file(s)"
    print(f"nmas-mutation: refreshing the coverage map of {len(stale)} stale function(s) in "
          f"{len(paths)} module(s): {scope}, per test", flush=True)

    def run(args, log):
        try:
            r = subprocess.run(cmd[:1] + args, cwd=M.ROOT, env=env, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, errors="replace",
                               timeout=REFRESH_TIMEOUT_S + 60)
            text, code = r.stdout, r.returncode
        except subprocess.TimeoutExpired as e:
            partial = e.stdout or b""
            text = partial.decode("utf-8", "replace") if isinstance(partial, bytes) else partial
            code = None
        with open(os.path.join(out, log), "w", encoding="utf-8") as fh:
            fh.write(text)
        return text, code

    if files is not None and not files:
        # No test file reaches, imports or is near their modules: nothing to run (pytest given
        # no path would run the whole suite). Each is reached by none, a measurement, so its
        # mutants meet no test and survive: red, named.
        return {"paths": paths, "exit": 0, "seconds": 0, "failed": [], "rerun": [], "files": 0,
                "why": "no test file reaches their modules, so nothing ran",
                "reach": {"functions": {k: [] for k in sorted(stale)}, "tiers": {},
                          "complete": True}}
    start = time.monotonic()
    text, code = run(cmd[1:] + list(files or []), "refresh.log")
    res = {"paths": paths, "exit": code, "seconds": round(time.monotonic() - start),
           "failed": [], "rerun": [], "why": "", "reach": None,
           "files": None if files is None else len(files)}
    if code not in (0, 1) or not os.path.exists(data):
        res["why"] = (f"the refresh ended with exit {code} (0 passed, 1 tests failed; 124 or 137 "
                      f"its {REFRESH_TIMEOUT_S} s bound) and left "
                      + ("its data" if os.path.exists(data) else "no data")
                      + ", so it measured nothing usable")
        return res
    if code == 1:
        # A test that failed may have stopped before it reached a stale function. Each is run
        # once more, alone of the rest, its contexts added to the same data: one that passes
        # then (a test whose result depends on its neighbours: measured 2026-10-15, one of
        # 10,877 in the laptop's refresh, passing alone) is measured whole.
        failed = M.failing_tests(text)
        res["rerun"] = failed
        again, code2 = run(["-q", "-rfE", "-p", "no:cacheprovider", "--cov-append",
                            *cmd[cmd.index("-n") + 2:], *failed], "refresh-rerun.log") \
            if failed else ("", 1)
        res["seconds"] = round(time.monotonic() - start)
        if code2 == 1:
            # Failing again alone: it fails on the unmutated code, so it can kill no mutant (it
            # would fail mutmut's clean run, and be deselected there: C779). The reach stands.
            res["failed"] = M.failing_tests(again) or failed
            res["why"] = ("failing at head, alone too, so they can kill no mutant: "
                          + ", ".join(res["failed"]))
            code = 0
        elif code2 != 0:
            # Their reach is unknown: they may pass alone and reach a stale function.
            res["failed"] = failed
            res["why"] = (f"the run of its failing tests alone ended with exit {code2}, so their "
                          "reach is unknown: survivors labelled stale map")
            code = 1
        else:
            code = 0

    def read(path):
        return M.git("show", f"{head}:{path}", root=M.ROOT)
    res["reach"] = {"functions": M.refreshed_reach(data, stale, read),
                    "tiers": M.load_tier_records(tiers), "complete": code == 0}
    return res


def cmd_plan(a) -> int:
    state = {}
    if a.state and os.path.exists(a.state):
        with open(a.state, encoding="utf-8") as fh:
            state = json.load(fh)
    p = M.plan(state, a.head, also=a.also, debt=M.load_debt(), cap=a.cap)
    os.makedirs(a.out, exist_ok=True)
    files = sorted({path for path, _q in p["planned"]})
    sources = {}
    for f in glob.glob(os.path.join(M.ROOT, "tests", "test_*.py")):
        with open(f, encoding="utf-8") as fh:
            sources[os.path.relpath(f, M.ROOT)] = fh.read()
    # The night's tests by MEASURED reach where the coverage nightly measured the function at its
    # text tonight (C796, C834); where it did not, by tonight's own whole-suite refresh, or the
    # function waits (the operator, 2026-10-15: M.STALE_REFRESH, and why).
    reach = M.load_reach(a.reach) if a.reach else None
    fresh = M.reach_fresh(p["planned"], p["hashes"], reach, a.reach_commit or "", p["head"],
                          root=M.ROOT)
    map_info = {"run": a.reach_run or "", "commit": a.reach_commit or "",
                "date": a.reach_date or "", "unusable": fresh["unusable"]}
    refresh, refreshed = {}, None
    if fresh["stale"] and a.stale_map == M.STALE_REFRESH:
        # Scoped to the tests that reach the stale functions' modules, by the map's own module
        # index (C1640; run #41's whole-suite refresh took 3,207 s of its 80 minutes).
        scope = M.refresh_scope(fresh["stale"], reach, sources, fresh["changed_tests"],
                                fresh["changed_modules"], fresh["unusable"])
        refresh = _refresh(sorted(fresh["stale"]), a.out, p["head"], scope["files"])
        refresh["scope"] = scope["why"]
        refreshed = refresh.pop("reach", None)
        if refreshed is None:
            # It measured nothing usable: every stale function waits, and the run is red
            # (M.not_mutated, C1616).
            p["refresh_failed"] = sorted(fresh["stale"])
    chosen = M.choose_tests(p["planned"], sources, reach if not fresh["unusable"] else None,
                            fresh["fresh"], fresh["changed_tests"], refreshed)
    if chosen["deferred"]:
        why = (refresh.get("why") or "the refresh measured nothing of it") \
            if a.stale_map == M.STALE_REFRESH else "the stale-map rule is defer (--stale-map)"
        M.defer_stale(p, chosen["deferred"], why)
        files = sorted({path for path, _q in p["planned"]})
    whole = [t for t in chosen["tests"] if "::" not in t]
    ids = [t for t in chosen["tests"] if "::" in t]
    not_found = []
    if ids:
        collected = _collected(sorted({i.split("::")[0] for i in ids}))
        if collected is None:
            whole, ids = sorted(set(whole) | {i.split("::")[0] for i in ids}), []
        else:
            ids, not_found = M.valid_ids(ids, collected)
    tests = whole + ids
    p["tests"] = tests
    p["selection"] = {"reach_commit": a.reach_commit or "", "unusable": fresh["unusable"],
                      "map": map_info, "stale_rule": a.stale_map, "refresh": refresh,
                      "map_hashes": fresh["map_hashes"],
                      "how": chosen["how"], "stale": fresh["stale"],
                      "changed_tests": fresh["changed_tests"], "not_found": not_found,
                      "ids": sum(1 for t in tests if "::" in t),
                      "files": sum(1 for t in tests if "::" not in t)}
    names = M.patterns(p) if p["planned"] else []
    M.save(os.path.join(a.out, "plan.json"), p)
    with open(os.path.join(a.out, "patterns.txt"), "w", encoding="utf-8") as fh:
        fh.write("".join(n + "\n" for n in names))
    sel = p["selection"]
    print(f"base {p['base'][:9]}, head {p['head'][:9]}: {len(p['planned'])} function(s) in "
          f"{len(files)} module(s), {sel['files']} test file(s) whole and {sel['ids']} test(s) "
          f"by measured reach, {len(names)} mutmut name(s)")
    print("  " + M.map_line(map_info))
    if refresh:
        print(f"  refreshed: {refresh.get('scope', 'the whole suite')}, over "
              f"{len(refresh['paths'])} module(s), exit {refresh['exit']}, "
              f"{refresh['seconds']} s" + (f": {refresh['why']}" if refresh.get("why") else ""))
    short = M.not_mutated(p)
    for k, why in short:
        print(f"  NOT MUTATED {k}: {why} (the run is red)")
    for path, q in p["planned"]:
        k = M.key((path, q))
        why = (f"moved from {p['carried'][k]}, its text unchanged: the record's results carried, "
               f"{len(p['names'][k])} mutant(s) left or open"
               if k in p.get("carried", {}) else
               f"kept by the record: {len(p['names'][k])} mutant(s) left or open"
               if k in p["kept"] else
               f"moved from {p['moved'][k]}, its text unchanged: every mutant"
               if k in p.get("moved", {}) else "changed since the covered commit: every mutant")
        how = sel["how"].get(k, "deferred")
        print(f"  {path}: {q} ({why}; tests {how}"
              + (f": {sel['stale'][k]}" if k in sel["stale"] else "") + ")")
    for k in p.get("deferred") or {}:
        stale_why = (p.get("deferred_stale") or {}).get(k)
        print(f"  {k}: " + (f"stale map, not refreshed ({stale_why}): waits in the record until "
                            "a coverage map holds its text" if stale_why else
                            "capped: waits in the record for a later night"))
    for t in sel["not_found"]:
        print(f"  {t}: measured by the drill-down, not collected at head: not run")
    for k, was in sorted(p.get("skipped_moved", {}).items()):
        print(f"  {k}: moved from {was}, its text unchanged, finished or on the debt list "
              "before: not mutated again")
    for k in p["dropped"]:
        if k in p.get("carried", {}).values():
            continue
        print(f"  {k}: the record's results dropped (its text changed)")
    for k in p.get("gone", []):
        print(f"  {k}: gone at head: dropped from the record")
    for k in p.get("debt_not_rerun", []):
        print(f"  {k}: known debt at its listed text: not run again")
    if not p["planned"]:
        # Nothing to mutate: the debt is still reported, and its growth still turns the night
        # red; the record keeps what it knew (the finished functions' hashes).
        debt = M.load_debt()
        prev, now = p.get("previous_debt_entries"), M.debt_entries(debt, counted=True)
        grew = prev is not None and now > prev
        if a.summary:
            with open(a.summary, "a", encoding="utf-8") as fh:
                fh.write(M.summary(p["base"], p["head"], [], {}, [], 0,
                                   known=M.debt_entries(debt), map_info=map_info,
                                   waiting=len(p.get("deferred") or {})))
                fh.write("\n" + "\n".join(M.not_mutated_lines(short, 0)
                                            + M.selection_lines(p) + M.deferred_lines(p)
                                            + M.gone_lines(p) + M.not_rerun_lines(p)
                                            + M.debt_lines([], debt, prev))
                         + "\n")
                if grew:
                    fh.write(f"**The debt list grew** from {prev} to {now}: red this night.\n")
        if a.state:
            # The record keeps what waits (the next run of this label takes it first).
            M.save(a.state, M.next_state(p["head"], [], {}, [], {},
                                         finished_before=p.get("finished_before"),
                                         debt_count=now, deferred=p.get("deferred")))
        if short:
            print(f"FAILED: {len(short)} function(s) this run was to mutate were not mutated "
                  "(C1616): " + "; ".join(f"{k}: {why}" for k, why in short))
        return 1 if grew or short else 0
    sources_to_mutate = files + [M.CANARY_FILE]
    with open(os.path.join(M.ROOT, "setup.cfg"), "w", encoding="utf-8") as fh:
        fh.write("[mutmut]\nsource_paths =\n" + "".join(f"    {f}\n" for f in sources_to_mutate)
                 + "also_copy =\n" + "".join(f"    {c}\n" for c in ALSO_COPY)
                 # A list, one argument a line: one line "-p no:cacheprovider" reaches pytest
                 # as ONE argument (measured 2026-10-14, mutmut's debug output).
                 + "pytest_add_cli_args =\n    -p\n    no:cacheprovider\n"
                 + "pytest_add_cli_args_test_selection =\n"
                 + "".join(f"    {t}\n" for t in tests + [M.CANARY_TESTS]))
    if a.fence:
        # Only the planned functions reach mutmut: every other function and class of a planned
        # module is fenced off in place (M.fence). In place, so only in a checkout made for the
        # night (the workflow's); the record's hashes are read from git, never from these files.
        # Refused over a file with changes of its own, so what it rewrites is always in git.
        dirty = M.git("status", "--porcelain", "--", *files).strip()
        if dirty:
            print(f"nmas-mutation: --fence refused: these planned modules hold uncommitted "
                  f"changes, and fencing rewrites them in place:\n{dirty}", file=sys.stderr)
            return 2
        for path in files:
            planned_here = {q for p_, q in p["planned"] if p_ == path}
            with open(os.path.join(M.ROOT, path), encoding="utf-8") as fh:
                source = fh.read()
            fenced = M.fence(source, planned_here)
            with open(os.path.join(M.ROOT, path), "w", encoding="utf-8") as fh:
                fh.write(fenced)
            print(f"  fenced {path}: {fenced.count(M.FENCE)} function(s) and class(es) not "
                  f"mutated; {len(planned_here)} planned", flush=True)
    return 0


def cmd_run(a) -> int:
    with open(os.path.join(a.out, "plan.json"), encoding="utf-8") as fh:
        p = json.load(fh)
    tiers_dir = os.path.join(os.path.abspath(a.out), "tiers")
    os.makedirs(tiers_dir, exist_ok=True)
    # Tonight's results only: an earlier run's copy would read as tonight's.
    record = {"runs": [], "removed_an_earlier_copy": M.fresh_workspace()}

    def log_of(n):
        return os.path.join(a.out, f"mutmut-run-{n}.log")

    def next_log():
        return log_of(len(record["runs"]) + 1)

    def done(name, code):
        path = next_log()
        ran = os.path.exists(path)
        record["runs"].append({"run": name, "exit": code,
                               "log": os.path.basename(path) if ran else ""})
        if ran and code not in (M.FINISHED, M.OUT_OF_TIME):
            with open(path, encoding="utf-8") as fh:
                record["failure"] = M.failure_excerpt(fh.read())
        M.save(os.path.join(a.out, "run.json"), record)
        return code

    # 1. The canary in the test's process; mutmut collects its statistics here, and each test
    #    records its tier (tests/conftest.py).
    first = [M.mutant_pattern(*M.CANARY_IN_PROCESS)]
    tiers_env = dict(os.environ, NMAS_TEST_TIERS=tiers_dir)
    code = _mutmut_run(first, next_log(), env=tiers_env)
    if code not in (M.FINISHED, M.OUT_OF_TIME):
        # A test that fails in mutmut's copy with no mutant active cannot tell a mutant from the
        # original: it reads the program's source, which the copy rewrites (the second GitHub
        # night, C778's walk: 2 of 2,725, each a scan of a planned module's definitions). They
        # are measured each night, not listed, deselected, named, and the run is tried again.
        failing = _fails_in_the_copy(p, a.out)
        if failing:
            done("the canary, in process (tests that fail in mutmut's copy found)", code)
            record.pop("failure", None)
            record["not_run_fail_in_the_copy"] = failing
            cfg_path = os.path.join(M.ROOT, "setup.cfg")
            with open(cfg_path, encoding="utf-8") as fh:
                cfg = fh.read()
            with open(cfg_path, "w", encoding="utf-8") as fh:
                fh.write(M.with_deselected(cfg, failing))
            M.save(os.path.join(a.out, "run.json"), record)
            print(f"nmas-mutation: {len(failing)} test(s) fail in mutmut's copy itself and are "
                  f"not run tonight: {', '.join(failing)}", flush=True)
            code = _mutmut_run(first, next_log(), env=tiers_env)
    if done("the canary, in process", code):
        return code
    # 2. A child records nothing in mutmut's statistics, and the coverage nightly's contexts do
    #    not see it either (measured 2026-10-15): each test that started a child of ours is run
    #    once more with coverage in its children, and joins only the functions they ran (the
    #    canary's in-child function among them, which must still die); a test whose children
    #    could not all be measured joins every function, as before (C796).
    population = M.child_starting(M.load_tier_records(tiers_dir))
    planned_and_canary = [tuple(f) for f in p["planned"]] + [M.CANARY_IN_PROCESS,
                                                              M.CANARY_IN_CHILD]
    functions = {}
    for path, q in planned_and_canary:
        with open(os.path.join(M.ROOT, path), encoding="utf-8") as fh:
            functions[M.mangled(path, q)] = (path, M.body_lines(fh.read(), q))
    reach = (_measure_children(population, sorted({f[0] for f in planned_and_canary}),
                               functions, a.out) if population
             else {"by_function": {f: [] for f in functions}, "reached": {}, "unmeasured": []})
    with open(STATS, encoding="utf-8") as fh:
        stats = json.load(fh)
    record["spawning_tests"] = population
    record["children_reached"] = reach["reached"]
    record["children_unmeasured"] = reach["unmeasured"]
    record["associations_added"] = M.add_tests_by(stats, reach["by_function"])
    M.save(STATS, stats)
    M.save(os.path.join(a.out, "run.json"), record)
    print(f"nmas-mutation: {len(population)} test(s) start a child; "
          f"{len(reach['reached'])} measured, {len(reach['unmeasured'])} not (added to every "
          f"function); {record['associations_added']} test association(s) added", flush=True)
    code = _mutmut_run([M.mutant_pattern(*M.CANARY_IN_CHILD)], next_log())
    if done("the canary, in a child", code):
        return code
    # The canary must be dead before the night's mutants mean anything.
    broken = M.canary_error(M.parse_results(_mutmut("results", "--all", "true")))
    if broken:
        print(f"nmas-mutation: {broken}", flush=True)
        return done("the canary's verdict", M.CANARY_BROKEN)
    # 3. The night: every planned mutant classified from mutmut's own copy of its module
    #    (logging, MESSAGE or VERDICT); a logging call's are never run, the rest by name.
    kinds = {}
    for path in sorted({f[0] for f in p["planned"]}):
        with open(os.path.join(M.ROOT, "mutants", path), encoding="utf-8") as fh:
            mutated = fh.read()
        with open(os.path.join(M.ROOT, path), encoding="utf-8") as fh:
            source = fh.read()
        module = path[:-3].replace("/", ".")
        kinds.update({f"{module}.{n}": k for n, k in M.classify_file(mutated, source).items()})
    record["kinds"] = kinds
    tonight = []
    for f in p["planned"]:
        k = M.key(tuple(f))
        mine = (p["names"][k] if k in p["names"]
                else sorted(m for m in kinds if M.function_of(m) == M.dotted(tuple(f))))
        tonight += [m for m in mine if kinds.get(m) != "logging"]
    record["logging_not_run"] = sorted(m for m, k in kinds.items() if k == "logging"
                                       and M.function_of(m) in {M.dotted(tuple(f))
                                                                for f in p["planned"]})
    print(f"nmas-mutation: {len(tonight)} mutant(s) tonight; "
          f"{len(record['logging_not_run'])} in logging calls not run", flush=True)
    return (done("the night", _mutmut_run(tonight, next_log())) if tonight
            else done("the night", 0))


def cmd_report(a) -> int:
    with open(a.plan, encoding="utf-8") as fh:
        p = json.load(fh)
    planned = [tuple(f) for f in p["planned"]]
    run_path = os.path.join(os.path.dirname(a.plan), "run.json")
    ran_record = {}
    if os.path.exists(run_path):
        with open(run_path, encoding="utf-8") as fh:
            ran_record = json.load(fh)
    kinds = ran_record.get("kinds") or {}
    everything = M.parse_results(_mutmut("results", "--all", "true")) if planned else {}
    canary = [M.CANARY_IN_PROCESS, M.CANARY_IN_CHILD]
    # A logging call's mutants are never run, so never counted, never "not checked".
    everything = {m: s for m, s in everything.items() if kinds.get(m) != "logging"}
    tonight = M.only_functions(everything, planned)
    results = {}
    for f in planned:
        kept = (p["kept"].get(M.key(f)) or {}).get("results", {})
        kept = {m: s for m, s in kept.items() if kinds.get(m) != "logging"}
        results.update(M.merge(kept, M.only_functions(tonight, [f])))
    exit_ = M.FINISHED if a.mutmut_exit == M.CANARY_BROKEN else a.mutmut_exit
    out = M.outcome(planned, results, exit_)
    # mutmut failing is the cause when it did; otherwise the canary, then the scope.
    error = out["error"] or M.canary_error(everything) or M.scope_error(everything,
                                                                       planned + canary)
    if error:
        results = {}
    shows = {m: _mutmut("show", m) for m, s in results.items() if s in M.SURVIVING}
    eq_mod = M._load("mutation_equivalent", os.path.join(M.ROOT, "tests",
                                                          "mutation_equivalent.py"))
    debt = M.load_debt()
    hash_of_function = {M.dotted(f): p["hashes"].get(M.key(f), "") for f in planned}
    # A function whose tests tonight were not chosen by a measurement of its text tonight (a
    # plan without a selection is one from before measured reach: by import): its survivors
    # are labelled stale map (the operator, 2026-10-15).
    how = (p.get("selection") or {}).get("how") or {}
    stale = {M.dotted(f) for f in planned if how.get(M.key(f)) not in M.FRESH_SELECTION}
    v = M.verdict(results, shows, eq_mod.EQUIVALENT, kinds, debt, hash_of_function,
                  M.load_sweep(), stale=stale)
    prev_debt, debt_now = p.get("previous_debt_entries"), M.debt_entries(debt, counted=True)
    debt_grew = prev_debt is not None and debt_now > prev_debt
    ran = sum(1 for m, s in tonight.items() if s != "not checked")
    # C1616: what this run was to mutate and did not (said first; the run red).
    short = [] if error else M.not_mutated(p, out, results)
    extra = [] if error else M.not_mutated_lines(short, len(planned)) + [
        f"Canary: all {len(M.only_functions(everything, canary))} of its mutants killed, in the "
        "test's process and through a child (the measurement works).", "",
        f"Scope: {ran} mutant(s) ran tonight, all of the planned functions; "
        f"{len(p['kept'])} function(s) carried in by the record; "
        f"{len(ran_record.get('logging_not_run') or [])} in logging calls never mutated.", ""]
    not_run = ran_record.get("not_run_fail_in_the_copy") or []
    if not_run:
        # Said whether or not the night's results stand: a test it could not use is never silent.
        extra += [f"Not run tonight ({len(not_run)}): they fail in mutmut's copy itself, with no "
                  "mutant active, so cannot tell a mutant from the original (each reads the "
                  "program's source, which the copy rewrites):", "",
                  *[f"- `{t}`" for t in not_run], ""]
    if not error:
        # The debt, every night, never hidden (the operator, 2026-10-14).
        extra += M.debt_lines(v["debt"], debt, prev_debt)
        if debt_grew:
            extra += [f"**The debt list grew** from {prev_debt} to {debt_now} since the last "
                      "night: red this night; an addition is a person's, made on purpose "
                      "(`nmas-mutation debt add --reason …`), and seen once.", ""]
    extra += M.selection_lines(p, ran_record) + M.deferred_lines(p)
    extra += M.gone_lines(p) + M.not_rerun_lines(p)
    carried, skipped = p.get("carried") or {}, p.get("skipped_moved") or {}
    if carried or skipped:
        extra += [f"Moved, their text unchanged, known from an earlier night ({len(carried)} "
                  f"carried, {len(skipped)} not mutated again):", ""]
        extra += [f"- `{k}` from `{old}`: its results carried; only what was left or open ran"
                  for k, old in sorted(carried.items())]
        extra += [f"- `{k}` from `{old}`: finished, or on the debt list, before: not mutated"
                  for k, old in sorted(skipped.items())]
        extra += [""]
    with open(a.summary, "a", encoding="utf-8") as fh:
        fh.write(M.summary(p["base"], p["head"], planned, v, out["left"], a.budget, error,
                           out["empty"], extra,
                           cause=ran_record.get("failure") or [] if out["error"] else [],
                           moved=p.get("moved"), known=M.debt_entries(debt),
                           map_info=(p.get("selection") or {}).get("map")))
    M.save(os.path.join(os.path.dirname(a.plan), "report.json"),
           {"plan": p, "mutmut_exit": a.mutmut_exit, "error": error, "results": results,
            "verdict": v, **{k: out[k] for k in ("done", "left", "empty")}})
    if error:
        print(f"FAILED: {error}")
        return 1
    # Every open kind stays in the record and runs again each night (a test that kills a debt
    # survivor is seen); only a VERDICT survivor off the debt list, or the list grown, fails it.
    M.save(a.state_out, M.next_state(p["head"], planned, results,
                                     [s["mutant"] for s in v["new"] + v["message"] + v["debt"]
                                      + v["sweep"]],
                                     p["hashes"], finished_before=p.get("finished_before"),
                                     debt_count=debt_now, deferred=p.get("deferred"),
                                     since=p.get("since"),
                                     stale_open=[s["mutant"] for s in v["new"] + v["message"]
                                                 if s.get("stale_map")]))
    for s in v["new"]:
        print(f"OPEN VERDICT SURVIVOR {s['mutant']}"
              + (" (stale map)" if s.get("stale_map") else "") + f": {s['was']} -> {s['now']}")
    for s in v["message"]:
        print(f"open message survivor {s['mutant']}: {s['was']} -> {s['now']}")
    print(f"known debt: {len(v['debt'])} met tonight; the list holds {debt_now}"
          + (f" (grew from {prev_debt})" if debt_grew else ""))
    for k, why in short:
        print(f"NOT MUTATED {k}: {why}")
    return 1 if v["new"] or debt_grew or short else 0


DEBT_ABOUT = ("Known open VERDICT survivors (scripts/nmas_mutation.py, 'The debt'): a night "
              "is red on a survivor not listed here, or when this list grows. Added to only by "
              "`nmas-mutation debt add --from-report <report.json> --reason ...`, never by a "
              "night; a killed survivor's entry is removed. Each function keeps its path, "
              "qualname and text hash (a move is followed by the hash).")


def cmd_debt(a) -> int:
    """`debt add`: the night's NEW open VERDICT survivors in *a.from_report* (a night's
    report.json) onto the list, each with the reason given; the hash of each function is its
    text at that night's head."""
    with open(a.from_report, encoding="utf-8") as fh:
        report = json.load(fh)
    if report.get("error"):
        print(f"nmas-mutation: refused: that night failed ({report['error']}), so no result "
              "of it stands", file=sys.stderr)
        return 2
    head = report["plan"]["head"]

    def hash_of(path, qualname):
        return M.function_hash(M.git("show", f"{head}:{path}"), qualname)

    debt = M.load_debt(a.file)
    # The sweep's reason adds only what the night found finishing the baseline sweep (the
    # operator's approval, 2026-10-14, for that sweep alone); any other reason, only NEW ones.
    which = "sweep" if (a.reason or "").strip() == M.SWEEP_REASON else "new"
    try:
        added = M.add_to_debt(debt, report["verdict"].get(which, []), a.reason, hash_of)
    except ValueError as e:
        print(f"nmas-mutation: refused: {e}", file=sys.stderr)
        return 2
    M.save(a.file, {"about": DEBT_ABOUT, "functions": debt["functions"]})
    print(f"nmas-mutation: {added} survivor(s) added; the debt list holds "
          f"{M.debt_entries(debt)} in {len(debt['functions'])} function(s)")
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="nmas-mutation", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("plan")
    p.add_argument("--state")
    p.add_argument("--head", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--summary")
    p.add_argument("--fence", action="store_true",
                   help="fence every unplanned function of each planned module off from mutmut, "
                        "IN PLACE: only in a checkout made for the night")
    p.add_argument("--also", action="append", default=[], metavar="PATH::QUALNAME",
                   help="a function to mutate whole tonight, changed or not")
    p.add_argument("--reach", metavar="DIR",
                   help="the coverage nightly's drill-down, unpacked (coverage.json, tiers/): "
                        "each function's tests by measured reach")
    p.add_argument("--reach-commit", metavar="SHA",
                   help="the commit the drill-down measured")
    p.add_argument("--reach-run", metavar="ID", help="the coverage nightly's run it came from")
    p.add_argument("--reach-date", metavar="WHEN", help="when that run was made")
    p.add_argument("--stale-map", choices=[M.STALE_REFRESH, M.STALE_DEFER],
                   default=M.STALE_REFRESH,
                   help="a function the map does not hold at its text tonight: refresh the map "
                        "for it tonight (the whole suite, per test; the default) or defer it")
    p.add_argument("--cap", type=int, default=NIGHT_CAP,
                   help=f"at most this many functions tonight, the oldest first (default "
                        f"{NIGHT_CAP})")
    r = sub.add_parser("run")
    r.add_argument("--out", required=True)
    s = sub.add_parser("report")
    s.add_argument("--plan", required=True)
    s.add_argument("--summary", required=True)
    s.add_argument("--state-out", required=True)
    s.add_argument("--budget", type=int, default=120)
    s.add_argument("--mutmut-exit", type=int, required=True)
    d = sub.add_parser("debt", help="the known-survivor list (tests/mutation_debt.json)")
    d.add_argument("action", choices=["add"])
    d.add_argument("--from-report", required=True, help="a night's report.json")
    d.add_argument("--reason", required=True, help="why these are accepted as known debt")
    d.add_argument("--file", default=M.DEBT_FILE)
    a = ap.parse_args(argv)
    return {"plan": cmd_plan, "run": cmd_run, "report": cmd_report,
            "debt": cmd_debt}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
