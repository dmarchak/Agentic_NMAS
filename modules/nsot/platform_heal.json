        {"object": "key-chain", "words": "a key chain",
         "defines": ["^key chain (?P<name>\\S+)$"],
         "uses": ["\\bkey-chain (?:eigrp \\d+ )?(?P<names>\\S+)$"]},
        {"object": "track", "words": "a track",
         "defines": ["^track (?P<name>\\d+) "],
         "uses": ["\\btrack (?P<names>\\d+)\\b"]},
        {"object": "ip-sla", "words": "an IP SLA operation",
         "defines": ["^ip sla (?P<name>\\d+)$", "^ip sla schedule (?P<name>\\d+)\\b"],
         "uses": ["^track \\d+ ip sla (?P<names>\\d+)\\b"]}
      ]
    },
    "cisco_iosxe": {"same_as": "cisco_ios"}
  }
