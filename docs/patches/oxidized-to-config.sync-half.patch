 # ---------------------------------------------------------------------------
-# Back up, copy, commit
+# Back up, copy, commit - PER LAB
 # ---------------------------------------------------------------------------
 ts=$(date +%Y%m%d-%H%M%S)
-ssh "$CLAB" "cp -r '$REMOTE_DIR' '${REMOTE_DIR}.bak-${ts}' 2>/dev/null; \
-             cp $STAGE/*.cfg '$REMOTE_DIR/' && rm -rf $STAGE" || {
-  echo "Copy failed - staged files left at ${CLAB}:${STAGE}"; exit 1; }
-
-echo "Copied. Backup at ${REMOTE_DIR}.bak-${ts}"
-
-ssh "$CLAB" "cd \$(dirname '$REMOTE_DIR') && \
-  git rev-parse --git-dir >/dev/null 2>&1 && \
