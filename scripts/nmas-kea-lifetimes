#!/usr/bin/env python3
"""E19's lease lifetimes (`modules/dhcp_lifetimes.py`), the app's side of the one-time host step
`scripts/host-steps/e19-dhcp-lifetimes.sh`. Run as the app's user; Kea's main configuration is
root's, so the host step installs the candidates this writes.

    nmas-kea-lifetimes plan                 # each family's change
    nmas-kea-lifetimes candidates           # write the classes files and the candidates; test
    nmas-kea-lifetimes reload               # config-reload, both families
    nmas-kea-lifetimes verify               # Kea runs the lifetimes, both families, and every
                                            # client of the management (ZTP) subnet takes a class's
    nmas-kea-lifetimes expected <a> <b>     # two snapshots (nmas-kea-subnet-files snapshot):
                                            # only the lifetimes, timers and classes moved

The candidates are `<Kea's folder>/nmas/.lifetimes-candidate-dhcp{4,6}.conf` (Kea's AppArmor
profile lets it read under /etc/kea only), tested by `kea-dhcp4 -t` and `kea-dhcp6 -t`; the
classes files they include, `nmas/classes4.json` and `classes6.json`, are written first (Kea
reads them only once the installed main file includes them).
Exit 0 done or as expected, 1 refused, failed or different, 2 Kea could not be asked.
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

SVC ={"IPv4": ("dhcp4", "kea-dhcp4"), "IPv6": ("dhcp6", "kea-dhcp6")}
#: The keys the step may move in Kea's running configuration: the global ones it sets or
#: removes, those Kea derives from them, and the classes (checked by name below).
MOVES = {"valid-lifetime", "preferred-lifetime", "renew-timer", "rebind-timer",
         "calculate-tee-times", "t1-percent", "t2-percent", "min-valid-lifetime",
         "max-valid-lifetime", "min-preferred-lifetime", "max-preferred-lifetime"}


def candidate_path(main: str, family: str) -> str:
    return os.path.join(os.path.dirname(main), "nmas", f".lifetimes-candidate-{SVC[family][0]}.conf")


def expected(a: dict, b: dict, ztp_id) -> list:
    """What moved between two snapshots besides the lifetimes, the timers and the reserved
    class, in words; [] when only those did."""
    from modules import dhcp_lifetimes as L

    moved = []
    for family in sorted(set(a) | set(b)):
        x, y = a.get(family) or {}, b.get(family) or {}
        cx, cy = x.get("config") or {}, y.get("config") or {}
        key_sub = L.SUBNET_KEYS[family]
        for key in sorted(set(cx) | set(cy)):
            if cx.get(key) == cy.get(key) or key in MOVES:
                continue
            if key == "client-classes":
                before = [c for c in cx.get(key) or [] if c.get("name") != L.RESERVED]
                after = [c for c in cy.get(key) or [] if c.get("name") != L.RESERVED]
                if before != after:
                    moved.append(f"{family}: a client class other than {L.RESERVED} moved")
                continue
            if key == key_sub:
                sx = {s.get("id"): s for s in cx.get(key) or []}
                sy = {s.get("id"): s for s in cy.get(key) or []}
                if set(sx) != set(sy):
                    moved.append(f"{family}: the subnets are {sorted(sy)} after, {sorted(sx)} "
                                 "before")
                for i in sorted(set(sx) & set(sy)):
                    rest = [{k: v for k, v in s[i].items() if k not in MOVES} for s in (sx, sy)]
                    if rest[0] != rest[1]:
                        moved.append(f"{family}: subnet {i} moved beyond its lifetimes and timers")
                continue
            moved.append(f"{family}: Kea's configuration key {key!r} differs")
        for what in ("reservations", "leases"):
            if (x.get(what) or []) != (y.get(what) or []):
                moved.append(f"{family}: the {what} differ")
    return moved


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("what", choices=("plan", "candidates", "reload", "verify", "expected"))
    ap.add_argument("args", nargs="*")
    args = ap.parse_args(argv)

    from modules import dhcp_discovery as Disc
    from modules import dhcp_lifetimes as L
    from modules import dhcp_reservations as D
    from modules import dhcp_subnets as S
    from modules.integrations.kea import KeaIntegration
    from modules.list_settings import DEFAULT_LIST
    from modules.nsot import ztp

    kea = KeaIntegration()
    if not kea.is_configured():
        print("Kea is not configured for the Default network (its Kea card in Settings)")
        return 2
    if args.what == "reload":
        bad = 0
        for family, (svc, _prog) in SVC.items():
            got = kea.command("config-reload", [svc])
            print(f"{svc}: config-reload "
                  f"{'ok' if got.get('ok') else 'FAILED: ' + str(got.get('error'))}")
            bad += not got.get("ok")
        return 1 if bad else 0
    try:
        configs = {family: D.kea_config(kea, family) for family in SVC}
        seg = Disc.segment(configs["IPv4"])
    except D.Refused as exc:
        print(f"Kea could not be asked: {exc}")
        return 2
    except Disc.Refused as exc:
        print(f"REFUSED: the management (ZTP) subnet: {exc}")
        return 1
    if args.what == "expected":
        if len(args.args) != 2:
            print("expected takes two snapshot files")
            return 1
        snaps = []
        for path in args.args:
            with open(path, encoding="utf-8") as fh:
                snaps.append(json.load(fh))
        moved = expected(*snaps, seg["id"])
        print("\n".join(moved) if moved else
              f"AS EXPECTED: only the global lifetimes and timers, the class {L.RESERVED} and "
              "the subnets' lifetimes moved; every other setting, subnet, reservation and "
              "lease, both families, as before")
        return 1 if moved else 0
    if args.what == "verify":
        bad = 0
        for family in SVC:
            r = L.running(configs[family], family)
            print(f"{family}: Kea runs the lifetimes: {r['state']}"
                  + (f"; {'; '.join(r['missing'])}" if r["missing"] else ""))
            bad += r["state"] != "on"
        sub = next((s for s in configs["IPv4"].get("subnet4") or [] if s.get("id") == seg["id"]),
                   {})
        free = [p.get("pool", "") for p in sub.get("pools") or [] if not p.get("client-class")]
        print(f"the management (ZTP) subnet {seg['id']} ({seg['prefix']}): "
              + ("every client takes a class's lifetime: a reserved device "
                 f"{L.RESERVED}'s 7 days, an unreserved one discovery's 300 s"
                 if not free else
                 f"REFUSED: pool(s) {', '.join(free)} serve any client at the subnet's own "
                 "lifetime"))
        return 1 if bad or free else 0
    plans = {}
    for family in SVC:
        main_ = D.main_config(DEFAULT_LIST, family)
        with open(main_, encoding="utf-8") as fh:
            plans[family] = (main_, L.plan(fh.read(), main_, family))
    if args.what in ("plan", "candidates"):
        refused = 0
        for family, (main_, p) in plans.items():
            print(f"{family} ({main_}): {p['state']}" + (f": {p['refused']}" if p["refused"] else ""))
            for c in p["changes"]:
                print(f"  {c}")
            refused += p["state"] == "refused"
        if refused:
            return 1
    if args.what == "plan":
        print(f"the management (ZTP) subnet {seg['id']} ({seg['prefix']}): unchanged; its "
              f"reserved devices take {L.RESERVED}'s 7 days, its unreserved ones discovery's "
              "300 s")
        return 0
    if args.what == "candidates":
        bad = 0
        for family, (main_, p) in plans.items():
            if p["state"] == "done":
                print(f"{family}: nothing to change")
                continue
            ztp._replace(p["classes_file"], S.dump(p["classes"]))               # noqa: SLF001
            cand = candidate_path(main_, family)
            if os.path.exists(cand):
                os.remove(cand)
            ztp._write_file(cand, p["candidate"])                               # noqa: SLF001
            ok, detail = ztp._run_kea_test(cand, SVC[family][1])                # noqa: SLF001
            print(f"{family}: wrote {p['classes_file']}; candidate {cand}: "
                  f"{SVC[family][1]} -t {'PASS' if ok else 'FAIL'}: {detail}")
            bad += not ok
        return 1 if bad else 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
