 #   Options:
 #     ./oxidized-to-config.sh --no-deploy    convert and diff only
 #     ./oxidized-to-config.sh --yes          skip the prompt (for cron)
 #     CLAB=user@host ./oxidized-to-config.sh
-#     REMOTE_DIR=~/labs/lab/configs ./oxidized-to-config.sh
+#     NMAS_URL=http://10.0.0.211:5000 ./oxidized-to-config.sh
+#
+# WHERE THE DEVICE LIST COMES FROM
+#   The NMAS, once, via `nmas-clab-targets`. It used to be four hardcoded
+#   loops over `r1 r2 r3 r4 r5 s1 s2 s3 s4`, a `ROUTERS` string and a `NODE`
+#   array - six places encoding the same population, all current when they
+#   were written. r6 was in none of them, so it would have been sanitised as
+#   a switch (wrong rules, silently) if it had been reached at all.
+#
+#   If the NMAS cannot be asked, this STOPS. It does not fall back to a
+#   default directory: a guess about where a config boots from writes one
+#   device's credentials into another lab.
 # ---------------------------------------------------------------------------
 set -uo pipefail
 
 REPO="${REPO:-/opt/oxidized/rcn-lab.git}"
 OUT="${OUT:-configs}"
 REF="${REF:-HEAD}"
 CLAB="${CLAB:-dmarchak@10.0.0.210}"
-REMOTE_DIR="${REMOTE_DIR:-labs/lab/configs}"
 STAGE="/tmp/oxidized-staged"
+NMAS_URL="${NMAS_URL:-http://10.0.0.211:5000}"
+TARGETS="${TARGETS:-nmas-clab-targets}"
 
 DEPLOY=ask
 for a in "$@"; do
@@
-# device -> the filename Oxidized stores it under (see router.db)
-declare -A NODE=(
-  [r1]=10.255.1.11 [r2]=10.255.1.12 [r3]=10.255.1.13
-  [r4]=10.255.1.14 [r5]=10.255.1.15
-  [s1]=10.255.1.21 [s2]=10.255.1.22 [s3]=10.255.1.23 [s4]=10.255.1.24
-)
-ROUTERS="r1 r2 r3 r4 r5"
+# ---------------------------------------------------------------------------
+# The map, fetched ONCE. Replaces NODE, ROUTERS and all four device loops.
+# ---------------------------------------------------------------------------
+declare -A NODE CFGDIR PLATFORM LAB
+DEVICES=()
+
+map="$("$TARGETS" --url "$NMAS_URL")" || {
+  echo "REFUSED - the NMAS could not be asked where configs belong."
+  echo "Not falling back to a default directory."
+  exit 2
+}
+
+while IFS=$'\t' read -r n cfgdir lab clabhost platform oxnode; do
+  [ -n "${n:-}" ] || continue
+  # A row the NMAS could not complete is a device nobody should write.
+  if [ -z "${cfgdir:-}" ] || [ -z "${platform:-}" ] || [ -z "${oxnode:-}" ]; then
+    echo "REFUSED $n: incomplete map row (configs_dir='${cfgdir:-}' platform='${platform:-}' oxidized_node='${oxnode:-}')"
+    exit 2
+  fi
+  DEVICES+=("$n")
+  NODE[$n]="$oxnode"
+  CFGDIR[$n]="$cfgdir"
+  PLATFORM[$n]="$platform"
+  LAB[$n]="$lab"
+  [ -n "${clabhost:-}" ] && CLAB="$clabhost"
+done <<<"$map"
+
+[ ${#DEVICES[@]} -gt 0 ] || { echo "REFUSED - the map is empty."; exit 2; }
+
+# The config DIALECT decides the sanitising rules, not the hostname.
+# `*)` refuses: a default here picks a device kind for exactly the devices
+# nobody thought about, which is what `ROUTERS` did.
+kind_for() {
+  case "$1" in
+    cisco_iosxe) echo router ;;
+    cisco_ios)   echo switch ;;
+    *) echo "REFUSED - no sanitising rules for platform '$1'" >&2; return 1 ;;
+  esac
+}
 
 GIT=(git -C "$REPO")
 sudo -n true 2>/dev/null && GIT=(sudo git -C "$REPO")
@@
-for n in r1 r2 r3 r4 r5 s1 s2 s3 s4; do
-  case " $ROUTERS " in *" $n "*) kind=router ;; *) kind=switch ;; esac
+for n in "${DEVICES[@]}"; do
+  kind="$(kind_for "${PLATFORM[$n]}")" || { echo "$n: ${PLATFORM[$n]}"; fail=1; continue; }
   printf '%-4s ' "$n"
@@
 echo "All files converted and validated."
 
+# Every mapped device accounted for, before anything is copied. A device
