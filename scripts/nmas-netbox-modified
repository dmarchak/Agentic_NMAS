#!/usr/bin/env python3
"""What NMAS has MODIFIED in NetBox — and a way to sanitise the record.

An update is the one NetBox write that carries no provenance: the
`nmas-managed` tag means *"NMAS created this"* and is injected on POST only,
so a PATCH leaves nothing behind. `data/netbox_modified.json` is that missing
record, and this reads it.

`--sanitise` exists because the first version of the recorder capped strings
and not **structures**, so `local_context_data` — a dict holding a device's
whole running config — went in whole: 113,767 bytes from one sync of ten
devices, carrying a `secret 9` hash and a `username … password 0` line. The
writer is fixed; this is what makes what is already on disk safe, without
throwing away the findings it holds.

    python3 scripts/nmas-netbox-modified
    python3 scripts/nmas-netbox-modified --sanitise

Names, sizes and hashes only. It never prints a recorded value.
"""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)


def _human(n: int) -> str:
    return f"{n/1024:.1f} KB" if n >= 1024 else f"{n} B"


def _report(entries: list) -> None:
    for e in entries:
        fields = e.get("fields") or {}
        if e.get("before_unknown"):
            detail = "before-state unreadable"
        else:
            parts = []
            for name, pair in fields.items():
                b, a = pair.get("before"), pair.get("after")
                if isinstance(b, dict) and b.get("summarised"):
                    parts.append(f"{name}: {_human(b['bytes'])} → "
                                 f"{_human((a or {}).get('bytes', 0))} "
                                 f"(sha {b['sha256']} → "
                                 f"{(a or {}).get('sha256', '?')})")
                else:
                    parts.append(f"{name}: {b} → {a}")
            detail = "; ".join(parts)
        print(f"  {e['at']}  {e['endpoint']}/{e['id']} {e.get('name') or ''} "
              f"[{e.get('actor')}]")
        print(f"      {detail}")


APP_LOG = os.path.join("logs", "device_manager.log")
GUARD_LOGGER = " modules.netbox_guard: "


def _app_log_summary(root: str) -> str:
    """Count the recorder's ERROR lines in the app log, with a denominator.

    Zero failures is only a finding if lines were read: a missing log (the
    app runs with debug on, or from elsewhere) is UNPROVEN, never clean —
    and the line count and newest write are printed so a log that stopped
    being written is visible beside the zero.
    """
    base = os.path.join(root, APP_LOG)
    files = [p for p in [base] + [f"{base}.{i}" for i in range(1, 11)]
             if os.path.isfile(p)]
    if not files:
        return (f"UNPROVEN — no app log at {base}; that is not the same as "
                "no failures")
    lines = errors = 0
    last_error = ""
    for path in files:
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    lines += 1
                    if GUARD_LOGGER in line and " ERROR " in line:
                        errors += 1
                        last_error = last_error or line.strip()[:200]
        except OSError as exc:
            return f"UNPROVEN — could not read {path}: {exc}"
    from datetime import datetime, timezone
    newest = datetime.fromtimestamp(os.path.getmtime(base) if os.path.isfile(
        base) else 0, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    head = (f"{errors} recorder ERROR line(s) in the app log "
            f"({lines} line(s) read from {len(files)} file(s), "
            f"newest written {newest})")
    return head + (f"\n    most recent: {last_error}" if errors else "")


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--sanitise", action="store_true",
                    help="rewrite the record through today's summarisation "
                         "and masking, in place")
    ap.add_argument("--list", dest="list_name", default="",
                    help="only this device list")
    args = ap.parse_args()

    from modules.netbox_guard import (_MODIFIED_FILE, modified_since,
                                      sanitise_modified)

    if args.sanitise:
        got = sanitise_modified()
        if not got["ok"]:
            print(f"UNPROVEN — {got['reason']}")
            print("Nothing was rewritten. That is not the same as nothing "
                  "needing it.")
            return 2
        if not got["entries"]:
            print("no record to sanitise — nothing has been written to "
                  f"{_MODIFIED_FILE}")
            return 0
        print(f"{got['rewritten']} of {got['entries']} entr(ies) rewritten")
        print(f"{_human(got['bytes_before'])} → {_human(got['bytes_after'])}")
        print(f"mode {got.get('mode') or 'unknown'}"
              + ("  (owner-only)" if got.get("mode") == "0o600" else
                 "  ⚠ NOT owner-only"))
        if got["rewritten"]:
            print("\nWhat was removed was the CONTENT of oversized fields. "
                  "Each is now recorded as changed, its size, and a hash of "
                  "each side — which is the finding. The bytes were not.")
        else:
            print("\nNothing needed rewriting — every value was already "
                  "within the cap.")
        return 0

    got = modified_since(list_name=args.list_name)
    if not got["ok"]:
        print(f"UNKNOWN — the record could not be read: {got['reason']}")
        print("That is weaker than 'nothing was modified', not equal to it.")
        return 2
    if not got["exists"]:
        print(f"NO RECORD EXISTS — nothing has been written to {_MODIFIED_FILE}.")
        print("On an install that has run an import, read that as 'unknown' "
              "rather than 'none'.")
        return 0

    h = got.get("health") or {}
    # HEALTH IS PER-PROCESS, AND THE RECORDER RUNS IN THE APP.
    #
    # `health()` counts in memory, and this script is a different process
    # from the Flask app that does the recording — so a zero here says
    # nothing whatever about what the app experienced. Printing it without
    # that sentence would be the reassuring-zero failure one level up: the
    # very check built to stop "silence" meaning two things, itself silent
    # about whose silence it is reporting.
    #
    # The cross-process channel is the app log, which `_write_json_atomic`
    # and `record_modified` write at ERROR — and it is READ here, not named.
    # This line used to print `journalctl -u nmas … | grep netbox_guard`,
    # and the deployment host has no `nmas` unit: journalctl answers
    # "-- No entries --", which is exactly what "no failures" looks like.
    # The file below is what app.py's root handler actually writes.
    print("health below is THIS process only — the recorder runs inside the "
          "app, so its failures are in the app log:")
    print("    " + _app_log_summary(ROOT))
    print()
    if h.get("writes") or h.get("unreadable"):
        print(f"⚠ THE RECORDER HAS FAILED since this process started: "
              f"{h.get('writes', 0)} write(s) failed, "
              f"{h.get('unreadable', 0)} refused because the existing record "
              f"could not be read.")
        print(f"  last error: {h.get('last_error')}")
        print("  So the count below is a FLOOR, not a total. In-process only "
              "— a restart clears it.")
        print()

    print(f"{got['count']} modification(s) recorded"
          + (f", {got['unknown_before']} with an unreadable before-state"
             if got["unknown_before"] else ""))
    _report(got["entries"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
