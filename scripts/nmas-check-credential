#!/usr/bin/env python3
"""Can a given credential log in to a device? Three answers, never two.

Written after stage D2, where a redeploy-checklist line passed for the wrong
reason:

    sshpass -p 'admin' ssh ... && echo "FAIL: old credential works" \\
                               || echo "PASS: admin refused"

The connection failed at **key exchange** -- a modern OpenSSH against a 2018
vIOS image -- so `ssh` exited non-zero and the check printed PASS. It would
have printed PASS with the device powered off, and it would have printed PASS
on the redeploy's item 5 while every router sat on `admin/admin` and
unreachable, which is the exact hazard the whole stage exists to detect.

**A two-valued check on a remote system is a check that can pass by not
asking.** Exit status conflates "the device refused us" with "we never
reached the device", and those have opposite consequences.

Two corrections, and the second matters more:

1. Three outcomes -- ACCEPTED, REFUSED, INCONCLUSIVE -- from
   `credential_rotation.verify_new_credential()`, which already separates a
   device verdict from a local or transport fault and was built for this
   exact mistake on the rotation path.

2. It connects the way **NMAS** does, through `connection_params()` and
   Netmiko/Paramiko, not through the shell's `ssh`. The claim being checked is
   "NMAS can log in to this device", and the shell's client negotiates
   differently -- which is what produced the false PASS. Testing the property
   rather than a nearby proxy.

    python3 scripts/nmas-check-credential r1 --expect accepted
    python3 scripts/nmas-check-credential r1 --password admin --expect refused

Exit codes: 0 the expectation held, 1 it did not, 2 INCONCLUSIVE (nothing was
established either way).
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

ACCEPTED, REFUSED, INCONCLUSIVE = "ACCEPTED", "REFUSED", "INCONCLUSIVE"


def check(list_name: str, hostname: str, password: str = "") -> dict:
    """Ask the device. Returns one of three verdicts, with the reason."""
    from modules.device import decrypt_field, load_saved_devices
    from modules.nsot import credential_rotation as cr
    from modules.nsot.listref import resolve

    ref = resolve(list_name)
    row = next((d for d in load_saved_devices(ref.csv_path)
                if d.get("hostname") == hostname), None)
    if row is None:
        return {"verdict": INCONCLUSIVE,
                "reason": f"{hostname!r} is not in list {ref.name!r}"}

    # No password given: check the one NMAS holds, which is the question the
    # redeploy checklist is actually asking.
    plaintext = password or decrypt_field(row.get("password", ""))
    if not plaintext:
        return {"verdict": INCONCLUSIVE,
                "reason": f"no stored credential for {hostname}"}

    result = cr.verify_new_credential(row, row.get("username", "admin"),
                                      plaintext, secret=cr.enable_secret(row))
    if result.get("ok"):
        return {"verdict": ACCEPTED, "reason": "authenticated",
                "stage": result.get("stage", "")}

    # `attempted` is the whole point: it separates "the device answered and
    # said no" from "we never got far enough to be told anything".
    if result.get("attempted"):
        return {"verdict": REFUSED,
                "reason": result.get("error", "refused"),
                "error_type": result.get("error_type", ""),
                "stage": result.get("stage", "")}
    return {"verdict": INCONCLUSIVE,
            "reason": result.get("error", "could not reach the device"),
            "error_type": result.get("error_type", ""),
            "stage": result.get("stage", "")}


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("device")
    parser.add_argument("--list", dest="list_name", default="")
    parser.add_argument("--password", default="",
                        help="check THIS value instead of the stored one")
    parser.add_argument("--expect", choices=["accepted", "refused"], default="",
                        help="exit 1 unless the verdict matches")
    args = parser.parse_args()

    from modules.config import get_current_list_name

    out = check(args.list_name or get_current_list_name(), args.device,
                args.password)
    verdict = out["verdict"]
    which = "the supplied value" if args.password else "the credential NMAS holds"

    print(f"{args.device:<10} {verdict:<12} {which}")
    print(f"           {out['reason']}")
    if out.get("stage"):
        print(f"           failed at: {out['stage']}")

    if verdict == INCONCLUSIVE:
        print("\n  Nothing was established. This is NOT a refusal -- the device\n"
              "  was never in a position to refuse. Treat it as unknown and\n"
              "  find out why before reading anything into it.")
        return 2
    if not args.expect:
        return 0
    if verdict.lower() == args.expect:
        return 0
    print(f"\n  EXPECTED {args.expect.upper()}, GOT {verdict}.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
