{# Shared macros. Every emitted line comes from a structured host_vars field —
   never from a stored copy of the original line, which would make the round
   trip pass while modelling nothing. #}

{#- ── The routing feature packs (K7, C764; docs/FEATURE_PACKS.md) ─────────────────────────
    OSPFv2, OSPFv3, RIPv2 and RIPng, rendered from STRUCTURED intent. Shared by both Cisco
    dialects (each `<platform>/base.j2` imports this file, the loader looking in the dialect's
    directory first); a dialect that prints a line differently overrides here.

    Every field has been completed by `modules.nsot.features.prepare` (the render calls it, as
    it calls `complete_schema`): numbers arrive as strings, an absent field as its empty value,
    so `{% if x %}` emits nothing for a field nobody set.

    Each body macro emits the lines BELOW a block's header, one leading space each, in the
    order IOS and IOS-XE print them where a capture shows it. The unmodelled lines (`settings`,
    `networks` and `raw`, the shape intent had before the packs) are emitted by `routing` after
    these, so an intent holding only those renders exactly as it did. The parser models a line
    only when the macro here reproduces it exactly (`features.reproduces`); any other line
    stays unmodelled, verbatim. -#}

{%- macro redistribute(r) -%}
redistribute {{ r.protocol }}{% if r.process %} {{ r.process }}{% endif %}{% if r.metric %} metric {{ r.metric }}{% endif %}{% if r.metric_type %} metric-type {{ r.metric_type }}{% endif %}{% if r.subnets %} subnets{% endif %}{% if r.tag %} tag {{ r.tag }}{% endif %}{% if r.include_connected %} include-connected{% endif %}{% if r.route_map %} route-map {{ r.route_map }}{% endif %}
{%- endmacro -%}

{%- macro _area_lines(a, family) -%}
{% if a.type in ('stub', 'nssa') %} area {{ a.id }} {{ a.type }}{% if a.no_summary %} no-summary{% endif %}

{% endif %}
{%- if a.default_cost %} area {{ a.id }} default-cost {{ a.default_cost }}
{% endif %}
{%- for r in a.ranges %} area {{ a.id }} range {% if family == 'ipv4' %}{{ r.address }} {{ r.mask }}{% else %}{{ r.prefix }}{% endif %}{% if not r.advertise %} not-advertise{% endif %}{% if r.cost %} cost {{ r.cost }}{% endif %}

{% endfor %}
{%- endmacro -%}

{%- macro _passive(p) -%}
{% if p.passive_default %} passive-interface default
{% endif %}
{%- for n in p.no_passive_interfaces %} no passive-interface {{ n }}
{% endfor %}
{%- for n in p.passive_interfaces %} passive-interface {{ n }}
{% endfor %}
{%- endmacro -%}

{%- macro _default_information(d) -%}
{% if d.originate %} default-information originate{% if d.always %} always{% endif %}{% if d.metric %} metric {{ d.metric }}{% endif %}{% if d.metric_type %} metric-type {{ d.metric_type }}{% endif %}{% if d.route_map %} route-map {{ d.route_map }}{% endif %}

{% endif %}
{%- endmacro -%}

{%- macro _process_head(o) -%}
{% if o.router_id %} router-id {{ o.router_id }}
{% endif %}
{%- if o.log_adjacency_changes is sameas true %} log-adjacency-changes
{% elif o.log_adjacency_changes == 'detail' %} log-adjacency-changes detail
{% elif o.log_adjacency_changes is sameas false %} no log-adjacency-changes
{% endif %}
{%- if o.reference_bandwidth %} auto-cost reference-bandwidth {{ o.reference_bandwidth }}
{% endif %}
{%- endmacro -%}

{#- `router ospf <process>`: router-id, logging, auto-cost, the areas' own lines, redistribution,
    passive interfaces, the network statements area by area, the default route, distance. -#}
{%- macro ospf_body(o) -%}
{{ _process_head(o) }}
{%- for a in o.areas %}{{ _area_lines(a, 'ipv4') }}{% endfor %}
{%- for r in o.redistribute %} {{ redistribute(r) }}
{% endfor %}
{{- _passive(o) }}
{%- for a in o.areas %}{% for n in a.networks %} network {{ n.address }} {{ n.wildcard }} area {{ a.id }}
{% endfor %}{% endfor %}
{{- _default_information(o.default_information) }}
{%- if o.distance %} distance {{ o.distance }}
{% endif %}
{%- endmacro -%}

{#- `ipv6 router ospf <process>`: as OSPFv2 without network statements (an interface joins an
    area with `ipv6 ospf <process> area <area>`); IOS-XE prints the default route before
    redistribution here. -#}
{%- macro ospfv3_body(o) -%}
{{ _process_head(o) }}
{%- for a in o.areas %}{{ _area_lines(a, 'ipv6') }}{% endfor %}
{{- _default_information(o.default_information) }}
{%- for r in o.redistribute %} {{ redistribute(r) }}
{% endfor %}
{{- _passive(o) }}
{%- if o.distance %} distance {{ o.distance }}
{% endif %}
{%- endmacro -%}

{#- `router rip`: version, timers, redistribution, passive interfaces, the classful networks,
    the default route, distance, summarisation. Subscripts for the timers, not attributes:
    `.update` would be the mapping's own method. -#}
{%- macro rip_body(r) -%}
{% if r.version %} version {{ r.version }}
{% endif %}
{%- if r.timers['update'] %} timers basic {{ r.timers['update'] }} {{ r.timers['invalid'] }} {{ r.timers['holddown'] }} {{ r.timers['flush'] }}
{% endif %}
{%- for x in r.redistribute %} {{ redistribute(x) }}
{% endfor %}
{%- if r.default_metric %} default-metric {{ r.default_metric }}
{% endif %}
{{- _passive(r) }}
{%- for n in r.classful_networks %} network {{ n }}
{% endfor %}
{%- if r.default_information.originate %} default-information originate{% if r.default_information.route_map %} route-map {{ r.default_information.route_map }}{% endif %}

{% endif %}
{%- if r.distance %} distance {{ r.distance }}
{% endif %}
{%- if r.auto_summary is sameas true %} auto-summary
{% elif r.auto_summary is sameas false %} no auto-summary
{% endif %}
{%- endmacro -%}

{#- `ipv6 router rip <name>`: redistribution. -#}
{%- macro ripng_body(r) -%}
{% for x in r.redistribute %} {{ redistribute(x) }}
{% endfor %}
{%- endmacro -%}

{#- An interface's own OSPF lines; *prefix* is `ip ospf` (OSPFv2) or `ipv6 ospf` (OSPFv3). -#}
{%- macro ospf_interface(x, prefix) -%}
{% if x.network_type %} {{ prefix }} network {{ x.network_type }}
{% endif %}
{%- if x.hello_interval %} {{ prefix }} hello-interval {{ x.hello_interval }}
{% endif %}
{%- if x.dead_interval %} {{ prefix }} dead-interval {{ x.dead_interval }}
{% endif %}
{%- if x.priority %} {{ prefix }} priority {{ x.priority }}
{% endif %}
{%- if x.process %} {{ prefix }} {{ x.process }} area {{ x.area }}
{% endif %}
{%- if x.cost %} {{ prefix }} cost {{ x.cost }}
{% endif %}
{%- endmacro -%}

{#- An interface's RIPng lines, one entry per RIPng process it takes part in. -#}
{%- macro ripng_interface(entries) -%}
{% for e in entries %}{% if e.enable %} ipv6 rip {{ e.name }} enable
{% endif %}
{%- if e.default_information %} ipv6 rip {{ e.name }} default-information {{ e.default_information }}
{% endif %}
{%- endfor %}
{%- endmacro -%}
{#- ── end of the routing feature packs ───────────────────────────────────────────────── -#}


{%- macro globals(v) -%}
{% for s in v.services %}{{ s }}
{% endfor %}
{%- if v.hostname %}hostname {{ v.hostname }}
{% endif %}
{%- if v.domain_name %}ip domain{{ ' name ' if v.platform == 'cisco_iosxe' else '-name ' }}{{ v.domain_name }}
{% endif %}
{%- for key, on in (v.flags or {}).items() %}{{ '' if on else 'no ' }}{{ key }}
{% endfor %}
{%- if v.vtp_mode %}vtp mode {{ v.vtp_mode }}
{% endif %}
{%- for line in v.vtp or [] %}{{ line }}
{% endfor %}
{%- if v.fhrp_version_vrrp %}fhrp version vrrp {{ v.fhrp_version_vrrp }}
{% endif %}
{%- for line in (v.spanning_tree or {}).get('lines', []) %}{{ line }}
{% endfor %}
{%- for x in v.login or [] %}login {{ x }}
{% endfor %}
{%- for x in v.subscriber or [] %}subscriber {{ x }}
{% endfor %}
{%- for x in v.multilink or [] %}multilink {{ x }}
{% endfor %}
{%- for x in v.diagnostic or [] %}diagnostic {{ x }}
{% endfor %}
{%- for x in v.memory or [] %}memory {{ x }}
{% endfor %}
{%- if v.redundancy is not none %}redundancy
{% for s in v.redundancy.settings %} {{ s }}
{% endfor %}
{%- endif %}
{%- for line in v.platform_settings or [] %}{{ line }}
{% endfor %}
{%- for line in v.license_settings or [] %}{{ line }}
{% endfor %}
{%- endmacro -%}

{%- macro users(v) -%}
{% for u in v.users %}username {{ u.name }}{% if u.privilege is defined %} privilege {{ u.privilege }}{% endif %}{% if u.secret_ref %} {{ u.secret_kind }} {{ secret(u.secret_ref) }}{% endif %}

{% endfor %}
{%- if v.enable_secret_ref %}enable {{ v.enable_secret_keyword }} {{ secret(v.enable_secret_ref) }}
{% endif %}
{%- endmacro -%}

{%- macro vlans(v) -%}
{% for vl in v.vlans %}vlan {{ vl.id }}
{% if vl.name %} name {{ vl.name }}
{% endif %}
{%- for e in vl.extra or [] %} {{ e }}
{% endfor %}
{%- endfor %}
{%- endmacro -%}

{%- macro tracks(v) -%}
{% for t in v.tracks %}track {{ t.id }} {{ t.spec }}
{% endfor %}
{%- endmacro -%}

{%- macro interface(i) -%}
interface {{ i.name }}
{% if i.description %} description {{ i.description }}
{% endif %}
{%- if i.no_switchport %} no switchport
{% endif %}
{%- if i.switchport_mode %} switchport mode {{ i.switchport_mode }}
{% endif %}
{%- if i.switchport_access_vlan %} switchport access vlan {{ i.switchport_access_vlan }}
{% endif %}
{%- for x in i.switchport_trunk_vlans or [] %} switchport trunk allowed vlan {{ x }}
{% endfor %}
{%- if i.switchport_trunk_encapsulation %} switchport trunk encapsulation {{ i.switchport_trunk_encapsulation }}
{% endif %}
{%- for x in i.switchport or [] %} switchport {{ x }}
{% endfor %}
{%- if i.vrf %} vrf forwarding {{ i.vrf }}
{% endif %}
{%- if i.ipv4 %} ip address {{ i.ipv4 }}
{% endif %}
{%- for h in i.helper_addresses or [] %} ip helper-address {{ h }}
{% endfor %}
{%- for x in i.ip_nat or [] %} ip nat {{ x }}
{% endfor %}
{{- ospf_interface(i.ospf_interface, 'ip ospf') }}
{%- for x in i.ospf or [] %} ip ospf {{ x }}
{% endfor %}
{%- if i.mtu %} mtu {{ i.mtu }}
{% endif %}
{%- if i.negotiation %} negotiation {{ i.negotiation }}
{% endif %}
{%- if i.encapsulation %} encapsulation {{ i.encapsulation }}
{% endif %}
{%- if i.channel_group %} channel-group {{ i.channel_group }}
{% endif %}
{%- for a in i.ipv6 or [] %} ipv6 address {{ a }}
{% endfor %}
{%- if i.ipv6_enable %} ipv6 enable
{% endif %}
{%- for x in i.ipv6_nd or [] %} ipv6 nd {{ x }}
{% endfor %}
{{- ospf_interface(i.ospfv3_interface, 'ipv6 ospf') }}
{%- for x in i.ospfv3 or [] %} ipv6 ospf {{ x }}
{% endfor %}
{{- ripng_interface(i.ripng_interface) }}
{%- for x in i.ripng or [] %} ipv6 rip {{ x }}
{% endfor %}
{%- for x in i.dhcpv6_relay or [] %} ipv6 dhcp relay destination {{ x }}
{% endfor %}
{%- if i.no_ip_address %} no ip address
{% endif %}
{%- for x in i.vrrp or [] %} vrrp {{ x }}
{% endfor %}
{%- for g in i.vrrp_groups or [] %} vrrp {{ g.group }} address-family {{ g.family }}
{% for s in g.settings %}  {{ s }}
{% endfor %}
{%- if g.terminator %}  {{ g.terminator }}
{% endif %}
{%- endfor %}
{%- for x in i.mop or [] %} {{ x }}
{% endfor %}
{%- if i.shutdown %} shutdown
{% endif %}
{%- if i.no_shutdown %} no shutdown
{% endif %}
{%- for line in i.unmodeled or [] %} {{ line | resolve_secrets }}
{% endfor %}
{%- endmacro -%}

{#- Each routing block: its feature pack's structured lines (`_routing.j2`), then the lines no
    pack models, as intent held them before the packs. -#}
{%- macro routing(v) -%}
{% for o in (v.routing or {}).get('ospf', []) %}router ospf {{ o.process }}
{{ ospf_body(o) }}{% for s in o.settings %} {{ s }}
{% endfor %}
{%- for n in o.networks %} {{ n }}
{% endfor %}
{%- endfor %}
{%- if (v.routing or {}).rip %}router rip
{{ rip_body(v.routing.rip) }}{% for s in v.routing.rip.settings %} {{ s }}
{% endfor %}
{%- for n in v.routing.rip.networks %} {{ n }}
{% endfor %}
{%- endif %}
{%- if (v.routing or {}).bgp %}router bgp {{ v.routing.bgp.asn }}
{% for s in v.routing.bgp.settings %} {{ s }}
{% endfor %}
{%- for n in v.routing.bgp.neighbors %} {{ n }}
{% endfor %}
{%- for n in v.routing.bgp.networks %} {{ n }}
{% endfor %}
{%- for af in v.routing.bgp.address_families or [] %} !
 address-family {{ af.afi }}
{% for n in af.networks %}  {{ n }}
{% endfor %}
{%- for n in af.neighbors %}  {{ n }}
{% endfor %}
{%- for s in af.settings %}  {{ s }}
{% endfor %} exit-address-family
{% endfor %}
{%- endif %}
{%- for o in (v.routing or {}).get('ospfv3', []) %}ipv6 router ospf {{ o.process }}
{{ ospfv3_body(o) }}{% for s in o.raw %} {{ s }}
{% endfor %}
{%- endfor %}
{%- for r in (v.routing or {}).get('ripng', []) %}ipv6 router rip {{ r.name }}
{{ ripng_body(r) }}{% for s in r.raw %} {{ s }}
{% endfor %}
{%- endfor %}
{%- endmacro -%}

{%- macro services_block(v) -%}
{% for s in v.ssh or [] %}ip ssh {{ s }}
{% endfor %}
{%- set si = v.source_interfaces or {} %}
{%- if si.get('ssh') %}ip ssh source-interface {{ si.get('ssh') }}
{% endif %}
{%- if si.get('tftp') %}ip tftp source-interface {{ si.get('tftp') }}
{% endif %}
{%- for key, on in (v.http or {}).items() %}{{ '' if on else 'no ' }}ip http {{ key.replace('_', '-') }}
{% endfor %}
{%- for f in v.forward_protocol or [] %}ip forward-protocol {{ f }}
{% endfor %}
{%- for line in v.mgcp or [] %}{{ line }}
{% endfor %}
{%- if v.control_plane is not none %}control-plane
{% for s in v.control_plane.settings %} {{ s }}
{% endfor %}
{%- endif %}
{%- endmacro -%}

{%- macro management(v) -%}
{% if v.logging.console is defined %}{{ '' if v.logging.console else 'no ' }}logging console
{% endif %}
{%- for s in (v.logging or {}).get('settings', []) %}logging {{ s }}
{% endfor %}
{%- for h in (v.logging or {}).get('hosts', []) %}logging host {{ h }}
{% endfor %}
{%- set sl = (v.logging or {}).get('syslog') %}
{%- if sl %}{% if sl.trap %}logging trap {{ sl.trap }}
{% endif %}{% if sl.origin_id %}logging origin-id {{ sl.origin_id }}
{% endif %}{% if sl.source_interface %}logging source-interface {{ sl.source_interface }}
{% endif %}{% for h in sl.hosts %}logging host {{ h }}
{% endfor %}{% if sl.heartbeat %}event manager applet NMAS-HEARTBEAT
 event timer watchdog time {{ sl.heartbeat }}
 action 1.0 syslog priority notifications msg "NMAS-HEARTBEAT"
{% endif %}{% endif %}
{%- for c in (v.snmp or {}).get('communities', []) %}snmp-server community {{ secret(c.ref) }} {{ c.access }}
{% endfor %}
{%- for s in (v.snmp or {}).get('settings', []) %}{{ ('snmp-server ' ~ s if not s.startswith('snmp ') else s) | resolve_secrets }}
{% endfor %}
{%- for h in (v.snmp or {}).get('hosts', []) %}snmp-server host {{ h.address }} {{ h.options | resolve_secrets }}
{% endfor %}
{%- for n in v.ntp_servers %}ntp server {{ n }}
{% endfor %}
{%- endmacro -%}

{%- macro nat_and_prefix_lists(v) -%}
{% for x in v.ip_nat or [] %}ip nat {{ x }}
{% endfor %}
{%- for pl in v.prefix_lists or [] %}
{%- for e in pl.entries %}ip prefix-list {{ pl.name }} {{ e }}
{% endfor %}
{%- endfor %}
{%- endmacro -%}

{%- macro ip_sla(v) -%}
{% for s in v.ip_sla or [] %}ip sla {{ s.id }}
{% for line in s.settings %}{{ line }}
{% endfor %}
{%- endfor %}
{%- for s in v.ip_sla_schedules or [] %}ip sla schedule {{ s }}
{% endfor %}
{%- endmacro -%}

{%- macro call_home(v) -%}
{% if v.call_home is not none %}call-home
{% for line in v.call_home.body %}{{ line }}
{% endfor %}
{%- endif %}
{%- endmacro -%}

{%- macro routes_and_acls(v) -%}
{% for r in v.static_routes %}{{ 'ip' if r.family == 'ipv4' else 'ipv6' }} route {{ r.spec }}
{% endfor %}
{%- for a in v.acls %}ip access-list {{ a.type }} {{ a.name }}
{% for e in a.entries %} {{ e }}
{% endfor %}
{%- endfor %}
{%- endmacro -%}

{%- macro lines_block(v) -%}
{% for l in v.lines %}line {{ l.spec }}
{% for s in l.settings %} {{ s }}
{% endfor %}
{%- endfor %}
{%- endmacro -%}

{%- macro unmodeled_block(v) -%}
{% for u in v.unmodeled %}{{ u.line | resolve_secrets }}
{% for c in u.children %}{{ c | resolve_secrets }}
{% endfor %}
{%- endfor %}
{%- endmacro -%}
