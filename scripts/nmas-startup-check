#!/usr/bin/env python3
"""Does every device's STARTUP config carry the credential NMAS holds?

Register C53, as a job (deploy/systemd/nmas-startup-check.timer, hourly).
READ-ONLY: two show commands per device, never a save. Writes
data/startup_check.json, which job health reads; prints each device's state,
and each credential line's FORM, never its value.

    python3 scripts/nmas-startup-check

Exit codes: 0 every device carries it; 1 at least one does not (a reload
would lock NMAS out of it); 2 none fails but at least one could not be asked.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def main(argv=None) -> int:
    from modules.nsot.startup_check import run_check

    out = run_check()
    for d in out["devices"]:
        print(f"{d['list']:<10} {d['device']:<10} {d['state'].upper():<14} {d['detail']}")
    counts = out["counts"]
    print("\n" + ", ".join(f"{k}: {v}" for k, v in sorted(counts.items())))
    if counts.get("not_persisted"):
        return 1
    return 2 if counts.get("unknown") else 0


if __name__ == "__main__":
    sys.exit(main())
