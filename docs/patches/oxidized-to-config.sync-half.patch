-      out="$(ssh "$CLAB" "diff -u '$REMOTE_DIR/${n}.cfg' '$STAGE/${n}.cfg' 2>/dev/null" || true)"
+    for n in "${DEVICES[@]}"; do
+      out="$(ssh "$CLAB" "diff -u '${CFGDIR[$n]}/${n}.cfg' '$STAGE/${n}.cfg' 2>/dev/null" || true)"
       [ -n "$out" ] && { echo; echo "########## $n ##########"; echo "$out"; }
     done | ${PAGER:-less -R}
   fi
 
   echo
-  echo "This will overwrite $REMOTE_DIR on $CLAB."
+  echo "This will overwrite these directories on $CLAB:"
