#!/usr/bin/env python3
"""Grafana alert rules for the syslog heartbeat: one per device, each with a
window MEASURED from that device's own heartbeats.

NSOT_PLAN.md **P.1**, OPEN_FINDINGS **C16**. Every device's EEM applet emits
``NMAS-HEARTBEAT`` every ``syslog_heartbeat_seconds`` BY ITS OWN CLOCK, and
the clocks do not agree with the wall: measured 2026-09-25, the four vIOS
switches run at 0.94, 0.94, 0.75 and 0.55-0.61 of real time (s3's rate
varies), the C8000v routers at 1.00. A window per platform was wrong for
three of four switches -- too wide for s1/s2 (a double miss would never
fire), too narrow for s3 (one miss could). "vIOS runs at 75%" was s4
generalised to a platform.

**The window is per device, from its own arrivals.** The rule must stay quiet
on ONE missed heartbeat (a gap up to 2 x the longest real interval) and fire
on TWO (at least 3 x the shortest). The window is the midpoint of that band,
``(2*longest + 3*shortest) / 2``, and every rule's labels say how it was
derived:

* ``window_basis: measured`` -- from this device's own heartbeats in Loki
  (the rule's own anchored query), gaps over 1.8 x the median excluded so a
  real miss in the history cannot widen the window meant to catch the next;
* ``window_basis: provisional`` -- fewer than MIN_GAPS gaps (a new device):
  2.5 intervals at the SLOWEST rate measured anywhere in the fleet. **Derived
  from an assumption, not a measurement of this device**, and the rule's own
  label and description say so. A new device gets a rule, never silence;
* ``window_basis: inseparable`` -- the device's own band is empty
  (2 x longest >= 3 x shortest): no window separates one miss from two. It
  gets one just above 2 x longest (never a false alarm on one miss) and the
  label says a double miss may go unseen.

**A rate that moves is a named state, not a silently wrong window.**
``--check`` re-measures every device and compares with the generated rules file (made on the host, never committed):
``stale_rate`` (the band moved off the window), ``provisional_ready`` (it can
be measured now), ``inseparable``, and the population in both directions.
Run on a timer (deploy/systemd/nmas-heartbeat-check.*) and declared in
``modules/job_health.py``, so the check stopping is itself visible.

**Keyed on the device's own name** (``logging origin-id hostname``,
``\\s<host>:\\s``), never rsyslog's hostname field (C13). **NoData is
Alerting**: a silent device yields no series. **The population is committed
intent carrying a complete syslog block**; NetBox devices without one are
named "not expected to heartbeat".

    nmas-heartbeat-rules --datasource-uid <uid> --loki-url <url>   # write
    nmas-heartbeat-rules --check --loki-url <url>   # 0 current, 1 not, 2 unproven

**An empty population is refused, never written**: a file with no rules
reads like a fleet that is all heartbeating.
"""

import argparse
import math
import os
import re
import statistics
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

EXIT_OK, EXIT_STALE, EXIT_UNPROVEN = 0, 1, 2

OUT = os.path.join(ROOT, "deploy", "grafana", "provisioning", "alerting",
                   "nmas-heartbeat.yaml")
GROUP = "nmas-heartbeat"
FOLDER = "NMAS"
JOB = "network_syslog"
MARKER = "NMAS-HEARTBEAT"
#: The heartbeat line ITSELF: the applet's `action syslog`, which IOS writes
#: as `%HA_EM-<sev>-LOG: <applet>: <message>`, both NMAS-HEARTBEAT.
#: A bare substring match on the marker also counted any line that merely
#: NAMES the applet. Measured 2026-09-25: silencing s4 by removing the
#: applet's timer logged `%HA_EM-4-FMPD_NO_EVENT: No event configured for
#: applet NMAS-HEARTBEAT`, which was counted as a heartbeat. That made a 73 s
#: gap and marked s4 INSEPARABLE. The alert rules use the same query, so a
#: device whose applet BROKE logged a line that read as a sign of life: the
#: unsafe direction. Over 6 h of the whole fleet, those were the only two
#: shapes naming the applet. The severity digit is left free, so changing
#: the applet's priority cannot silently stop every match.
HEARTBEAT_LINE = r"%HA_EM-\d-LOG: " + re.escape(MARKER) + ": " + re.escape(MARKER)
#: A gap during which the device was reconfigured is not a measurement of its
#: interval: re-entering the applet restarts its timer, so the gap can fall
#: anywhere between one and two intervals. That is under the long-gap cut,
#: and it widens the band until one miss and two overlap. So every
#: maintenance window would otherwise leave INSEPARABLE behind it.
CONFIG_EVENT = r"%SYS-5-CONFIG_I:"
_NAME = re.compile(r"^[A-Za-z][A-Za-z0-9._-]*$")

#: Fewer consecutive gaps than this and a device is PROVISIONAL.
MIN_GAPS = 6
#: A gap over this multiple of the median is a miss in the history, not the
#: device's interval, and is excluded from the band.
OUTLIER_FACTOR = 1.8
LOOKBACK_HOURS = 6
#: Provisional window: this many intervals at the fleet's slowest rate.
PROVISIONAL_INTERVALS = 2.5
#: Used for the provisional rate only when NO device has been measured.
#: An assumption, named as one in every rule it produces.
PROVISIONAL_RATE_FLOOR = 0.5
BASES = ("measured", "provisional", "inseparable")


def host_pattern(hostname: str) -> str:
    """The RE2 fragment matching this device's hostname field, anchored so a
    prefix of another name never matches (``r1`` against ``r10``)."""
    return r"\s" + re.escape(hostname) + r":\s"


def query_for(hostname: str) -> str:
    # The substring filter first is only for Loki's cost; the anchored
    # regex is the match.
    return (f'{{job="{JOB}"}} |= "{MARKER}" |~ `{HEARTBEAT_LINE}` '
            f'|~ `{host_pattern(hostname)}`')


def config_query_for(hostname: str) -> str:
    return (f'{{job="{JOB}"}} |~ `{CONFIG_EVENT}` |~ `{host_pattern(hostname)}`')


# ---------------------------------------------------------------------------
# The measurement
# ---------------------------------------------------------------------------

def gaps_from(arrivals: list, config_events=()) -> list:
    """Consecutive arrival gaps, with misses in the history excluded, and
    every gap spanning one of the device's own configuration changes."""
    times = sorted(arrivals)
    events = sorted(config_events)
    pairs = [(a, b) for a, b in zip(times, times[1:])
             if not any(a < e <= b for e in events)]
    raw = [b - a for a, b in pairs]
    if not raw:
        return []
    median = statistics.median(raw)
    return [g for g in raw if g <= OUTLIER_FACTOR * median]


def measure(gaps: list, interval: int) -> dict:
    """The window for one device from its own gaps; provisional windows are
    filled in by :func:`windows`, which knows the fleet."""
    if len(gaps) < MIN_GAPS:
        return {"basis": "provisional", "n": len(gaps)}
    lo, hi = min(gaps), max(gaps)
    rate = interval / statistics.median(gaps)
    if 2 * hi < 3 * lo:
        return {"basis": "measured", "window": math.ceil((2 * hi + 3 * lo) / 2),
                "lo": round(lo, 1), "hi": round(hi, 1), "n": len(gaps),
                "rate": round(rate, 3)}
    return {"basis": "inseparable", "window": math.ceil(2 * hi * 1.05),
            "lo": round(lo, 1), "hi": round(hi, 1), "n": len(gaps),
            "rate": round(rate, 3)}


def windows(gaps_by_host: dict, interval: int) -> dict:
    """``{host: measure(...)}`` with every provisional window filled from the
    SLOWEST rate measured anywhere in the fleet (or the named floor)."""
    out = {h: measure(g, interval) for h, g in gaps_by_host.items()}
    rates = [m["rate"] for m in out.values() if "rate" in m]
    slowest = min(rates) if rates else PROVISIONAL_RATE_FLOOR
    for m in out.values():
        if m["basis"] == "provisional":
            m["window"] = math.ceil(PROVISIONAL_INTERVALS * interval / slowest)
            m["assumed_rate"] = round(slowest, 3)
            m["rate_source"] = ("the slowest rate measured in the fleet"
                                if rates else "PROVISIONAL_RATE_FLOOR "
                                "(no device measured yet)")
    return out


def loki_arrivals(loki_url: str, hostname: str,
                  hours: int = LOOKBACK_HOURS, query: str = "") -> list:
    """Arrival times (Loki's timestamps, the ones the rule counts)."""
    import requests

    now = time.time()
    r = requests.get(loki_url.rstrip("/") + "/loki/api/v1/query_range",
                     params={"query": query or query_for(hostname), "limit": 5000,
                             "start": int((now - hours * 3600) * 1e9),
                             "end": int(now * 1e9), "direction": "forward"},
                     timeout=30)
    r.raise_for_status()
    out = []
    for stream in r.json().get("data", {}).get("result", []):
        out.extend(int(ts) / 1e9 for ts, _line in stream.get("values", []))
    return out


# ---------------------------------------------------------------------------
# The rules
# ---------------------------------------------------------------------------

def rule_for(hostname: str, datasource_uid: str, heartbeat: int,
             info: dict) -> dict:
    if not _NAME.match(hostname):
        raise ValueError(f"{hostname!r} is not a usable device name")
    if info.get("basis") not in BASES or not info.get("window"):
        raise ValueError(f"{hostname}: no window ({info})")
    window = int(info["window"])
    expr = f"sum(count_over_time({query_for(hostname)} [{window}s]))"
    basis = info["basis"]
    if basis == "measured":
        how = (f"measured from this device's own {info['n']} heartbeat gaps "
               f"({info['lo']}-{info['hi']} s; clock rate {info['rate']})")
    elif basis == "provisional":
        how = (f"PROVISIONAL: derived from an ASSUMPTION, not a measurement of "
               f"this device ({info['n']} gap(s) so far) -- {PROVISIONAL_INTERVALS} "
               f"intervals at rate {info['assumed_rate']}, {info['rate_source']}. "
               "Regenerate once it has heartbeated for a few hours")
    else:
        how = (f"INSEPARABLE: this device's gaps run {info['lo']}-{info['hi']} s, "
               "so one miss (2 x longest) overlaps two (3 x shortest). The "
               "window avoids a false alarm on one miss, and a double miss "
               "may go unseen")
    return {
        "uid": ("nmas-hb-" + re.sub(r"[^A-Za-z0-9_-]", "-", hostname))[:40],
        "title": f"NMAS heartbeat missing: {hostname}",
        "condition": "C",
        "data": [
            {"refId": "A", "datasourceUid": datasource_uid,
             "relativeTimeRange": {"from": window, "to": 0},
             "model": {"refId": "A", "expr": expr, "queryType": "instant"}},
            {"refId": "B", "datasourceUid": "__expr__",
             "model": {"refId": "B", "type": "reduce", "expression": "A",
                       "reducer": "last"}},
            {"refId": "C", "datasourceUid": "__expr__",
             "model": {"refId": "C", "type": "threshold", "expression": "B",
                       "conditions": [{"evaluator": {"type": "lt",
                                                     "params": [1]}}]}},
        ],
        # A silent device yields NO series: that is the failure, not "fine".
        "noDataState": "Alerting",
        "execErrState": "Alerting",
        "for": "0s",
        "labels": {"nmas": "heartbeat", "device": hostname,
                   "window_basis": basis, "window_seconds": str(window)},
        "annotations": {
            "summary": f"No syslog heartbeat from {hostname} for {window} s",
            "description": (
                f"{hostname} emits {MARKER} every {heartbeat} s by its own "
                f"clock. Window {window} s, {how}. None arrived in the "
                "window: the device, its logging block, the path to rsyslog, "
                "rsyslog, Alloy or Loki has stopped. The heartbeat cannot say "
                "which; it says that one of them has."),
        },
    }


def build(infos: dict, datasource_uid: str, heartbeat: int) -> dict:
    """*infos* is ``{hostname: window info}`` from :func:`windows`."""
    names = sorted(infos)
    if not names:
        raise ValueError("the population is empty -- a rule file with no "
                         "rules alerts on nothing and reads like a healthy fleet")
    if not datasource_uid:
        raise ValueError("no Loki datasource UID")
    if not isinstance(heartbeat, int) or heartbeat < 60:
        raise ValueError(f"heartbeat interval {heartbeat!r} is not usable "
                         "(syslog_heartbeat_seconds, minimum 60)")
    return {"apiVersion": 1, "groups": [{
        "orgId": 1, "name": GROUP, "folder": FOLDER, "interval": "1m",
        "rules": [rule_for(n, datasource_uid, heartbeat, infos[n])
                  for n in names]}]}


def render(doc: dict) -> str:
    import yaml
    head = ("# GENERATED by scripts/nmas-heartbeat-rules: one rule per device "
            "with a window\n# measured from its own heartbeats (label "
            "window_basis). Do not edit; regenerate.\n")
    return head + yaml.safe_dump(doc, sort_keys=False, width=100)


def installed(doc: dict) -> dict:
    """``{device: (window, basis, datasource_uid)}`` from a rules document."""
    out = {}
    for g in doc.get("groups", []):
        for r in g.get("rules", []):
            labels = r.get("labels", {})
            out[labels["device"]] = (int(r["data"][0]["relativeTimeRange"]["from"]),
                                     labels.get("window_basis", "?"),
                                     r["data"][0].get("datasourceUid", ""))
    return out


def devices_in(doc: dict) -> set:
    return set(installed(doc))


def check(installed_now: dict, fresh: dict, expected: set) -> tuple:
    """(exit code, lines). Every device in exactly one named state."""
    lines, code = [], EXIT_OK
    for host in sorted(set(installed_now) | set(expected)):
        if host not in installed_now:
            lines.append(f"MISSING    {host}: told to heartbeat, no rule")
            code = EXIT_STALE
            continue
        if host not in expected:
            lines.append(f"EXTRA      {host}: a rule for a device no longer "
                         "told to heartbeat")
            code = EXIT_STALE
            continue
        window, basis, _uid = installed_now[host]
        now = fresh.get(host, {"basis": "provisional", "n": 0})
        if basis == "provisional":
            if now["basis"] != "provisional":
                lines.append(f"PROVISIONAL READY {host}: {now['n']} gaps now, "
                             f"a measured window would be {now['window']} s "
                             f"(installed {window} s from an assumption) -- regenerate")
                code = EXIT_STALE
            else:
                lines.append(f"provisional {host}: {now['n']} gap(s), still "
                             "too few to measure; the rule is labelled provisional")
            continue
        if now["basis"] == "provisional":
            lines.append(f"UNMEASURABLE {host}: {now['n']} gap(s) in the last "
                         f"{LOOKBACK_HOURS} h -- is it still heartbeating?")
            code = EXIT_STALE
            continue
        lo, hi = now["lo"], now["hi"]
        if now["basis"] == "inseparable":
            lines.append(f"INSEPARABLE {host}: gaps {lo}-{hi} s, one miss "
                         "overlaps two; no window is right")
            code = EXIT_STALE
        elif 2 * hi < window < 3 * lo:
            lines.append(f"current    {host}: window {window} s inside "
                         f"({2 * hi:.0f}, {3 * lo:.0f})")
        else:
            lines.append(f"STALE RATE {host}: window {window} s, but gaps are "
                         f"now {lo}-{hi} s, needing ({2 * hi:.0f}, {3 * lo:.0f}) "
                         "-- the clock rate moved; regenerate")
            code = EXIT_STALE
    return code, lines


# ---------------------------------------------------------------------------
# The population
# ---------------------------------------------------------------------------

def expected_devices() -> tuple:
    """``(set of hostnames told to heartbeat, not_expected)``.

    The population is every device whose COMMITTED intent carries a complete
    syslog block (the operator's decision, 2026-09-25): a device with the
    block has been told to heartbeat, so a rule follows the configuration
    rather than the inventory. *not_expected* names every NetBox device
    without one, stated rather than silently omitted.
    """
    from modules.config import LISTS_DIR
    from modules.device import get_device_lists
    from modules.netbox_client import _nb_get, _nb_ready
    from modules.nsot import hostvars

    expected = set()
    for entry in get_device_lists():
        repo = os.path.join(LISTS_DIR, entry["filename"], "config_repo")
        for name in hostvars.list_committed(repo):
            doc = hostvars.read_committed(repo, name) or {}
            block = (doc.get("logging") or {}).get("syslog")
            if block and not hostvars.syslog_block_problems(doc):
                expected.add(name)
    not_expected = []
    ok, err, session, base = _nb_ready()
    if ok:
        in_netbox = {d["name"] for d in _nb_get(session, base, "dcim/devices/")
                     if d.get("name")}
        not_expected = sorted(in_netbox - expected)
    else:
        not_expected = [f"(NetBox could not be asked: {err})"]
    return expected, not_expected


def _loki_url(arg: str) -> str:
    if arg:
        return arg
    try:
        from modules.integrations.loki import LokiIntegration
        client = LokiIntegration()
        return client.url if client.is_configured() else ""
    except Exception:                          # noqa: BLE001
        return ""


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--datasource-uid",
                    default=os.environ.get("NMAS_GRAFANA_LOKI_UID", ""))
    ap.add_argument("--loki-url", default=os.environ.get("NMAS_LOKI_URL", ""),
                    help="where to MEASURE (default: the Loki integration)")
    ap.add_argument("--check", action="store_true",
                    help="re-measure and compare with the generated rules file "
                         "(--out; generated on the host, not committed)")
    ap.add_argument("--out", default=OUT)
    args = ap.parse_args()

    loki = _loki_url(args.loki_url)
    if not loki:
        print("UNPROVEN: no Loki to measure from (--loki-url, NMAS_LOKI_URL, "
              "or the Loki integration). A window without a measurement is "
              "a guess, and this refuses to write one.")
        return EXIT_UNPROVEN
    from modules.settings_schema import get_setting
    heartbeat = int(get_setting("syslog_heartbeat_seconds") or 0)
    try:
        expected, not_expected = expected_devices()
        fresh = windows({h: gaps_from(loki_arrivals(loki, h),
                                      loki_arrivals(loki, h, query=config_query_for(h)))
                         for h in sorted(expected)}, heartbeat)
    except Exception as exc:                   # noqa: BLE001
        print(f"UNPROVEN: {type(exc).__name__}: {exc}")
        return EXIT_UNPROVEN

    if args.check:
        import yaml
        try:
            with open(args.out, encoding="utf-8") as fh:
                committed = yaml.safe_load(fh) or {}
        except FileNotFoundError:
            print(f"STALE: {args.out} does not exist")
            return EXIT_STALE
        code, lines = check(installed(committed), fresh, expected)
        # The HEADLINE first, stating the failure plainly: job_health reports
        # a failing run's first line that names a failure, and "current r1"
        # ahead of "STALE RATE s3" would bury the one that matters.
        bad = [l for l in lines if l.split()[0].isupper()]
        print(f"FAILED: {len(bad)} of {len(lines)} device(s) need attention: "
              + "; ".join(l.split(":")[0] for l in bad) if bad else
              f"heartbeat windows current for {len(lines)} device(s)")
        print("\n".join(lines))
        return code

    try:
        doc = build(fresh, args.datasource_uid, heartbeat)
    except ValueError as exc:
        print(f"UNPROVEN: {exc}")
        return EXIT_UNPROVEN
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    with open(args.out, "w", encoding="utf-8") as fh:
        fh.write(render(doc))
    for host in sorted(fresh):
        m = fresh[host]
        print(f"  {m['basis']:<11} {host:<6} window {m['window']} s"
              + (f"  (gaps {m['lo']}-{m['hi']} s, n={m['n']})" if "lo" in m
                 else f"  (n={m['n']}, rate {m['assumed_rate']} assumed)"))
    for name in not_expected:
        print(f"  not expected to heartbeat: {name} -- no complete syslog "
              "block in its committed intent")
    print(f"wrote {len(fresh)} rule(s) to {args.out}")
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())
