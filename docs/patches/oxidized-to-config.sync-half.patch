-  git commit -q -m 'harvest from oxidized $ts' && \
-  echo 'Committed to git.' || echo 'Not a git repo, or nothing to commit.'"
+# One transfer per DESTINATION, not per device: the unit of work is a lab,
+# which is the unit --stray and the lab map already use, and a failure is
+# then "this lab was not updated" - a claim nmas-check-startup-applies can
+# confirm per device.
+#
+# --files-from rather than a staging dir per lab: ./configs holds exactly
+# one <hostname>.cfg per device and nothing else, so selecting a subset
+# needs no second copy of it - and a second copy is how the two diverge.
+copy_failed=0
+for dir in $(printf '%s\n' "${DEVICES[@]}" | while read -r n; do echo "${CFGDIR[$n]}"; done | sort -u); do
+  list=""
+  for n in "${DEVICES[@]}"; do
+    [ "${CFGDIR[$n]}" = "$dir" ] && list="${list}${n}.cfg"$'\n'
+  done
+  printf '%s' "$list" > "$STAGE.files.$$"
+  scp -q "$STAGE.files.$$" "${CLAB}:${STAGE}/.files" && rm -f "$STAGE.files.$$"
+  if ssh "$CLAB" "cp -r '$dir' '${dir}.bak-${ts}' 2>/dev/null; \
+                  rsync -a --files-from='$STAGE/.files' '$STAGE/' '$dir/'"; then
+    echo "Copied $(printf '%s' "$list" | grep -c .) file(s) to $dir   (backup ${dir}.bak-${ts})"
+  else
+    echo "Copy FAILED for $dir - staged files left at ${CLAB}:${STAGE}"
+    copy_failed=1
+  fi
+done
+
+[ "$copy_failed" -eq 0 ] || exit 1
+ssh "$CLAB" "rm -rf $STAGE"
+
+for dir in $(printf '%s\n' "${DEVICES[@]}" | while read -r n; do echo "${CFGDIR[$n]}"; done | sort -u); do
+  ssh "$CLAB" "cd \$(dirname '$dir') && \
+    git rev-parse --git-dir >/dev/null 2>&1 && \
+    git add -A \$(basename '$dir') && \
+    git commit -q -m 'harvest from oxidized $ts' && \
+    echo \"Committed \$(basename '$dir') to git.\" || echo \"Not a git repo, or nothing to commit: $dir\""
+done
