#!/usr/bin/env python3
"""Record Ask in words' cases live, and merge a recording into the case file (PHASE8_PLAN 13.6;
modules/ai/cases.py; tests/fixtures/ai_cases/nl_query/metrics.json).

    # on the host, once hosted AI is allowed and this release is deployed: each case one
    # recorded call, as <actor> (the deployed copy, run as a file: it adopts the app's
    # interpreter, whose packages it imports)
    nmas-host nmas -- <checkout>/scripts/nmas-nl-cases --record --list <network> \\
        --actor <actor> --out /tmp/cases.json
    # on the laptop: the recording into the case file, then the gate
    scripts/nmas-nl-cases --merge /tmp/cases.json

**Record** asks each case through `nl_query.metrics`, the screen's own path (the gateway: the
allowance, the caps, the mask, the record), and writes, per case, the model's choices, when,
on which model, its cost and the judge's misses (`cases.misses`), to `--out`, which may not be
inside the checkout (the host's live checkout is never written). It stops at the first refusal
that is not the model's (hosted AI off, a cap), naming it, with nothing more spent.

**Merge** writes each recorded case's `recorded` into the case file, refusing a recording
made on another model than the file's (a pin changed is a set recorded again).

**Check** (`--check --list <network>`, and first thing in every `--record`): each case's
expected metric must be carried by its named devices, else its role, else the network's
devices, in the live catalogue (`cases.stale`). A stale expectation fails the check, before
anything is asked or spent, never as the model's miss (the operator, 2026-10-25: cases 11, 13
and 15 were stale).

**`--cases`** names the case file: the 20 recorded cases by default, or the held-out set
(`tests/fixtures/ai_cases/nl_query/held_out_2.json`; set 1, `held_out.json`, is retired),
measured beside them and reported apart.

**`--thinking adaptive|off`** asks every case with that thinking in place of the task's pin,
for this run (the batched gateway change: v7 measured with and without it).
"""
import os
import sys

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

import argparse  # noqa: E402
import json  # noqa: E402
import time  # noqa: E402

CASES = os.path.join("tests", "fixtures", "ai_cases", "nl_query", "metrics.json")
#: The held-out set (C1724's overfitting guard): measured beside the 20, reported apart, never
#: tuned on. Set 2 since v7 (the operator, 2026-10-25): set 1, `held_out.json`, was seen when
#: v6 was measured and is retired.
HELD_OUT = os.path.join("tests", "fixtures", "ai_cases", "nl_query", "held_out_2.json")
#: Refusals that are Mercury's or the provider's, not the model's: the run stops, spending
#: nothing more (the adapter's kinds, modules/ai/anthropic_adapter.py, among them).
STOPS = ("ai_off", "no_key", "over_cap", "unknown_task", "unknown_model", "not_configured",
         "catalogue", "provider_error", "rate_limited", "overloaded", "key_refused",
         "bad_request", "provider_down")


def _checkout(given: str) -> str:
    return os.path.abspath(os.path.expanduser(given)) if given else ROOT


def check(checkout: str, list_name: str, case_file: str = CASES, prompt: int = None) -> list:
    """The stale expectations (`cases.stale`) against the network's live Prometheus: what the
    named devices, the role or the network's devices carry, one read each. A logs case file
    (``"kind": "logs"``, C1762) is checked by `cases.stale_logs`: the mnemonics each question
    would be offered now, by the prompt version *prompt* names (the platform pack's events
    from v3), one read of the logs reader's counts."""
    from modules import history_promq as pq
    from modules.ai import cases, nl_query

    data = cases.load(os.path.join(checkout, case_file))
    if data.get("kind") == "logs":
        from modules import history_logq as lq
        rng = lq.window(dict(lq.DEFAULTS, range="7d"), time.time())
        seen = lq.mnemonics(list_name, rng, []).get("rows")
        version = prompt or nl_query.PROMPT_LOGS[1]

        def offered(question):
            if seen is None:
                return None
            if version >= 3:
                return [m for m, _w in nl_query.offer_events(
                    question, seen, nl_query.events_for(list_name))]
            return nl_query.offer_mnemonics(question, seen)
        return cases.stale_logs(data, offered)
    client = pq._client(list_name, 15.0)
    rng = pq.window(dict(pq.DEFAULTS), time.time())

    def carried(kind, value):
        if kind == "devices":
            return nl_query.device_metrics(client, rng, value)
        if kind == "role":
            return nl_query.device_metrics(client, rng, [value], label=pq.ROLE_LABEL)
        return nl_query.device_metrics(client, rng)
    return cases.stale(data, carried)


def record(checkout: str, list_name: str, actor: str, out: str, case_file: str = CASES,
           thinking: str = None, model: str = None, prompt: int = None) -> int:
    from modules.ai import cases, nl_query, profiles

    if os.path.realpath(out).startswith(os.path.realpath(checkout) + os.sep):
        print(f"nmas-nl-cases: --out {out} is inside the checkout; write it elsewhere",
              file=sys.stderr)
        return 2
    if "@" in actor:
        # A measurement is never recorded as a person (C1784): its actor names the run.
        print(f"nmas-nl-cases: --actor {actor!r} reads as a person's address; a measurement "
              "is recorded as evaluation:<run id>", file=sys.stderr)
        return 2
    data = cases.load(os.path.join(checkout, case_file))
    logs = data.get("kind") == "logs"
    feature_prompt = (nl_query.PROMPT_LOGS if logs else nl_query.PROMPT)[0]
    asked = (feature_prompt, prompt) if prompt else None
    if model:
        # A comparison on another model (the operator, 2026-10-26: Sonnet 5.5 beside the
        # pinned Haiku 5.5): this process's pin alone is replaced, never the pin file; its
        # recordings name their model, and merge refuses them for a file on another.
        if model not in profiles.MODELS:
            print(f"nmas-nl-cases: no model profile for {model!r}; known: "
                  f"{', '.join(sorted(profiles.MODELS))}", file=sys.stderr)
            return 2
        profiles.TASKS[nl_query.FEATURE] = dict(profiles.TASKS[nl_query.FEATURE], model=model)
        print(f"nmas-nl-cases: a comparison on {model}, the pin file unchanged "
              f"({data['model']} pinned)")
        data = dict(data, model=model)
    pin = profiles.TASKS[nl_query.FEATURE]["model"]
    if data["model"] != pin:
        print(f"nmas-nl-cases: the case file is for {data['model']}, the task is pinned to "
              f"{pin}: record against the pin, after the file says so", file=sys.stderr)
        return 2
    # Every measurement starts with the expectations checked against the live catalogue: a
    # stale one fails here, before anything is asked or spent, never as the model's miss.
    problems = check(checkout, list_name, case_file, prompt)
    if problems:
        for p in problems:
            print(f"nmas-nl-cases: stale expectation: {p}", file=sys.stderr)
        print(f"nmas-nl-cases: {len(problems)} stale expectation(s); nothing recorded, "
              "nothing spent", file=sys.stderr)
        return 3
    got_all, spent = [], 0.0
    for case in data["cases"]:
        now = time.time()
        if logs:
            got = nl_query.logs(list_name, case["question"], actor=actor, prompt=asked)
        else:
            got = nl_query.metrics(list_name, case["question"], actor=actor, thinking=thinking,
                                   prompt=asked)
        spent += float(got.get("cost_usd") or 0)
        if got.get("error") in STOPS:
            print(f"nmas-nl-cases: case {case['n']} refused by Mercury ({got['error']}: "
                  f"{got.get('detail', '')}); stopped, {len(got_all)} recorded, "
                  f"${spent:.4f} spent", file=sys.stderr)
            break
        rec = {"n": case["n"], "model": pin, "now": now,
               "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
               "choices": got.get("choices"), "call_id": got.get("call_id", ""),
               "cost_usd": got.get("cost_usd", 0), "error": got.get("error", ""),
               "prompt": list(asked or (feature_prompt, (nl_query.PROMPT_LOGS if logs
                                                          else nl_query.PROMPT)[1])),
               "misses": (cases.logs_misses if logs else cases.misses)(case["expect"], got,
                                                                       now)}
        got_all.append(rec)
        verdict = "pass" if not rec["misses"] else "MISS: " + "; ".join(rec["misses"])
        print(f"case {case['n']:2d}: {verdict}")
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"model": pin, "thinking": thinking or "the task's pin",
                   "recordings": got_all}, fh, indent=2)
    passed = sum(1 for r in got_all if not r["misses"])
    print(f"{passed} of {len(got_all)} recorded cases pass; ${spent:.4f} spent; written {out}")
    return 0


def merge(checkout: str, path: str, case_file: str = CASES) -> int:
    file = os.path.join(checkout, case_file)
    with open(file, encoding="utf-8") as fh:
        data = json.load(fh)
    with open(path, encoding="utf-8") as fh:
        rec = json.load(fh)
    if rec.get("model") != data["model"]:
        print(f"nmas-nl-cases: the recording is on {rec.get('model')}, the file on "
              f"{data['model']}: refused", file=sys.stderr)
        return 2
    by = {c["n"]: c for c in data["cases"]}
    n = 0
    for r in rec.get("recordings", ()):
        if r.get("choices") is None:
            continue                           # a Mercury refusal: nothing the model said
        by[r["n"]]["recorded"] = {k: r[k] for k in ("model", "now", "recorded_at", "choices")}
        n += 1
    with open(file, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    print(f"merged {n} recorded case(s) into {case_file}")
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    ap.add_argument("--checkout", default="")
    ap.add_argument("--record", action="store_true")
    ap.add_argument("--list", default="")
    ap.add_argument("--actor", default="")
    ap.add_argument("--out", default="")
    ap.add_argument("--merge", default="")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--cases", default=CASES,
                    help="the case file, relative to the checkout (the held-out set: "
                         + HELD_OUT + ")")
    ap.add_argument("--thinking", default=None, choices=("adaptive", "off"),
                    help="ask with this thinking in place of the task's pin, for this run "
                         "(the batched gateway change's measurement)")
    ap.add_argument("--model", default=None,
                    help="ask on this model in place of the pin, for this run only: a "
                         "comparison; its recordings are never merged into a file pinned "
                         "to another")
    ap.add_argument("--prompt", type=int, default=None,
                    help="ask with this prompt version of the case file's feature in place of "
                         "the current one (a candidate measured against the adoption bar: "
                         "metrics 8, logs 3)")
    args = ap.parse_args(argv)
    checkout = _checkout(args.checkout)
    sys.path.insert(0, checkout)
    os.chdir(checkout)
    if args.merge:
        return merge(checkout, args.merge, args.cases)
    if args.check:
        if not args.list:
            ap.error("--check needs --list")
        problems = check(checkout, args.list, args.cases, args.prompt)
        for p in problems:
            print(f"stale expectation: {p}")
        print(f"{len(problems)} stale expectation(s)")
        return 3 if problems else 0
    if args.record:
        if not (args.list and args.actor and args.out):
            ap.error("--record needs --list, --actor and --out")
        return record(checkout, args.list, args.actor, args.out, args.cases, args.thinking,
                      args.model, args.prompt)
    ap.error("--record or --merge")
    return 2


if __name__ == "__main__":
    sys.exit(main())
