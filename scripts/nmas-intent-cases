#!/usr/bin/env python3
"""Record feature 7's cases live (an intent change in words; PHASE8_PLAN 13.6 and 15.16;
modules/ai/intent_words.py; tests/fixtures/ai_cases/intent_patch/).

    # on the host, the deployed copy run as a file (it adopts the app's interpreter): each
    # case asked on its device's Intent tab, as <actor>, five runs
    nmas-host nmas -- <checkout>/scripts/nmas-intent-cases --list <network> \\
        --actor <actor> --runs 5 --out /tmp/intent-cases.json
    nmas-host nmas -- <checkout>/scripts/nmas-intent-cases --list <network> \\
        --cases tests/fixtures/ai_cases/intent_patch/held_out.json --actor <actor> \\
        --runs 5 --out /tmp/intent-held-out.json

Each run asks every case through `intent_words.change`, the screen's own path (the scope read
by code, the gateway's allowance, caps, mask and record, the scope check, the intent editor's
preview), with the case's device as the tab's scope. **Nothing is written:** a draft is only
previewed, as the screen does before a person commits it.

Per case and run it keeps the outcome, the model's operations, the judge's misses
(`cases.intent_misses`), the cost and the latency (the call's wall time), and reports per case
the passes, whether every run gave the same outcome and operations (consistency), and the
cost and latency. A refusal that is Mercury's or the provider's (hosted AI off, a cap) stops the
run with nothing more spent. A call that stops at max_tokens voids the run (C1756's rule).
`--out` may not be inside the checkout (the host's live checkout is never written).
"""
import argparse
import json
import os
import statistics
import sys
import time

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

CASES = os.path.join("tests", "fixtures", "ai_cases", "intent_patch", "recorded.json")
STOPS = ("ai_off", "no_key", "over_cap", "unknown_task", "unknown_model", "provider_error",
         "rate_limited", "overloaded", "key_refused", "bad_request", "provider_down")


def summary(case: dict, runs: list) -> dict:
    """One case's runs, reported: passes, consistency (the same outcome and operations every
    run), cost and latency."""
    shapes = {json.dumps([r["outcome"], sorted(json.dumps(o, sort_keys=True)
                                                for o in r["ops"])]) for r in runs}
    lat = [r["latency_s"] for r in runs]
    return {"n": case["n"], "passed": sum(not r["misses"] for r in runs), "runs": len(runs),
            "consistent": len(shapes) == 1, "cost_usd": round(sum(r["cost_usd"] for r in runs), 4),
            "latency_p50_s": round(statistics.median(lat), 2) if lat else None,
            "outcomes": [r["outcome"] for r in runs],
            "first_miss": next((r["misses"][0] for r in runs if r["misses"]), ""),
            "expect": case["expect"]["outcome"]}


def record(checkout: str, list_name: str, actor: str, out: str, case_file: str,
           runs: int) -> int:
    from modules.ai import cases, intent_words, profiles

    if os.path.realpath(out).startswith(os.path.realpath(checkout) + os.sep):
        print(f"nmas-intent-cases: --out {out} is inside the checkout; write it elsewhere",
              file=sys.stderr)
        return 2
    data = cases.load(os.path.join(checkout, case_file))
    pin = profiles.TASKS[intent_words.FEATURE]["model"]
    if data["model"] != pin:
        print(f"nmas-intent-cases: the case file is for {data['model']}, the task is pinned to "
              f"{pin}", file=sys.stderr)
        return 2
    by_case, spent, status = {c["n"]: [] for c in data["cases"]}, 0.0, 0
    for run in range(1, runs + 1):
        for case in data["cases"]:
            t0 = time.monotonic()
            got = intent_words.change(list_name, case["sentence"], actor=actor,
                                      devices=[case["device"]])
            took = time.monotonic() - t0
            spent += float(got.get("cost_usd") or 0)
            if got.get("error") in STOPS:
                print(f"nmas-intent-cases: run {run} case {case['n']} refused by Mercury "
                      f"({got['error']}: {got.get('detail', '')}); stopped, ${spent:.4f} spent",
                      file=sys.stderr)
                status = 3
                break
            if got.get("error") == "max_tokens":
                print(f"nmas-intent-cases: run {run} case {case['n']} stopped at max_tokens: "
                      "the run is void (C1756)", file=sys.stderr)
                status = 4
                break
            rec = {"run": run, "outcome": cases.intent_outcome(got),
                   "ops": cases.intent_ops(got.get("choices")),
                   "misses": cases.intent_misses(case["expect"], got),
                   "cost_usd": float(got.get("cost_usd") or 0), "latency_s": round(took, 2),
                   "call_id": got.get("call_id", ""), "error": got.get("error", ""),
                   "detail": (got.get("detail") or "")[:240]}
            by_case[case["n"]].append(rec)
            verdict = "pass" if not rec["misses"] else "MISS: " + "; ".join(rec["misses"])
            print(f"run {run} case {case['n']:2d} ({rec['outcome']}, {took:.1f} s): {verdict}",
                  flush=True)
        if status:
            break
    report = [summary(c, by_case[c["n"]]) for c in data["cases"] if by_case[c["n"]]]
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"model": pin, "prompt": f"{intent_words.PROMPT[0]}.v{intent_words.PROMPT[1]}",
                   "case_file": case_file, "runs": runs, "spent_usd": round(spent, 4),
                   "report": report, "recordings": by_case}, fh, indent=2)
    total = sum(s["runs"] for s in report)
    passed = sum(s["passed"] for s in report)
    consistent = sum(s["consistent"] for s in report)
    lat = [r["latency_s"] for rs in by_case.values() for r in rs]
    print(f"{passed} of {total} runs pass; {consistent} of {len(report)} cases consistent; "
          f"latency p50 {statistics.median(lat) if lat else 0:.1f} s; ${spent:.4f} spent; "
          f"written {out}")
    return status


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    ap.add_argument("--checkout", default="")
    ap.add_argument("--list", required=True)
    ap.add_argument("--actor", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--cases", default=CASES)
    ap.add_argument("--runs", type=int, default=1)
    args = ap.parse_args(argv)
    checkout = os.path.abspath(os.path.expanduser(args.checkout)) if args.checkout else ROOT
    sys.path.insert(0, checkout)
    os.chdir(checkout)
    return record(checkout, args.list, args.actor, args.out, args.cases, args.runs)


if __name__ == "__main__":
    sys.exit(main())
