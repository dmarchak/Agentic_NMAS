#!/usr/bin/env python3
"""Which device-credential overrides correspond to a device that exists.

    nmas-credential-overrides            # the survey
    nmas-credential-overrides --orphans  # only the ones nothing claims
    nmas-credential-overrides --json

**NAMES AND KEYS ONLY. No value is read, decrypted or printed** — a tool that
audits a secret store must not become a second place the secrets appear.

## Why this exists

`data/credential_profiles.json` holds a credential per device key, and until
now **nothing removed one except abandoning the device that created it** — and
that only cleared the key it knew about. Measured on the live store: five keys,
of which one was `''` (an onboarding that ran before the key was corrected for
DHCP), one belonged to a probe torn down hours earlier, and one nobody
recognised.

Same shape as the 29 untracked backup directories beside `labs/lab/configs` —
an accumulating store with no expiry and no owner check — **except these hold
credentials**. A credential outliving its device is a secret with no owner, and
the longer it sits the less anybody can say what it opens.

## What counts as "claimed"

A key is claimed when some list can plausibly look it up:

* a `devices.csv` row's `ip` matches it (the inventory the resolver reads);
* a manifest entry's `mgmt_ip` matches it;
* a manifest entry's `reserved_address` matches it — a **pending DHCP** device,
  whose credential is keyed on the reservation because it has no address yet.

Anything else is an orphan. That is a finding to act on and **not** something
this tool deletes: an override may be a deliberate break-glass credential
somebody set by hand, and deleting a credential because a script could not
attribute it is exactly the wrong direction. It prints what would remove each
one instead.
"""

import argparse
import json
import os
import sys

# THE REPO ROOT ON sys.path, the same two lines fourteen other scripts carry.
# Without them this only ran with PYTHONPATH set — which is to say it had never
# been run the way a person runs one.
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

EXIT_OK, EXIT_ORPHANS, EXIT_UNPROVEN = 0, 1, 2


def _lists():
    """List NAMES. `get_device_lists()` returns `list[dict]`, not a mapping.

    The first version iterated it as though it were `{name: slug}` and handed
    a **dict** to `get_list_data_dir()`, which called `.lower()` on it. Sixth
    inferred-signature defect in this project — and it surfaced the moment the
    script was run the way a person runs one, which is the argument for the
    check below rather than for reading more carefully.
    """
    from modules.device import get_device_lists

    return [row.get("name") for row in (get_device_lists() or [])
            if isinstance(row, dict) and row.get("name")]


def claimed_keys() -> dict:
    """``{key: [where it is claimed]}`` across every list."""
    from modules.config import get_list_data_dir
    from modules.device import load_saved_devices
    from modules.nsot import manifest as _m

    claims: dict = {}

    def _claim(key, where):
        if key:
            claims.setdefault(str(key).strip(), []).append(where)

    for name in _lists():
        list_dir = get_list_data_dir(name)
        csv_path = os.path.join(list_dir, "devices.csv")
        try:
            for row in load_saved_devices(csv_path):
                _claim(row.get("ip"), f"{name}: devices.csv ({row.get('hostname','?')})")
        except Exception as exc:                # noqa: BLE001
            print(f"WARNING {name}: inventory unreadable: {exc}", file=sys.stderr)
        repo = os.path.join(list_dir, "config_repo")
        try:
            for entry in (_m.load(repo).get("devices") or {}).values():
                who = entry.get("name", "?")
                _claim(entry.get("mgmt_ip"), f"{name}: manifest ({who})")
                _claim(entry.get("reserved_address"),
                       f"{name}: manifest reservation ({who}, pending DHCP)")
        except Exception as exc:                # noqa: BLE001
            print(f"WARNING {name}: manifest unreadable: {exc}", file=sys.stderr)
    return claims


def survey() -> dict:
    from modules import credentials

    data = credentials._load()                 # noqa: SLF001 - the store's reader
    keys = list((data.get("device_overrides") or {}).keys())
    claims = claimed_keys()
    rows = []
    for key in keys:
        where = claims.get(str(key).strip(), [])
        rows.append({"key": key, "claimed_by": where,
                     "orphan": not where,
                     "unkeyed": not str(key).strip()})
    return {"overrides": rows, "lists": sorted(_lists()),
            "claimed_total": len(claims)}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--orphans", action="store_true")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    result = survey()
    rows = result["overrides"]

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        if not rows:
            print("No device credential overrides are stored.")
            return EXIT_OK
        # A FLOOR ON THE OTHER SIDE. Zero claims across every list means the
        # inventories could not be read, and then EVERY key looks like an
        # orphan -- a scan that could not run, reporting the worst possible
        # answer with confidence.
        if not result["claimed_total"]:
            print("REFUSED - no device was found in any list's inventory or "
                  "manifest, so every override would be reported as an orphan. "
                  "That is a fact about this answer, not about the store.",
                  file=sys.stderr)
            return EXIT_UNPROVEN
        for row in rows:
            if args.orphans and not row["orphan"]:
                continue
            key = row["key"] or "(empty key)"
            if row["unkeyed"]:
                note = ("UNKEYED - nothing can look this up, and abandoning "
                        "the device cannot clear it. Remove it by hand: "
                        "credentials.clear_device_override('')")
            elif row["orphan"]:
                note = ("ORPHAN - no list claims this address. Either a "
                        "deliberate break-glass credential, or a device that "
                        "no longer exists: "
                        f"credentials.clear_device_override({row['key']!r})")
            else:
                note = "claimed by " + "; ".join(row["claimed_by"])
            print(f"  {key:<20} {note}")

        orphans = [r for r in rows if r["orphan"]]
        print()
        print(f"{len(rows)} override(s), {len(orphans)} unclaimed, across "
              f"{len(result['lists'])} list(s).")
        if orphans:
            print("An unclaimed override is a credential with no owner. This "
                  "tool does not delete one: an override may be a deliberate "
                  "break-glass credential, and removing a secret because a "
                  "script could not attribute it is the wrong direction.")
    return EXIT_ORPHANS if any(r["orphan"] for r in rows) else EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
