#!/usr/bin/env python3
"""Which test files a CI job runs: `nmas-shards <browser1|browser2|a|b>` prints them,
space-separated.

CI runs the suite as four jobs at once (the operator, 2026-10-03: a run took 6.5 to 9
minutes, 93% of it the tests; four since C614, 2026-10-09: the files that start a real
browser weighed 40% of the suite, so one job holding them all was the long pole). The two
BROWSER jobs share every file that starts a real browser (`= browser.available()`, the
population tests/test_nmas_gate.py reads), and then all four share the rest; each by the
files' measured seconds (tests/shard_weights.json), the heaviest first, each to the lightest
job. A file the weights do not know weighs their median, so a new file is placed the moment
it exists and the same way every time. The gate runs the same four commands (C349: argument
for argument).
"""

import json
import os
import re
import statistics
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# Phase 4 section 8.1: the interpreter flask-app runs, before any other import.
from modules.app_interpreter import adopt  # noqa: E402
adopt(__name__)

ROOT = os.path.dirname(HERE)
TESTS = os.path.join(ROOT, "tests")
SHARDS = ("browser1", "browser2", "a", "b")
BROWSER_SHARDS = ("browser1", "browser2")
_BROWSER = re.compile(r"=\s*browser\.available\(\)")


def test_files() -> list:
    return sorted(f"tests/{n}" for n in os.listdir(TESTS)
                  if n.startswith("test_") and n.endswith(".py"))


def uses_a_browser(path: str) -> bool:
    with open(os.path.join(ROOT, path), encoding="utf-8") as fh:
        return bool(_BROWSER.search(fh.read()))


def weights() -> dict:
    with open(os.path.join(TESTS, "shard_weights.json"), encoding="utf-8") as fh:
        return json.load(fh)["seconds"]


def assign() -> dict:
    """``{shard: [file, ...]}``: every test file in exactly one shard."""
    files = test_files()
    out = {s: [] for s in SHARDS}
    load = {s: 0.0 for s in SHARDS}
    w = weights()
    median = statistics.median(w.values()) if w else 1.0

    def heaviest_first(fs):
        return sorted(fs, key=lambda f: (-w.get(f, median), f))

    def place(f, among):
        shard = min(among, key=lambda s: (load[s], SHARDS.index(s)))
        out[shard].append(f)
        load[shard] += w.get(f, median)

    browser = [f for f in files if uses_a_browser(f)]
    # The browser jobs share their files first, then all four jobs share the rest, so the
    # four end near the same time.
    for f in heaviest_first(browser):
        place(f, BROWSER_SHARDS)
    for f in heaviest_first(f for f in files if f not in browser):
        place(f, SHARDS)
    return {k: sorted(v) for k, v in out.items()}


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) != 1 or argv[0] not in SHARDS:
        sys.stderr.write(f"usage: nmas-shards <{'|'.join(SHARDS)}>\n")
        return 2
    print(" ".join(assign()[argv[0]]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
