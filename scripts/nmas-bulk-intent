#!/usr/bin/env python3
"""Apply one structured change to N devices' committed intent, as ONE commit.

NSOT_PLAN.md P.1b. Runs IN-PROCESS on the host, through the same helpers the
routes use (`routes.templatize._bulk_inputs`, `_bulk_render_and_eligible`)
and the same `modules.nsot.bulk_intent.plan` / `apply`, so there is still one
code path. It used to POST to the app, and from P.3 the app refuses an
unidentified commit of intent: a shell on the host has no Access assertion.
Shell access to the host is the authentication here, as for `nmas-retire`,
and `--actor` names the person accountable (CLAUDE.md, ACTOR_CONVENTION).

    nmas-bulk-intent --list Default --devices s1,s2,r1 \\
        --change deploy/intent-changes/p1-syslog-block.json
    #   -> the headline ("3 device(s), 1 group(s)"), every group's render
    #      delta, every refusal with both operands, and the preview HASH

    nmas-bulk-intent ... --apply <HASH> --actor you@example.com

Exit 0 previewed / committed, 1 refused (nothing written), 2 could not run.
Read the headline before applying: more than one group means the same change
does something different on some device.
"""

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)


def _run(body: dict, confirmed_hash: str = "", actor: str = "") -> tuple:
    """(status, payload) with the routes' own shapes, computed in-process."""
    from modules.nsot import bulk_intent
    from routes.templatize import _bulk_inputs, _bulk_render_and_eligible

    list_name, repo, devices, steps, error = _bulk_inputs(body)
    if error:
        return 400, {"ok": False, "error": error}
    render, eligible = _bulk_render_and_eligible(list_name, repo)
    if confirmed_hash:
        out = bulk_intent.apply(list_name, repo, devices, steps, confirmed_hash,
                                render=render, eligible=eligible,
                                summary=body.get("summary", ""), actor=actor)
        return (200 if out.get("ok") else 409), out
    out = bulk_intent.plan(repo, devices, steps, render=render,
                           eligible=eligible, summary=body.get("summary", ""))
    return (200 if out.get("ok") else 400), out


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", dest="list_name", required=True)
    ap.add_argument("--devices", required=True, help="comma-separated")
    ap.add_argument("--change", required=True, help="JSON: summary + steps")
    ap.add_argument("--apply", default="", help="the preview hash to commit")
    ap.add_argument("--actor", default="")
    args = ap.parse_args()

    with open(args.change, encoding="utf-8") as fh:
        change = json.load(fh)
    body = {"list_name": args.list_name, "summary": change.get("summary", ""),
            "steps": change["steps"],
            "devices": [d.strip() for d in args.devices.split(",") if d.strip()]}
    try:
        if args.apply:
            if not args.actor:
                print("REFUSED: --actor is required to commit (who is accountable)")
                return 1
            code, out = _run(body, args.apply, args.actor)
            if not out.get("ok"):
                print(f"REFUSED ({code}): {out.get('error')}")
                return 1
            print(f"COMMITTED {out['commit'][:8]}: {out['headline']}")
            print(f"  devices: {', '.join(out['devices'])}")
            if out.get("refused"):
                print(f"  refused (untouched): {', '.join(out['refused'])}")
            return 0
        code, out = _run(body)
    except Exception as exc:                           # noqa: BLE001
        print(f"UNPROVEN: could not run the preview: {type(exc).__name__}: {exc}")
        return 2
    if not out.get("ok"):
        print(f"REFUSED ({code}): {out.get('error')}")
        return 1
    print(out["headline"])
    for n, g in enumerate(out["groups"], 1):
        print(f"\n  group {n}: {', '.join(g['devices'])}")
        for line in g["added"]:
            print(f"    + {line}")
        for line in g["removed"]:
            print(f"    - {line}")
    for r in out["refused"]:
        print(f"\n  REFUSED {r['device']}: {r['reason']}")
        for m in r.get("mismatched", []):
            print(f"    {m['path']}: expected {m['expected']!r}, has {m['has']!r}")
    for a in out["accepted"]:
        if not a.get("deployable"):
            print(f"\n  note {a['device']}: not deployable after the change: "
                  + "; ".join(a.get("blocking_reasons") or []))
    print(f"\npreview hash: {out['hash']}   (apply with --apply {out['hash']} --actor <you>)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
